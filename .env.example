# Omnix Compose settings (WP-11.2). Copy to .env and fill in the required
# values; never commit .env. Generate secrets with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- required -------------------------------------------------------------
# Database owner: runs migrations and backups.
OMNIX_POSTGRES_PASSWORD=
# Runtime role (omnix_app): what the gateway and workers connect as. It is
# created when the database volume is first initialized.
OMNIX_APP_DB_PASSWORD=
# Shared credential between Omnix processes and the model services.
OMNIX_SERVICE_TOKEN=
# Signs agent run tokens; gateway processes only, never the model services.
# At least 32 characters, and different from OMNIX_SERVICE_TOKEN.
OMNIX_RUN_TOKEN_KEY=

# --- optional -------------------------------------------------------------
# OMNIX_POSTGRES_USER=omnix
# OMNIX_POSTGRES_DB=omnix
# OMNIX_POSTGRES_PORT=5432
# OMNIX_WEB_PORT=8080
# OMNIX_API_REPLICAS=2
# OMNIX_JOB_WORKER_POOLS=cpu=2
# Hosts and origins the browser uses to reach the web service.
# OMNIX_ALLOWED_HOSTS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
# OMNIX_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Sign-in is on (local accounts) unless set to oidc or, for loopback development, disabled.
# OMNIX_AUTH_MODE=
# Who may create an account: open, invite (the default here) or closed; guests follow open.
# OMNIX_AUTH_REGISTRATION=invite
# OMNIX_AUTH_GUESTS=false
# Sign in with Google: an OAuth web client whose redirect URI is <origin>/api/auth/google/callback.
# OMNIX_GOOGLE_CLIENT_ID=
# OMNIX_GOOGLE_CLIENT_SECRET=
# OMNIX_GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback
# Runtime data: a named volume by default, or a host path.
# OMNIX_RESOURCES=omnix-resources

# --- storage profile ------------------------------------------------------
# OMNIX_BLOB_BACKEND=s3
# OMNIX_S3_ACCESS_KEY_ID=
# OMNIX_S3_SECRET_ACCESS_KEY=
# OMNIX_S3_BUCKET=omnix

# --- observability profile ------------------------------------------------
# Tracing needs the tracing build: OMNIX_LOCK=tracing.
# OMNIX_LOCK=tracing
# OMNIX_OTEL_ENABLED=true

# --- images -----------------------------------------------------------------
# Released images: OMNIX_IMAGE_REGISTRY=ghcr.io/<owner>/ and OMNIX_IMAGE_TAG=<version>.
# OMNIX_IMAGE_REGISTRY=
# OMNIX_IMAGE_TAG=local
# OMNIX_SOFTWARE_REVISION=
