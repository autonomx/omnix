{
  "name": "@omnix/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:devtools": "vite --host 127.0.0.1 --port 5173 --mode devtools",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "devtools": "react-devtools",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:trading": "vitest run src/features/trading",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:trading": "playwright test tests/e2e/trading-terminal.spec.ts --project=chromium",
    "typecheck": "tsc -b",
    "typecheck:trading": "tsc -p tsconfig.trading.json",
    "api:schema": "python ../scripts/export_gateway_openapi.py web/src/api/generated/openapi.json",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:generate": "npm run api:schema && npm run api:types",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated \"src/features/*/api/generated.ts\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "codemirror": "^6.0.2",
    "lightweight-charts": "^5.1.0",
    "openapi-fetch": "^0.17.0",
    "pixi.js": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "untitled-pixi-live2d-engine": "^1.3.5",
    "zod": "^4.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.0"
  }
}
