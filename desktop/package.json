{
  "name": "omnix-desktop",
  "productName": "Omnix",
  "version": "0.1.0",
  "description": "Omnix as a desktop app: chat, voice, transcription, image generation and more, with the AI models you choose downloaded on first run.",
  "author": "Autonomx",
  "license": "MIT",
  "private": true,
  "main": "out/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && playwright test --config tests/playwright.config.ts",
    "test:unit": "playwright test --config tests/playwright.config.ts tests/unit.spec.ts",
    "dist": "npm run build && node --experimental-require-module scripts/dist.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
