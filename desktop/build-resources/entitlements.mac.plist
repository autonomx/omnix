<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Omnix and every binary it ships (desktop roadmap DT-8.4), applied to the app and,
  as entitlementsInherit, to the bundled Python and PostgreSQL. No App Sandbox: the backend writes its own data dir.
  - allow-jit: Electron's V8.
  - allow-unsigned-executable-memory: Python's ctypes and cffi callbacks (libffi trampolines).
  - disable-library-validation: Python loads its extension modules and wheels' dylibs at run time (the runtime packs
    the setup screen downloads included).
  - device.audio-input: the microphone, for live voice and dictation (Info.plist names why).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
