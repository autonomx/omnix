# Git
.git
.gitignore

# Python (patterns are relative to the context root, so nested caches need **/)
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.egg-info
.eggs
dist
build

# Virtual environments
venv
env
.venv

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests
src/tests/

# Local data
resources/data/
# voice_clones/ - included for voice cloning feature
resources/voice_clones/

# Large model files - these are downloaded inside the container
resources/models/

# Large downloads and temp files
*.zip
*.tar
*.tar.gz
*.tar.zst

# Documentation - keep only README and the agent skills the runtime loads
*.md
!README.md
!src/app/**/*.md

# Node dependencies and web build output (the gateway image serves no SPA)
node_modules/
**/node_modules/
web/dist/

# Local scratch: worktrees, temporary analysis output, test artifacts
.sc16-qualification-worktree/
.tmp-*
.kilo/
artifacts/
# Root-level dot directories: tool caches, local venvs, agent worktrees.
.*
# Local scratch output left in the working tree.
__main__/
_bundle*/
bundle_*/
autoplay-campaign-results-unzipped/
nonfatal-endurance-warnings-summary.json/
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
# The browser app is built and served separately (Nginx); not part of this image.
web/
# Operator runtime data (logs, caches, trading history, run artifacts).
# Compose deployments mount ./resources; the image needs none of it.
resources/trading/
resources/logs/
resources/artifacts/
resources/cache/
resources/tools/
tmp/
