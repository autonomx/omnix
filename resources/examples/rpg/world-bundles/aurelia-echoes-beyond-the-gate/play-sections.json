    {
      "npc_id": "npc:elyra-moonroot",
      "facts": [
        {
          "fact_id": "unfinished-call",
          "text": "The voice in the phone is the hero's own: the last call they made as the blackout took them, torn loose at the crossing and caught in the Memory Loom beneath Moonroot, which plays it back toward Earth. Elyra calls it the Unfinished Call; while it rings, someone on Earth is still listening for the hero.",
          "topics": [
            "voice",
            "phone",
            "call",
            "earth",
            "loom"
          ]
        }
      ]
    },
