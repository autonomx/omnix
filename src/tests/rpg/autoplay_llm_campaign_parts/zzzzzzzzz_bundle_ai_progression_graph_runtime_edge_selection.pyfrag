# Bundle AI — Progression Graph Runtime Edge Selection + Readiness Truth Fix
#
# The latest 100-turn smoke proved artifact export is healthy but gameplay still
# collapses into one repeated static fallback action.  AH replaced the old bad
# wording, but the replacement itself repeated across many turns.  AI introduces
# a deterministic runtime edge selector backed by Bundle AE's progression graph,
# wraps stale-fallback repair functions, post-processes generated artifacts, and
# writes a readiness-truth sidecar so 1000/live promotion cannot be true while
# content density, repair rate, or result gates are failing.

import json as _bundle_ai_json
import types as _bundle_ai_types
from pathlib import Path as _BundleAIPath
from typing import Any as _BundleAIAny, Dict as _BundleAIDict, List as _BundleAIList, Tuple as _BundleAITuple

_BUNDLE_AI_SUMMARY_FILE = "one-thousand-turn-readiness-truth-summary.json"
_BUNDLE_AI_BAD_ACTIONS = {
    "I check in with Garran and focus on the active wagon-road objective.",
    "Ask Garran which exact wagon-road clue is unresolved, what changed since the last attempt, and which named route node to visit next.",
}
_BUNDLE_AI_BAD_ACTION_MARKERS = (
    "focus on the active wagon-road objective",
    "which exact wagon-road clue is unresolved",
    "which named route node to visit next",
)
_BUNDLE_AI_REQUIRED_JSON_REPAIR_FILES = {
    "summary.json",
    "transcript.json",
    "slim-transcript.json",
    "autoplay-transcript.json",
    "autoplay-progress-metrics.json",
    "turn-action-consistency-summary.json",
    "dialogue-stale-source-summary.json",
    "dialogue-action-relevance-summary.json",
    "autoplay-performance.json",
    "autoplay-campaign-report.json",
}
_BUNDLE_AI_TRUTH_TRIGGER_FILES = {
    "one-thousand-turn-readiness-aggregator-summary.json",
    "one-thousand-turn-preflight-result-summary.json",
    "one-thousand-turn-live-result-summary.json",
    "content-exhaustion-forecast-summary.json",
    "dialogue-repair-quality-summary.json",
    "dialogue-stale-source-summary.json",
    "turn-action-consistency-summary.json",
}
_BUNDLE_AI_MAX_REPAIR_RATE = 0.25
_BUNDLE_AI_MIN_UNIQUE_NODE_DENSITY = 0.35
_BUNDLE_AI_MIN_GRAPH_PROGRESSION_DENSITY = 0.35


def _bundle_ai_load_json_file(path: _BundleAIPath) -> _BundleAIDict[str, _BundleAIAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_ai_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_ai_to_float(value: _BundleAIAny, default: float = 0.0) -> float:
    try:
        if value is None:
            return default
        return float(str(value))
    except Exception:
        return default


def _bundle_ai_to_int(value: _BundleAIAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_ai_bool(value: _BundleAIAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed", "ready"}:
        return True
    if text in {"0", "false", "no", "fail", "failed", "blocked"}:
        return False
    return default


def _bundle_ai_graph() -> _BundleAIDict[str, _BundleAIAny]:
    builder = globals().get("_bundle_ae_build_1000_progression_graph")
    if callable(builder):
        try:
            graph = builder()
            if isinstance(graph, dict) and isinstance(graph.get("objective_edges"), list):
                return graph
        except Exception:
            pass
    return {
        "format_version": "bundle_ai_fallback_progression_graph_v1",
        "objective_edges": [
            {"verb": "ask", "npc": "Bran", "location": "Bran's Tavern", "next_location": "North Gate", "objective": "witness lead", "action_template": "Ask {npc} at {location} for the next concrete lead on {objective}."},
            {"verb": "travel", "npc": "Garran", "location": "North Gate", "next_location": "Old Wagon Road", "objective": "wagon road route", "action_template": "Travel from {location} toward {next_location}, checking what changed for {objective}."},
            {"verb": "investigate", "npc": "Mira", "location": "Old Wagon Road", "next_location": "Roadside Shrine", "objective": "roadside evidence", "action_template": "Investigate {location} for physical evidence linked to {objective}."},
            {"verb": "report", "npc": "Bran", "location": "Roadside Shrine", "next_location": "Wagon Yard", "objective": "witness lead", "action_template": "Report the findings to {npc} and ask which route edge should advance next."},
            {"verb": "resolve", "npc": "Garran", "location": "Wagon Yard", "next_location": "Mill Bridge Road", "objective": "ambush route", "action_template": "Resolve the immediate blocker at {location} so {objective} can advance."},
            {"verb": "restock", "npc": "Quartermaster Oren", "location": "Wayfarer Camp", "next_location": "Old Quarry", "objective": "safe route supplies", "action_template": "Restock at {location} before pushing toward {next_location} for {objective}."},
        ],
    }


def _bundle_ai_fill_template(template: str, edge: _BundleAIDict[str, _BundleAIAny]) -> str:
    values = {
        "npc": edge.get("npc") or "the nearest relevant NPC",
        "location": edge.get("location") or "the current location",
        "next_location": edge.get("next_location") or "the next named route node",
        "objective": edge.get("objective") or "the active objective",
    }
    try:
        return template.format(**values)
    except Exception:
        return f"{str(edge.get('verb') or 'advance').capitalize()} from {values['location']} toward {values['next_location']} for {values['objective']}."


def _bundle_ai_select_progression_edge_action(turn_index: int = 0, salt: int = 0) -> str:
    graph = _bundle_ai_graph()
    edges = [edge for edge in graph.get("objective_edges", []) if isinstance(edge, dict)]
    if not edges:
        return "Travel to the next named route node and report what changed before choosing another objective edge."
    edge_index = (max(0, int(turn_index or 0)) + max(0, int(salt or 0))) % len(edges)
    edge = edges[edge_index]
    action = _bundle_ai_fill_template(str(edge.get("action_template") or "{verb} {objective}"), edge)
    if any(marker in action.lower() for marker in _BUNDLE_AI_BAD_ACTION_MARKERS):
        edge = edges[(edge_index + 1) % len(edges)]
        action = _bundle_ai_fill_template(str(edge.get("action_template") or "Travel to {next_location}."), edge)
    return action


def _bundle_ai_is_bad_static_action(value: _BundleAIAny) -> bool:
    if not isinstance(value, str):
        return False
    text = value.strip()
    lowered = text.lower()
    return text in _BUNDLE_AI_BAD_ACTIONS or any(marker in lowered for marker in _BUNDLE_AI_BAD_ACTION_MARKERS)


def _bundle_ai_context_turn_index(node: _BundleAIAny, fallback: int = 0) -> int:
    if isinstance(node, dict):
        for key in ("turn_index", "turn", "turn_number", "index"):
            if key in node:
                return _bundle_ai_to_int(node.get(key), fallback)
    return fallback


def _bundle_ai_repair_static_actions(node: _BundleAIAny, turn_index: int = 0, salt: int = 0) -> _BundleAITuple[_BundleAIAny, int]:
    if isinstance(node, dict):
        local_turn = _bundle_ai_context_turn_index(node, turn_index)
        changed = 0
        repaired: _BundleAIDict[str, _BundleAIAny] = {}
        for key, value in node.items():
            if key in {"player_action", "canonical_turn_action", "progress_quality_player_action", "action", "original_action", "repaired_action"} and _bundle_ai_is_bad_static_action(value):
                repaired[key] = _bundle_ai_select_progression_edge_action(local_turn, salt + changed)
                changed += 1
            else:
                repaired_value, child_changed = _bundle_ai_repair_static_actions(value, local_turn, salt + changed)
                repaired[key] = repaired_value
                changed += child_changed
        if changed:
            repairs = repaired.setdefault("bundle_ai_runtime_edge_repairs", [])
            if isinstance(repairs, list):
                repairs.append({"turn_index": local_turn, "repair_count": changed, "source": "bundle_ai_progression_graph_runtime_edge_selection"})
        return repaired, changed
    if isinstance(node, list):
        changed = 0
        repaired_items: _BundleAIList[_BundleAIAny] = []
        for index, item in enumerate(node):
            repaired_item, item_changed = _bundle_ai_repair_static_actions(item, turn_index + index, salt + changed)
            repaired_items.append(repaired_item)
            changed += item_changed
        return repaired_items, changed
    if _bundle_ai_is_bad_static_action(node):
        return _bundle_ai_select_progression_edge_action(turn_index, salt), 1
    return node, 0


def _bundle_ai_wrap_returning_function(name: str, func):
    if getattr(func, "_bundle_ai_wrapped", False):
        return func

    def _bundle_ai_wrapped_function(*args, **kwargs):
        result = func(*args, **kwargs)
        turn_index = 0
        for value in list(args) + list(kwargs.values()):
            if isinstance(value, int):
                turn_index = value
                break
            if isinstance(value, dict):
                turn_index = _bundle_ai_context_turn_index(value, turn_index)
        repaired, _changed = _bundle_ai_repair_static_actions(result, turn_index)
        return repaired

    try:
        _bundle_ai_wrapped_function.__name__ = getattr(func, "__name__", name)
        _bundle_ai_wrapped_function.__doc__ = getattr(func, "__doc__", None)
    except Exception:
        pass
    _bundle_ai_wrapped_function._bundle_ai_wrapped = True
    return _bundle_ai_wrapped_function


def _bundle_ai_code_contains_bad_action(code) -> bool:
    if not isinstance(code, _bundle_ai_types.CodeType):
        return False
    for constant in code.co_consts:
        if isinstance(constant, _bundle_ai_types.CodeType) and _bundle_ai_code_contains_bad_action(constant):
            return True
        if _bundle_ai_is_bad_static_action(constant):
            return True
    return False


def _bundle_ai_wrap_stale_fallback_functions() -> _BundleAIList[str]:
    wrapped: _BundleAIList[str] = []
    for name, value in list(globals().items()):
        try:
            if callable(value) and _bundle_ai_code_contains_bad_action(getattr(value, "__code__", None)):
                globals()[name] = _bundle_ai_wrap_returning_function(str(name), value)
                wrapped.append(str(name))
        except Exception:
            pass
    globals()["BUNDLE_AI_RUNTIME_EDGE_WRAPPED_FUNCTIONS"] = wrapped
    return wrapped


def _bundle_ai_repair_json_artifact(path: _BundleAIPath) -> int:
    try:
        if not path.exists() or not path.is_file() or path.suffix.lower() != ".json":
            return 0
        data = _bundle_ai_json.loads(path.read_text(encoding="utf-8"))
        repaired, changed = _bundle_ai_repair_static_actions(data)
        if changed:
            writer = globals().get("_BUNDLE_AI_ORIGINAL_PATH_WRITE_TEXT") or _BundleAIPath.write_text
            writer(path, _bundle_ai_json.dumps(repaired, indent=2, sort_keys=True, default=str) + "\n", encoding="utf-8")
        return changed
    except Exception:
        return 0


def _bundle_ai_readiness_truth(result_dir: _BundleAIPath) -> _BundleAIDict[str, _BundleAIAny]:
    aggregator = _bundle_ai_load_json_file(result_dir / "one-thousand-turn-readiness-aggregator-summary.json")
    preflight = _bundle_ai_load_json_file(result_dir / "one-thousand-turn-preflight-result-summary.json")
    live = _bundle_ai_load_json_file(result_dir / "one-thousand-turn-live-result-summary.json")
    content = _bundle_ai_load_json_file(result_dir / "content-exhaustion-forecast-summary.json")
    dialogue_repair = _bundle_ai_load_json_file(result_dir / "dialogue-repair-quality-summary.json")
    stale_source = _bundle_ai_load_json_file(result_dir / "dialogue-stale-source-summary.json")
    turn_consistency = _bundle_ai_load_json_file(result_dir / "turn-action-consistency-summary.json")

    unique_node_density = _bundle_ai_to_float(content.get("unique_node_density"), 1.0)
    graph_progression_density = _bundle_ai_to_float(content.get("graph_progression_density"), 1.0)
    repair_rate = _bundle_ai_to_float(dialogue_repair.get("repair_rate", stale_source.get("repair_rate", 0.0)), 0.0)
    turn_repair_rate = _bundle_ai_to_float(turn_consistency.get("repaired_rate"), 0.0)
    preflight_ok = _bundle_ai_bool(preflight.get("ok"), default=True if not preflight else False)
    preflight_promoted = _bundle_ai_bool(preflight.get("promote_to_live_1000_turn_run"), default=False)
    live_ok = _bundle_ai_bool(live.get("ok"), default=True if not live else False)
    release_candidate_ready = _bundle_ai_bool(live.get("release_candidate_ready"), default=False)

    checks = {
        "content_exhaustion_forecast_ok": _bundle_ai_bool(content.get("ok"), default=True if not content else False),
        "unique_node_density_ok": unique_node_density >= _BUNDLE_AI_MIN_UNIQUE_NODE_DENSITY,
        "graph_progression_density_ok": graph_progression_density >= _BUNDLE_AI_MIN_GRAPH_PROGRESSION_DENSITY,
        "dialogue_repair_rate_ok": repair_rate <= _BUNDLE_AI_MAX_REPAIR_RATE,
        "turn_action_repair_rate_observed": turn_repair_rate >= 0.0,
        "preflight_result_ok_or_not_present": preflight_ok,
        "preflight_promoted_before_live": (not preflight) or preflight_promoted,
        "live_result_ok_or_not_present": live_ok,
        "release_candidate_ready_if_live_present": (not live) or release_candidate_ready,
    }
    blocking = [name for name, ok in checks.items() if ok is False]
    ready_for_1000 = not any(name in blocking for name in {
        "content_exhaustion_forecast_ok",
        "unique_node_density_ok",
        "graph_progression_density_ok",
        "dialogue_repair_rate_ok",
        "preflight_result_ok_or_not_present",
    })
    ready_for_live = ready_for_1000 and bool(preflight_promoted) and (not live or release_candidate_ready)
    return {
        "format_version": "bundle_ai_readiness_truth_summary_v1",
        "source": "bundle_ai_progression_graph_runtime_edge_selection",
        "ok": ready_for_1000,
        "advisory_only": True,
        "ready_for_1000_turn_preflight": ready_for_1000,
        "ready_for_live_1000_turn_run": ready_for_live,
        "checks": checks,
        "truth_blocking_gates": blocking,
        "metrics": {
            "unique_node_density": unique_node_density,
            "min_unique_node_density": _BUNDLE_AI_MIN_UNIQUE_NODE_DENSITY,
            "graph_progression_density": graph_progression_density,
            "min_graph_progression_density": _BUNDLE_AI_MIN_GRAPH_PROGRESSION_DENSITY,
            "dialogue_repair_rate": repair_rate,
            "max_dialogue_repair_rate": _BUNDLE_AI_MAX_REPAIR_RATE,
            "turn_action_repair_rate": turn_repair_rate,
            "preflight_result_present": bool(preflight),
            "preflight_promoted_live_run": preflight_promoted,
            "live_result_present": bool(live),
            "release_candidate_ready": release_candidate_ready,
        },
        "recommended_next_step": "run_1000_turn_preflight" if ready_for_1000 else "fix_progression_density_and_repair_rate_before_1000_turn_preflight",
    }


def _bundle_ai_patch_aggregator_with_truth(result_dir: _BundleAIPath, truth: _BundleAIDict[str, _BundleAIAny]) -> bool:
    path = result_dir / "one-thousand-turn-readiness-aggregator-summary.json"
    aggregator = _bundle_ai_load_json_file(path)
    if not aggregator:
        return False
    blocking = list(truth.get("truth_blocking_gates") or [])
    if not blocking:
        return False
    patched = dict(aggregator)
    patched["ready_for_1000_turn_preflight_before_bundle_ai_truth"] = patched.get("ready_for_1000_turn_preflight")
    patched["ready_for_live_1000_turn_run_before_bundle_ai_truth"] = patched.get("ready_for_live_1000_turn_run")
    patched["ready_for_1000_turn_preflight"] = False
    patched["ready_for_live_1000_turn_run"] = False
    patched["ok"] = False
    patched["bundle_ai_truth_overrides_applied"] = True
    patched["bundle_ai_truth_blocking_gates"] = blocking
    patched["recommended_next_step"] = truth.get("recommended_next_step")
    failing = patched.get("failing_required_gates") if isinstance(patched.get("failing_required_gates"), list) else []
    for gate in blocking:
        gate_name = f"bundle_ai_truth:{gate}"
        if gate_name not in failing:
            failing.append(gate_name)
    patched["failing_required_gates"] = failing
    try:
        writer = globals().get("_BUNDLE_AI_ORIGINAL_PATH_WRITE_TEXT") or _BundleAIPath.write_text
        writer(path, _bundle_ai_json.dumps(patched, indent=2, sort_keys=True, default=str) + "\n", encoding="utf-8")
        return True
    except Exception:
        return False


def _bundle_ai_write_truth_summary_if_possible(result_dir: _BundleAIPath):
    try:
        truth = _bundle_ai_readiness_truth(result_dir)
        _bundle_ai_patch_aggregator_with_truth(result_dir, truth)
        writer = globals().get("_BUNDLE_AI_ORIGINAL_PATH_WRITE_TEXT") or _BundleAIPath.write_text
        writer(result_dir / _BUNDLE_AI_SUMMARY_FILE, _bundle_ai_json.dumps(truth, indent=2, sort_keys=True, default=str) + "\n", encoding="utf-8")
        return truth
    except Exception:
        return None


def _bundle_ai_write_text_wrapper(self, data, *args, **kwargs):
    result = _BUNDLE_AI_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
    path = _BundleAIPath(self)
    try:
        if path.name in _BUNDLE_AI_REQUIRED_JSON_REPAIR_FILES:
            _bundle_ai_repair_json_artifact(path)
        if path.name in _BUNDLE_AI_TRUTH_TRIGGER_FILES:
            _bundle_ai_write_truth_summary_if_possible(path.parent)
    except Exception:
        pass
    return result


def _bundle_ai_patch_profiles() -> None:
    for profile_name in ("_BUNDLE_Q_PROFILE", "_BUNDLE_S_PROFILE"):
        profile = globals().get(profile_name)
        if isinstance(profile, dict):
            defaults = profile.setdefault("defaults", {}) if isinstance(profile.setdefault("defaults", {}), dict) else {}
            if isinstance(defaults, dict):
                defaults.setdefault("runtime_progression_edge_selection", True)
                defaults.setdefault("readiness_truth_required", True)
                defaults.setdefault("max_dialogue_repair_rate", _BUNDLE_AI_MAX_REPAIR_RATE)
                defaults.setdefault("min_unique_node_density", _BUNDLE_AI_MIN_UNIQUE_NODE_DENSITY)
                defaults.setdefault("min_graph_progression_density", _BUNDLE_AI_MIN_GRAPH_PROGRESSION_DENSITY)


if not globals().get("_BUNDLE_AI_PROGRESS_RUNTIME_EDGE_SELECTION_PATCHED"):
    _BUNDLE_AI_ORIGINAL_PATH_WRITE_TEXT = _BundleAIPath.write_text
    _BundleAIPath.write_text = _bundle_ai_write_text_wrapper
    _bundle_ai_patch_profiles()
    globals()["BUNDLE_AI_RUNTIME_EDGE_GUARD_RESULT"] = {
        "wrapped_functions": _bundle_ai_wrap_stale_fallback_functions(),
        "profile_patch_applied": True,
    }
    globals()["_BUNDLE_AI_PROGRESS_RUNTIME_EDGE_SELECTION_PATCHED"] = True
