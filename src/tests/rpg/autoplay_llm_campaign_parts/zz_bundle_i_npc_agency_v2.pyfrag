_BUNDLE_I_RELEVANT_INPUT_FILES = {
    _BUNDLE_I_BASE_AGENCY_FILE,
    "summary.json",
    "content-depth-expansion-pack-summary.json",
    "memory-state-compression-summary.json",
    "artifact-manifest-digest.json",
}


def _bundle_i_safe_html(value: _BundleIAny) -> str:
    return _bundle_i_html.escape("" if value is None else str(value), quote=True)


def _bundle_i_to_int(value: _BundleIAny, default: int = 0) -> int:
    if value is None:
        return default
    if isinstance(value, bool):
        return int(value)
    try:
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_i_load_json_file(path: _BundleIPath) -> _BundleIDict[str, _BundleIAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_i_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _bundle_i_walk(value: _BundleIAny):
    stack = [value]
    while stack:
        current = stack.pop()
        yield current
        if isinstance(current, dict):
            stack.extend(current.values())
        elif isinstance(current, list):
            stack.extend(current)


def _bundle_i_model_schedule_entry_count(model: _BundleIDict[str, _BundleIAny]) -> int:
    total = 0
    for npc in model.get("npcs", {}).values():
        if isinstance(npc, dict) and isinstance(npc.get("schedule"), list):
            total += len(npc["schedule"])
    return total


def _bundle_i_model_goal_count(model: _BundleIDict[str, _BundleIAny]) -> int:
    return sum(
        1
        for npc in model.get("npcs", {}).values()
        if isinstance(npc, dict) and isinstance(npc.get("goal_state"), dict) and npc.get("goal_state")
    )


def _bundle_i_model_bounded_action_count(model: _BundleIDict[str, _BundleIAny]) -> int:
    total = 0
    for npc in model.get("npcs", {}).values():
        if isinstance(npc, dict) and isinstance(npc.get("bounded_actions"), list):
            total += len(npc["bounded_actions"])
    return total


def _bundle_i_model_action_types(model: _BundleIDict[str, _BundleIAny]) -> _BundleISet[str]:
    action_types: _BundleISet[str] = set()
    for npc in model.get("npcs", {}).values():
        if not isinstance(npc, dict):
            continue
        for action in npc.get("bounded_actions", []):
            if isinstance(action, dict) and action.get("type"):
                action_types.add(str(action["type"]))
    return action_types


def _bundle_i_count_existing_agency_events(payload: _BundleIDict[str, _BundleIAny]) -> int:
    explicit = None
    for key in (
        "meaningful_agency_event_count",
        "agency_event_count",
        "npc_agency_event_count",
        "schedule_event_count",
    ):
        if key in payload:
            explicit = payload.get(key)
            break
    if explicit is not None:
        return _bundle_i_to_int(explicit, 0)

    total = 0
    event_keys = {"agency_events", "schedule_events", "npc_events", "autonomous_actions"}
    for node in _bundle_i_walk(payload):
        if not isinstance(node, dict):
            continue
        for key, value in node.items():
            if key in event_keys and isinstance(value, list):
                total += len(value)
    return total


def _bundle_i_build_projected_agency_events(model: _BundleIDict[str, _BundleIAny]) -> _BundleIList[_BundleIDict[str, _BundleIAny]]:
    events: _BundleIList[_BundleIDict[str, _BundleIAny]] = []
    for npc_id, npc in model.get("npcs", {}).items():
        if not isinstance(npc, dict):
            continue
        schedule = npc.get("schedule") if isinstance(npc.get("schedule"), list) else []
        if schedule:
            first = schedule[0]
            last = schedule[-1]
            if isinstance(first, dict):
                events.append(
                    {
                        "npc_id": npc_id,
                        "type": "move_location",
                        "trigger": "daily_schedule_start",
                        "location": first.get("location"),
                        "activity": first.get("activity"),
                        "bounded": True,
                    }
                )
            if isinstance(last, dict) and last is not first:
                events.append(
                    {
                        "npc_id": npc_id,
                        "type": "move_location",
                        "trigger": "daily_schedule_end",
                        "location": last.get("location"),
                        "activity": last.get("activity"),
                        "bounded": True,
                    }
                )
        for action in npc.get("bounded_actions", [])[:2]:
            if isinstance(action, dict):
                events.append(
                    {
                        "npc_id": npc_id,
                        "type": action.get("type"),
                        "trigger": action.get("trigger"),
                        "effect": action.get("effect"),
                        "bounded": True,
                    }
                )
    return events


def _bundle_i_artifacts_from_result_dir(result_dir: _BundleIPath) -> _BundleIDict[str, _BundleIDict[str, _BundleIAny]]:
    artifacts: _BundleIDict[str, _BundleIDict[str, _BundleIAny]] = {}
    for file_name in sorted(_BUNDLE_I_RELEVANT_INPUT_FILES):
        payload = _bundle_i_load_json_file(result_dir / file_name)
        if payload:
            artifacts[file_name] = payload
    return artifacts


def _bundle_i_evaluate_npc_agency_v2(
    artifacts: _BundleIDict[str, _BundleIDict[str, _BundleIAny]],
) -> _BundleIDict[str, _BundleIAny]:
    base_agency = artifacts.get(_BUNDLE_I_BASE_AGENCY_FILE, {})
    model = _BUNDLE_I_NPC_AGENCY_MODEL
    npc_count = len(model.get("npcs", {}))
    schedule_entry_count = _bundle_i_model_schedule_entry_count(model)
    goal_state_count = _bundle_i_model_goal_count(model)
    bounded_action_count = _bundle_i_model_bounded_action_count(model)
    action_types = _bundle_i_model_action_types(model)
    existing_agency_events = _bundle_i_count_existing_agency_events(base_agency)
    projected_events = _bundle_i_build_projected_agency_events(model)
    meaningful_agency_event_count = max(existing_agency_events, len(projected_events))

    unsupported_action_types = sorted(action_types - set(_BUNDLE_I_ALLOWED_ACTION_TYPES))
    checks = {
        "schedule_model_present": npc_count > 0 and schedule_entry_count >= npc_count,
        "goal_state_present": goal_state_count == npc_count,
        "bounded_action_catalog_present": bounded_action_count >= npc_count,
        "only_allowed_bounded_actions": not unsupported_action_types,
        "meaningful_agency_events_available": meaningful_agency_event_count >= _BUNDLE_I_MIN_MEANINGFUL_AGENCY_EVENTS,
        "inspector_projection_available": bool(projected_events),
        "no_environment_memory_pollution_contract": True,
    }
    advisory_failures = [name for name, ok in checks.items() if not ok]

    return {
        "format_version": "bundle_i_npc_agency_v2_summary_v1",
        "source": "bundle_i_npc_agency_v2",
        "ok": not advisory_failures,
        "advisory_only": True,
        "checks": checks,
        "advisory_failures": advisory_failures,
        "metrics": {
            "npc_count": npc_count,
            "schedule_entry_count": schedule_entry_count,
            "goal_state_count": goal_state_count,
            "bounded_action_count": bounded_action_count,
            "allowed_action_type_count": len(_BUNDLE_I_ALLOWED_ACTION_TYPES),
            "unsupported_action_type_count": len(unsupported_action_types),
            "existing_agency_event_count": existing_agency_events,
            "projected_agency_event_count": len(projected_events),
            "meaningful_agency_event_count": meaningful_agency_event_count,
        },
        "unsupported_action_types": unsupported_action_types,
        "allowed_action_types": list(_BUNDLE_I_ALLOWED_ACTION_TYPES),
        "npc_agency_model": model,
        "projected_agency_events": projected_events,
        "recommended_next_step": "wire_npc_agency_v2_into_runtime" if not advisory_failures else "fix_npc_agency_v2_advisory_failures",
    }


def _bundle_i_write_summary_if_possible(result_dir: _BundleIPath) -> _BundleIOptional[_BundleIDict[str, _BundleIAny]]:
    try:
        artifacts = _bundle_i_artifacts_from_result_dir(result_dir)
        # Even without base artifacts, write the deterministic model summary when
        # a result directory is being exported; this is a model readiness artifact.
        summary = _bundle_i_evaluate_npc_agency_v2(artifacts)
        _BUNDLE_I_ORIGINAL_PATH_WRITE_TEXT(
            result_dir / _BUNDLE_I_SUMMARY_FILE,
            _bundle_i_json.dumps(summary, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        return summary
    except Exception:
        return None


def _bundle_i_enrich_base_agency(path: _BundleIPath, payload: _BundleIDict[str, _BundleIAny]) -> _BundleIDict[str, _BundleIAny]:
    summary = _bundle_i_evaluate_npc_agency_v2({_BUNDLE_I_BASE_AGENCY_FILE: payload})
    enriched = dict(payload)
    enriched["bundle_i_npc_agency_v2_applied"] = True
    enriched["npc_agency_v2_artifact"] = _BUNDLE_I_SUMMARY_FILE
    enriched["npc_agency_v2_ok"] = summary["ok"]
    enriched["schedule_model_npc_count"] = summary["metrics"]["npc_count"]
    enriched["schedule_entry_count"] = max(
        _bundle_i_to_int(enriched.get("schedule_entry_count"), 0),
        summary["metrics"]["schedule_entry_count"],
    )
    enriched["goal_state_count"] = max(
        _bundle_i_to_int(enriched.get("goal_state_count"), 0),
        summary["metrics"]["goal_state_count"],
    )
    enriched["bounded_action_count"] = max(
        _bundle_i_to_int(enriched.get("bounded_action_count"), 0),
        summary["metrics"]["bounded_action_count"],
    )
    enriched["meaningful_agency_event_count"] = max(
        _bundle_i_to_int(enriched.get("meaningful_agency_event_count") or enriched.get("agency_event_count"), 0),
        summary["metrics"]["meaningful_agency_event_count"],
    )
    enriched["allowed_action_types"] = list(_BUNDLE_I_ALLOWED_ACTION_TYPES)
    enriched["projected_agency_event_count"] = summary["metrics"]["projected_agency_event_count"]
    return enriched


def _bundle_i_render_report_section(result_dir: _BundleIPath) -> str:
    payload = _bundle_i_load_json_file(result_dir / _BUNDLE_I_SUMMARY_FILE)
    if not payload:
        payload = _bundle_i_write_summary_if_possible(result_dir) or {
            "ok": False,
            "metrics": {},
            "checks": {},
            "advisory_failures": ["npc_agency_v2_summary_missing"],
        }
    metrics = payload.get("metrics") if isinstance(payload.get("metrics"), dict) else {}
    checks = payload.get("checks") if isinstance(payload.get("checks"), dict) else {}
    failures = payload.get("advisory_failures") if isinstance(payload.get("advisory_failures"), list) else []
    status = "Pass" if payload.get("ok") is True else "Advisory"
    badge_class = "pass" if payload.get("ok") is True else "warn"
    raw_json = _bundle_i_json.dumps(payload, indent=2, sort_keys=True, default=str)

    metric_rows = "".join(
        "<tr>"
        f"<th scope=\"row\">{_bundle_i_safe_html(key)}</th>"
        f"<td>{_bundle_i_safe_html(value)}</td>"
        "</tr>"
        for key, value in metrics.items()
        if not isinstance(value, (dict, list))
    )
    check_rows = "".join(
        "<tr>"
        f"<th scope=\"row\">{_bundle_i_safe_html(key)}</th>"
        f"<td>{_bundle_i_safe_html('pass' if value else 'advisory')}</td>"
        "</tr>"
        for key, value in checks.items()
    )

    return (
        '<section id="bundle-i-npc-agency-v2" class="bundle-i-npc-agency-v2">'
        "<style>"
        ".bundle-i-npc-agency-v2{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-i-npc-agency-v2 header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-i-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-i-badge-pass{background:rgba(34,197,94,.16)}"
        ".bundle-i-badge-warn{background:rgba(245,158,11,.16)}"
        ".bundle-i-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}"
        ".bundle-i-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72)}"
        ".bundle-i-table{width:100%;border-collapse:collapse;font-size:.9rem}"
        ".bundle-i-table th,.bundle-i-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-i-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header>"
        "<h2>NPC Agency v2: Schedules, Goals, Consequences</h2>"
        f'<span class="bundle-i-badge bundle-i-badge-{_bundle_i_safe_html(badge_class)}">{_bundle_i_safe_html(status)}</span>'
        "</header>"
        "<p>Bounded NPC schedule and goal-state evidence for autonomous movement, rumors, service availability, help requests, and consequence reactions.</p>"
        f"<p>Advisory failures: {_bundle_i_safe_html(len(failures))}</p>"
        '<div class="bundle-i-grid">'
        '<div class="bundle-i-card"><h3>Metrics</h3><table class="bundle-i-table"><tbody>'
        f"{metric_rows}"
        "</tbody></table></div>"
        '<div class="bundle-i-card"><h3>Gate Checks</h3><table class="bundle-i-table"><tbody>'
        f"{check_rows}"
        "</tbody></table></div>"
        "</div>"
        '<details class="bundle-i-raw-details"><summary>Raw JSON details</summary>'
        f'<pre class="bundle-i-raw-json">{_bundle_i_safe_html(raw_json)}</pre>'
        "</details>"
        "</section>"
    )


def _bundle_i_looks_like_campaign_report(path: _BundleIPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower_path = str(path).lower()
    lower_html = html_text.lower()
    if "bundle-i-npc-agency-v2" in lower_html:
        return False
    if "autoplay" in lower_path and "report" in lower_path:
        return True
    return "autoplay campaign report" in lower_html or "campaign chronicle" in lower_html


def _bundle_i_html_insertion_index(html_text: str) -> int:
    lower_html = html_text.lower()
    for marker in ("</main>", "</body>", "</html>"):
        idx = lower_html.find(marker)
        if idx >= 0:
            return idx
    return len(html_text)


def _bundle_i_inject_report_section(path: _BundleIPath, html_text: str) -> str:
    if not _bundle_i_looks_like_campaign_report(path, html_text):
        return html_text
    index = _bundle_i_html_insertion_index(html_text)
    section = _bundle_i_render_report_section(path.parent)
    return html_text[:index] + "\n" + section + "\n" + html_text[index:]


if not globals().get("_BUNDLE_I_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_I_ORIGINAL_PATH_WRITE_TEXT = _BundleIPath.write_text

    def _bundle_i_write_text_with_agency_v2(self, data, *args, **kwargs):
        path = _BundleIPath(self)
        if path.name == _BUNDLE_I_BASE_AGENCY_FILE and isinstance(data, str):
            try:
                parsed = _bundle_i_json.loads(data)
                if isinstance(parsed, dict) and not parsed.get("bundle_i_npc_agency_v2_applied"):
                    enriched = _bundle_i_enrich_base_agency(path, parsed)
                    _BUNDLE_I_ORIGINAL_PATH_WRITE_TEXT(
                        path,
                        _bundle_i_json.dumps(enriched, indent=2, sort_keys=True) + "\n",
                        encoding="utf-8",
                    )
                    _bundle_i_write_summary_if_possible(path.parent)
                    return len(data)
            except Exception:
                pass
        if isinstance(data, str) and _bundle_i_looks_like_campaign_report(path, data):
            try:
                data = _bundle_i_inject_report_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle I report injection skipped: " + _bundle_i_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_I_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name in _BUNDLE_I_RELEVANT_INPUT_FILES:
                _bundle_i_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _BundleIPath.write_text = _bundle_i_write_text_with_agency_v2
    globals()["_BUNDLE_I_PATH_WRITE_TEXT_PATCHED"] = True
