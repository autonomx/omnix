# Bundle I — NPC Agency v2: Schedules, Goals, Consequences
#
# Advisory/bounded NPC agency layer.  This fragment exposes deterministic daily
# schedules, NPC goal state, bounded autonomous action permissions, and report
# visibility.  It does not mutate authoritative simulation state; it writes
# artifact evidence that later gameplay/runtime code can consume or compare
# against without giving narration/LLM permission to invent outcomes.

import html as _bundle_i_html
import json as _bundle_i_json
from pathlib import Path as _BundleIPath
from typing import Any as _BundleIAny, Dict as _BundleIDict, Iterable as _BundleIIterable, List as _BundleIList, Optional as _BundleIOptional, Set as _BundleISet, Tuple as _BundleITuple


_BUNDLE_I_SUMMARY_FILE = "npc-agency-v2-summary.json"
_BUNDLE_I_BASE_AGENCY_FILE = "npc-agency-schedule-summary.json"
_BUNDLE_I_REPORT_MARKER = 'id="bundle-i-npc-agency-v2"'
_BUNDLE_I_MIN_MEANINGFUL_AGENCY_EVENTS = 6

_BUNDLE_I_ALLOWED_ACTION_TYPES = [
    "move_location",
