      }
      .turn-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 10px;
      }
      .player-action, .narration, .npc-line {
        margin: 10px 0;
        padding: 11px 13px;
        border-radius: 14px;
