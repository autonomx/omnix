        border: 1px solid rgba(242,232,213,0.08);
      }
      .npc-line { border-left: 3px solid var(--accent-2); }
      .badges { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
      .badge {
        display: inline-flex;
