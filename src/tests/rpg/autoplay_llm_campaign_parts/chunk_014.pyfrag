        border: 1px solid var(--line);
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(36,31,26,0.96), rgba(27,24,21,0.96));
        box-shadow: var(--shadow);
      }
      .muted { color: var(--muted); }
      .turn-card {
        margin: 14px 0;
        padding: 18px;
