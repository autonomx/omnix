# Bundle G — Content Exhaustion Expansion Pack for 300 Turns
#
# This is a bounded/advisory content-depth layer for the 300-turn readiness
# path.  It does not let the LLM invent outcomes; it exposes deterministic
# second-act objectives, rumor leads, NPC hooks, travel complications, and
# location unlocks as artifact evidence and enriches content exhaustion forecasts
# to account for the added available content budget.

import json as _bundle_g_json
from pathlib import Path as _BundleGPath
from typing import Any as _BundleGAny, Dict as _BundleGDict, Iterable as _BundleGIterable, List as _BundleGList, Optional as _BundleGOptional, Set as _BundleGSet


_BUNDLE_G_DEPTH_FILE = "content-depth-expansion-pack-summary.json"
_BUNDLE_G_FORECAST_FILE = "content-exhaustion-forecast-summary.json"
_BUNDLE_G_TARGET_TURNS = 300
_BUNDLE_G_MIN_UNIQUE_LEADS_FOR_300 = 24
_BUNDLE_G_REPEAT_GUARDS = [
    "no_repeated_observe_talk_loops",
    "no_repeated_payment_trace_if_resolved",
    "no_stale_objective_target_loops",
]

