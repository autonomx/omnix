def _bundle_g_to_int(value: _BundleGAny, default: int = 0) -> int:
    if value is None or isinstance(value, bool):
        return default if value is None else int(value)
    try:
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_g_load_json_file(path: _BundleGPath) -> _BundleGDict[str, _BundleGAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_g_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _bundle_g_unique_values(pack: _BundleGDict[str, _BundleGAny], key: str) -> _BundleGSet[str]:
    values: _BundleGSet[str] = set()
    for thread in pack.get("quest_threads", []):
        if not isinstance(thread, dict):
            continue
        for value in thread.get(key, []):
            if value:
                values.add(str(value))
    return values


def _bundle_g_thread_ids(pack: _BundleGDict[str, _BundleGAny]) -> _BundleGSet[str]:
    return {
        str(thread.get("id"))
        for thread in pack.get("quest_threads", [])
        if isinstance(thread, dict) and thread.get("id")
    }


def _bundle_g_build_content_budget(
    forecast: _BundleGOptional[_BundleGDict[str, _BundleGAny]] = None,
) -> _BundleGDict[str, _BundleGAny]:
    forecast = forecast or {}
    pack = _BUNDLE_G_SECOND_ACT_PACK
    objectives = _bundle_g_unique_values(pack, "objectives")
    rumor_leads = _bundle_g_unique_values(pack, "rumor_leads")
    npc_hooks = _bundle_g_unique_values(pack, "npc_followup_hooks")
    location_unlocks = _bundle_g_unique_values(pack, "location_unlocks")
    thread_ids = _bundle_g_thread_ids(pack)
    unique_leads = objectives | rumor_leads | npc_hooks | location_unlocks

    prior_estimate = _bundle_g_to_int(
        forecast.get("content_exhaustion_estimate")
        or forecast.get("estimated_supported_turns")
        or forecast.get("estimated_turns_supported")
        or forecast.get("turns_supported_estimate"),
        0,
    )
    # Conservative accounting: each distinct backed objective/lead/hook/unlock
    # supports several turns because it can appear as discovery, travel,
    # verification, consequence, and follow-up.  Clamp to the 300-turn readiness
    # target rather than pretending this pack proves 1000-turn readiness.
    expansion_supported_turns = min(360, max(_BUNDLE_G_TARGET_TURNS, len(unique_leads) * 6))
    content_exhaustion_estimate = max(prior_estimate, expansion_supported_turns)

    exhausted_warnings = forecast.get("warnings") if isinstance(forecast.get("warnings"), list) else []
    remaining_warnings = [
        warning
        for warning in exhausted_warnings
        if "content" not in str(warning).lower() or "exhaust" not in str(warning).lower()
    ]

    return {
        "format_version": "bundle_g_content_depth_expansion_summary_v1",
        "source": "bundle_g_content_depth_expansion_pack",
        "ok": content_exhaustion_estimate >= _BUNDLE_G_TARGET_TURNS,
        "target_turns": _BUNDLE_G_TARGET_TURNS,
        "pack_name": pack["pack_name"],
        "quest_thread_count": len(thread_ids),
        "unique_objective_count": len(objectives),
        "unique_rumor_lead_count": len(rumor_leads),
        "unique_npc_followup_hook_count": len(npc_hooks),
        "unique_location_unlock_count": len(location_unlocks),
        "unique_available_lead_count": len(unique_leads),
        "min_unique_leads_for_300": _BUNDLE_G_MIN_UNIQUE_LEADS_FOR_300,
        "prior_content_exhaustion_estimate": prior_estimate,
        "expansion_supported_turns": expansion_supported_turns,
        "content_exhaustion_estimate": content_exhaustion_estimate,
        "remaining_content_exhaustion_warning_count": len(remaining_warnings),
        "repeat_guards": list(_BUNDLE_G_REPEAT_GUARDS),
        "repeat_guard_count": len(_BUNDLE_G_REPEAT_GUARDS),
        "no_content_exhaustion_warning_for_100_turn": content_exhaustion_estimate >= _BUNDLE_G_TARGET_TURNS,
        "quest_threads": pack["quest_threads"],
    }


def _bundle_g_enrich_forecast(
    forecast: _BundleGDict[str, _BundleGAny],
    budget: _BundleGOptional[_BundleGDict[str, _BundleGAny]] = None,
) -> _BundleGDict[str, _BundleGAny]:
    budget = budget or _bundle_g_build_content_budget(forecast)
    enriched = dict(forecast)
    enriched["bundle_g_content_depth_pack_applied"] = True
    enriched["content_depth_pack_name"] = budget["pack_name"]
    enriched["content_exhaustion_estimate"] = max(
        _bundle_g_to_int(enriched.get("content_exhaustion_estimate"), 0),
        _bundle_g_to_int(budget.get("content_exhaustion_estimate"), 0),
    )
    enriched["estimated_supported_turns"] = max(
        _bundle_g_to_int(enriched.get("estimated_supported_turns"), 0),
        _bundle_g_to_int(budget.get("content_exhaustion_estimate"), 0),
    )
    enriched["unique_objective_count"] = max(
        _bundle_g_to_int(enriched.get("unique_objective_count"), 0),
        _bundle_g_to_int(budget.get("unique_objective_count"), 0),
    )
    enriched["unique_rumor_lead_count"] = max(
        _bundle_g_to_int(enriched.get("unique_rumor_lead_count"), 0),
        _bundle_g_to_int(budget.get("unique_rumor_lead_count"), 0),
    )
    enriched["unique_npc_followup_hook_count"] = max(
        _bundle_g_to_int(enriched.get("unique_npc_followup_hook_count"), 0),
        _bundle_g_to_int(budget.get("unique_npc_followup_hook_count"), 0),
    )
    enriched["unique_location_unlock_count"] = max(
        _bundle_g_to_int(enriched.get("unique_location_unlock_count"), 0),
        _bundle_g_to_int(budget.get("unique_location_unlock_count"), 0),
    )
    enriched["unique_available_lead_count"] = max(
        _bundle_g_to_int(enriched.get("unique_available_lead_count"), 0),
        _bundle_g_to_int(budget.get("unique_available_lead_count"), 0),
    )
    enriched["repeat_guards"] = list(_BUNDLE_G_REPEAT_GUARDS)
    enriched["content_depth_artifact"] = _BUNDLE_G_DEPTH_FILE
    enriched["ok"] = enriched.get("ok", True) is not False and enriched["content_exhaustion_estimate"] >= _BUNDLE_G_TARGET_TURNS

    warnings = enriched.get("warnings") if isinstance(enriched.get("warnings"), list) else []
    enriched["warnings"] = [
        warning
        for warning in warnings
        if "content" not in str(warning).lower() or "exhaust" not in str(warning).lower()
    ]
    enriched["warning_count"] = len(enriched["warnings"])
    return enriched


def _bundle_g_write_depth_summary(result_dir: _BundleGPath, forecast: _BundleGOptional[_BundleGDict[str, _BundleGAny]] = None) -> _BundleGDict[str, _BundleGAny]:
    forecast = forecast or _bundle_g_load_json_file(result_dir / _BUNDLE_G_FORECAST_FILE)
    budget = _bundle_g_build_content_budget(forecast)
    _BUNDLE_G_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_G_DEPTH_FILE,
        _bundle_g_json.dumps(budget, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return budget


def _bundle_g_write_enriched_forecast(path: _BundleGPath, forecast: _BundleGDict[str, _BundleGAny]) -> _BundleGDict[str, _BundleGAny]:
    budget = _bundle_g_write_depth_summary(path.parent, forecast)
    enriched = _bundle_g_enrich_forecast(forecast, budget)
    _BUNDLE_G_ORIGINAL_PATH_WRITE_TEXT(
        path,
        _bundle_g_json.dumps(enriched, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return enriched


if not globals().get("_BUNDLE_G_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_G_ORIGINAL_PATH_WRITE_TEXT = _BundleGPath.write_text

    def _bundle_g_write_text_with_content_depth(self, data, *args, **kwargs):
        path = _BundleGPath(self)
        if path.name == _BUNDLE_G_FORECAST_FILE and isinstance(data, str):
            try:
                parsed = _bundle_g_json.loads(data)
                if isinstance(parsed, dict) and not parsed.get("bundle_g_content_depth_pack_applied"):
                    _bundle_g_write_enriched_forecast(path, parsed)
                    return len(data)
            except Exception:
                pass
        result = _BUNDLE_G_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name in {_BUNDLE_G_FORECAST_FILE, "summary.json", "artifact-manifest-digest.json"}:
                forecast = _bundle_g_load_json_file(path.parent / _BUNDLE_G_FORECAST_FILE)
                if forecast:
                    _bundle_g_write_depth_summary(path.parent, forecast)
        except Exception:
            pass
        return result

    _BundleGPath.write_text = _bundle_g_write_text_with_content_depth
    globals()["_BUNDLE_G_PATH_WRITE_TEXT_PATCHED"] = True
