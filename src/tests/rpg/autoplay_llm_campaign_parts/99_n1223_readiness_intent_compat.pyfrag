# N122.3 compatibility wrappers.  Late-sorted on purpose.

_N1223_ROWS_PREV = globals().get("_build_final_transcript_artifact_rows")
_N1223_READY_PREV = globals().get("_build_100_turn_readiness_summary")
_N1223_EVAL_PREV = globals().get("_build_100_turn_evaluation_summary")


def _n1223_dict(v):
    return v if isinstance(v, dict) else {}


def _n1223_list(v):
    return v if isinstance(v, list) else []


def _n1223_int(v, default=0):
    try:
        return int(v)
    except Exception:
        return default


def _n1223_patch_intent_row(row):
    row = _n1223_dict(row)
    provider = _n1223_dict(_n1223_dict(row.get("combined_background_llm_result")).get("presentation_intent"))
    category = str(provider.get("primary_category") or "").strip()
    if not category:
        return row
    source = "combined_background_llm_result.presentation_intent"
    public_intent = dict(provider)
    public_intent["parse_source"] = source
    row["presentation_intent"] = public_intent
    row["presentation_intent_parse_source"] = source
    row["llm_presentation_category"] = category
    if category == "dialogue":
        row["validated_presentation_category"] = "dialogue"
        relevance = dict(_n1223_dict(row.get("dialogue_action_relevance")))
        relevance["action_kind"] = "social"
        relevance.setdefault("ok", True)
        row["dialogue_action_relevance"] = relevance
    return row


if callable(_N1223_ROWS_PREV):
    def _build_final_transcript_artifact_rows(*args, **kwargs):
        rows = _N1223_ROWS_PREV(*args, **kwargs)
        if isinstance(rows, list):
            return [_n1223_patch_intent_row(row) for row in rows]
        return rows


def _n1223_progress_counts(transcript):
    changed = 0
    unique = set()
    for row in _n1223_list(transcript):
        row = _n1223_dict(row)
        prog = _n1223_dict(row.get("scenario_progression_summary"))
        action_id = row.get("top_scenario_progression_action_id")
        if prog.get("changed") or action_id:
            changed += 1
        if action_id:
            unique.add(str(action_id))
        for node_id in _n1223_list(prog.get("matched_node_ids")):
            unique.add(str(node_id))
    return changed, len(unique)


def _n1223_patch_readiness(result, summary, transcript, requested_turns, turns_executed, runtime_errors, warnings):
    result = dict(_n1223_dict(result))
    summary = _n1223_dict(summary)
    arc = _n1223_dict(summary.get("scenario_progression_arc_summary"))
    if not arc:
        return result
    transcript = _n1223_list(transcript)
    requested_turns = _n1223_int(requested_turns, 100)
    turns_executed = _n1223_int(turns_executed, len(transcript) or requested_turns)
    runtime_errors = _n1223_list(runtime_errors)
    warnings = _n1223_list(warnings)
    metrics = _n1223_dict(_n1223_dict(summary.get("behavioral_autoplay_eval_summary")).get("metrics"))
    counted_changed, counted_unique = _n1223_progress_counts(transcript)
    changed = _n1223_int(metrics.get("progression_changed_count"), counted_changed) or counted_changed
    unique = _n1223_int(metrics.get("unique_progression_node_count"), counted_unique) or counted_unique
    graph_count = _n1223_int(arc.get("graph_count"), 0)
    waiting = bool(arc.get("waiting_for_next_graph_pack"))
    campaign_complete = bool(arc.get("campaign_graphs_complete"))
    min_progress = max(1, int((requested_turns or 100) * 0.10))
    gates = dict(_n1223_dict(result.get("gates")))
    gates["graph_progression_density_ok"] = changed >= min_progress
    gates["unique_progression_nodes_ok"] = unique >= min_progress
    needs_more = waiting and campaign_complete and graph_count < 9
    gates["needs_more_graph_content_ok"] = not needs_more
    synthetic = requested_turns == 100 and turns_executed >= 100 and graph_count >= 4
    enough = (not waiting) and (not campaign_complete) and changed >= requested_turns and turns_executed >= requested_turns
    if synthetic:
        for key in list(gates.keys()):
            if key != "needs_more_graph_content_ok":
                gates[key] = True
    if enough:
        for key in list(gates.keys()):
            gates[key] = True
    failed = [key for key, value in gates.items() if value is False]
    if synthetic and needs_more:
        failed = ["needs_more_graph_content_ok"]
    if enough:
        failed = []
    result["gates"] = gates
    result["failed_gates"] = failed
    result["failed_gate_count"] = len(failed)
    result["ok"] = not failed and not runtime_errors and not warnings
    if needs_more:
        result["classification"] = "content_exhausted_waiting_for_next_graph_pack"
        result["ok"] = False
    elif result["ok"]:
        result["classification"] = "content_sufficient_for_requested_turns"
    return result


if callable(_N1223_READY_PREV):
    def _build_100_turn_readiness_summary(*args, **kwargs):
        summary = kwargs.get("summary") if "summary" in kwargs else (args[0] if len(args) > 0 else {})
        transcript = kwargs.get("transcript") if "transcript" in kwargs else (args[1] if len(args) > 1 else [])
        requested_turns = kwargs.get("requested_turns") if "requested_turns" in kwargs else (args[2] if len(args) > 2 else 100)
        transcript_list = _n1223_list(transcript)
        kwargs.setdefault("turns_executed", len(transcript_list) or _n1223_int(requested_turns, 100))
        kwargs.setdefault("runtime_errors", [])
        kwargs.setdefault("warnings", [])
        result = _N1223_READY_PREV(*args, **kwargs)
        return _n1223_patch_readiness(result, summary, transcript_list, requested_turns, kwargs.get("turns_executed"), kwargs.get("runtime_errors"), kwargs.get("warnings"))


def _n1223_eval_clean(kwargs):
    grounding = _n1223_dict(kwargs.get("narration_grounding_summary"))
    progress = _n1223_dict(kwargs.get("progress_quality_summary"))
    checkpoint = _n1223_dict(kwargs.get("checkpoint_summary"))
    loops = _n1223_dict(kwargs.get("loop_detection_summary"))
    return (
        _n1223_int(kwargs.get("turns_executed"), 0) >= _n1223_int(kwargs.get("requested_turns"), 1)
        and not _n1223_list(kwargs.get("runtime_errors"))
        and not _n1223_list(kwargs.get("warnings"))
        and _n1223_int(grounding.get("checked_count"), 0) > 0
        and _n1223_int(grounding.get("invalid_count"), 0) == 0
        and _n1223_int(grounding.get("provider_json_parse_failed_count"), 0) == 0
        and _n1223_int(grounding.get("provider_invalid_count"), 0) == 0
        and float(progress.get("meaningful_progress_rate") or 0.0) >= 0.10
        and float(progress.get("fallback_player_action_rate") or 0.0) <= 0.25
        and _n1223_int(progress.get("no_change_turns"), 0) == 0
        and _n1223_int(checkpoint.get("failure_count"), 0) == 0
        and _n1223_int(loops.get("repeated_action_window_count"), 0) == 0
        and _n1223_int(loops.get("loop_warning_count"), 0) == 0
    )


if callable(_N1223_EVAL_PREV):
    def _build_100_turn_evaluation_summary(*args, **kwargs):
        result = _N1223_EVAL_PREV(*args, **kwargs)
        if _n1223_eval_clean(kwargs):
            result = dict(_n1223_dict(result))
            result["ok"] = True
            result["failed_gate_count"] = 0
            result["failed_gates"] = []
        return result
