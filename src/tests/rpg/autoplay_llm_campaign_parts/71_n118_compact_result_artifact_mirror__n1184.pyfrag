
# N118.4 -- Compact result artifact filesystem mirror
#
# N118.1 mirrored every ZIP member, but full-transcript oversized row field
# splits can produce tens of thousands of files.  Keep the filesystem mirror
# useful for GitHub/ChatGPT review by extracting top-level artifacts, review
# indexes, and compact/small review chunks while skipping the explosive
# full-transcript oversized-row field tree by default.

_N1184_COMPACT_MIRROR_TRUE_VALUES = {"1", "true", "yes", "on"}
_N1184_COMPACT_MIRROR_FALSE_VALUES = {"0", "false", "no", "off"}


def _n1184_compact_mirror_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_COMPACT_UNZIPPED_RESULTS", "1")).lower()
    return flag not in _N1184_COMPACT_MIRROR_FALSE_VALUES


def _n1184_full_review_mirror_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_FULL_UNZIPPED_RESULTS", "")).lower()
    return flag in _N1184_COMPACT_MIRROR_TRUE_VALUES


def _n1184_should_extract_review_member(name: str, *, per_artifact_counts: Dict[str, int]) -> bool:
    normalized = _safe_str(name).replace("\\", "/").lstrip("/")
    if not normalized.startswith("review-artifacts/"):
        return True
    if _n1184_full_review_mirror_enabled():
        return True

    # Always keep root and per-artifact indexes. These are enough to navigate the
    # ZIP/review layout without committing thousands of tiny oversized-row files.
    if normalized == "review-artifacts/index.json":
        return True
    if normalized.endswith("/index.json") or normalized.endswith("/top-level-keys.json"):
        return True

    # The pathological case: every oversized full transcript row can expand into
    # hundreds of top-level field chunks. Keep indexes only for this tree.
    if normalized.startswith("review-artifacts/full-transcript.json/oversized-rows/"):
        return False

    # Keep compact transcript chunks, summary key files, and focused diagnostic
    # artifact chunks, but cap each artifact subtree to prevent future runaway
    # mirrors if another artifact starts producing thousands of files.
    parts = normalized.split("/")
    artifact_slug = parts[1] if len(parts) > 1 else "root"
    cap = int(os.environ.get("RPG_AUTOPLAY_COMPACT_UNZIPPED_MAX_FILES_PER_ARTIFACT", "250") or "250")
    current = int(per_artifact_counts.get(artifact_slug, 0))
    if current >= cap:
        return False
    per_artifact_counts[artifact_slug] = current + 1
    return True


def _n1184_reset_generated_mirror_dir(mirror_dir: Path) -> None:
    # This directory is generated by the autoplay harness. Remove it before each
    # mirror write so stale 17k-file mirrors do not persist after switching to the
    # compact policy.  Disable with RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS=1.
    keep_stale = _safe_str(os.environ.get("RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS", "")).lower()
    if keep_stale in _N1184_COMPACT_MIRROR_TRUE_VALUES:
        mirror_dir.mkdir(parents=True, exist_ok=True)
        return
    if mirror_dir.exists():
        shutil.rmtree(mirror_dir)
    mirror_dir.mkdir(parents=True, exist_ok=True)


def _n1181_mirror_autoplay_results_zip(args: Any) -> Dict[str, Any]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    zip_path = output_dir / "autoplay-campaign-results.zip"
    mirror_dir = output_dir / "autoplay-campaign-results-unzipped"
    summary: Dict[str, Any] = {
        "format_version": "n1184_compact_unzipped_result_artifact_mirror_v1",
        "ok": False,
        "zip_path": _safe_str(zip_path),
        "mirror_dir": _safe_str(mirror_dir),
        "compact_mirror": _n1184_compact_mirror_enabled(),
        "full_review_mirror": _n1184_full_review_mirror_enabled(),
        "extracted_file_count": 0,
        "skipped_member_count": 0,
        "extracted_files": [],
        "skipped_members": [],
        "stale_files_deleted_before_write": _safe_str(os.environ.get("RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS", "")).lower() not in _N1184_COMPACT_MIRROR_TRUE_VALUES,
        "note": (
            "Compact mirror for GitHub/ChatGPT review. Top-level artifacts and review indexes are extracted; "
            "full-transcript oversized row field chunks are skipped unless RPG_AUTOPLAY_FULL_UNZIPPED_RESULTS=1."
        ),
    }
    if not zip_path.exists():
        summary["reason"] = "zip_not_found"
        return summary

    _n1184_reset_generated_mirror_dir(mirror_dir)
    extracted: List[str] = []
    skipped: List[str] = []
    per_artifact_counts: Dict[str, int] = {}
    try:
        with zipfile.ZipFile(zip_path, "r") as zip_handle:
            for member in zip_handle.infolist():
                member_name = _safe_str(getattr(member, "filename", ""))
                if member_name.endswith("/"):
                    continue
                normalized = member_name.replace("\\", "/").lstrip("/")
                if not _n1184_should_extract_review_member(normalized, per_artifact_counts=per_artifact_counts):
                    skipped.append(normalized)
                    continue
                target = _n1181_safe_extract_zip_member(zip_handle, member, mirror_dir)
                if target is None:
                    skipped.append(normalized)
                    continue
                try:
                    extracted.append(_safe_str(target.relative_to(mirror_dir)).replace("\\", "/"))
                except Exception:
                    extracted.append(_safe_str(target))
    except Exception as exc:
        summary["reason"] = f"extract_failed:{type(exc).__name__}:{exc}"
        try:
            (mirror_dir / "unzipped-artifact-index.json").write_text(
                json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
                encoding="utf-8",
            )
        except Exception:
            pass
        return summary

    summary["ok"] = True
    summary["extracted_file_count"] = len(extracted)
    summary["skipped_member_count"] = len(skipped)
    summary["extracted_files"] = extracted[:5000]
    summary["skipped_members"] = skipped[:1000]
    summary["skipped_member_count_by_prefix"] = {
        "review-artifacts/full-transcript.json/oversized-rows": sum(
            1 for item in skipped if item.startswith("review-artifacts/full-transcript.json/oversized-rows/")
        )
    }
    summary["review_artifacts_index"] = (
        "review-artifacts/index.json"
        if (mirror_dir / "review-artifacts" / "index.json").exists()
        else ""
    )
    summary["recommended_git_path"] = _safe_str(mirror_dir)
    index_path = mirror_dir / "unzipped-artifact-index.json"
    index_path.write_text(
        json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
        encoding="utf-8",
    )
    _timestamped_print(
        "Wrote compact unzipped autoplay result artifact mirror to: "
        f"{mirror_dir} files={len(extracted)} skipped={len(skipped)}"
    )
    return summary
