# Bundle T — Live 1000-Turn Result Evaluator + Release Candidate Gate
#
# Advisory result gate for the first guarded live 1000-turn campaign run.  This
# fragment reads the live profile, preflight result, run summary, performance,
# progress, artifact manifest, and dashboard outputs, then writes
# one-thousand-turn-live-result-summary.json.  It does not mutate authoritative
# simulation state.

import json as _bundle_t_json
from pathlib import Path as _BundleTPath
from typing import Any as _BundleTAny, Dict as _BundleTDict, Iterable as _BundleTIterable

_BUNDLE_T_SUMMARY_FILE = "one-thousand-turn-live-result-summary.json"
_BUNDLE_T_LIVE_PROFILE_FILE = "one-thousand-turn-live-run-profile-summary.json"
_BUNDLE_T_PREFLIGHT_RESULT_FILE = "one-thousand-turn-preflight-result-summary.json"
_BUNDLE_T_DASHBOARD_FILE = "one-thousand-turn-readiness-dashboard-summary.json"
_BUNDLE_T_TARGET_TURNS = 1000
_BUNDLE_T_MAX_RUNTIME_ERRORS = 0
_BUNDLE_T_MAX_UNRESOLVED_BACKGROUND_JOBS = 0
_BUNDLE_T_MAX_REQUIRED_GATE_FAILURES = 0
_BUNDLE_T_MAX_BLOCKING_P95_SECONDS = 10.0
_BUNDLE_T_MAX_BACKGROUND_DRAIN_SECONDS = 180.0
_BUNDLE_T_MAX_PLAYER_AGENT_FALLBACK_RATE = 0.25
_BUNDLE_T_MIN_MEANINGFUL_PROGRESS_RATE = 0.10
_BUNDLE_T_MAX_REPORT_REGRESSION_WARNINGS = 0

_BUNDLE_T_INPUT_FILES = {
    _BUNDLE_T_LIVE_PROFILE_FILE,
    _BUNDLE_T_PREFLIGHT_RESULT_FILE,
    _BUNDLE_T_DASHBOARD_FILE,
    "summary.json",
    "artifact-manifest-digest.json",
    "performance-summary.json",
    "autoplay-performance-summary.json",
    "progress-quality-summary.json",
    "transcript-payload-budget-summary.json",
    "one-thousand-turn-readiness-aggregator-summary.json",
    "autoplay-campaign-report.html",
    "autoplay-campaign-results.zip",
}


def _bundle_t_load_json_file(path: _BundleTPath) -> _BundleTDict[str, _BundleTAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_t_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_t_artifacts_from_result_dir(result_dir: _BundleTPath) -> _BundleTDict[str, _BundleTDict[str, _BundleTAny]]:
    artifacts: _BundleTDict[str, _BundleTDict[str, _BundleTAny]] = {}
    for file_name in sorted(_BUNDLE_T_INPUT_FILES):
        if file_name.endswith(".json"):
            payload = _bundle_t_load_json_file(result_dir / file_name)
            if payload:
                artifacts[file_name] = payload
        else:
            path = result_dir / file_name
            if path.exists():
                artifacts[file_name] = {"present": True, "size_bytes": path.stat().st_size if path.is_file() else 0}
    return artifacts


def _bundle_t_truth(value: _BundleTAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, (int, float)):
        return bool(value)
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed", "ready", "promote"}:
        return True
    if text in {"0", "false", "no", "fail", "failed", "not_ready", "blocked"}:
        return False
    return default


def _bundle_t_to_int(value: _BundleTAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_t_to_float(value: _BundleTAny, default: float = 0.0) -> float:
    try:
        if value is None:
            return default
        return float(str(value))
    except Exception:
        return default


def _bundle_t_walk(value: _BundleTAny):
    stack = [value]
    while stack:
        current = stack.pop()
        yield current
        if isinstance(current, dict):
            stack.extend(current.values())
        elif isinstance(current, list):
            stack.extend(current)


def _bundle_t_first_scalar(payloads: _BundleTIterable[_BundleTDict[str, _BundleTAny]], *keys: str) -> _BundleTAny:
    key_set = set(keys)
    for payload in payloads:
        for node in _bundle_t_walk(payload):
            if not isinstance(node, dict):
                continue
            for key in key_set:
                if key in node and not isinstance(node.get(key), (dict, list)):
                    return node.get(key)
    return None


def _bundle_t_failure_count(payload: _BundleTDict[str, _BundleTAny]) -> int:
    failures = payload.get("advisory_failures")
    if isinstance(failures, list):
        return len(failures)
    checks = payload.get("checks")
    if isinstance(checks, dict):
        return len([value for value in checks.values() if value is False])
    return 0


def _bundle_t_evaluate_live_1000_result(artifacts: _BundleTDict[str, _BundleTDict[str, _BundleTAny]]):
    live_profile = artifacts.get(_BUNDLE_T_LIVE_PROFILE_FILE, {})
    preflight = artifacts.get(_BUNDLE_T_PREFLIGHT_RESULT_FILE, {})
    dashboard = artifacts.get(_BUNDLE_T_DASHBOARD_FILE, {})
    aggregator = artifacts.get("one-thousand-turn-readiness-aggregator-summary.json", {})
    run_summary = artifacts.get("summary.json", {})
    manifest = artifacts.get("artifact-manifest-digest.json", {})
    performance = artifacts.get("performance-summary.json") or artifacts.get("autoplay-performance-summary.json", {})
    progress = artifacts.get("progress-quality-summary.json", {})
    transcript_budget = artifacts.get("transcript-payload-budget-summary.json", {})
    report_artifact = artifacts.get("autoplay-campaign-report.html", {})
    zip_artifact = artifacts.get("autoplay-campaign-results.zip", {})
    payloads = [live_profile, preflight, dashboard, aggregator, run_summary, manifest, performance, progress, transcript_budget]

    completed_turns = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "completed_turns", "turn_count", "turns_completed"), 0)
    requested_turns = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "requested_turns", "target_turns", "turns"), _BUNDLE_T_TARGET_TURNS)
    runtime_error_count = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "runtime_error_count", "error_count", "exception_count"), 0)
    unresolved_jobs = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "unresolved_final_background_jobs", "unresolved_background_jobs", "unfinished_background_jobs"), 0)
    blocking_p95 = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "blocking_turn_p95_seconds", "turn_p95_seconds", "p95_turn_seconds", "p95_seconds"), 0.0)
    background_drain = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "background_drain_seconds", "final_background_drain_seconds", "background_drain_elapsed_seconds"), 0.0)
    fallback_rate = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "player_agent_fallback_rate", "fallback_rate"), 0.0)
    progress_rate = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "meaningful_progress_rate", "progress_rate"), 1.0)
    report_regression_warnings = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "report_regression_warning_count", "regression_warning_count"), 0)
    required_gate_failures = len(aggregator.get("failing_required_gates") or []) + len(aggregator.get("missing_required_gates") or [])
    transcript_budget_ok = transcript_budget == {} or _bundle_t_truth(transcript_budget.get("ok"), True)

    checks = {
        "live_profile_ready": _bundle_t_truth(live_profile.get("ready_to_start_live_1000_turn_run"), False),
        "preflight_promoted_live_run": _bundle_t_truth(preflight.get("promote_to_live_1000_turn_run"), False),
        "completed_target_turns": completed_turns >= _BUNDLE_T_TARGET_TURNS or requested_turns >= _BUNDLE_T_TARGET_TURNS,
        "no_required_gate_failures": required_gate_failures <= _BUNDLE_T_MAX_REQUIRED_GATE_FAILURES,
        "no_runtime_errors": runtime_error_count <= _BUNDLE_T_MAX_RUNTIME_ERRORS,
        "no_unresolved_background_jobs": unresolved_jobs <= _BUNDLE_T_MAX_UNRESOLVED_BACKGROUND_JOBS,
        "blocking_turn_p95_within_live_budget": blocking_p95 <= _BUNDLE_T_MAX_BLOCKING_P95_SECONDS if blocking_p95 > 0 else True,
        "background_drain_within_live_budget": background_drain <= _BUNDLE_T_MAX_BACKGROUND_DRAIN_SECONDS if background_drain > 0 else True,
        "player_agent_fallback_rate_within_budget": fallback_rate <= _BUNDLE_T_MAX_PLAYER_AGENT_FALLBACK_RATE,
        "meaningful_progress_rate_within_budget": progress_rate >= _BUNDLE_T_MIN_MEANINGFUL_PROGRESS_RATE,
        "artifact_manifest_ok": manifest == {} or _bundle_t_truth(manifest.get("ok") or manifest.get("manifest_ok") or manifest.get("invariant_ok"), True),
        "transcript_budget_ok": transcript_budget_ok,
        "campaign_report_artifact_present": bool(report_artifact.get("present")) or _bundle_t_truth(run_summary.get("campaign_report_present"), False),
        "zipped_results_artifact_present": bool(zip_artifact.get("present")) or _bundle_t_truth(run_summary.get("zipped_results_present"), False),
        "no_report_regression_warnings": report_regression_warnings <= _BUNDLE_T_MAX_REPORT_REGRESSION_WARNINGS,
    }
    failures = [name for name, ok in checks.items() if not ok]
    release_candidate_ready = not failures

    return {
        "format_version": "bundle_t_live_1000_result_summary_v1",
        "source": "bundle_t_live_1000_result_gate",
        "ok": release_candidate_ready,
        "advisory_only": True,
        "release_candidate_ready": release_candidate_ready,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "target_turns": _BUNDLE_T_TARGET_TURNS,
            "completed_turns": completed_turns,
            "requested_turns": requested_turns,
            "runtime_error_count": runtime_error_count,
            "unresolved_background_jobs": unresolved_jobs,
            "blocking_turn_p95_seconds": blocking_p95,
            "max_blocking_turn_p95_seconds": _BUNDLE_T_MAX_BLOCKING_P95_SECONDS,
            "background_drain_seconds": background_drain,
            "max_background_drain_seconds": _BUNDLE_T_MAX_BACKGROUND_DRAIN_SECONDS,
            "player_agent_fallback_rate": fallback_rate,
            "max_player_agent_fallback_rate": _BUNDLE_T_MAX_PLAYER_AGENT_FALLBACK_RATE,
            "meaningful_progress_rate": progress_rate,
            "min_meaningful_progress_rate": _BUNDLE_T_MIN_MEANINGFUL_PROGRESS_RATE,
            "required_gate_failure_count": required_gate_failures,
            "live_profile_failure_count": _bundle_t_failure_count(live_profile),
            "preflight_failure_count": _bundle_t_failure_count(preflight),
            "dashboard_failure_count": _bundle_t_failure_count(dashboard),
            "report_regression_warning_count": report_regression_warnings,
            "campaign_report_size_bytes": _bundle_t_to_int(report_artifact.get("size_bytes"), 0),
            "zipped_results_size_bytes": _bundle_t_to_int(zip_artifact.get("size_bytes"), 0),
        },
        "recommended_next_step": "mark_1000_turn_release_candidate" if release_candidate_ready else "fix_live_1000_result_failures_before_release_candidate",
    }


def _bundle_t_write_summary_if_possible(result_dir: _BundleTPath):
    try:
        summary = _bundle_t_evaluate_live_1000_result(_bundle_t_artifacts_from_result_dir(result_dir))
        _BUNDLE_T_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_T_SUMMARY_FILE, _bundle_t_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_T_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_T_ORIGINAL_PATH_WRITE_TEXT = _BundleTPath.write_text

    def _bundle_t_write_text_with_live_1000_result_gate(self, data, *args, **kwargs):
        result = _BUNDLE_T_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleTPath(self)
        try:
            if path.name in _BUNDLE_T_INPUT_FILES:
                _bundle_t_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _BundleTPath.write_text = _bundle_t_write_text_with_live_1000_result_gate
    globals()["_BUNDLE_T_PATH_WRITE_TEXT_PATCHED"] = True
