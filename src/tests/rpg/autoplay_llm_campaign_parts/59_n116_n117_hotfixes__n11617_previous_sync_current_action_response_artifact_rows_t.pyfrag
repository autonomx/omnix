


# N116.17 — Root Service Resolver Veto Integration
# Keep this block above main(); it monkey-patches artifact-row normalization so
# false service/economy matches are removed before transcript/report artifacts
# are persisted.  This is a veto only: it does not force investigation/evidence
# classification and it keeps the original bad resolver output for diagnostics.

_N11617_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS = _sync_current_action_response_artifact_rows
_N11617_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11617_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11617_DOCUMENT_EVIDENCE_TERMS = (
    "sealed order", "sealed orders", "captured order", "captured orders",
    "written order", "written orders", "route paper", "route papers",
    "captured route paper", "captured route papers", "ledger", "ledger entries",
    "manifest", "manifest marks", "payment mark", "payment marks",
    "marked coin", "marked coin proof", "coin proof", "route cipher",
    "coded message", "coded messages", "toll marker", "toll markers",
    "courier route", "paymaster", "backer", "backers", "funded", "funding",
    "proof", "evidence", "documents", "papers",
)
_N11617_EXPLICIT_SERVICE_OR_COMMERCE_TERMS = (
    "buy", "purchase", "pay for", "pay bran for", "pay the innkeeper for",
    "rent a room", "rent room", "book a room", "book room", "order ale",
    "order a drink", "order food", "order a meal", "buy ale", "buy food",
    "buy meal", "sell", "trade", "hire", "lodging", "sleep here", "rest here",
)
_N11617_SERVICE_ACTION_VALUES = {
    "service", "service_inquiry", "commerce", "economy", "drink_inquiry",
    "drink", "purchase", "purchase_inquiry", "lodging", "room", "rest_service",
}
_N11617_SERVICE_STATUSES = {
    "offers_available", "available", "service_available", "matched", "purchase_available",
}


def _n11617_norm_text(value: Any) -> str:
    return _normalize_turn_action_text(value) if callable(globals().get("_normalize_turn_action_text")) else _safe_str(value).lower()


def _n11617_row_action_text(row: Dict[str, Any]) -> str:
    row = _safe_dict(row)
    return _n11617_norm_text(
        " ".join(
            _safe_str(row.get(key))
            for key in (
                "display_player_action", "visible_player_action", "canonical_turn_action",
                "actual_sent_action", "player_action", "resolver_input_action",
                "selected_player_action", "original_player_action",
            )
            if _safe_str(row.get(key))
        )
    )


def _n11617_is_document_evidence_without_explicit_service(action_text: str) -> bool:
    action = _n11617_norm_text(action_text)
    if not action:
        return False
    if not any(term in action for term in _N11617_DOCUMENT_EVIDENCE_TERMS):
        return False
    if any(term in action for term in _N11617_EXPLICIT_SERVICE_OR_COMMERCE_TERMS):
        return False
    return True


def _n11617_service_result_looks_false_positive(service_result: Dict[str, Any]) -> bool:
    service_result = _safe_dict(service_result)
    if not service_result:
        return False
    status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
    kind = _safe_str(service_result.get("service_kind") or service_result.get("kind") or service_result.get("item_kind")).lower()
    return bool(
        service_result.get("matched")
        or service_result.get("service")
        or service_result.get("purchase")
        or service_result.get("sale")
        or status in _N11617_SERVICE_STATUSES
        or kind in _N11617_SERVICE_ACTION_VALUES
        or _safe_list(service_result.get("offers"))
        or _safe_list(service_result.get("items"))
    )


def _n11617_semantic_action_looks_service(value: Dict[str, Any]) -> bool:
    semantic = _safe_dict(value)
    if not semantic:
        return False
    fields = (
        semantic.get("action_type"), semantic.get("semantic_family"),
        semantic.get("activity_label"), semantic.get("intent"), semantic.get("kind"),
        semantic.get("category"), semantic.get("family"), semantic.get("label"),
    )
    normalized = {_safe_str(item).strip().lower() for item in fields if _safe_str(item)}
    return bool(normalized & _N11617_SERVICE_ACTION_VALUES)


def _n11617_veto_service_result(value: Dict[str, Any], *, action_text: str) -> Dict[str, Any]:
    service_result = _safe_dict(value)
    if not _n11617_service_result_looks_false_positive(service_result):
        return service_result
    return {
        "matched": False,
        "service": False,
        "purchase": False,
        "sale": False,
        "status": "service_false_positive_vetoed",
        "reason": "document_evidence_without_explicit_service_request",
        "service_kind": "",
        "offers": [],
        "items": [],
        "original_service_result": deepcopy(service_result),
        "veto_policy": "n11617_service_resolver_veto_only",
        "action_text": _safe_str(action_text)[:500],
    }


def _n11617_veto_semantic_action(value: Dict[str, Any], *, action_text: str) -> Dict[str, Any]:
    semantic = _safe_dict(value)
    if not _n11617_semantic_action_looks_service(semantic):
        return semantic
    repaired = dict(semantic)
    repaired["original_semantic_action"] = deepcopy(semantic)
    repaired["service_false_positive_vetoed"] = True
    repaired["veto_policy"] = "n11617_service_resolver_veto_only"
    repaired["veto_reason"] = "document_evidence_without_explicit_service_request"
    # Negative guard only: remove impossible service/economy labels, but do not
    # replace them with investigation/evidence.  The LLM still classifies
    # presentation intent from the cleaned contract.
    for key in ("action_type", "semantic_family", "activity_label", "intent", "kind", "category", "family", "label"):
        if _safe_str(repaired.get(key)).strip().lower() in _N11617_SERVICE_ACTION_VALUES:
            repaired[key] = "service_false_positive_vetoed"
    repaired["llm_classifies_presentation_intent"] = True
    repaired["action_text"] = _safe_str(action_text)[:500]
    return repaired


def _n11617_scrub_container(container: Dict[str, Any], *, action_text: str) -> bool:
    container = _safe_dict(container)
    if not container:
        return False
    changed = False
    if isinstance(container.get("service_result"), dict):
        original = _safe_dict(container.get("service_result"))
        scrubbed = _n11617_veto_service_result(original, action_text=action_text)
        if scrubbed is not original and scrubbed != original:
            container["service_result"] = scrubbed
            changed = True
    for key in ("semantic_action", "semantic_action_v2"):
        if isinstance(container.get(key), dict):
            original_semantic = _safe_dict(container.get(key))
            scrubbed_semantic = _n11617_veto_semantic_action(original_semantic, action_text=action_text)
            if scrubbed_semantic != original_semantic:
                container[key] = scrubbed_semantic
                changed = True
    nested_contract = container.get("turn_contract")
    if isinstance(nested_contract, dict):
        changed = _n11617_scrub_container(nested_contract, action_text=action_text) or changed
    return changed


def _n11617_apply_root_service_veto_to_row(row: Dict[str, Any]) -> Dict[str, Any]:
    row = _safe_dict(row)
    action_text = _n11617_row_action_text(row)
    if not _n11617_is_document_evidence_without_explicit_service(action_text):
        return row
    changed = False
    changed = _n11617_scrub_container(row, action_text=action_text) or changed
    for key in ("turn_contract", "turn_result", "result", "raw_result", "manual_turn_summary"):
        if isinstance(row.get(key), dict):
            changed = _n11617_scrub_container(row[key], action_text=action_text) or changed
    if changed:
        row["service_false_positive_vetoed"] = True
        row["service_resolver_veto"] = {
            "format_version": "n11617_service_resolver_veto_v1",
            "service_false_positive_vetoed": True,
            "reason": "document_evidence_without_explicit_service_request",
            "veto_only": True,
            "forced_positive_classification": False,
            "llm_classifies_presentation_intent": True,
            "action_text": action_text[:500],
        }
    return row


def _sync_current_action_response_artifact_rows(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    synced = _N11617_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS(rows)
    out: List[Dict[str, Any]] = []
    for row in synced if isinstance(synced, list) else []:
        out.append(_n11617_apply_root_service_veto_to_row(row))
    return out


def _n11617_service_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    vetoed: List[Dict[str, Any]] = []
    remaining: List[Dict[str, Any]] = []
    for row in rows:
        turn_index = int(row.get("turn_index") or row.get("turn") or 0)
        action_text = _n11617_row_action_text(row)
        if not _n11617_is_document_evidence_without_explicit_service(action_text):
            continue
        if row.get("service_false_positive_vetoed") or _safe_dict(row.get("service_resolver_veto")).get("service_false_positive_vetoed"):
            vetoed.append({"turn_index": turn_index, "player_action": row.get("player_action"), "reason": "service_false_positive_vetoed"})
        offenders: List[str] = []
        for container_name in ("row", "turn_contract", "turn_result"):
            container = row if container_name == "row" else _safe_dict(row.get(container_name))
            service_result = _safe_dict(container.get("service_result"))
            semantic = _safe_dict(container.get("semantic_action")) or _safe_dict(container.get("semantic_action_v2"))
            status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
            if (
                _n11617_service_result_looks_false_positive(service_result)
                and status != "service_false_positive_vetoed"
            ):
                offenders.append(f"{container_name}.service_result")
            if _n11617_semantic_action_looks_service(semantic):
                offenders.append(f"{container_name}.semantic_action")
        if offenders:
            remaining.append({
                "turn_index": turn_index,
                "player_action": row.get("player_action"),
                "offenders": offenders,
            })
    return {
        "format_version": "n11617_service_veto_regression_summary_v1",
        "ok": not remaining,
        "vetoed_count": len(vetoed),
        "remaining_violation_count": len(remaining),
        "vetoed_turns": vetoed[:50],
        "remaining_violations": remaining[:50],
        "policy": "veto_only_no_forced_investigation_classification",
    }


def _n11617_repair_pressure_breakdown(rows: List[Dict[str, Any]], base_summary: Dict[str, Any]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    base_summary = _safe_dict(base_summary)
    service_veto = _n11617_service_veto_regression_summary(rows)
    metadata_repaired = sum(1 for row in rows if _safe_dict(row.get("background_presentation_result")).get("metadata_repaired") or row.get("background_metadata_repaired"))
    category_reclassified = sum(1 for row in rows if row.get("category_reclassified") or row.get("validated_presentation_category") != row.get("llm_presentation_category") and row.get("llm_presentation_category"))
    dialogue_repaired = sum(1 for row in rows if row.get("dialogue_action_relevance_repaired"))
    return {
        "format_version": "n11617_repair_pressure_breakdown_v1",
        "metadata_repaired_count": metadata_repaired,
        "category_reclassified_count": category_reclassified,
        "dialogue_relevance_repaired_count": dialogue_repaired,
        "service_resolver_veto_count": int(service_veto.get("vetoed_count") or 0),
        "dominant_sources": {
            "provider_metadata_or_shape_repair": metadata_repaired,
            "provider_category_reclassification": category_reclassified,
            "dialogue_action_relevance_repair": dialogue_repaired,
            "service_resolver_veto": int(service_veto.get("vetoed_count") or 0),
        },
        "note": "Counts are diagnostic repair pressure, not additional authoritative simulation outcomes.",
    }


def _build_llm_prompt_and_fallback_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _N11617_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY(rows)
    service_summary = _n11617_service_veto_regression_summary(rows)
    summary["service_resolver_veto_summary"] = service_summary
    summary["repair_pressure_breakdown"] = _n11617_repair_pressure_breakdown(rows, summary)
    summary["ok"] = bool(summary.get("ok", True)) and bool(service_summary.get("ok", True))
    if not service_summary.get("ok", True):
        failures = _safe_list(summary.get("failed_gates"))
        if "service_resolver_veto_regression_ok" not in failures:
            failures.append("service_resolver_veto_regression_ok")
        summary["failed_gates"] = failures
    return summary


def _force_final_autoplay_health(summary: Dict[str, Any]) -> Dict[str, Any]:
    health = _N11617_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH(summary)
    service_summary = _safe_dict(
        _safe_dict(summary.get("llm_prompt_and_fallback_summary")).get("service_resolver_veto_summary")
    )
    if service_summary and not bool(service_summary.get("ok", True)):
        health = dict(health)
        health["ok"] = False
        health["service_resolver_veto_regression_ok"] = False
        warnings = _safe_list(health.get("warnings"))
        if "service_resolver_veto_regression_failed" not in warnings:
            warnings.append("service_resolver_veto_regression_failed")
        health["warnings"] = warnings
        health["failed_gate_count"] = int(health.get("failed_gate_count") or 0) + 1
    return health



# N116.18 — Prompt Contract Veto Sync + Repair Breakdown Fix
# This block builds on N116.17.  N116.17 removed false service/economy
# mechanics from top-level persisted rows; N116.18 applies the same veto
# recursively to nested prompt/debug contracts so those artifacts cannot keep
# stale service/drink instructions after the row itself is cleaned.  This is
# still veto-only: it never forces a positive investigation/evidence label.

_N11618_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS = _sync_current_action_response_artifact_rows
_N11618_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11618_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11618_SERVICE_FOCUS_ITEMS = {
    "purchase_acknowledgement",
    "item_quantity_or_availability",
    "price_or_payment",
    "service_request_acknowledgement",
    "lodging_or_rest_terms",
    "acknowledge_the_service_or_economy_request_first",
    "mention_item_quantity_price_or_refusal_only_if_present_in_contract",
    "mention_price_or_payment",
    "service_or_economy_request",
    "commerce_or_service_terms",
}
_N11618_VETO_GUIDANCE_ITEMS = (
    "do_not_treat_document_order_words_as_shop_or_drink_orders",
    "llm_classifies_presentation_intent",
    "deterministic_code_only_vetoes_impossible_service_or_economy",
)
_N11618_SKIP_DEEP_KEYS = {
    "original_service_result",
    "original_semantic_action",
    "n11615_original_semantic_action",
}
_N11618_PROMPT_CONTRACT_KEYS = {
    "llm_prompt_contract",
    "current_turn_prompt_contract",
    "prompt_contract",
    "current_action_response",
    "npc_response_architecture",
}


def _n11618_normalized_focus_item(value: Any) -> str:
    return _safe_str(value).strip().lower().replace("-", "_").replace(" ", "_")


def _n11618_focus_is_service_or_economy(value: Any) -> bool:
    text = _n11618_normalized_focus_item(value)
    if not text:
        return False
    return bool(
        text in _N11618_SERVICE_FOCUS_ITEMS
        or "purchase" in text
        or "price" in text
        or "payment" in text
        or "lodging" in text
        or "service_or_economy" in text
        or "drink" in text
    )


def _n11618_repair_focus_list(value: Any) -> tuple[List[Any], bool]:
    values = value if isinstance(value, list) else []
    repaired: List[Any] = []
    changed = False
    for item in values:
        if _n11618_focus_is_service_or_economy(item):
            changed = True
            continue
        if item not in repaired:
            repaired.append(item)
    for item in _N11618_VETO_GUIDANCE_ITEMS:
        if item not in repaired:
            repaired.append(item)
            changed = True
    return repaired[:12], changed


def _n11618_apply_veto_policy(container: Dict[str, Any], *, action_text: str) -> bool:
    container = _safe_dict(container)
    if not container:
        return False
    changed = False
    policy = _safe_dict(container.get("classification_policy"))
    desired_policy = {
        "llm_classifies_presentation_intent": True,
        "deterministic_code_only_vetoes_impossible_service_or_economy": True,
        "service_economy_categories_blocked_without_authoritative_contract_support": True,
        "veto_only_no_forced_positive_classification": True,
        "reason": "document_evidence_without_explicit_service_request",
    }
    for key, value in desired_policy.items():
        if policy.get(key) != value:
            policy[key] = value
            changed = True
    container["classification_policy"] = policy
    veto = _safe_dict(container.get("service_resolver_veto"))
    veto_update = {
        "format_version": "n11618_prompt_contract_veto_sync_v1",
        "service_false_positive_vetoed": True,
        "reason": "document_evidence_without_explicit_service_request",
        "veto_only": True,
        "forced_positive_classification": False,
        "llm_classifies_presentation_intent": True,
        "action_text": _safe_str(action_text)[:500],
    }
    for key, value in veto_update.items():
        if veto.get(key) != value:
            veto[key] = value
            changed = True
    container["service_resolver_veto"] = veto
    return changed