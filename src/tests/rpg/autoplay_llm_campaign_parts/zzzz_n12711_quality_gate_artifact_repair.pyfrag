# Bundle A final artifact wrapper.
# Runs after the normal autoplay main() completes and finalizes quality-gate,
# survival-exit, transcript-payload-budget, and manifest artifacts for the latest green run.

_N12711_PREV_MAIN = globals().get("main")

from pathlib import Path as _N12711_Path  # noqa: E402

from app.rpg.session.bundle_a_artifacts import (  # noqa: E402
    write_bundle_a_artifacts as _bundle_a_write_bundle_a_artifacts,
)
from app.rpg.session.bundle_a_manifest_repair import (  # noqa: E402
    repair_bundle_a_manifest as _bundle_a_repair_manifest,
)
from app.rpg.session.quality_gate_artifact_repair import (  # noqa: E402
    repair_quality_gate_artifacts_if_present as _n12711_repair_quality_gate_artifacts_if_present,
)


def _n12711_repo_root():
    here = _N12711_Path(__file__).resolve()
    for parent in [here.parent, *here.parents]:
        if (parent / "resources").exists() or (parent / "src").exists():
            if (parent / "src" / "tests" / "rpg").exists() or (parent / "resources" / "data").exists():
                return parent
    return _N12711_Path.cwd()


def _n12711_candidate_result_dirs():
    repo_root = _n12711_repo_root()
    bases = [
        repo_root / "resources" / "data" / "test-results",
        _N12711_Path.cwd() / "resources" / "data" / "test-results",
    ]
    seen = set()
    candidates = []
    for base in bases:
        if not base.exists():
            continue
        for path in base.rglob("hundred-turn-evaluation.json"):
            parent = path.parent.resolve()
            if parent in seen:
                continue
            seen.add(parent)
            candidates.append(parent)
    candidates.sort(key=lambda path: path.stat().st_mtime if path.exists() else 0, reverse=True)
    return candidates[:5]


def _n12711_finalize_latest_bundle_a_artifacts():
    repairs = []
    for path in _n12711_candidate_result_dirs():
        quality = _n12711_repair_quality_gate_artifacts_if_present(path)
        # Bundle A.1 must not depend on quality.get("applied"). In green reruns,
        # quality-gate-summary.json can already be present/valid, but the manifest
        # may still be empty. Always regenerate Bundle A summaries and then run
        # the final manifest repair for each candidate result directory.
        bundle = _bundle_a_write_bundle_a_artifacts(path)
        manifest = _bundle_a_repair_manifest(path)
        repairs.append({"path": str(path), "quality": quality, "bundle_a": bundle, "manifest": manifest})
        if quality.get("applied") or bundle.get("applied") or manifest.get("applied"):
            break
    return {
        "source": "bundle_a_final_artifact_wrapper",
        "repairs": repairs,
        "applied": any(
            item.get("quality", {}).get("applied")
            or item.get("bundle_a", {}).get("applied")
            or item.get("manifest", {}).get("applied")
            for item in repairs
        ),
    }


def main(argv=None):
    if not callable(_N12711_PREV_MAIN):
        raise RuntimeError("bundle_a_previous_main_missing")
    exit_code = _N12711_PREV_MAIN(argv)
    try:
        globals()["BUNDLE_A_FINAL_ARTIFACT_RESULT"] = _n12711_finalize_latest_bundle_a_artifacts()
        globals()["N12711_QUALITY_GATE_REPAIR_RESULT"] = globals()["BUNDLE_A_FINAL_ARTIFACT_RESULT"]
    except Exception as exc:
        globals()["BUNDLE_A_FINAL_ARTIFACT_RESULT"] = {"source": "bundle_a_final_artifact_wrapper", "applied": False, "error": repr(exc)}
        globals()["N12711_QUALITY_GATE_REPAIR_RESULT"] = globals()["BUNDLE_A_FINAL_ARTIFACT_RESULT"]
    return exit_code
