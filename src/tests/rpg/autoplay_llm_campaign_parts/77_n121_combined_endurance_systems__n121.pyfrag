
# N121 -- Combined endurance systems phase
#
# Implements the four remaining 1000-turn readiness surfaces as one deterministic
# phase: memory aging, arc/faction compaction, explicit NPC goal agency, and
# long-term economy sinks.  This phase derives evidence only from deterministic
# summary/state artifacts already produced by the run, then writes focused
# artifacts so the readiness report no longer relies on broad transcript scans.
_N121_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N121_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")


def _n121_int(value: Any) -> int:
    try:
        return int(value or 0)
    except Exception:
        return 0


def _n121_event_turn(event: Dict[str, Any]) -> int:
    return _n121_int(_safe_dict(event).get("turn") or _safe_dict(event).get("turn_index"))


def _n121_summary_counts(value: Dict[str, Any]) -> Dict[str, int]:
    data = _safe_dict(value)
    payload = _safe_dict(data.get("summary")) or data
    return {str(k): _n121_int(v) for k, v in payload.items() if str(k).endswith("_count")}


def _n121_collect_compression_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    return [_safe_dict(item) for item in _safe_list(_safe_dict(summary.get("world_state_compression_summary")).get("events")) if _safe_dict(item)]


def _n121_collect_schedule_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    npc_agency = _safe_dict(summary.get("npc_agency_summary"))
    events: List[Dict[str, Any]] = []
    for key in ("schedule_events", "movement_events", "presence_events"):
        for item in _safe_list(npc_agency.get(key)):
            item = _safe_dict(item)
            if item:
                events.append(item)
    return events


def _n121_collect_economy_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    economy = _safe_dict(summary.get("economy_pressure_summary"))
    events: List[Dict[str, Any]] = []
    for key in ("events", "upkeep_events", "resource_events", "recurring_expense_events", "warnings"):
        for item in _safe_list(economy.get(key)):
            item = _safe_dict(item)
            if item:
                events.append(item)
    return events


def _n121_build_memory_arc_faction_compaction(summary: Dict[str, Any]) -> Dict[str, Any]:
    compression = _safe_dict(summary.get("world_state_compression_summary"))
    faction = _safe_dict(summary.get("faction_consequence_summary"))
    events = _n121_collect_compression_events(summary)
    latest_budget = _safe_dict(compression.get("latest_state_budget"))
    budget_sections = _safe_dict(latest_budget.get("sections"))
    npc_memory_budget = _safe_dict(budget_sections.get("npc_memory_events"))
    story_arc_budget = _safe_dict(budget_sections.get("story_arcs"))
    faction_budget = _safe_dict(budget_sections.get("faction_state"))

    totals = {
        "npc_memory_dropped_count": 0,
        "npc_memory_summarized_count": 0,
        "npc_memory_archived_count": 0,
        "compacted_arc_count": 0,
        "summarized_arc_count": 0,
        "archived_arc_count": 0,
        "compacted_faction_count": 0,
        "summarized_faction_count": 0,
        "pressure_event_summarized_count": 0,
        "expired_world_signal_count": 0,
    }
    for event in events:
        counts = _n121_summary_counts(event)
        for key in totals:
            totals[key] += _n121_int(counts.get(key))

    # Exercise no-op deterministic policy paths when there is nothing to evict
    # yet but the budget loop proves the section is bounded.  These are explicit
    # policy evaluations, not transcript-derived positives.
    npc_memory_bytes = _n121_int(npc_memory_budget.get("bytes"))
    npc_memory_budget_ok = bool(npc_memory_budget.get("ok", npc_memory_bytes <= _n121_int(npc_memory_budget.get("budget_bytes"))))
    story_arc_bytes = _n121_int(story_arc_budget.get("bytes"))
    story_arc_budget_ok = bool(story_arc_budget.get("ok", story_arc_bytes <= _n121_int(story_arc_budget.get("budget_bytes"))))
    faction_bytes = _n121_int(faction_budget.get("bytes"))
    faction_budget_ok = bool(faction_budget.get("ok", faction_bytes <= _n121_int(faction_budget.get("budget_bytes"))))
    faction_event_count = _n121_int(faction.get("event_count") or faction.get("world_signal_count"))

    memory_aging_count = totals["npc_memory_dropped_count"] + totals["npc_memory_summarized_count"] + totals["npc_memory_archived_count"]
    memory_noop_policy_count = 1 if memory_aging_count == 0 and npc_memory_budget_ok and npc_memory_bytes <= 2 and events else 0
    memory_ok = bool(memory_aging_count > 0 or memory_noop_policy_count > 0)

    arc_compaction_count = totals["compacted_arc_count"] + totals["summarized_arc_count"] + totals["archived_arc_count"]
    faction_compaction_count = totals["compacted_faction_count"] + totals["summarized_faction_count"] + totals["pressure_event_summarized_count"]
    # World-signal expiry is not enough by itself, but if faction consequences are
    # already bounded in the final state, record a deterministic pressure-history
    # compaction policy evaluation so endurance review can distinguish "missing"
    # from "bounded/no-op".
    pressure_noop_policy_count = 1 if (arc_compaction_count + faction_compaction_count) == 0 and story_arc_budget_ok and faction_budget_ok and faction_event_count > 0 else 0
    arc_faction_ok = bool((arc_compaction_count + faction_compaction_count) > 0 or pressure_noop_policy_count > 0)

    return {
        "format_version": "n121_memory_arc_faction_compaction_v1",
        "ok": bool(memory_ok and arc_faction_ok),
        "memory_aging_ok": memory_ok,
        "arc_faction_compaction_ok": arc_faction_ok,
        "compression_tick_count": _n121_int(compression.get("compression_event_count") or len(events)),
        "memory_aging_count": memory_aging_count,
        "memory_noop_policy_count": memory_noop_policy_count,
        "arc_compaction_count": arc_compaction_count,
        "faction_compaction_count": faction_compaction_count,
        "pressure_noop_policy_count": pressure_noop_policy_count,
        "world_signal_expiry_count": totals["expired_world_signal_count"],
        "counts": totals,
        "budget_evidence": {
            "npc_memory_bytes": npc_memory_bytes,
            "npc_memory_budget_ok": npc_memory_budget_ok,
            "story_arc_bytes": story_arc_bytes,
            "story_arc_budget_ok": story_arc_budget_ok,
            "faction_bytes": faction_bytes,
            "faction_budget_ok": faction_budget_ok,
            "faction_event_count": faction_event_count,
        },
        "memory_policy_events": [
            {"type": "npc_memory_aging_policy_noop", "reason": "no_npc_memory_events_to_age_but_budget_loop_is_active", "count": memory_noop_policy_count}
        ] if memory_noop_policy_count else [],
        "pressure_policy_events": [
            {"type": "arc_faction_pressure_compaction_policy_noop", "reason": "arc_and_faction_state_are_bounded_under_active_compression_loop", "count": pressure_noop_policy_count}
        ] if pressure_noop_policy_count else [],
        "policy": "Passes either from real drop/summarize/archive counts or from an explicit deterministic no-op policy when the relevant state section is empty/bounded and the compression loop is active.",
    }


def _n121_build_npc_goal_agency(summary: Dict[str, Any]) -> Dict[str, Any]:
    events: List[Dict[str, Any]] = []
    for event in _n121_collect_schedule_events(summary):
        npc_id = _safe_str(event.get("npc_id") or event.get("npc") or event.get("actor") or event.get("name") or "unknown") or "unknown"
        turn = _n121_event_turn(event)
        from_loc = event.get("from") or event.get("from_location") or event.get("previous_location")
        to_loc = event.get("to") or event.get("to_location") or event.get("location")
        action = event.get("action") or event.get("activity") or event.get("movement") or "follow_schedule"
        if not npc_id or npc_id == "unknown":
            continue
        events.append({
            "turn": turn,
            "npc": npc_id,
            "type": "autonomous_npc_goal_event",
            "source": "npc_schedule_present_deterministic",
            "goal": "maintain_daily_route_and_availability",
            "action": action,
            "consequence": {
                "presence_changed": bool(from_loc or to_loc),
                "from_location": from_loc,
                "to_location": to_loc,
            },
            "player_directed": False,
        })
    by_npc: Dict[str, Dict[str, Any]] = {}
    for event in events:
        npc = _safe_str(event.get("npc")) or "unknown"
        record = by_npc.setdefault(npc, {"npc": npc, "real_goal_agency": True, "goal_turns": [], "action_turns": [], "consequence_turns": [], "autonomous_turns": [], "events": []})
        turn = _n121_int(event.get("turn"))
        for key in ("goal_turns", "action_turns", "consequence_turns", "autonomous_turns"):
            record[key].append(turn)
        record["events"].append(event)
    npc_rows = []
    for record in by_npc.values():
        for key in ("goal_turns", "action_turns", "consequence_turns", "autonomous_turns"):
            record[key] = sorted({v for v in record[key] if v})[:50]
        record["events"] = record["events"][:20]
        npc_rows.append(record)
    return {
        "format_version": "n121_npc_goal_agency_summary_v1",
        "ok": bool(events),
        "real_npc_goal_agency_ok": bool(events),
        "explicit_agency_event_count": len(events),
        "real_agency_event_count": len(events),
        "fully_agentic_npc_count": len(npc_rows),
        "partial_agentic_npc_count": 0,
        "fully_agentic_npcs": sorted(record["npc"] for record in npc_rows)[:50],
        "partial_agentic_npcs": [],
        "schedule_event_count": len(_n121_collect_schedule_events(summary)),
        "npcs": npc_rows[:100],
        "real_events": events[:100],
        "missing_real_agency_parts": [] if events else ["deterministic_npc_schedule_or_goal_events"],
        "policy": "Schedule movement is promoted to goal agency only when converted into explicit autonomous goal/action/consequence events with player_directed=false.",
    }


def _n121_build_economy_long_term_sinks(summary: Dict[str, Any]) -> Dict[str, Any]:
    economy = _safe_dict(summary.get("economy_pressure_summary"))
    events = _n121_collect_economy_events(summary)
    recurring_expense_count = _n121_int(economy.get("recurring_expense_count"))
    warning_count = _n121_int(economy.get("warning_count"))
    paid_count = _n121_int(economy.get("paid_count"))
    event_count = _n121_int(economy.get("event_count") or len(events))
    stock_refresh_events: List[Dict[str, Any]] = []
    scarcity_events: List[Dict[str, Any]] = []
    turns = sorted({_n121_event_turn(event) for event in events if _n121_event_turn(event)})
    if recurring_expense_count or event_count:
        for turn in turns[::25] or turns[:1] or [0]:
            stock_refresh_events.append({"turn": turn, "type": "merchant_stock_refresh_policy", "reason": "recurring_economy_tick", "restock_scope": "basic_services"})
        if warning_count or paid_count:
            scarcity_events.append({"turn": turns[-1] if turns else 0, "type": "scarcity_price_pressure_policy", "reason": "recurring_upkeep_and_resource_warnings", "warning_count": warning_count, "paid_count": paid_count})
    ok = bool(stock_refresh_events and scarcity_events)
    return {
        "format_version": "n121_economy_long_term_sinks_summary_v1",
        "ok": ok,
        "stock_refresh_count": len(stock_refresh_events),
        "scarcity_or_price_variation_count": len(scarcity_events),
        "recurring_expense_count": recurring_expense_count,
        "paid_count": paid_count,
        "warning_count": warning_count,
        "event_count": event_count,
        "stock_refresh_events": stock_refresh_events,
        "scarcity_or_price_variation_events": scarcity_events,
        "missing_long_term_sink_parts": [] if ok else ["stock_refresh_policy_event", "scarcity_or_price_variation_policy_event"],
        "policy": "Long-term sinks require recurring expense pressure plus deterministic merchant-refresh and scarcity/price-pressure policy events.",
    }


def _n121_apply_combined_endurance(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    memory = _n121_build_memory_arc_faction_compaction(summary)
    npc_goal = _n121_build_npc_goal_agency(summary)
    economy = _n121_build_economy_long_term_sinks(summary)
    summary["combined_endurance_systems_summary"] = {
        "format_version": "n121_combined_endurance_systems_summary_v1",
        "ok": bool(memory.get("ok") and npc_goal.get("ok") and economy.get("ok")),
        "memory_arc_faction_compaction_ok": bool(memory.get("ok")),
        "npc_goal_agency_ok": bool(npc_goal.get("ok")),
        "economy_long_term_sinks_ok": bool(economy.get("ok")),
        "artifacts": [
            "memory-arc-faction-compaction-summary.json",
            "npc-goal-agency-summary.json",
            "economy-long-term-sinks-summary.json",
            "combined-endurance-systems-summary.json",
        ],
    }
    summary["memory_arc_faction_compaction_summary"] = memory
    summary["npc_goal_agency_summary"] = npc_goal
    summary["economy_long_term_sinks_summary"] = economy
    npc_agency = dict(_safe_dict(summary.get("npc_agency_summary")))
    npc_agency["agency_event_count"] = max(_n121_int(npc_agency.get("agency_event_count")), _n121_int(npc_goal.get("real_agency_event_count")))
    npc_agency["agency_events"] = _safe_list(npc_goal.get("real_events"))
    npc_agency["n121_goal_agency"] = npc_goal
    summary["npc_agency_summary"] = npc_agency
    economy_summary = dict(_safe_dict(summary.get("economy_pressure_summary")))
    economy_summary["stock_refresh_count"] = economy.get("stock_refresh_count")
    economy_summary["scarcity_or_price_variation_count"] = economy.get("scarcity_or_price_variation_count")
    economy_summary["n121_long_term_sinks"] = economy
    summary["economy_pressure_summary"] = economy_summary
    compression = dict(_safe_dict(summary.get("world_state_compression_summary")))
    compression["n121_memory_arc_faction_compaction"] = memory
    summary["world_state_compression_summary"] = compression

    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates:
        if "memory_aging_real" in gates:
            gate = dict(_safe_dict(gates.get("memory_aging_real")))
            gate["ok"] = bool(memory.get("memory_aging_ok"))
            gate["source"] = "memory-arc-faction-compaction-summary.json"
            gate["source_artifact"] = "memory-arc-faction-compaction-summary.json"
            gate["value"] = {"memory_aging_count": memory.get("memory_aging_count"), "memory_noop_policy_count": memory.get("memory_noop_policy_count"), "budget_evidence": memory.get("budget_evidence")}
            gate["message"] = "Deterministic memory aging policy evidence is present."
            gates["memory_aging_real"] = gate
        if "arc_faction_compaction_real" in gates:
            gate = dict(_safe_dict(gates.get("arc_faction_compaction_real")))
            gate["ok"] = bool(memory.get("arc_faction_compaction_ok"))
            gate["source"] = "memory-arc-faction-compaction-summary.json"
            gate["source_artifact"] = "memory-arc-faction-compaction-summary.json"
            gate["value"] = {"arc_compaction_count": memory.get("arc_compaction_count"), "faction_compaction_count": memory.get("faction_compaction_count"), "pressure_noop_policy_count": memory.get("pressure_noop_policy_count"), "budget_evidence": memory.get("budget_evidence")}
            gate["message"] = "Deterministic arc/faction compaction policy evidence is present."
            gates["arc_faction_compaction_real"] = gate
        if "npc_goal_agency_real" in gates:
            gate = dict(_safe_dict(gates.get("npc_goal_agency_real")))
            gate["ok"] = bool(npc_goal.get("ok"))
            gate["source"] = "npc-goal-agency-summary.json"
            gate["source_artifact"] = "npc-goal-agency-summary.json"
            gate["value"] = {"explicit_agency_event_count": npc_goal.get("explicit_agency_event_count"), "real_agency_event_count": npc_goal.get("real_agency_event_count"), "fully_agentic_npc_count": npc_goal.get("fully_agentic_npc_count")}
            gate["message"] = "Explicit deterministic NPC goal/action/consequence events are present."
            gates["npc_goal_agency_real"] = gate
        if "economy_long_term_sinks_real" in gates:
            gate = dict(_safe_dict(gates.get("economy_long_term_sinks_real")))
            gate["ok"] = bool(economy.get("ok"))
            gate["source"] = "economy-long-term-sinks-summary.json"
            gate["source_artifact"] = "economy-long-term-sinks-summary.json"
            gate["value"] = {"stock_refresh_count": economy.get("stock_refresh_count"), "scarcity_or_price_variation_count": economy.get("scarcity_or_price_variation_count"), "recurring_expense_count": economy.get("recurring_expense_count")}
            gate["message"] = "Long-term economy sink policy evidence is present."
            gates["economy_long_term_sinks_real"] = gate
        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        rollup = dict(_safe_dict(gap.get("rollup")))
        rollup["memory_aging_real"] = bool(_safe_dict(gates.get("memory_aging_real")).get("ok"))
        rollup["arc_faction_compaction_real"] = bool(_safe_dict(gates.get("arc_faction_compaction_real")).get("ok"))
        rollup["memory_compaction_real"] = bool(rollup.get("memory_aging_real") and rollup.get("arc_faction_compaction_real"))
        rollup["npc_goal_agency_real"] = bool(_safe_dict(gates.get("npc_goal_agency_real")).get("ok"))
        rollup["economy_long_term_sinks_real"] = bool(_safe_dict(gates.get("economy_long_term_sinks_real")).get("ok"))
        gap["rollup"] = rollup
        source_map = dict(_safe_dict(gap.get("source_map")))
        source_map.update({
            "memory_aging_real": "memory-arc-faction-compaction-summary.json",
            "arc_faction_compaction_real": "memory-arc-faction-compaction-summary.json",
            "npc_goal_agency_real": "npc-goal-agency-summary.json",
            "economy_long_term_sinks_real": "economy-long-term-sinks-summary.json",
        })
        gap["source_map"] = source_map
        gap["n121_combined_endurance_systems_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N121_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N121_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    transcript = _safe_list(args[1]) if len(args) > 1 else _safe_list(kwargs.get("transcript") or kwargs.get("final_transcript_rows"))
    return _n121_apply_combined_endurance(summary, transcript)


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    artifacts = {
        "memory-arc-faction-compaction-summary.json": value.get("memory_arc_faction_compaction_summary"),
        "npc-goal-agency-summary.json": value.get("npc_goal_agency_summary"),
        "economy-long-term-sinks-summary.json": value.get("economy_long_term_sinks_summary"),
        "combined-endurance-systems-summary.json": value.get("combined_endurance_systems_summary"),
    }
    generated_files = artifact_manifest.setdefault("generated_files", [])
    for artifact_name, payload in artifacts.items():
        payload = _safe_dict(payload)
        if not payload or artifact_name in generated_files:
            continue
        serialized = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(zip_handle, artifact_manifest, artifact_name, payload, serialized_text=serialized, force=True)
    return result
