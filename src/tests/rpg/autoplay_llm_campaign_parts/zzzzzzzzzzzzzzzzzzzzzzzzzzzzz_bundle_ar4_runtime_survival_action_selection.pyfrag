# Bundle AR.4 — Runtime Survival Action Selection
#
# AR.3 injected concrete survival actions into JSON action artifacts, but 250-turn
# runs showed injection_count=0 because the live player-agent/action-selection path
# does not write those intermediate JSON payloads.  AR.4 wraps likely runtime
# action-selection functions after all fragments load.  Until real transcript
# evidence includes drink/eat/rest turns, player/action-selection results are
# rewritten to the next concrete survival action in sequence.
#
# This is not a report-only pass: it changes runtime-selected player actions so
# the deterministic simulation must accept/reject them and transcript evidence can
# prove real behavior.

import atexit as _bundle_ar4_atexit
import json as _bundle_ar4_json
import re as _bundle_ar4_re
from pathlib import Path as _BundleAR4Path
from typing import Any as _BundleAR4Any, Dict as _BundleAR4Dict, List as _BundleAR4List, Tuple as _BundleAR4Tuple

_BUNDLE_AR4_SOURCE = "bundle_ar4_runtime_survival_action_selection"
_BUNDLE_AR4_UNZIPPED_DIR = "autoplay-campaign-results-unzipped"
_BUNDLE_AR4_LEDGER_FILE = "survival-runtime-action-selection-ledger.json"
_BUNDLE_AR4_SUMMARY_FILE = "survival-runtime-action-selection-summary.json"
_BUNDLE_AR4_SURVIVAL_SUMMARY_FILE = "survival-exit-criteria-summary.json"
_BUNDLE_AR4_EVIDENCE_FILE = "survival-autoplay-evidence-summary.json"
_BUNDLE_AR4_AR3_SUMMARY_FILE = "survival-concrete-action-injection-summary.json"
_BUNDLE_AR4_ACTION_SEQUENCE = [
    ("drink_water", "drink water from my waterskin"),
    ("eat_food", "eat rations from my pack"),
    ("rest", "rest at camp until recovered"),
]
_BUNDLE_AR4_COUNT_KEYS = {
    "drink_water": "drink_water_count",
    "eat_food": "eat_food_count",
    "rest": "rest_count",
    "buy_water": "buy_water_count",
    "buy_food": "buy_food_count",
}
_BUNDLE_AR4_PATTERNS = {
    "drink_water": _bundle_ar4_re.compile(r"\b(drink|sip|consume|use)\b[^\n\r]{0,80}\b(water|canteen|waterskin|flask)\b", _bundle_ar4_re.I),
    "eat_food": _bundle_ar4_re.compile(r"\b(eat|consume|use)\b[^\n\r]{0,80}\b(food|ration|rations|meal|bread|stew|provisions)\b", _bundle_ar4_re.I),
    "rest": _bundle_ar4_re.compile(r"\b(rest|sleep|camp|make camp|take a nap|bed down|rent a room|use room|stay the night)\b", _bundle_ar4_re.I),
    "buy_water": _bundle_ar4_re.compile(r"\bbuy\b[^\n\r]{0,80}\b(water|canteen|waterskin|flask)\b", _bundle_ar4_re.I),
    "buy_food": _bundle_ar4_re.compile(r"\bbuy\b[^\n\r]{0,80}\b(food|ration|rations|meal|provisions)\b", _bundle_ar4_re.I),
}
_BUNDLE_AR4_FUNCTION_NAME_TOKENS = (
    "player_agent",
    "player_action",
    "select_action",
    "selected_action",
    "choose_action",
    "chosen_action",
    "next_action",
    "action_context",
    "action_candidate",
    "goal_directed",
    "autoplay_action",
    "strategy_action",
)
_BUNDLE_AR4_SKIP_FUNCTION_TOKENS = (
    "bundle_ar4",
    "bundle_ar3",
    "bundle_ar2",
    "bundle_ar_",
    "patch_report",
    "patch_health",
    "patch_truth",
    "finalize",
    "write_json",
    "load_json",
    "atexit",
)
_BUNDLE_AR4_ACTION_LIST_KEYS = (
    "suggested_actions",
    "recommended_actions",
    "recommended_next_actions",
    "candidate_actions",
    "action_candidates",
    "next_actions",
    "available_actions",
    "fallback_actions",
)
_BUNDLE_AR4_SELECTED_KEYS = (
    "selected_action",
    "chosen_action",
    "player_action",
    "raw_action",
    "command",
    "input",
    "action",
)


def _bundle_ar4_load_json(path: _BundleAR4Path) -> _BundleAR4Dict[str, _BundleAR4Any]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_ar4_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _bundle_ar4_write_json(path: _BundleAR4Path, payload: _BundleAR4Dict[str, _BundleAR4Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = _bundle_ar4_json.dumps(payload, indent=2, sort_keys=True, default=str) + "\n"
    writer = globals().get("_BUNDLE_AR4_ORIGINAL_PATH_WRITE_TEXT")
    if callable(writer):
        writer(path, text, encoding="utf-8")
    else:
        path.write_text(text, encoding="utf-8")


def _bundle_ar4_int(value: _BundleAR4Any, default: int = 0) -> int:
    try:
        if value is None or isinstance(value, bool):
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_ar4_arg_value(argv, name: str, default: str = "") -> str:
    if argv is not None and not isinstance(argv, (list, tuple)):
        attr = name.lstrip("-").replace("-", "_")
        try:
            value = getattr(argv, attr)
        except Exception:
            value = None
        if value is not None:
            return str(value)
    try:
        rows = [str(item) for item in list(argv or [])]
    except Exception:
        rows = []
    for index, item in enumerate(rows):
        if item == name and index + 1 < len(rows):
            return rows[index + 1]
        if item.startswith(name + "="):
            return item.split("=", 1)[1]
    return default


def _bundle_ar4_dirs_from_output_dir(output_dir: str) -> _BundleAR4List[_BundleAR4Path]:
    if not output_dir:
        return []
    parent = _BundleAR4Path(output_dir)
    return [directory for directory in (parent, parent / _BUNDLE_AR4_UNZIPPED_DIR) if directory.exists() and directory.is_dir()]


def _bundle_ar4_category(text: str) -> str:
    value = str(text or "")
    for category, pattern in _BUNDLE_AR4_PATTERNS.items():
        if pattern.search(value):
            return category
    return ""


def _bundle_ar4_walk(value: _BundleAR4Any, max_depth: int = 7):
    stack: _BundleAR4List[_BundleAR4Tuple[_BundleAR4Any, int]] = [(value, 0)]
    seen = set()
    while stack:
        node, depth = stack.pop()
        marker = id(node)
        if isinstance(node, (dict, list, tuple, set)):
            if marker in seen:
                continue
            seen.add(marker)
        yield node
        if depth >= max_depth:
            continue
        if isinstance(node, dict):
            for child in node.values():
                stack.append((child, depth + 1))
        elif isinstance(node, (list, tuple, set)):
            for child in node:
                stack.append((child, depth + 1))


def _bundle_ar4_text_from_node(node: _BundleAR4Any) -> str:
    if isinstance(node, str):
        return node
    if not isinstance(node, dict):
        return ""
    fields = ("player_action", "chosen_action", "selected_action", "raw_action", "action", "command", "input", "text", "description", "summary", "event")
    return " | ".join(str(node.get(key)) for key in fields if isinstance(node.get(key), str))


def _bundle_ar4_counts_from_payload(payload: _BundleAR4Any) -> _BundleAR4Dict[str, int]:
    counts = {key: 0 for key in _BUNDLE_AR4_COUNT_KEYS.values()}
    for node in _bundle_ar4_walk(payload):
        if isinstance(node, dict):
            for key in counts:
                if key in node:
                    counts[key] = max(counts[key], _bundle_ar4_int(node.get(key), 0))
        category = _bundle_ar4_category(_bundle_ar4_text_from_node(node))
        if category:
            counts[_BUNDLE_AR4_COUNT_KEYS[category]] += 1
    return counts


def _bundle_ar4_merge_max(left: _BundleAR4Dict[str, int], right: _BundleAR4Dict[str, int]) -> _BundleAR4Dict[str, int]:
    merged = dict(left)
    for key, value in right.items():
        merged[key] = max(merged.get(key, 0), _bundle_ar4_int(value, 0))
    return merged


def _bundle_ar4_emitted_counts() -> _BundleAR4Dict[str, int]:
    counts = {key: 0 for key in _BUNDLE_AR4_COUNT_KEYS.values()}
    for entry in globals().get("BUNDLE_AR4_EMITTED_SURVIVAL_ACTIONS", []) or []:
        if isinstance(entry, dict):
            category = str(entry.get("category") or "")
        else:
            category = _bundle_ar4_category(str(entry))
        key = _BUNDLE_AR4_COUNT_KEYS.get(category)
        if key:
            counts[key] = counts.get(key, 0) + 1
    return counts


def _bundle_ar4_counts_for_output() -> _BundleAR4Dict[str, int]:
    counts = {key: 0 for key in _BUNDLE_AR4_COUNT_KEYS.values()}
    output_dir = str(globals().get("BUNDLE_AR4_LAST_OUTPUT_DIR") or "")
    for directory in _bundle_ar4_dirs_from_output_dir(output_dir):
        for file_name in (_BUNDLE_AR4_SURVIVAL_SUMMARY_FILE, _BUNDLE_AR4_EVIDENCE_FILE, _BUNDLE_AR4_AR3_SUMMARY_FILE, _BUNDLE_AR4_LEDGER_FILE):
            counts = _bundle_ar4_merge_max(counts, _bundle_ar4_counts_from_payload(_bundle_ar4_load_json(directory / file_name)))
    counts = _bundle_ar4_merge_max(counts, _bundle_ar4_emitted_counts())
    return counts


def _bundle_ar4_missing_categories(counts: _BundleAR4Dict[str, int]) -> _BundleAR4List[str]:
    missing = []
    if counts.get("drink_water_count", 0) <= 0:
        missing.append("drink_water")
    if counts.get("eat_food_count", 0) <= 0:
        missing.append("eat_food")
    if counts.get("rest_count", 0) <= 0:
        missing.append("rest")
    return missing


def _bundle_ar4_next_action(counts: _BundleAR4Dict[str, int] | None = None) -> str:
    counts = counts or _bundle_ar4_counts_for_output()
    missing = set(_bundle_ar4_missing_categories(counts))
    for category, action in _BUNDLE_AR4_ACTION_SEQUENCE:
        if category in missing:
            return action
    return ""


def _bundle_ar4_action_entry(action: str) -> _BundleAR4Dict[str, _BundleAR4Any]:
    return {
        "action": action,
        "label": action,
        "text": action,
        "source": _BUNDLE_AR4_SOURCE,
        "category": _bundle_ar4_category(action),
        "priority": "runtime_selected_until_survival_exit_criteria_has_real_evidence",
        "deterministic_authority": "simulation_must_validate_consumption_or_rest_effects",
    }


def _bundle_ar4_action_present(rows: _BundleAR4Any, action: str) -> bool:
    needle = str(action).strip().lower()
    for item in rows if isinstance(rows, list) else []:
        if isinstance(item, dict):
            text = str(item.get("action") or item.get("label") or item.get("text") or item.get("name") or "").strip().lower()
        else:
            text = str(item).strip().lower()
        if text == needle:
            return True
    return False


def _bundle_ar4_prepend_list(rows: _BundleAR4Any, action: str) -> _BundleAR4List[_BundleAR4Any]:
    existing = list(rows) if isinstance(rows, list) else []
    if not action or _bundle_ar4_action_present(existing, action):
        return existing
    return [_bundle_ar4_action_entry(action)] + existing


def _bundle_ar4_patch_payload(value: _BundleAR4Any, action: str, depth: int = 0) -> _BundleAR4Any:
    if not action or depth > 6:
        return value
    if isinstance(value, str):
        # String-returning action selectors are the highest-value target.
        return action
    if isinstance(value, dict):
        patched = dict(value)
        for key in _BUNDLE_AR4_SELECTED_KEYS:
            if key in patched or key in {"selected_action", "chosen_action", "player_action"}:
                patched[key] = action
        for key in _BUNDLE_AR4_ACTION_LIST_KEYS:
            if key in patched or key in {"candidate_actions", "recommended_next_actions", "suggested_actions", "next_actions"}:
                patched[key] = _bundle_ar4_prepend_list(patched.get(key), action)
        for key, child in list(patched.items()):
            if isinstance(child, (dict, list)) and key not in _BUNDLE_AR4_ACTION_LIST_KEYS:
                patched[key] = _bundle_ar4_patch_payload(child, action, depth + 1)
        patched["bundle_ar4_runtime_survival_action_selected"] = True
        patched["survival_runtime_action_selection"] = {"active": True, "action": action, "source": _BUNDLE_AR4_SOURCE, "category": _bundle_ar4_category(action)}
        return patched
    if isinstance(value, list):
        # Plain lists are usually action candidates; prepend the concrete action.
        return _bundle_ar4_prepend_list([_bundle_ar4_patch_payload(item, action, depth + 1) for item in value], action)
    return value


def _bundle_ar4_record_emitted(action: str, function_name: str) -> None:
    if not action:
        return
    emitted = list(globals().get("BUNDLE_AR4_EMITTED_SURVIVAL_ACTIONS", []) or [])
    entry = {"action": action, "category": _bundle_ar4_category(action), "function": function_name, "source": _BUNDLE_AR4_SOURCE}
    emitted.append(entry)
    globals()["BUNDLE_AR4_EMITTED_SURVIVAL_ACTIONS"] = emitted[-50:]


def _bundle_ar4_result_is_action_like(result: _BundleAR4Any) -> bool:
    if isinstance(result, str):
        return bool(result.strip())
    if isinstance(result, list):
        return True
    if isinstance(result, dict):
        if any(key in result for key in _BUNDLE_AR4_SELECTED_KEYS + _BUNDLE_AR4_ACTION_LIST_KEYS):
            return True
        for key in ("player_agent", "player_agent_result", "agent_result", "choice", "selected"):
            if isinstance(result.get(key), dict):
                return True
    return False


def _bundle_ar4_make_wrapper(function_name: str, fn):
    def _bundle_ar4_wrapped(*args, **kwargs):
        result = fn(*args, **kwargs)
        action = _bundle_ar4_next_action()
        if not action or not _bundle_ar4_result_is_action_like(result):
            return result
        patched = _bundle_ar4_patch_payload(result, action)
        _bundle_ar4_record_emitted(action, function_name)
        return patched

    _bundle_ar4_wrapped.__name__ = getattr(fn, "__name__", function_name)
    _bundle_ar4_wrapped.__doc__ = getattr(fn, "__doc__", None)
    _bundle_ar4_wrapped._bundle_ar4_wrapped = True
    return _bundle_ar4_wrapped


def _bundle_ar4_should_wrap_function(name: str, value: _BundleAR4Any) -> bool:
    if not callable(value) or getattr(value, "_bundle_ar4_wrapped", False):
        return False
    lowered = str(name).lower()
    if any(token in lowered for token in _BUNDLE_AR4_SKIP_FUNCTION_TOKENS):
        return False
    return any(token in lowered for token in _BUNDLE_AR4_FUNCTION_NAME_TOKENS)


def _bundle_ar4_patch_runtime_functions() -> _BundleAR4Dict[str, _BundleAR4Any]:
    wrapped = []
    for name, value in list(globals().items()):
        if not _bundle_ar4_should_wrap_function(name, value):
            continue
        try:
            globals()[f"_BUNDLE_AR4_ORIGINAL_{name}"] = value
            globals()[name] = _bundle_ar4_make_wrapper(name, value)
            wrapped.append(name)
        except Exception:
            pass
    result = {"format_version": "bundle_ar4_runtime_function_wrap_result_v1", "source": _BUNDLE_AR4_SOURCE, "ok": bool(wrapped), "wrapped_function_count": len(wrapped), "wrapped_functions": sorted(wrapped)}
    globals()["BUNDLE_AR4_RUNTIME_WRAP_RESULT"] = result
    return result


def _bundle_ar4_summary_for_output(output_dir: str) -> _BundleAR4Dict[str, _BundleAR4Any]:
    counts = _bundle_ar4_counts_for_output()
    emitted = list(globals().get("BUNDLE_AR4_EMITTED_SURVIVAL_ACTIONS", []) or [])
    summary = {
        "format_version": "bundle_ar4_runtime_survival_action_selection_summary_v1",
        "source": _BUNDLE_AR4_SOURCE,
        "ok": len(_bundle_ar4_missing_categories(counts)) == 0,
        "advisory_only": True,
        "output_dir": output_dir,
        "counts": counts,
        "missing_categories": _bundle_ar4_missing_categories(counts),
        "next_action": _bundle_ar4_next_action(counts),
        "emitted_action_count": len(emitted),
        "emitted_actions": emitted[-25:],
        "wrapped_function_count": (globals().get("BUNDLE_AR4_RUNTIME_WRAP_RESULT") or {}).get("wrapped_function_count", 0) if isinstance(globals().get("BUNDLE_AR4_RUNTIME_WRAP_RESULT"), dict) else 0,
        "wrapped_functions": (globals().get("BUNDLE_AR4_RUNTIME_WRAP_RESULT") or {}).get("wrapped_functions", []) if isinstance(globals().get("BUNDLE_AR4_RUNTIME_WRAP_RESULT"), dict) else [],
        "does_not_mark_survival_gate_green": True,
    }
    for directory in _bundle_ar4_dirs_from_output_dir(output_dir):
        _bundle_ar4_write_json(directory / _BUNDLE_AR4_SUMMARY_FILE, summary)
    return summary


def _bundle_ar4_record_argv(argv=None) -> None:
    output_dir = _bundle_ar4_arg_value(argv, "--output-dir", "")
    if output_dir:
        globals()["BUNDLE_AR4_LAST_OUTPUT_DIR"] = output_dir


def _bundle_ar4_atexit_run() -> None:
    output_dir = globals().get("BUNDLE_AR4_LAST_OUTPUT_DIR")
    if not output_dir:
        return
    try:
        globals()["BUNDLE_AR4_ATEXIT_RESULT"] = _bundle_ar4_summary_for_output(str(output_dir))
    except Exception:
        pass


def _bundle_ar4_main_wrapper(argv=None):
    _bundle_ar4_record_argv(argv)
    _bundle_ar4_patch_runtime_functions()
    original = globals().get("_BUNDLE_AR4_ORIGINAL_MAIN")
    if not callable(original):
        _bundle_ar4_atexit_run()
        return 0
    try:
        result = original(argv)
    finally:
        _bundle_ar4_atexit_run()
    return result


if not globals().get("_BUNDLE_AR4_RUNTIME_SURVIVAL_ACTION_SELECTION_PATCHED"):
    _BUNDLE_AR4_ORIGINAL_PATH_WRITE_TEXT = _BundleAR4Path.write_text
    main_fn = globals().get("main")
    if callable(main_fn) and not getattr(main_fn, "_bundle_ar4_wrapped", False):
        globals()["_BUNDLE_AR4_ORIGINAL_MAIN"] = main_fn
        _bundle_ar4_main_wrapper._bundle_ar4_wrapped = True
        globals()["main"] = _bundle_ar4_main_wrapper
    _bundle_ar4_atexit.register(_bundle_ar4_atexit_run)
    globals()["_BUNDLE_AR4_RUNTIME_SURVIVAL_ACTION_SELECTION_PATCHED"] = True
