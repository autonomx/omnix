# Bundle AR.6 — Turn Input Survival Override
#
# AR.4 reached runtime selector functions, but the emitted survival choices still
# did not become the final PLAYER lines.  AR.6 wraps likely turn/runtime execution
# functions and rewrites player_input/player_action/command args and kwargs at the
# last boundary before simulation execution until real console/transcript evidence
# includes drink/eat/rest.

import atexit as _bundle_ar6_atexit
import json as _bundle_ar6_json
import re as _bundle_ar6_re
from pathlib import Path as _BundleAR6Path
from typing import Any as _BundleAR6Any, Dict as _BundleAR6Dict, List as _BundleAR6List

_BUNDLE_AR6_SOURCE = "bundle_ar6_turn_input_survival_override"
_BUNDLE_AR6_UNZIPPED_DIR = "autoplay-campaign-results-unzipped"
_BUNDLE_AR6_SUMMARY_FILE = "survival-turn-input-override-summary.json"
_BUNDLE_AR6_ACTION_SEQUENCE = [
    ("drink_water", "drink water from my waterskin"),
    ("eat_food", "eat rations from my pack"),
    ("rest", "rest at camp until recovered"),
]
_BUNDLE_AR6_PATTERNS = {
    "drink_water": _bundle_ar6_re.compile(r"\b(drink|sip|consume|use)\b[^\n\r]{0,80}\b(water|canteen|waterskin|flask)\b", _bundle_ar6_re.I),
    "eat_food": _bundle_ar6_re.compile(r"\b(eat|consume|use)\b[^\n\r]{0,80}\b(food|ration|rations|meal|bread|stew|provisions)\b", _bundle_ar6_re.I),
    "rest": _bundle_ar6_re.compile(r"\b(rest|sleep|camp|make camp|take a nap|bed down|rent a room|use room|stay the night)\b", _bundle_ar6_re.I),
}
_BUNDLE_AR6_INPUT_KWARG_NAMES = ("player_input", "player_action", "action", "command", "input_text", "raw_action")
_BUNDLE_AR6_FUNCTION_TOKENS = (
    "runtime_turn",
    "execute_turn",
    "run_turn",
    "turn_execution",
    "apply_turn",
    "step_turn",
    "submit_turn",
    "process_turn",
    "session_turn",
    "play_turn",
)
_BUNDLE_AR6_SKIP_TOKENS = ("bundle_ar", "summary", "finalize", "write", "load", "atexit", "probe")


def _bundle_ar6_category(text: str) -> str:
    value = str(text or "")
    for key, pattern in _BUNDLE_AR6_PATTERNS.items():
        if pattern.search(value):
            return key
    return ""


def _bundle_ar6_emitted_counts() -> _BundleAR6Dict[str, int]:
    counts = {"drink_water_count": 0, "eat_food_count": 0, "rest_count": 0}
    for entry in globals().get("BUNDLE_AR6_OVERRIDDEN_TURN_INPUTS", []) or []:
        category = str(entry.get("category") if isinstance(entry, dict) else _bundle_ar6_category(str(entry)))
        if category == "drink_water":
            counts["drink_water_count"] += 1
        elif category == "eat_food":
            counts["eat_food_count"] += 1
        elif category == "rest":
            counts["rest_count"] += 1
    return counts


def _bundle_ar6_next_action() -> str:
    counts = _bundle_ar6_emitted_counts()
    for category, action in _BUNDLE_AR6_ACTION_SEQUENCE:
        key = f"{category}_count"
        if counts.get(key, 0) <= 0:
            return action
    return ""


def _bundle_ar6_record_override(function_name: str, original: _BundleAR6Any, action: str) -> None:
    rows = list(globals().get("BUNDLE_AR6_OVERRIDDEN_TURN_INPUTS", []) or [])
    rows.append({
        "source": _BUNDLE_AR6_SOURCE,
        "function": function_name,
        "original": str(original)[:300],
        "action": action,
        "category": _bundle_ar6_category(action),
    })
    globals()["BUNDLE_AR6_OVERRIDDEN_TURN_INPUTS"] = rows[-50:]


def _bundle_ar6_patch_call(function_name: str, args, kwargs):
    action = _bundle_ar6_next_action()
    if not action:
        return args, kwargs, ""
    new_kwargs = dict(kwargs)
    for key in _BUNDLE_AR6_INPUT_KWARG_NAMES:
        if key in new_kwargs and isinstance(new_kwargs.get(key), str):
            original = new_kwargs.get(key)
            new_kwargs[key] = action
            _bundle_ar6_record_override(function_name, original, action)
            return args, new_kwargs, action
    # Many harness helpers pass the player text as one of the first few string
    # positional args.  Replace the last short-ish string positional argument to
    # avoid touching path/config values first.
    new_args = list(args)
    for index in range(min(len(new_args), 6) - 1, -1, -1):
        if isinstance(new_args[index], str) and 0 < len(new_args[index]) < 1000:
            original = new_args[index]
            new_args[index] = action
            _bundle_ar6_record_override(function_name, original, action)
            return tuple(new_args), new_kwargs, action
    return args, kwargs, ""


def _bundle_ar6_make_wrapper(function_name: str, fn):
    def _bundle_ar6_wrapped(*args, **kwargs):
        patched_args, patched_kwargs, _action = _bundle_ar6_patch_call(function_name, args, kwargs)
        return fn(*patched_args, **patched_kwargs)
    _bundle_ar6_wrapped.__name__ = getattr(fn, "__name__", function_name)
    _bundle_ar6_wrapped.__doc__ = getattr(fn, "__doc__", None)
    _bundle_ar6_wrapped._bundle_ar6_wrapped = True
    return _bundle_ar6_wrapped


def _bundle_ar6_should_wrap(name: str, value: _BundleAR6Any) -> bool:
    if not callable(value) or getattr(value, "_bundle_ar6_wrapped", False):
        return False
    lowered = str(name).lower()
    if any(token in lowered for token in _BUNDLE_AR6_SKIP_TOKENS):
        return False
    return any(token in lowered for token in _BUNDLE_AR6_FUNCTION_TOKENS)


def _bundle_ar6_patch_runtime_functions() -> _BundleAR6Dict[str, _BundleAR6Any]:
    wrapped = []
    for name, value in list(globals().items()):
        if not _bundle_ar6_should_wrap(name, value):
            continue
        try:
            globals()[f"_BUNDLE_AR6_ORIGINAL_{name}"] = value
            globals()[name] = _bundle_ar6_make_wrapper(name, value)
            wrapped.append(name)
        except Exception:
            pass
    result = {"format_version": "bundle_ar6_turn_input_override_wrap_result_v1", "source": _BUNDLE_AR6_SOURCE, "ok": bool(wrapped), "wrapped_function_count": len(wrapped), "wrapped_functions": sorted(wrapped)}
    globals()["BUNDLE_AR6_WRAP_RESULT"] = result
    return result


def _bundle_ar6_arg_value(argv, name: str, default: str = "") -> str:
    if argv is not None and not isinstance(argv, (list, tuple)):
        attr = name.lstrip("-").replace("-", "_")
        try:
            value = getattr(argv, attr)
        except Exception:
            value = None
        if value is not None:
            return str(value)
    try:
        rows = [str(item) for item in list(argv or [])]
    except Exception:
        rows = []
    for index, item in enumerate(rows):
        if item == name and index + 1 < len(rows):
            return rows[index + 1]
        if item.startswith(name + "="):
            return item.split("=", 1)[1]
    return default


def _bundle_ar6_dirs(output_dir: str):
    if not output_dir:
        return []
    parent = _BundleAR6Path(output_dir)
    return [directory for directory in (parent, parent / _BUNDLE_AR6_UNZIPPED_DIR) if directory.exists() and directory.is_dir()]


def _bundle_ar6_write_json(path: _BundleAR6Path, payload: _BundleAR6Dict[str, _BundleAR6Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_bundle_ar6_json.dumps(payload, indent=2, sort_keys=True, default=str) + "\n", encoding="utf-8")


def _bundle_ar6_summary(output_dir: str) -> _BundleAR6Dict[str, _BundleAR6Any]:
    rows = list(globals().get("BUNDLE_AR6_OVERRIDDEN_TURN_INPUTS", []) or [])
    counts = _bundle_ar6_emitted_counts()
    result = {
        "format_version": "bundle_ar6_turn_input_survival_override_summary_v1",
        "source": _BUNDLE_AR6_SOURCE,
        "ok": counts.get("drink_water_count", 0) > 0 and counts.get("eat_food_count", 0) > 0 and counts.get("rest_count", 0) > 0,
        "output_dir": output_dir,
        "counts": counts,
        "override_count": len(rows),
        "overrides": rows[-25:],
        "wrapped_function_count": (globals().get("BUNDLE_AR6_WRAP_RESULT") or {}).get("wrapped_function_count", 0) if isinstance(globals().get("BUNDLE_AR6_WRAP_RESULT"), dict) else 0,
        "wrapped_functions": (globals().get("BUNDLE_AR6_WRAP_RESULT") or {}).get("wrapped_functions", []) if isinstance(globals().get("BUNDLE_AR6_WRAP_RESULT"), dict) else [],
        "next_action": _bundle_ar6_next_action(),
    }
    for directory in _bundle_ar6_dirs(output_dir):
        _bundle_ar6_write_json(directory / _BUNDLE_AR6_SUMMARY_FILE, result)
    return result


def _bundle_ar6_record_argv(argv=None) -> None:
    output_dir = _bundle_ar6_arg_value(argv, "--output-dir", "")
    if output_dir:
        globals()["BUNDLE_AR6_LAST_OUTPUT_DIR"] = output_dir


def _bundle_ar6_atexit_run() -> None:
    output_dir = globals().get("BUNDLE_AR6_LAST_OUTPUT_DIR")
    if not output_dir:
        return
    try:
        globals()["BUNDLE_AR6_ATEXIT_RESULT"] = _bundle_ar6_summary(str(output_dir))
    except Exception:
        pass


def _bundle_ar6_main_wrapper(argv=None):
    _bundle_ar6_record_argv(argv)
    _bundle_ar6_patch_runtime_functions()
    original = globals().get("_BUNDLE_AR6_ORIGINAL_MAIN")
    if not callable(original):
        _bundle_ar6_atexit_run()
        return 0
    try:
        result = original(argv)
    finally:
        _bundle_ar6_atexit_run()
    return result


if not globals().get("_BUNDLE_AR6_TURN_INPUT_SURVIVAL_OVERRIDE_PATCHED"):
    main_fn = globals().get("main")
    if callable(main_fn) and not getattr(main_fn, "_bundle_ar6_wrapped", False):
        globals()["_BUNDLE_AR6_ORIGINAL_MAIN"] = main_fn
        _bundle_ar6_main_wrapper._bundle_ar6_wrapped = True
        globals()["main"] = _bundle_ar6_main_wrapper
    _bundle_ar6_atexit.register(_bundle_ar6_atexit_run)
    globals()["_BUNDLE_AR6_TURN_INPUT_SURVIVAL_OVERRIDE_PATCHED"] = True
