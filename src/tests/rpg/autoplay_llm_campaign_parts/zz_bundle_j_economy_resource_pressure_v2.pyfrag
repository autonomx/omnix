        "safe_route_discount": -0.10,
    },
    "determinism": "stock refresh is keyed by location, refresh interval, campaign seed, and faction pressure state",
}

_BUNDLE_J_RESOURCE_PRESSURE_RULES: _BundleJDict[str, _BundleJAny] = {
    "format_version": "bundle_j_resource_pressure_rules_v1",
    "source": "bundle_j_economy_resource_pressure_v2",
    "resources": ["food", "water", "rest", "fatigue", "travel_cost", "debt"],
    "pressure_rules": [
        {"id": "food_low_warning", "resource": "food", "threshold": 1, "cooldown_turns": 8, "severity": "warning"},
        {"id": "water_low_warning", "resource": "water", "threshold": 1, "cooldown_turns": 8, "severity": "warning"},
        {"id": "fatigue_rest_needed", "resource": "fatigue", "threshold": 3, "cooldown_turns": 10, "severity": "warning"},
