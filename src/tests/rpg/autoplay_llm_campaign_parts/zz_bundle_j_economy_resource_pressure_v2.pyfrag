# Bundle J — Economy / Resource Pressure v2
#
# Advisory/bounded economy layer.  This fragment exports deterministic service
# catalogs, merchant inventory refresh rules, resource pressure rules, and
# balance/readiness gates.  It enriches economy-resource-pressure-summary.json
# and writes economy-resource-pressure-v2-summary.json without mutating the
# authoritative simulation state.

import html as _bundle_j_html
import json as _bundle_j_json
from pathlib import Path as _BundleJPath
from typing import Any as _BundleJAny, Dict as _BundleJDict, Iterable as _BundleJIterable, List as _BundleJList, Optional as _BundleJOptional, Set as _BundleJSet


_BUNDLE_J_SUMMARY_FILE = "economy-resource-pressure-v2-summary.json"
_BUNDLE_J_BASE_ECONOMY_FILE = "economy-resource-pressure-summary.json"
_BUNDLE_J_REPORT_MARKER = 'id="bundle-j-economy-resource-pressure-v2"'
_BUNDLE_J_MIN_SERVICE_COUNT = 10
_BUNDLE_J_MIN_MERCHANT_STOCK_COUNT = 12
_BUNDLE_J_MAX_SURVIVAL_INTERVENTION_COUNT = 8
_BUNDLE_J_MAX_UNPAID_COUNT = 8
_BUNDLE_J_MAX_REPETITIVE_PRESSURE_EVENTS = 5

