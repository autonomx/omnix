        {"id": "drink_clean_water", "category": "drink", "tier": "basic", "base_price": 1, "effects": {"water": 2}},
        {"id": "drink_tavern_ale", "category": "drink", "tier": "comfort", "base_price": 1, "effects": {"morale": 1}},
        {"id": "supply_road_rations", "category": "travel_supply", "tier": "standard", "base_price": 5, "effects": {"food": 4, "travel_ready": 1}},
        {"id": "supply_waterskin_fill", "category": "travel_supply", "tier": "standard", "base_price": 2, "effects": {"water": 4, "travel_ready": 1}},
        {"id": "repair_light_gear", "category": "repair", "tier": "light", "base_price": 4, "effects": {"durability": 1}},
