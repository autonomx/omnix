# Bundle AB — Focused Suite Registry Dashboard Rendering
#
# Product-facing dashboard for Bundle AA's focused suite registry.  This
# fragment reads one-thousand-turn-focused-suite-registry-summary.json, writes a
# compact dashboard summary, and injects a campaign report section that shows
# command drift status and the canonical E-Z focused pytest command.

import html as _bundle_ab_html
import json as _bundle_ab_json
from pathlib import Path as _BundleABPath
from typing import Any as _BundleABAny, Dict as _BundleABDict, List as _BundleABList

_BUNDLE_AB_REGISTRY_FILE = "one-thousand-turn-focused-suite-registry-summary.json"
_BUNDLE_AB_DASHBOARD_FILE = "one-thousand-turn-focused-suite-registry-dashboard-summary.json"


def _bundle_ab_safe_html(value: _BundleABAny) -> str:
    return _bundle_ab_html.escape("" if value is None else str(value), quote=True)


def _bundle_ab_load_json_file(path: _BundleABPath) -> _BundleABDict[str, _BundleABAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_ab_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_ab_status_label(registry: _BundleABDict[str, _BundleABAny]) -> str:
    if registry.get("focused_suite_registry_ready") is True:
        return "Focused Suite Synced"
    if registry:
        return "Focused Suite Drift"
    return "Focused Suite Missing"


def _bundle_ab_status_class(registry: _BundleABDict[str, _BundleABAny]) -> str:
    if registry.get("focused_suite_registry_ready") is True:
        return "pass"
    if registry:
        return "warn"
    return "fail"


def _bundle_ab_build_dashboard_summary(registry: _BundleABDict[str, _BundleABAny]) -> _BundleABDict[str, _BundleABAny]:
    metrics = registry.get("metrics") if isinstance(registry.get("metrics"), dict) else {}
    failures = registry.get("advisory_failures") if isinstance(registry.get("advisory_failures"), list) else []
    test_files = registry.get("test_files") if isinstance(registry.get("test_files"), list) else []
    canonical = registry.get("canonical_command") if isinstance(registry.get("canonical_command"), dict) else {}
    return {
        "format_version": "bundle_ab_focused_suite_registry_dashboard_summary_v1",
        "source": "bundle_ab_focused_suite_registry_dashboard",
        "ok": registry.get("focused_suite_registry_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_ab_status_label(registry),
        "status_class": _bundle_ab_status_class(registry),
        "focused_suite_registry_ready": registry.get("focused_suite_registry_ready") is True,
        "test_file_count": int(metrics.get("test_file_count") or len(test_files) or 0),
        "missing_test_file_count": int(metrics.get("missing_test_file_count") or 0),
        "duplicate_test_file_count": int(metrics.get("duplicate_test_file_count") or 0),
        "handoff_command_arg_count": int(metrics.get("handoff_command_arg_count") or 0),
        "canonical_command_arg_count": int(metrics.get("command_arg_count") or len(canonical.get("argv") or []) or 0),
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "first_test_file": test_files[0] if test_files else "",
        "last_test_file": test_files[-1] if test_files else "",
        "canonical_command_text": canonical.get("text") or "",
        "recommended_next_step": registry.get("recommended_next_step") or "write_focused_suite_registry_summary_first",
    }


def _bundle_ab_write_dashboard_summary_if_possible(result_dir: _BundleABPath) -> _BundleABDict[str, _BundleABAny]:
    registry = _bundle_ab_load_json_file(result_dir / _BUNDLE_AB_REGISTRY_FILE)
    dashboard = _bundle_ab_build_dashboard_summary(registry)
    if not registry:
        dashboard["advisory_failures"] = [_BUNDLE_AB_REGISTRY_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_focused_suite_registry_summary_first"
    _BUNDLE_AB_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_AB_DASHBOARD_FILE,
        _bundle_ab_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_ab_test_rows(registry: _BundleABDict[str, _BundleABAny]) -> str:
    test_files = registry.get("test_files") if isinstance(registry.get("test_files"), list) else []
    rows: _BundleABList[str] = []
    for index, path in enumerate(test_files, start=1):
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_ab_safe_html(index)}</th>"
            f"<td><code>{_bundle_ab_safe_html(path)}</code></td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">0</th><td>no focused suite registry available</td></tr>"


def _bundle_ab_render_dashboard_section(result_dir: _BundleABPath) -> str:
    registry = _bundle_ab_load_json_file(result_dir / _BUNDLE_AB_REGISTRY_FILE)
    dashboard = _bundle_ab_load_json_file(result_dir / _BUNDLE_AB_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_ab_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_ab_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Focused Suite Missing"
    command_text = dashboard.get("canonical_command_text") or "not available"
    return (
        '<section id="bundle-ab-focused-suite-registry-dashboard" class="bundle-ab-focused-suite-registry-dashboard">'
        "<style>"
        ".bundle-ab-focused-suite-registry-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-ab-focused-suite-registry-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-ab-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-ab-badge-pass{background:rgba(34,197,94,.16)}.bundle-ab-badge-warn{background:rgba(245,158,11,.16)}.bundle-ab-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-ab-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72);margin-top:12px}"
        ".bundle-ab-table{width:100%;border-collapse:collapse;font-size:.9rem}.bundle-ab-table th,.bundle-ab-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-ab-command,.bundle-ab-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header><h2>Focused Suite Registry</h2>"
        f'<span class="bundle-ab-badge bundle-ab-badge-{_bundle_ab_safe_html(status_class)}">{_bundle_ab_safe_html(status_label)}</span></header>'
        "<p>Canonical E-Z focused test command and drift guard for archived release-candidate handoffs.</p>"
        f"<p>Tests: {_bundle_ab_safe_html(dashboard.get('test_file_count', 0))}; missing: {_bundle_ab_safe_html(dashboard.get('missing_test_file_count', 0))}; duplicates: {_bundle_ab_safe_html(dashboard.get('duplicate_test_file_count', 0))}.</p>"
        f"<p>Recommended next step: {_bundle_ab_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-ab-card"><h3>Canonical Command</h3>'
        f'<pre class="bundle-ab-command"><code>{_bundle_ab_safe_html(command_text)}</code></pre></div>'
        '<div class="bundle-ab-card"><h3>Focused Test Files</h3><table class="bundle-ab-table"><thead><tr><th>#</th><th>Path</th></tr></thead><tbody>'
        f"{_bundle_ab_test_rows(registry)}"
        "</tbody></table></div>"
        '<details class="bundle-ab-raw-details"><summary>Raw focused suite dashboard JSON</summary>'
        f'<pre class="bundle-ab-raw-json">{_bundle_ab_safe_html(raw_json)}</pre></details></section>'
    )


def _bundle_ab_looks_like_campaign_report(path: _BundleABPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-ab-focused-suite-registry-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_ab_inject_dashboard_section(path: _BundleABPath, html_text: str) -> str:
    if not _bundle_ab_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_ab_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_AB_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_AB_ORIGINAL_PATH_WRITE_TEXT = _BundleABPath.write_text

    def _bundle_ab_write_text_with_focused_suite_dashboard(self, data, *args, **kwargs):
        path = _BundleABPath(self)
        if isinstance(data, str) and _bundle_ab_looks_like_campaign_report(path, data):
            try:
                data = _bundle_ab_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle AB dashboard injection skipped: " + _bundle_ab_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_AB_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_AB_REGISTRY_FILE:
                _bundle_ab_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _BundleABPath.write_text = _bundle_ab_write_text_with_focused_suite_dashboard
    globals()["_BUNDLE_AB_PATH_WRITE_TEXT_PATCHED"] = True
