# N125.1 — real survival metric source repair + autoplay evidence gate.
#
# Runs after N123/N124 report wrappers and replaces survival summary extraction
# with a normalized real-transcript source-aware implementation.

_N1251_EVAL_PREV = globals().get("_build_100_turn_evaluation_summary")
_N1251_READY_PREV = globals().get("_build_100_turn_readiness_summary")

try:
    from app.rpg.session.survival_metrics import (
        build_survival_metric_source_gate,
        build_survival_metric_source_summary,
        build_survival_pressure_relief_summary as _n1251_build_survival_summary,
    )
except Exception:  # pragma: no cover - defensive for generated harness contexts
    build_survival_metric_source_gate = None
    build_survival_metric_source_summary = None
    _n1251_build_survival_summary = None

try:
    from app.rpg.session.survival_transcript_projector import persist_survival_evidence_into_transcript_rows as _n1251_project_survival_rows
except Exception:  # pragma: no cover - defensive for generated harness contexts
    _n1251_project_survival_rows = None


def _n1251_dict(value):
    return value if isinstance(value, dict) else {}


def _n1251_list(value):
    return value if isinstance(value, list) else []


def _n1251_has_projection(row):
    return bool(_n1251_dict(row).get("survival_evidence_projection"))


def _n1251_project_transcript(transcript):
    transcript = _n1251_list(transcript)
    if not transcript:
        return []
    if all(_n1251_has_projection(row) for row in transcript):
        return transcript
    if callable(_n1251_project_survival_rows):
        return _n1251_project_survival_rows(transcript)
    return transcript


def _n1251_transcript_from_args(args, kwargs):
    transcript = kwargs.get("transcript")
    if transcript is None and len(args) >= 5:
        transcript = args[4]
    if transcript is None and len(args) >= 2 and isinstance(args[1], list):
        transcript = args[1]
    return _n1251_project_transcript(transcript)


def _n1251_render_source_section(source_summary, gate):
    source_summary = _n1251_dict(source_summary)
    gate = _n1251_dict(gate)
    coverage = _n1251_dict(source_summary.get("coverage"))
    rows = "".join(f"<tr><td>{key}</td><td>{value}</td></tr>" for key, value in coverage.items()) or "<tr><td colspan='2'>No coverage rows.</td></tr>"
    reasons = ", ".join(str(item) for item in _n1251_list(gate.get("reasons"))) or "none"
    return f"""
<section id="n1251-survival-source" class="report-section n1251-survival-source">
  <h2>N125.1 Real Survival Metric Source Evidence</h2>
  <p><strong>Gate:</strong> survival_metric_source_ok = {bool(gate.get('ok'))} (advisory)</p>
  <p><strong>Reasons:</strong> {reasons}</p>
  <table><thead><tr><th>Coverage field</th><th>Count</th></tr></thead><tbody>{rows}</tbody></table>
</section>
""".strip()


def _n1251_insert_source_section(sections, source_section):
    clean_sections = [section for section in _n1251_list(sections) if _n1251_dict(section).get("id") != "n1251-survival-source"]
    insert_at = len(clean_sections)
    for index, section in enumerate(clean_sections):
        if _n1251_dict(section).get("id") == "n1234-survival-pressure":
            insert_at = index
            break
    clean_sections.insert(insert_at, source_section)
    return clean_sections


def _n1251_attach_source_repair(summary, transcript):
    base = dict(_n1251_dict(summary))
    transcript = _n1251_project_transcript(transcript)
    if not callable(_n1251_build_survival_summary):
        return base
    survival_summary = _n1251_build_survival_summary(transcript)
    source_summary = _n1251_dict(survival_summary.get("source_coverage_summary"))
    gate = _n1251_dict(survival_summary.get("source_gate"))
    if not gate and callable(build_survival_metric_source_gate):
        gate = build_survival_metric_source_gate(source_summary)
    base["survival_pressure_relief_summary"] = survival_summary
    base["real_run_survival_metrics"] = survival_summary
    base["synthetic_survival_balance_simulation"] = base.get("survival_balance_simulation")
    base["survival_pressure_trend_rows"] = _n1251_list(survival_summary.get("trend_rows"))
    base["survival_metric_source_summary"] = source_summary
    base["survival_metric_source_gate"] = gate
    artifacts = dict(_n1251_dict(base.get("artifact_level_summaries")))
    artifacts["survival-pressure-relief-summary.json"] = survival_summary
    artifacts["survival-pressure-trend-rows.json"] = survival_summary.get("trend_rows", [])
    artifacts["survival-metric-source-summary.json"] = source_summary
    artifacts["survival-metric-source-gate.json"] = gate
    base["artifact_level_summaries"] = artifacts
    source_section = {
        "id": "n1251-survival-source",
        "title": "N125.1 Real Survival Metric Source Evidence",
        "html": _n1251_render_source_section(source_summary, gate),
        "source": "survival-metric-source-summary.json",
    }
    base["report_sections"] = _n1251_insert_source_section(base.get("report_sections"), source_section)
    return base


if callable(_N1251_EVAL_PREV):
    def _build_100_turn_evaluation_summary(*args, **kwargs):
        result = _N1251_EVAL_PREV(*args, **kwargs)
        return _n1251_attach_source_repair(result, _n1251_transcript_from_args(args, kwargs))


if callable(_N1251_READY_PREV):
    def _build_100_turn_readiness_summary(*args, **kwargs):
        result = _N1251_READY_PREV(*args, **kwargs)
        enriched = _n1251_attach_source_repair(result, _n1251_transcript_from_args(args, kwargs))
        gate = _n1251_dict(enriched.get("survival_metric_source_gate"))
        gates = dict(_n1251_dict(enriched.get("gates")))
        if gate:
            gates["survival_metric_source_ok"] = bool(gate.get("ok"))
        enriched["gates"] = gates
        advisory = list(_n1251_list(enriched.get("advisory_gates")))
        if gate and "survival_metric_source_ok" not in advisory:
            advisory.append("survival_metric_source_ok")
        enriched["advisory_gates"] = advisory
        return enriched
