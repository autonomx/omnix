# Bundle Z — Release Candidate Artifact Index Dashboard Rendering
#
# Product-facing dashboard for Bundle Y's release-candidate artifact index.
# This fragment reads one-thousand-turn-release-candidate-artifact-index.json,
# writes a compact dashboard summary, and injects a campaign report section with
# the archive digest and tracked artifact table.  It is advisory-only.

import html as _bundle_z_html
import json as _bundle_z_json
from pathlib import Path as _BundleZPath
from typing import Any as _BundleZAny, Dict as _BundleZDict, List as _BundleZList

_BUNDLE_Z_INDEX_FILE = "one-thousand-turn-release-candidate-artifact-index.json"
_BUNDLE_Z_DASHBOARD_FILE = "one-thousand-turn-release-candidate-artifact-index-dashboard-summary.json"


def _bundle_z_safe_html(value: _BundleZAny) -> str:
    return _bundle_z_html.escape("" if value is None else str(value), quote=True)


def _bundle_z_load_json_file(path: _BundleZPath) -> _BundleZDict[str, _BundleZAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_z_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_z_status_label(index: _BundleZDict[str, _BundleZAny]) -> str:
    if index.get("archive_index_ready") is True:
        return "Archive Index Ready"
    if index:
        return "Archive Index Blocked"
    return "Archive Index Missing"


def _bundle_z_status_class(index: _BundleZDict[str, _BundleZAny]) -> str:
    if index.get("archive_index_ready") is True:
        return "pass"
    if index:
        return "warn"
    return "fail"


def _bundle_z_build_dashboard_summary(index: _BundleZDict[str, _BundleZAny]) -> _BundleZDict[str, _BundleZAny]:
    metrics = index.get("metrics") if isinstance(index.get("metrics"), dict) else {}
    tracked = index.get("tracked_files") if isinstance(index.get("tracked_files"), list) else []
    failures = index.get("advisory_failures") if isinstance(index.get("advisory_failures"), list) else []
    tracked_count = int(metrics.get("tracked_file_count") or len(tracked) or 0)
    present_count = int(metrics.get("present_tracked_file_count") or len([entry for entry in tracked if isinstance(entry, dict) and entry.get("present")]) or 0)
    completion_percent = int((present_count / tracked_count) * 100) if tracked_count else 0
    required_missing = index.get("missing_required_archive_artifacts") if isinstance(index.get("missing_required_archive_artifacts"), list) else []
    return {
        "format_version": "bundle_z_release_candidate_artifact_index_dashboard_summary_v1",
        "source": "bundle_z_release_candidate_artifact_index_dashboard",
        "ok": index.get("archive_index_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_z_status_label(index),
        "status_class": _bundle_z_status_class(index),
        "archive_index_ready": index.get("archive_index_ready") is True,
        "archive_digest_sha256": index.get("archive_digest_sha256") or "",
        "tracked_file_count": tracked_count,
        "present_tracked_file_count": present_count,
        "tracked_completion_percent": completion_percent,
        "missing_required_archive_artifact_count": len(required_missing),
        "missing_required_archive_artifacts": list(required_missing),
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "total_present_bytes": int(metrics.get("total_present_bytes") or 0),
        "recommended_next_step": index.get("recommended_next_step") or "write_release_candidate_artifact_index_first",
    }


def _bundle_z_write_dashboard_summary_if_possible(result_dir: _BundleZPath) -> _BundleZDict[str, _BundleZAny]:
    index = _bundle_z_load_json_file(result_dir / _BUNDLE_Z_INDEX_FILE)
    dashboard = _bundle_z_build_dashboard_summary(index)
    if not index:
        dashboard["advisory_failures"] = [_BUNDLE_Z_INDEX_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_release_candidate_artifact_index_first"
    _BUNDLE_Z_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_Z_DASHBOARD_FILE,
        _bundle_z_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_z_artifact_rows(index: _BundleZDict[str, _BundleZAny]) -> str:
    tracked = index.get("tracked_files") if isinstance(index.get("tracked_files"), list) else []
    rows: _BundleZList[str] = []
    for entry in tracked:
        if not isinstance(entry, dict):
            continue
        short_sha = str(entry.get("sha256") or "")[:12]
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_z_safe_html(entry.get('file'))}</th>"
            f"<td>{_bundle_z_safe_html('present' if entry.get('present') else 'missing')}</td>"
            f"<td>{_bundle_z_safe_html('yes' if entry.get('required_for_archive') else 'no')}</td>"
            f"<td>{_bundle_z_safe_html(entry.get('size_bytes', 0))}</td>"
            f"<td><code>{_bundle_z_safe_html(short_sha)}</code></td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">artifact</th><td colspan=\"4\">no tracked artifacts available</td></tr>"


def _bundle_z_render_dashboard_section(result_dir: _BundleZPath) -> str:
    index = _bundle_z_load_json_file(result_dir / _BUNDLE_Z_INDEX_FILE)
    dashboard = _bundle_z_load_json_file(result_dir / _BUNDLE_Z_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_z_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_z_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Archive Index Missing"
    digest = dashboard.get("archive_digest_sha256") or ""
    return (
        '<section id="bundle-z-release-candidate-artifact-index-dashboard" class="bundle-z-release-candidate-artifact-index-dashboard">'
        "<style>"
        ".bundle-z-release-candidate-artifact-index-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-z-release-candidate-artifact-index-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-z-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-z-badge-pass{background:rgba(34,197,94,.16)}.bundle-z-badge-warn{background:rgba(245,158,11,.16)}.bundle-z-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-z-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72);margin-top:12px}"
        ".bundle-z-table{width:100%;border-collapse:collapse;font-size:.9rem}.bundle-z-table th,.bundle-z-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-z-digest,.bundle-z-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header><h2>1000-Turn Artifact Index</h2>"
        f'<span class="bundle-z-badge bundle-z-badge-{_bundle_z_safe_html(status_class)}">{_bundle_z_safe_html(status_label)}</span></header>'
        "<p>Archive integrity digest and tracked artifact index for the release-candidate package.</p>"
        f"<p>Artifacts: {_bundle_z_safe_html(dashboard.get('present_tracked_file_count', 0))}/{_bundle_z_safe_html(dashboard.get('tracked_file_count', 0))} tracked present ({_bundle_z_safe_html(dashboard.get('tracked_completion_percent', 0))}%).</p>"
        f"<p>Recommended next step: {_bundle_z_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-z-card"><h3>Archive Digest</h3>'
        f'<pre class="bundle-z-digest"><code>{_bundle_z_safe_html(digest or "not available")}</code></pre></div>'
        '<div class="bundle-z-card"><h3>Tracked Artifacts</h3><table class="bundle-z-table"><thead><tr><th>Artifact</th><th>Status</th><th>Required</th><th>Bytes</th><th>SHA-256</th></tr></thead><tbody>'
        f"{_bundle_z_artifact_rows(index)}"
        "</tbody></table></div>"
        '<details class="bundle-z-raw-details"><summary>Raw artifact index dashboard JSON</summary>'
        f'<pre class="bundle-z-raw-json">{_bundle_z_safe_html(raw_json)}</pre></details></section>'
    )


def _bundle_z_looks_like_campaign_report(path: _BundleZPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-z-release-candidate-artifact-index-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_z_inject_dashboard_section(path: _BundleZPath, html_text: str) -> str:
    if not _bundle_z_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_z_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_Z_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_Z_ORIGINAL_PATH_WRITE_TEXT = _BundleZPath.write_text

    def _bundle_z_write_text_with_artifact_index_dashboard(self, data, *args, **kwargs):
        path = _BundleZPath(self)
        if isinstance(data, str) and _bundle_z_looks_like_campaign_report(path, data):
            try:
                data = _bundle_z_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle Z dashboard injection skipped: " + _bundle_z_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_Z_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_Z_INDEX_FILE:
                _bundle_z_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _BundleZPath.write_text = _bundle_z_write_text_with_artifact_index_dashboard
    globals()["_BUNDLE_Z_PATH_WRITE_TEXT_PATCHED"] = True
