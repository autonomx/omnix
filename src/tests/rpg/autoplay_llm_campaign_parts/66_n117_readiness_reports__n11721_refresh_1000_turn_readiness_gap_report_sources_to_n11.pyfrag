

def _n11721_refresh_1000_turn_readiness_gap_report_sources(
    summary: Dict[str, Any],
    transcript: List[Dict[str, Any]],
    *,
    requested_turns: int,
) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    if not summary:
        return summary

    readiness = dict(_safe_dict(summary.get("hundred_turn_readiness_summary")))
    previous_gap = _safe_dict(
        summary.get("one_thousand_turn_readiness_gap_report")
        or readiness.get("one_thousand_turn_readiness_gap_report")
    )
    dialogue_summary, dialogue_source = _n11721_dialogue_summary_for_gap_report(summary)

    try:
        refreshed = _n1172_build_1000_turn_readiness_gap_report(
            summary=summary,
            transcript=_safe_list(transcript),
            requested_turns=int(
                requested_turns
                or summary.get("requested_turns")
                or summary.get("turns_executed")
                or len(_safe_list(transcript))
                or 0
            ),
            hundred_turn_readiness=readiness,
            world_state_compression_summary=summary.get("world_state_compression_summary"),
            npc_agency_summary=summary.get("npc_agency_summary"),
            economy_pressure_summary=summary.get("economy_pressure_summary"),
            combat_lifecycle_summary=summary.get("combat_lifecycle_summary"),
            faction_consequence_summary=summary.get("faction_consequence_summary"),
            dialogue_action_relevance_summary=dialogue_summary,
        )
        refreshed = _n11721_add_gap_gate_sources(
            refreshed,
            dialogue_source=dialogue_source,
        )
        consistency = _n11721_build_gap_report_source_consistency(
            previous_gap_report=previous_gap,
            refreshed_gap_report=refreshed,
            dialogue_summary=dialogue_summary,
            dialogue_source=dialogue_source,
        )
        refreshed["source_consistency"] = consistency
        refreshed["format_version"] = "n11721_1000_turn_readiness_gap_report_v2"
        refreshed["refreshed_before_artifact_write"] = True

        summary["one_thousand_turn_readiness_gap_report"] = refreshed
        readiness["one_thousand_turn_readiness_gap_report"] = refreshed
        readiness["one_thousand_turn_candidate"] = bool(refreshed.get("one_thousand_turn_candidate"))
        readiness["one_thousand_turn_blocked_reasons"] = _safe_list(refreshed.get("one_thousand_turn_blocked_reasons"))
        readiness["readiness_grades"] = {
            "hundred_turn_ready": bool(readiness.get("ok")),
            "one_thousand_turn_candidate": bool(refreshed.get("one_thousand_turn_candidate")),
            "one_thousand_turn_blocked_reasons": _safe_list(refreshed.get("one_thousand_turn_blocked_reasons")),
        }
        summary["hundred_turn_readiness_summary"] = readiness
        summary["n11721_readiness_gap_source_consistency"] = consistency
    except Exception as exc:
        summary["n11721_readiness_gap_source_consistency"] = {
            "format_version": "n11721_readiness_gap_source_consistency_v1",
            "ok": False,
            "advisory_only": True,
            "refresh_error": f"{type(exc).__name__}: {exc}",
            "message": "Failed to refresh 1000-turn readiness gap report from final artifact summaries; 100-turn run remains authoritative.",
        }
    return summary

def _n1172_inject_1000_turn_gap_section(html_report: Any, final_summary: Dict[str, Any]) -> str:
    html = _safe_str(html_report)
    section = _n1172_render_1000_turn_gap_section(final_summary)
    if not section or "one-thousand-turn-readiness-gaps" in html:
        return html
    nav_link = '<a href="#one-thousand-turn-readiness-gaps">1000-Turn Readiness</a>'
    if "<nav" in html and nav_link not in html:
        html = html.replace("</nav>", f"{nav_link}</nav>", 1)
    marker = '<section class="card" id="summary">'
    if marker in html:
        return html.replace(marker, section + "\n" + marker, 1)
    body_marker = "</body>"
    if body_marker in html:
        return html.replace(body_marker, section + "\n" + body_marker, 1)
    return html + section

def main(argv: List[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    args = _apply_autoplay_profile_defaults(args)
    _assert_real_autoplay_runner_present()
    if (
        _safe_str(getattr(args, "autoplay_profile", "")) == "smoke_100"
        and int(getattr(args, "turns", 0) or 0) != 100
    ):
        _timestamped_print(
            f"[AUTOPLAY-WARN] smoke_100 profile running with explicit --turns={getattr(args, 'turns', None)}"
        )
    if getattr(args, "list_scenario_seeds", False):
        for name in available_campaign_seeds():
            _timestamped_print(name)
        return 0
    return _run_with_console_capture(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))