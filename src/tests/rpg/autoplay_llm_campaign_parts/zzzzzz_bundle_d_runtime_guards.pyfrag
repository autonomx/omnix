# Bundle D runtime guards.
# Installs narrowly-scoped guards for the 100-turn autoplay artifact finalization:
# - test-result artifact writes create missing parents under resources/data/test-results
# - prompt-only HTML transcript meta marker is treated as a false positive

from tests.rpg.autoplay_runtime_guards import (  # noqa: E402
    enable_html_transcript_prompt_marker_guard as _bundle_d_enable_html_prompt_guard,
    enable_test_result_artifact_write_parent_guard as _bundle_d_enable_write_parent_guard,
)

if _AUTOPLAY_INSTALL_PATH_HOOKS:
    _BUNDLE_D_WRITE_PARENT_GUARD_INSTALLED = _bundle_d_enable_write_parent_guard()
    _BUNDLE_D_HTML_PROMPT_GUARD_INSTALLED = _bundle_d_enable_html_prompt_guard(globals())
else:
    _BUNDLE_D_WRITE_PARENT_GUARD_INSTALLED = False
    _BUNDLE_D_HTML_PROMPT_GUARD_INSTALLED = False
