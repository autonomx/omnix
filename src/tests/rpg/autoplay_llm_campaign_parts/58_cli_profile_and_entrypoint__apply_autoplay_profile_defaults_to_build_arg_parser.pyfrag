    parser.add_argument(
        "--background-result-max-turn-lag",
        type=int,
        default=5,
        help="Warn/fail in strict mode when a background result attaches more than this many turns late.",
    )
    parser.add_argument(
        "--debug-autoplay-stage-timing",
        action="store_true",
        help="Print detailed before/after timing probes around autoplay blocking stages.",
    )
    parser.add_argument("--provider-workers", type=int, default=1)
    parser.add_argument(
        "--campaign-minutes-per-turn",
        type=int,
        default=30,
        help="Deterministic campaign calendar minutes advanced per turn for report/journal metadata.",
    )
    parser.add_argument(
        "--journal-every-turns",
        type=int,
        default=4,
        help="Create a deterministic player-perspective journal entry every N turns.",
    )
    parser.add_argument(
        "--capture-console-log",
        action="store_true",
        default=True,
        help="Capture stdout/stderr into output-dir/console-log.txt and include it in reports/artifacts.",
    )
    parser.add_argument(
        "--no-capture-console-log",
        action="store_false",
        dest="capture_console_log",
        help="Disable stdout/stderr capture.",
    )
    parser.add_argument(
        "--console-log-max-chars",
        type=int,
        default=250000,
        help="Maximum console log characters retained in console-log.txt/report summary.",
    )
    parser.add_argument(
        "--strict-eval-turns",
        type=int,
        default=100,
        help="Turn count at which long-run/100-turn quality gates become strict errors.",
    )
    parser.add_argument(
        "--max-100turn-no-progress-streak",
        type=int,
        default=10,
        help="Maximum no-progress streak allowed in strict 100-turn evaluation.",
    )
    parser.add_argument(
        "--max-100turn-repeat-semantic-target-streak",
        type=int,
        default=8,
        help="Maximum repeated semantic action/target streak allowed in strict 100-turn evaluation.",
    )
    return parser


def _assert_real_autoplay_runner_present() -> None:
    fn = globals().get("_run_autoplay_campaign")
    if not callable(fn):
        raise RuntimeError("real_autoplay_runner_missing:_run_autoplay_campaign")

    code = getattr(fn, "__code__", None)
    if code is None:
        raise RuntimeError("real_autoplay_runner_missing_code:_run_autoplay_campaign")

    # N117.5/N117.6 split the historical monolith across named fragments and
    # moved some artifact-write details into helpers.  inspect.getsource(fn) is
    # now a brittle proxy for runner integrity because it can return only the
    # first fragment-local slice of a function that was compiled from a
    # synthetic combined file.  Validate the loaded runtime shape instead.
    bytecode_size = len(getattr(code, "co_code", b""))
    if bytecode_size < 50_000:
        raise RuntimeError(
            "real_autoplay_runner_too_small:"
            f"bytecode_bytes={bytecode_size}"
        )

    # Do not require local/nested helper names here.  N117.5/N117.6 intentionally
    # split and moved artifact-write logic into smaller fragments and nested
    # helpers, so name-based helper checks can block a valid runner even after
    # bytecode and orchestration references prove the real runtime loaded.
    # Artifact helper coverage is validated by the report artifacts produced by
    # the run, not by this startup guard.

    required_runner_names = (
        "_new_background_result_timing_tracker",
        "_drain_completed_background_jobs_for_transcript",
        "_summarize_background_result_timing",
        "_reconcile_performance_budget_background_llm_counts",
    )
    missing_runner_names = [
        name
        for name in required_runner_names
        if name not in getattr(code, "co_names", ())
    ]
    if missing_runner_names:
        raise RuntimeError(
            "real_autoplay_runner_truncated:"
            f"missing_runner_names:{','.join(missing_runner_names)}"
        )


def _n11764_recover_summary_from_artifact(args: argparse.Namespace) -> Optional[Dict[str, Any]]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    for name in ("autoplay-summary.json", "summary.json"):
        path = output_dir / name
        if not path.exists():
            continue
        try:
            summary = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if isinstance(summary, dict):
            summary.setdefault("n11764_summary_recovered_from_artifact", True)
            return summary
    return None


def _n11764_require_summary(summary: Any, args: argparse.Namespace) -> Dict[str, Any]:
    recovered = summary if isinstance(summary, dict) else _n11764_recover_summary_from_artifact(args)
    if isinstance(recovered, dict):
        return recovered
    raise RuntimeError(
        "autoplay_runner_returned_none:no_summary_artifact:"
        "_run_autoplay_campaign ended before returning a summary and no autoplay-summary.json was found."
    )


def _run_with_console_capture(args: argparse.Namespace) -> int:
    global _ACTIVE_CONSOLE_CAPTURE
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    console_log_path = output_dir / "console-log.txt"
    if not getattr(args, "capture_console_log", True):
        summary = _n11764_require_summary(_run_autoplay_campaign(args), args)
        return 0 if _safe_dict(summary).get("ok") else 1

    with ConsoleCapture(
        output_path=console_log_path,
        max_chars=int(getattr(args, "console_log_max_chars", 250000) or 250000),
    ) as capture:
        _ACTIVE_CONSOLE_CAPTURE = capture
        try:
            summary = _run_autoplay_campaign(args)
            capture.write_file()
        finally:
            _ACTIVE_CONSOLE_CAPTURE = None

    summary = _n11764_require_summary(summary, args)
    if not _safe_dict(summary).get("ok"):
        for error in _safe_list(_safe_dict(summary).get("runtime_errors")):
            _timestamped_print(f"[AUTOPLAY-ERROR] {error}")

    return 0 if _safe_dict(summary).get("ok") else 1
