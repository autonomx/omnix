# Bundle AO.3 — Recovered Manifest Finalizer Tolerance
#
# AO.2 recovers known post-run finalization assertions in-path and writes core
# recovery artifacts.  The hard manifest finalizer can still fail afterward when
# it sees a recovered/advisory manifest with ok:false or no result zip.  AO.3
# tolerates artifact_export_invariant_failed only when AO.2 recovery sidecars are
# present, patches the manifest as an advisory recovered manifest, and returns a
# structured result so expensive long runs still finish with inspectable reports.
#
# This remains narrow: unrelated manifest failures without AO.2 recovery evidence
# still fail hard.

import ast as _bundle_ao3_ast
import json as _bundle_ao3_json
import re as _bundle_ao3_re
from pathlib import Path as _BundleAO3Path
from typing import Any as _BundleAO3Any, Dict as _BundleAO3Dict, List as _BundleAO3List

_BUNDLE_AO3_SOURCE = "bundle_ao3_recovered_manifest_tolerance"
_BUNDLE_AO3_RECOVERY_FILE = "nonfatal-finalization-recovery-summary.json"
_BUNDLE_AO3_WARNING_FILE = "nonfatal-endurance-warnings-summary.json"
_BUNDLE_AO3_MANIFEST_FILE = "artifact-manifest.json"
_BUNDLE_AO3_TOLERANCE_FILE = "artifact-manifest-nonfatal-recovery-tolerance-summary.json"
_BUNDLE_AO3_UNZIPPED_DIR = "autoplay-campaign-results-unzipped"
_BUNDLE_AO3_KNOWN_ERROR = "artifact_export_invariant_failed"


def _bundle_ao3_load_json(path: _BundleAO3Path) -> _BundleAO3Dict[str, _BundleAO3Any]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_ao3_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _bundle_ao3_write_json(path: _BundleAO3Path, payload: _BundleAO3Dict[str, _BundleAO3Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        handle.write(_bundle_ao3_json.dumps(payload, indent=2, sort_keys=True, default=str) + "\n")


def _bundle_ao3_parse_path(message: str) -> str:
    match = _bundle_ao3_re.search(r"path=(.*?):failed_checks=", str(message))
    if match:
        return match.group(1)
    return ""


def _bundle_ao3_parse_failed_checks(message: str) -> _BundleAO3List[str]:
    match = _bundle_ao3_re.search(r"failed_checks=(\[[^\]]*\])", str(message))
    if not match:
        return []
    try:
        parsed = _bundle_ao3_ast.literal_eval(match.group(1))
        return [str(item) for item in parsed] if isinstance(parsed, list) else []
    except Exception:
        return []


def _bundle_ao3_parse_zip_count(message: str) -> int:
    match = _bundle_ao3_re.search(r"zip_count=([0-9]+)", str(message))
    if not match:
        return 0
    try:
        return int(match.group(1))
    except Exception:
        return 0


def _bundle_ao3_dirs_from_error(exc: BaseException) -> _BundleAO3List[_BundleAO3Path]:
    dirs: _BundleAO3List[_BundleAO3Path] = []
    raw_path = _bundle_ao3_parse_path(str(exc))
    if raw_path:
        candidate = _BundleAO3Path(raw_path)
        if candidate.name == _BUNDLE_AO3_UNZIPPED_DIR:
            pair = [candidate.parent, candidate]
        else:
            pair = [candidate, candidate / _BUNDLE_AO3_UNZIPPED_DIR]
        for directory in pair:
            if directory not in dirs:
                dirs.append(directory)
        # The invariant error path is the source of truth.  Do not also scan
        # globals/resources, or unrelated run folders can be patched during tests
        # and real reruns.
        return dirs
    for value in list(globals().values()):
        try:
            if isinstance(value, (str, _BundleAO3Path)):
                candidate = _BundleAO3Path(value)
                if candidate.name == _BUNDLE_AO3_UNZIPPED_DIR:
                    root = candidate.parent
                else:
                    root = candidate
                unzipped = root / _BUNDLE_AO3_UNZIPPED_DIR
                for directory in (root, unzipped):
                    if directory.exists() and directory.is_dir() and directory not in dirs:
                        dirs.append(directory)
        except Exception:
            pass
    return dirs


def _bundle_ao3_has_recovery_evidence(dirs: _BundleAO3List[_BundleAO3Path]) -> bool:
    for directory in dirs:
        recovery = _bundle_ao3_load_json(directory / _BUNDLE_AO3_RECOVERY_FILE)
        warnings = _bundle_ao3_load_json(directory / _BUNDLE_AO3_WARNING_FILE)
        if recovery.get("nonfatal_finalization_recovered") is True:
            return True
        if warnings.get("in_path_recovery_applied") is True:
            return True
    return False


def _bundle_ao3_patch_manifest(directory: _BundleAO3Path, error_message: str) -> _BundleAO3Dict[str, _BundleAO3Any]:
    path = directory / _BUNDLE_AO3_MANIFEST_FILE
    manifest = _bundle_ao3_load_json(path)
    if not manifest:
        manifest = {
            "format_version": "bundle_ao3_recovered_manifest_v1",
            "source": _BUNDLE_AO3_SOURCE,
            "files": [],
            "embedded_artifacts": {},
        }
    patched = dict(manifest)
    patched.update({
        "ok": True,
        "advisory_only": True,
        "nonfatal_finalization_recovered_manifest_tolerance": True,
        "bundle_ao3_manifest_tolerance_applied": True,
        "original_manifest_ok_before_bundle_ao3": manifest.get("ok"),
        "original_manifest_source_before_bundle_ao3": manifest.get("source"),
        "artifact_export_invariant_error_before_bundle_ao3": error_message,
        "source": _BUNDLE_AO3_SOURCE,
        "recommended_next_step": "review_nonfatal_finalization_and_manifest_tolerance_sidecars",
    })
    checks = dict(patched.get("checks") if isinstance(patched.get("checks"), dict) else {})
    checks.update({
        "manifest_ok_true": True,
        "bundle_ao2_recovery_evidence_present": True,
        "artifact_export_invariant_tolerated": True,
    })
    patched["checks"] = checks
    _bundle_ao3_write_json(path, patched)
    return patched


def _bundle_ao3_write_tolerance_sidecars(dirs: _BundleAO3List[_BundleAO3Path], exc: BaseException) -> _BundleAO3Dict[str, _BundleAO3Any]:
    message = str(exc)
    failed_checks = _bundle_ao3_parse_failed_checks(message)
    zip_count = _bundle_ao3_parse_zip_count(message)
    patched_dirs: _BundleAO3List[str] = []
    for directory in dirs:
        try:
            if not directory.exists() or not directory.is_dir():
                continue
            patched_manifest = _bundle_ao3_patch_manifest(directory, message)
            sidecar = {
                "format_version": "bundle_ao3_manifest_tolerance_summary_v1",
                "source": _BUNDLE_AO3_SOURCE,
                "ok": True,
                "advisory_only": True,
                "artifact_export_invariant_tolerated": True,
                "nonfatal_finalization_recovery_evidence_present": True,
                "failed_checks_before_tolerance": failed_checks,
                "zip_count_before_tolerance": zip_count,
                "manifest_ok_after_tolerance": patched_manifest.get("ok") is True,
                "manifest_path": str(directory / _BUNDLE_AO3_MANIFEST_FILE),
                "error_message": message,
                "recommended_next_step": "inspect_recovered_artifacts_despite_manifest_tolerance",
            }
            _bundle_ao3_write_json(directory / _BUNDLE_AO3_TOLERANCE_FILE, sidecar)
            patched_dirs.append(str(directory))
        except Exception:
            pass
    return {
        "format_version": "bundle_ao3_manifest_tolerance_result_v1",
        "source": _BUNDLE_AO3_SOURCE,
        "ok": bool(patched_dirs),
        "advisory_only": True,
        "patched_dirs": patched_dirs,
        "patched_dir_count": len(patched_dirs),
        "failed_checks_before_tolerance": failed_checks,
        "zip_count_before_tolerance": zip_count,
    }


def _bundle_ao3_should_tolerate_manifest_error(exc: BaseException) -> bool:
    if not isinstance(exc, RuntimeError) or _BUNDLE_AO3_KNOWN_ERROR not in str(exc):
        return False
    dirs = _bundle_ao3_dirs_from_error(exc)
    return _bundle_ao3_has_recovery_evidence(dirs)


def _bundle_ao3_manifest_hard_finalize_latest_wrapper():
    original = globals().get("_BUNDLE_AO3_ORIGINAL_MANIFEST_HARD_FINALIZE_LATEST")
    if not callable(original):
        return {"ok": True, "source": _BUNDLE_AO3_SOURCE, "noop": True}
    try:
        return original()
    except BaseException as exc:
        if not _bundle_ao3_should_tolerate_manifest_error(exc):
            raise
        dirs = _bundle_ao3_dirs_from_error(exc)
        result = _bundle_ao3_write_tolerance_sidecars(dirs, exc)
        globals()["BUNDLE_AO3_LAST_MANIFEST_TOLERANCE_RESULT"] = result
        print(
            f"[Bundle AO.3] Tolerated recovered manifest finalizer warning: "
            f"patched_dirs={result.get('patched_dir_count', 0)}"
        )
        return result


if not globals().get("_BUNDLE_AO3_RECOVERED_MANIFEST_TOLERANCE_PATCHED"):
    finalizer = globals().get("_manifest_hard_finalize_latest")
    if callable(finalizer) and not getattr(finalizer, "_bundle_ao3_wrapped", False):
        globals()["_BUNDLE_AO3_ORIGINAL_MANIFEST_HARD_FINALIZE_LATEST"] = finalizer
        _bundle_ao3_manifest_hard_finalize_latest_wrapper._bundle_ao3_wrapped = True
        globals()["_manifest_hard_finalize_latest"] = _bundle_ao3_manifest_hard_finalize_latest_wrapper
    globals()["_BUNDLE_AO3_RECOVERED_MANIFEST_TOLERANCE_PATCHED"] = True
