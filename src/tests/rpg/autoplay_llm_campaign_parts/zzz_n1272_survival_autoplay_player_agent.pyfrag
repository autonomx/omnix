# N127.2 autoplay player agent survival suggestion promotion.
# Loaded after N127.1 so evidence gates can observe the promoted turns.

_N1272_GLOBAL_APPLY_TURN_PREV = globals().get("apply_turn")

from app.rpg.session.service import load_session as _n1272_load_session  # noqa: E402
from app.rpg.session.survival_autoplay_cadence import (  # noqa: E402
    apply_critical_thirst_hard_override as _n12710_apply_critical_thirst_hard_override,
)
from app.rpg.session.survival_autoplay_persistence import (  # noqa: E402
    merge_survival_accumulator_into_session as _n1272_merge_survival_accumulator_into_session,
    persist_result_survival_state as _n1272_persist_result_survival_state,
)
from app.rpg.session.survival_autoplay_player_agent import (  # noqa: E402
    promote_survival_suggestion_for_autoplay as _n1272_promote_survival_suggestion_for_autoplay,
)
from app.rpg.session.survival_autoplay_relief_supplies import (  # noqa: E402
    ensure_survival_autoplay_relief_supplies as _n1276_ensure_survival_autoplay_relief_supplies,
    merge_survival_autoplay_relief_supplies_into_session as _n1277_merge_survival_autoplay_relief_supplies_into_session,
)

_N127101_PROBE_SOURCE = "n127101_critical_thirst_override_runtime_attachment_probe"


def _n1272_dict(value):
    return value if isinstance(value, dict) else {}


def _n1272_str(value):
    return "" if value is None else str(value)


def _n127101_probe(session_id, original_player_input):
    return {
        "format_version": "n127101_runtime_attachment_probe_v1",
        "source": _N127101_PROBE_SOURCE,
        "session_id": _n1272_str(session_id),
        "original_player_input": _n1272_str(original_player_input),
        "wrapper_called": True,
        "previous_apply_turn_called": False,
        "previous_apply_turn_returned": False,
        "promotion_called": False,
        "promotion_promoted": False,
        "promotion_reason": "not_evaluated",
        "persistence_called": False,
        "persistence_applied": False,
        "override_called": False,
        "override_applied": False,
        "override_reason": "not_called",
        "override_action_kind": "",
        "override_blocked_reason": "",
        "turn_contract_attached": False,
        "result_attached": False,
        "runtime_state_attached": False,
    }


def _n127101_attach_probe(result, probe):
    result = _n1272_dict(result)
    probe = dict(_n1272_dict(probe))
    if not probe:
        return result
    probe["result_attached"] = True
    result["survival_autoplay_runtime_probe"] = probe
    result["n12710_critical_thirst_runtime_probe"] = probe

    turn_contract = dict(_n1272_dict(result.get("turn_contract")))
    turn_contract["survival_autoplay_runtime_probe"] = probe
    turn_contract["n12710_critical_thirst_runtime_probe"] = probe
    resource_changes = dict(_n1272_dict(turn_contract.get("resource_changes")))
    resource_changes["survival_autoplay_runtime_probe"] = probe
    turn_contract["resource_changes"] = resource_changes
    effect_result = dict(_n1272_dict(turn_contract.get("effect_result")))
    effect_result["survival_autoplay_runtime_probe"] = probe
    turn_contract["effect_result"] = effect_result
    probe["turn_contract_attached"] = True
    turn_contract["survival_autoplay_runtime_probe"] = probe
    turn_contract["n12710_critical_thirst_runtime_probe"] = probe
    resource_changes["survival_autoplay_runtime_probe"] = probe
    effect_result["survival_autoplay_runtime_probe"] = probe
    result["turn_contract"] = turn_contract

    result_payload = dict(_n1272_dict(result.get("result")))
    if result_payload:
        result_payload["survival_autoplay_runtime_probe"] = probe
        result_payload["n12710_critical_thirst_runtime_probe"] = probe
        payload_contract = dict(_n1272_dict(result_payload.get("turn_contract")))
        if payload_contract:
            payload_contract["survival_autoplay_runtime_probe"] = probe
            payload_contract["n12710_critical_thirst_runtime_probe"] = probe
            result_payload["turn_contract"] = payload_contract
        result["result"] = result_payload

    session = dict(_n1272_dict(result.get("session")))
    if session:
        runtime_state = dict(_n1272_dict(session.get("runtime_state")))
        runtime_state["last_survival_autoplay_runtime_probe"] = probe
        history = list(runtime_state.get("survival_autoplay_runtime_probe_history") or [])
        history.append(probe)
        runtime_state["survival_autoplay_runtime_probe_history"] = history[-64:]
        session["runtime_state"] = runtime_state
        result["session"] = session
        probe["runtime_state_attached"] = True
        result["survival_autoplay_runtime_probe"] = probe
        result["turn_contract"]["survival_autoplay_runtime_probe"] = probe
    return result


def _n1272_attach_promotion(result, promotion):
    result = _n1272_dict(result)
    promotion = _n1272_dict(promotion)
    if not promotion:
        return result
    result["survival_autoplay_promotion"] = promotion
    result["survival_autoplay_player_agent"] = promotion
    turn_contract = dict(_n1272_dict(result.get("turn_contract")))
    if turn_contract:
        turn_contract["survival_autoplay_promotion"] = promotion
        turn_contract["survival_autoplay_player_agent"] = promotion
        result["turn_contract"] = turn_contract
    result_payload = dict(_n1272_dict(result.get("result")))
    if result_payload:
        result_payload["survival_autoplay_promotion"] = promotion
        result_payload["survival_autoplay_player_agent"] = promotion
        result["result"] = result_payload
    session = dict(_n1272_dict(result.get("session")))
    if session:
        runtime_state = dict(_n1272_dict(session.get("runtime_state")))
        history = list(runtime_state.get("survival_autoplay_promotion_history") or [])
        history.append(promotion)
        runtime_state["survival_autoplay_promotion_history"] = history[-32:]
        runtime_state["last_survival_autoplay_promotion"] = promotion
        session["runtime_state"] = runtime_state
        result["session"] = session
    return result


def _n1276_attach_supply_summary(result, supply_summary, *, phase):
    result = _n1272_dict(result)
    summary = dict(_n1272_dict(supply_summary))
    if not summary:
        return result
    summary["phase"] = phase
    result["survival_autoplay_relief_supply_summary"] = summary
    summaries = list(result.get("survival_autoplay_relief_supply_summaries") or [])
    summaries.append(summary)
    result["survival_autoplay_relief_supply_summaries"] = summaries[-8:]
    turn_contract = dict(_n1272_dict(result.get("turn_contract")))
    if turn_contract:
        turn_contract["survival_autoplay_relief_supply_summary"] = summary
        turn_contract["survival_autoplay_relief_supply_summaries"] = summaries[-8:]
        result["turn_contract"] = turn_contract
    session = dict(_n1272_dict(result.get("session")))
    if session:
        runtime_state = dict(_n1272_dict(session.get("runtime_state")))
        runtime_state["last_survival_autoplay_relief_supply_summary"] = summary
        runtime_state["survival_autoplay_relief_supply_summaries"] = summaries[-8:]
        session["runtime_state"] = runtime_state
        result["session"] = session
    return result


def _n1272_apply_turn_wrapper(previous_apply_turn):
    if not callable(previous_apply_turn):
        return previous_apply_turn
    if getattr(previous_apply_turn, "_n1272_survival_autoplay_wrapped", False):
        return previous_apply_turn

    def _wrapped_apply_turn(session_id, player_input, action=None, *, performance_override=None):
        original_player_input = _n1272_str(player_input)
        session_key = _n1272_str(session_id)
        probe = _n127101_probe(session_key, original_player_input)
        promotion = {"promoted": False, "reason": "not_evaluated", "source": "n1272_survival_autoplay_player_agent"}
        promoted_player_input = original_player_input
        prior_session = {}
        pre_turn_supply_summary = {"applied": False, "reason": "not_evaluated", "source": "n1276_survival_hunger_thirst_relief_coverage"}
        handoff_supply_summary = {"applied": False, "reason": "not_evaluated", "source": "n1277_survival_relief_supply_handoff"}
        post_turn_supply_summary = {"applied": False, "reason": "not_evaluated", "source": "n1276_survival_hunger_thirst_relief_coverage"}
        try:
            prior_session = _n1272_load_session(session_id) or {}
            prior_session = _n1272_merge_survival_accumulator_into_session(prior_session, session_key)
            prior_session, pre_turn_supply_summary = _n1276_ensure_survival_autoplay_relief_supplies(
                prior_session,
                session_key=session_key,
            )
            probe["promotion_called"] = True
            promoted_player_input, promotion = _n1272_promote_survival_suggestion_for_autoplay(prior_session, original_player_input)
            probe["promotion_promoted"] = bool(_n1272_dict(promotion).get("promoted"))
            probe["promotion_reason"] = _n1272_str(_n1272_dict(promotion).get("reason"))
            probe["promoted_player_input"] = promoted_player_input
        except Exception as exc:
            promotion = {
                "promoted": False,
                "reason": "promotion_exception",
                "error": repr(exc),
                "source": "n1272_survival_autoplay_player_agent",
            }
            probe["promotion_called"] = True
            probe["promotion_reason"] = "promotion_exception"
            probe["promotion_error"] = repr(exc)
            promoted_player_input = original_player_input

        probe["previous_apply_turn_called"] = True
        if performance_override is None:
            result = previous_apply_turn(session_id, promoted_player_input, action=action)
        else:
            result = previous_apply_turn(
                session_id,
                promoted_player_input,
                action=action,
                performance_override=performance_override,
            )
        probe["previous_apply_turn_returned"] = True
        promotion = dict(_n1272_dict(promotion))
        promotion.setdefault("original_player_input", original_player_input)
        promotion.setdefault("promoted_player_input", promoted_player_input)
        promotion["effective_player_input"] = promoted_player_input
        promotion["input_was_replaced"] = promoted_player_input != original_player_input
        promotion["pre_turn_relief_supply_summary"] = pre_turn_supply_summary
        result = _n1272_attach_promotion(result, promotion)
        session = dict(_n1272_dict(result.get("session")))
        if session:
            try:
                session, handoff_supply_summary = _n1277_merge_survival_autoplay_relief_supplies_into_session(
                    session,
                    prior_session,
                    session_key=session_key,
                )
                session, post_turn_supply_summary = _n1276_ensure_survival_autoplay_relief_supplies(
                    session,
                    session_key=session_key,
                )
                result["session"] = session
            except Exception as exc:
                post_turn_supply_summary = {
                    "applied": False,
                    "reason": "post_turn_supply_exception",
                    "error": repr(exc),
                    "source": "n1276_survival_hunger_thirst_relief_coverage",
                }
                probe["post_turn_supply_error"] = repr(exc)
        result = _n1276_attach_supply_summary(result, pre_turn_supply_summary, phase="pre_turn_selection")
        result = _n1276_attach_supply_summary(result, handoff_supply_summary, phase="runtime_handoff")
        result = _n1276_attach_supply_summary(result, post_turn_supply_summary, phase="post_turn_persistence")
        probe["persistence_called"] = True
        result = _n1272_persist_result_survival_state(
            result,
            save=True,
            prior_session=prior_session,
            accumulator_key=session_key,
        )
        probe["persistence_applied"] = bool(_n1272_dict(result.get("survival_autoplay_persistence")).get("applied"))
        probe["override_called"] = True
        result = _n12710_apply_critical_thirst_hard_override(
            result,
            save=True,
            session_key=session_key,
        )
        override = _n1272_dict(result.get("survival_autoplay_critical_thirst_override"))
        probe["override_applied"] = bool(override.get("applied"))
        probe["override_reason"] = _n1272_str(override.get("reason") or "missing_override_result")
        probe["override_action_kind"] = _n1272_str(override.get("action_kind"))
        probe["override_blocked_reason"] = _n1272_str(override.get("blocked_reason"))
        probe["override_needs_before"] = _n1272_dict(override.get("needs_before") or override.get("needs"))
        probe["override_needs_after"] = _n1272_dict(override.get("needs_after"))
        result = _n127101_attach_probe(result, probe)
        return result

    _wrapped_apply_turn._n1272_survival_autoplay_wrapped = True
    _wrapped_apply_turn._n1272_previous_apply_turn = previous_apply_turn
    return _wrapped_apply_turn


try:
    import app.rpg.session.runtime as _n1272_runtime_module  # noqa: E402
    _n1272_runtime_module.apply_turn = _n1272_apply_turn_wrapper(_n1272_runtime_module.apply_turn)
except Exception:
    _n1272_runtime_module = None

if callable(_N1272_GLOBAL_APPLY_TURN_PREV):
    apply_turn = _n1272_apply_turn_wrapper(_N1272_GLOBAL_APPLY_TURN_PREV)
