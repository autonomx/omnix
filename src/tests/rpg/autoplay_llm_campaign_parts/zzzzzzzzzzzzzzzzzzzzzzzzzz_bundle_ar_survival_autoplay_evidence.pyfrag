# Bundle AR — Survival Autoplay Evidence + Player Need Response
#
# AR makes survival needs actionable for autoplay and keeps readiness evidence
# honest. It injects deterministic survival-pressure actions into advisory/player
# action payloads when thirst, hunger, or fatigue crosses threshold, derives the
# survival-exit-criteria summary from real transcript/action evidence, and clears
# the readiness/report blocker only when drink/eat/rest behavior is observed.

import atexit as _bundle_ar_atexit
import json as _bundle_ar_json
import re as _bundle_ar_re
from pathlib import Path as _BundleARPath
from typing import Any as _BundleARAny, Callable as _BundleARCallable, Dict as _BundleARDict, Iterable as _BundleARIterable, List as _BundleARList, Tuple as _BundleARTuple

_BUNDLE_AR_SOURCE = "bundle_ar_survival_autoplay_evidence"
_BUNDLE_AR_UNZIPPED_DIR = "autoplay-campaign-results-unzipped"
_BUNDLE_AR_SUMMARY_FILE = "survival-exit-criteria-summary.json"
_BUNDLE_AR_REPORT_FILE = "readiness-report-projection-summary.json"
_BUNDLE_AR_HEALTH_FILE = "autoplay-health.json"
_BUNDLE_AR_TRUTH_FILE = "one-thousand-turn-readiness-truth-summary.json"
_BUNDLE_AR_AGGREGATOR_FILE = "one-thousand-turn-readiness-aggregator-summary.json"
_BUNDLE_AR_RECONCILIATION_FILE = "survival-autoplay-evidence-summary.json"
_BUNDLE_AR_TRIGGER_FILES = {
    _BUNDLE_AR_SUMMARY_FILE,
    _BUNDLE_AR_REPORT_FILE,
    _BUNDLE_AR_HEALTH_FILE,
    _BUNDLE_AR_TRUTH_FILE,
    _BUNDLE_AR_AGGREGATOR_FILE,
    "summary.json",
    "transcript.json",
    "manual-transcript.json",
    "autoplay-transcript.json",
    "campaign-transcript.json",
}
_BUNDLE_AR_SURVIVAL_FAILURES = {
    "survival_exit_criteria",
    "survival-exit-criteria",
    "survival_exit_criteria_ok",
    "survival_autoplay_evidence_ok",
    "survival_response_ok",
    "survival_metric_source_ok",
    "drink_water_count_ok",
    "eat_food_count_ok",
    "rest_count_ok",
    "thirst_balance_attention_ok",
}
_BUNDLE_AR_NEED_THRESHOLDS = {"thirst": 0.55, "hunger": 0.55, "fatigue": 0.55}
_BUNDLE_AR_TEXT_PATTERNS = {
    "drink_water": _bundle_ar_re.compile(r"\b(drink|sip|consume|use)\b[^\n\r]{0,40}\b(water|canteen|waterskin|flask)\b|\b(fill|refill)\b[^\n\r]{0,40}\b(water|canteen|waterskin|flask)\b", _bundle_ar_re.I),
    "eat_food": _bundle_ar_re.compile(r"\b(eat|consume|use)\b[^\n\r]{0,40}\b(food|ration|rations|meal|bread|stew|provisions)\b|\bbuy\b[^\n\r]{0,40}\b(ration|rations|food|meal|provisions)\b", _bundle_ar_re.I),
    "rest": _bundle_ar_re.compile(r"\b(rest|sleep|camp|make camp|take a nap|bed down|rent a room|use room|stay the night)\b", _bundle_ar_re.I),
    "buy_water": _bundle_ar_re.compile(r"\bbuy\b[^\n\r]{0,40}\b(water|canteen|waterskin|flask)\b", _bundle_ar_re.I),
    "buy_food": _bundle_ar_re.compile(r"\bbuy\b[^\n\r]{0,40}\b(food|ration|rations|meal|provisions)\b", _bundle_ar_re.I),
}


def _bundle_ar_load_json(path: _BundleARPath) -> _BundleARDict[str, _BundleARAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_ar_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _bundle_ar_write_json(path: _BundleARPath, payload: _BundleARDict[str, _BundleARAny]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        handle.write(_bundle_ar_json.dumps(payload, indent=2, sort_keys=True, default=str) + "\n")


def _bundle_ar_bool(value: _BundleARAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "passed", "pass", "ready"}:
        return True
    if text in {"0", "false", "no", "failed", "fail", "blocked"}:
        return False
    return default


def _bundle_ar_float(value: _BundleARAny, default: float = 0.0) -> float:
    try:
        if isinstance(value, bool) or value is None:
            return default
        text = str(value).strip().lower()
        if text in {"low", "minor", "none"}:
            return 0.0
        if text in {"medium", "moderate"}:
            return 0.5
        if text in {"high", "urgent", "critical", "severe"}:
            return 1.0
        number = float(text)
        if number > 1.0:
            return number / 100.0 if number <= 100.0 else min(number / 10.0, 1.0)
        return max(0.0, min(1.0, number))
    except Exception:
        return default


def _bundle_ar_int(value: _BundleARAny, default: int = 0) -> int:
    try:
        if value is None or isinstance(value, bool):
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_ar_arg_value(argv, name: str, default: str = "") -> str:
    if argv is not None and not isinstance(argv, (list, tuple)):
        attr = name.lstrip("-").replace("-", "_")
        try:
            value = getattr(argv, attr)
        except Exception:
            value = None
        if value is not None:
            return str(value)
    try:
        rows = [str(item) for item in list(argv or [])]
    except Exception:
        rows = []
    for index, item in enumerate(rows):
        if item == name and index + 1 < len(rows):
            return rows[index + 1]
        if item.startswith(name + "="):
            return item.split("=", 1)[1]
    return default


def _bundle_ar_dirs_from_output_dir(output_dir: str) -> _BundleARList[_BundleARPath]:
    if not output_dir:
        return []
    parent = _BundleARPath(output_dir)
    return [directory for directory in (parent, parent / _BUNDLE_AR_UNZIPPED_DIR) if directory.exists() and directory.is_dir()]


def _bundle_ar_parent_from_path(path: _BundleARPath) -> _BundleARPath:
    directory = path if path.is_dir() else path.parent
    return directory.parent if directory.name == _BUNDLE_AR_UNZIPPED_DIR else directory


def _bundle_ar_walk(value: _BundleARAny, max_depth: int = 6) -> _BundleARIterable[_BundleARAny]:
    stack: _BundleARList[_BundleARTuple[_BundleARAny, int]] = [(value, 0)]
    seen = set()
    while stack:
        item, depth = stack.pop()
        marker = id(item)
        if marker in seen:
            continue
        if isinstance(item, (dict, list, tuple, set)):
            seen.add(marker)
        yield item
        if depth >= max_depth:
            continue
        if isinstance(item, dict):
            for child in item.values():
                stack.append((child, depth + 1))
        elif isinstance(item, (list, tuple, set)):
            for child in item:
                stack.append((child, depth + 1))


def _bundle_ar_extract_need_scores(value: _BundleARAny) -> _BundleARDict[str, float]:
    scores: _BundleARDict[str, float] = {"thirst": 0.0, "hunger": 0.0, "fatigue": 0.0}
    inverse_keys = {"hydration": "thirst", "water_balance": "thirst", "satiety": "hunger", "food_balance": "hunger", "rest": "fatigue", "energy": "fatigue"}
    direct_keys = {
        "thirst": "thirst", "thirst_level": "thirst", "dehydration": "thirst", "water_need": "thirst",
        "hunger": "hunger", "hunger_level": "hunger", "starvation": "hunger", "food_need": "hunger",
        "fatigue": "fatigue", "fatigue_level": "fatigue", "exhaustion": "fatigue", "tiredness": "fatigue", "sleep_need": "fatigue",
    }
    for item in _bundle_ar_walk(value):
        if not isinstance(item, dict):
            continue
        for raw_key, raw_value in item.items():
            key = str(raw_key).strip().lower().replace("-", "_")
            if key in direct_keys:
                need = direct_keys[key]
                scores[need] = max(scores[need], _bundle_ar_float(raw_value, 0.0))
            elif key in inverse_keys:
                need = inverse_keys[key]
                scores[need] = max(scores[need], 1.0 - _bundle_ar_float(raw_value, 1.0))
    return scores


def _bundle_ar_extract_inventory(value: _BundleARAny) -> _BundleARDict[str, int]:
    inventory: _BundleARDict[str, int] = {}
    for item in _bundle_ar_walk(value):
        if isinstance(item, dict):
            if isinstance(item.get("items"), list):
                for entry in item.get("items") or []:
                    if isinstance(entry, dict):
                        name = str(entry.get("name") or entry.get("id") or entry.get("item_id") or entry.get("key") or "").lower()
                        qty = _bundle_ar_int(entry.get("qty", entry.get("quantity", entry.get("count", 1))), 1)
                    else:
                        name = str(entry).lower()
                        qty = 1
                    if name:
                        inventory[name] = inventory.get(name, 0) + max(qty, 0)
            for key in ("inventory", "supplies", "resources"):
                nested = item.get(key)
                if isinstance(nested, dict):
                    for raw_name, raw_qty in nested.items():
                        name = str(raw_name).lower()
                        if name:
                            inventory[name] = inventory.get(name, 0) + max(_bundle_ar_int(raw_qty, 1), 0)
    return inventory


def _bundle_ar_inventory_has(inventory: _BundleARDict[str, int], needles: _BundleARIterable[str]) -> bool:
    terms = [str(needle).lower() for needle in needles]
    for name, qty in inventory.items():
        if qty <= 0:
            continue
        lowered = str(name).lower()
        if any(term in lowered for term in terms):
            return True
    return False


def _bundle_ar_survival_pressure_action(*values: _BundleARAny) -> str:
    envelope: _BundleARAny = list(values)
    scores = _bundle_ar_extract_need_scores(envelope)
    inventory = _bundle_ar_extract_inventory(envelope)
    if scores.get("thirst", 0.0) >= _BUNDLE_AR_NEED_THRESHOLDS["thirst"]:
        return "drink water" if _bundle_ar_inventory_has(inventory, ("water", "canteen", "waterskin", "flask")) else "buy water"
    if scores.get("hunger", 0.0) >= _BUNDLE_AR_NEED_THRESHOLDS["hunger"]:
        return "eat rations" if _bundle_ar_inventory_has(inventory, ("ration", "food", "bread", "meal", "provision")) else "buy rations"
    if scores.get("fatigue", 0.0) >= _BUNDLE_AR_NEED_THRESHOLDS["fatigue"]:
        return "rest"
    return ""


def _bundle_ar_action_category(text: str) -> str:
    value = str(text or "")
    if _BUNDLE_AR_TEXT_PATTERNS["drink_water"].search(value):
        return "drink_water"
    if _BUNDLE_AR_TEXT_PATTERNS["eat_food"].search(value):
        return "eat_food"
    if _BUNDLE_AR_TEXT_PATTERNS["rest"].search(value):
        return "rest"
    if _BUNDLE_AR_TEXT_PATTERNS["buy_water"].search(value):
        return "buy_water"
    if _BUNDLE_AR_TEXT_PATTERNS["buy_food"].search(value):
        return "buy_food"
    return ""


def _bundle_ar_action_entry(action: str, reason: str = "survival_need_pressure") -> _BundleARDict[str, _BundleARAny]:
    return {
        "action": action,
        "label": action,
        "source": _BUNDLE_AR_SOURCE,
        "category": _bundle_ar_action_category(action) or "survival",
        "reason": reason,
        "deterministic_authority": "simulation_validates_consumption_and_need_mutation",
    }


def _bundle_ar_action_present(rows: _BundleARAny, action: str) -> bool:
    needle = str(action).strip().lower()
    if not needle:
        return True
    for item in rows if isinstance(rows, list) else []:
        if isinstance(item, dict):
            text = str(item.get("action") or item.get("label") or item.get("name") or item.get("text") or "").strip().lower()
        else:
            text = str(item).strip().lower()
        if text == needle:
            return True
    return False


def _bundle_ar_prepend_action_list(rows: _BundleARAny, action: str) -> _BundleARList[_BundleARAny]:
    existing = list(rows) if isinstance(rows, list) else []
    if not action or _bundle_ar_action_present(existing, action):
        return existing
    return [_bundle_ar_action_entry(action)] + existing


def _bundle_ar_apply_action_pressure(result: _BundleARAny, action: str) -> _BundleARAny:
    if not action:
        return result
    if isinstance(result, dict):
        patched = dict(result)
        for key in ("suggested_actions", "recommended_actions", "recommended_next_actions", "candidate_actions", "action_candidates", "next_actions"):
            if key in patched or key in {"suggested_actions", "recommended_next_actions", "candidate_actions"}:
                patched[key] = _bundle_ar_prepend_action_list(patched.get(key), action)
        survival_pressure = dict(patched.get("survival_pressure") if isinstance(patched.get("survival_pressure"), dict) else {})
        survival_pressure.update({"active": True, "action": action, "source": _BUNDLE_AR_SOURCE})
        patched["survival_pressure"] = survival_pressure
        patched["bundle_ar_survival_pressure_applied"] = True
        return patched
    if isinstance(result, list):
        return _bundle_ar_prepend_action_list(result, action)
    return result


def _bundle_ar_patch_advisory_payload(payload: _BundleARAny) -> _BundleARAny:
    action = _bundle_ar_survival_pressure_action(payload)
    return _bundle_ar_apply_action_pressure(payload, action)


def _bundle_ar_relevant_action_payload_name(path: _BundleARPath) -> bool:
    name = path.name.lower()
    return any(token in name for token in ("action", "advisory", "candidate", "context", "progression", "suggest", "player-agent"))


def _bundle_ar_relevant_evidence_name(path: _BundleARPath) -> bool:
    name = path.name.lower()
    return any(token in name for token in ("transcript", "turn", "campaign", "autoplay", "summary", "health", "journal", "timeline")) and name not in {
        _BUNDLE_AR_SUMMARY_FILE,
        _BUNDLE_AR_REPORT_FILE,
        "artifact-manifest.json",
    }


def _bundle_ar_text_from_node(node: _BundleARAny) -> str:
    fields = ("player_action", "chosen_action", "raw_action", "action", "command", "input", "text", "description", "narration", "summary", "event")
    parts: _BundleARList[str] = []
    if isinstance(node, dict):
        for key in fields:
            value = node.get(key)
            if isinstance(value, str):
                parts.append(value)
            elif isinstance(value, (int, float)):
                parts.append(str(value))
    elif isinstance(node, str):
        parts.append(node)
    return " | ".join(parts)


def _bundle_ar_scan_payload_for_evidence(payload: _BundleARAny, source_file: str) -> _BundleARDict[str, _BundleARAny]:
    counts = {"drink_water_count": 0, "eat_food_count": 0, "rest_count": 0, "buy_water_count": 0, "buy_food_count": 0}
    evidence: _BundleARList[_BundleARDict[str, _BundleARAny]] = []
    metric_sources: _BundleARList[str] = []
    thirst_attention = False
    for node in _bundle_ar_walk(payload, max_depth=8):
        if isinstance(node, dict):
            for key in counts:
                if key in node:
                    counts[key] = max(counts[key], _bundle_ar_int(node.get(key), 0))
                    metric_sources.append(source_file)
            checks = node.get("checks") if isinstance(node.get("checks"), dict) else {}
            if checks.get("thirst_balance_attention_ok") is True or node.get("thirst_balance_attention"):
                thirst_attention = True
            scores = _bundle_ar_extract_need_scores(node)
            if scores.get("thirst", 0.0) >= _BUNDLE_AR_NEED_THRESHOLDS["thirst"]:
                action = _bundle_ar_survival_pressure_action(node)
                if action in {"drink water", "buy water"}:
                    thirst_attention = True
        text = _bundle_ar_text_from_node(node)
        if not text:
            continue
        category = _bundle_ar_action_category(text)
        if not category:
            continue
        key = {
            "drink_water": "drink_water_count",
            "eat_food": "eat_food_count",
            "rest": "rest_count",
            "buy_water": "buy_water_count",
            "buy_food": "buy_food_count",
        }.get(category)
        if key:
            counts[key] += 1
        if category in {"drink_water", "buy_water"}:
            thirst_attention = True
        if len(evidence) < 25:
            evidence.append({"category": category, "source_file": source_file, "text": text[:240]})
            metric_sources.append(source_file)
    return {"counts": counts, "evidence": evidence, "metric_sources": sorted(set(metric_sources)), "thirst_balance_attention": thirst_attention}


def _bundle_ar_merge_evidence(accumulator: _BundleARDict[str, _BundleARAny], addition: _BundleARDict[str, _BundleARAny]) -> None:
    counts = accumulator.setdefault("counts", {"drink_water_count": 0, "eat_food_count": 0, "rest_count": 0, "buy_water_count": 0, "buy_food_count": 0})
    for key, value in (addition.get("counts") or {}).items():
        counts[key] = counts.get(key, 0) + _bundle_ar_int(value, 0)
    accumulator.setdefault("evidence", [])
    accumulator["evidence"].extend((addition.get("evidence") or [])[: max(0, 25 - len(accumulator["evidence"]))])
    sources = set(accumulator.get("metric_sources") or [])
    sources.update(addition.get("metric_sources") or [])
    accumulator["metric_sources"] = sorted(sources)
    accumulator["thirst_balance_attention"] = bool(accumulator.get("thirst_balance_attention") or addition.get("thirst_balance_attention"))


def _bundle_ar_collect_survival_evidence(directory: _BundleARPath) -> _BundleARDict[str, _BundleARAny]:
    accumulator: _BundleARDict[str, _BundleARAny] = {
        "counts": {"drink_water_count": 0, "eat_food_count": 0, "rest_count": 0, "buy_water_count": 0, "buy_food_count": 0},
        "evidence": [],
        "metric_sources": [],
        "thirst_balance_attention": False,
    }
    if not directory.exists() or not directory.is_dir():
        return accumulator
    paths = []
    try:
        paths = [path for path in directory.rglob("*.json") if path.is_file()]
    except Exception:
        paths = []
    for path in paths:
        if not _bundle_ar_relevant_evidence_name(path):
            continue
        try:
            if path.stat().st_size > 4 * 1024 * 1024:
                continue
            payload = _bundle_ar_json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        _bundle_ar_merge_evidence(accumulator, _bundle_ar_scan_payload_for_evidence(payload, path.name))
    return accumulator


def _bundle_ar_patch_survival_summary(directory: _BundleARPath) -> _BundleARDict[str, _BundleARAny]:
    original = _bundle_ar_load_json(directory / _BUNDLE_AR_SUMMARY_FILE)
    collected = _bundle_ar_collect_survival_evidence(directory)
    counts = dict(collected.get("counts") if isinstance(collected.get("counts"), dict) else {})
    for key in ("drink_water_count", "eat_food_count", "rest_count", "buy_water_count", "buy_food_count"):
        counts[key] = max(_bundle_ar_int(counts.get(key), 0), _bundle_ar_int(original.get(key), 0), _bundle_ar_int((original.get("metrics") or {}).get(key) if isinstance(original.get("metrics"), dict) else None, 0))
    drink_ok = counts.get("drink_water_count", 0) > 0
    eat_ok = counts.get("eat_food_count", 0) > 0
    rest_ok = counts.get("rest_count", 0) > 0
    metric_source_ok = bool(collected.get("metric_sources")) or bool(original.get("metric_source") or original.get("evidence_source") or original.get("source_file"))
    thirst_attention_ok = bool(collected.get("thirst_balance_attention") or original.get("thirst_balance_attention") or drink_ok or counts.get("buy_water_count", 0) > 0)
    survival_autoplay_evidence_ok = drink_ok and eat_ok and rest_ok
    survival_response_ok = survival_autoplay_evidence_ok and thirst_attention_ok
    checks = dict(original.get("checks") if isinstance(original.get("checks"), dict) else {})
    checks.update({
        "survival_autoplay_evidence_ok": survival_autoplay_evidence_ok,
        "survival_response_ok": survival_response_ok,
        "survival_metric_source_ok": metric_source_ok,
        "drink_water_count_ok": drink_ok,
        "eat_food_count_ok": eat_ok,
        "rest_count_ok": rest_ok,
        "thirst_balance_attention_ok": thirst_attention_ok,
    })
    failed = [key for key, ok in checks.items() if key in _BUNDLE_AR_SURVIVAL_FAILURES and ok is not True]
    ok = survival_autoplay_evidence_ok and survival_response_ok and metric_source_ok and thirst_attention_ok
    patched = dict(original or {})
    patched.update({
        "format_version": patched.get("format_version", "bundle_ar_survival_exit_criteria_summary_v1"),
        "source": _BUNDLE_AR_SOURCE,
        "ok": ok,
        "advisory_ok": ok,
        "advisory_only": False,
        "bundle_ar_survival_autoplay_evidence": True,
        "drink_water_count": counts.get("drink_water_count", 0),
        "eat_food_count": counts.get("eat_food_count", 0),
        "rest_count": counts.get("rest_count", 0),
        "buy_water_count": counts.get("buy_water_count", 0),
        "buy_food_count": counts.get("buy_food_count", 0),
        "survival_action_count": counts.get("drink_water_count", 0) + counts.get("eat_food_count", 0) + counts.get("rest_count", 0),
        "thirst_balance_attention": thirst_attention_ok,
        "metric_source_files": collected.get("metric_sources", []),
        "evidence": collected.get("evidence", []),
        "checks": checks,
        "failed_checks": failed,
        "recommended_next_step": "survival_exit_criteria_passed" if ok else "make_autoplay_perform_real_drink_eat_rest_turns",
    })
    _bundle_ar_write_json(directory / _BUNDLE_AR_SUMMARY_FILE, patched)
    return patched


def _bundle_ar_patch_report(directory: _BundleARPath, survival: _BundleARDict[str, _BundleARAny]) -> _BundleARDict[str, _BundleARAny]:
    report = _bundle_ar_load_json(directory / _BUNDLE_AR_REPORT_FILE)
    if not report:
        return {}
    survival_ok = survival.get("ok") is True
    sections = []
    for section in report.get("sections", []) if isinstance(report.get("sections"), list) else []:
        item = dict(section) if isinstance(section, dict) else {}
        sid = str(item.get("id") or item.get("section_id") or item.get("name") or "")
        if sid == "survival-exit-criteria":
            item.update({
                "ok": survival_ok,
                "artifact_ok": survival_ok,
                "advisory_ok": survival_ok,
                "advisory_only": False,
                "manifest_embedded": True,
                "bundle_ar_survival_autoplay_evidence": True,
                "bundle_aq_real_remaining_gameplay_blocker": not survival_ok,
                "summary": {
                    "ok": survival_ok,
                    "drink_water_count": survival.get("drink_water_count"),
                    "eat_food_count": survival.get("eat_food_count"),
                    "rest_count": survival.get("rest_count"),
                    "thirst_balance_attention": survival.get("thirst_balance_attention"),
                    "source": _BUNDLE_AR_SUMMARY_FILE,
                },
            })
        sections.append(item)
    failed_section_ids = [str(section.get("id") or section.get("section_id") or section.get("name") or "") for section in sections if not section.get("ok")]
    failed = [str(item) for item in report.get("failed_checks", [])] if isinstance(report.get("failed_checks"), list) else []
    if survival_ok:
        failed = [item for item in failed if item not in _BUNDLE_AR_SURVIVAL_FAILURES and item != "all_report_sections_ok"]
    else:
        if "survival-exit-criteria" not in failed:
            failed.append("survival-exit-criteria")
    if failed_section_ids and "all_report_sections_ok" not in failed:
        failed.append("all_report_sections_ok")
    if not failed_section_ids:
        failed = [item for item in failed if item != "all_report_sections_ok"]
    checks = dict(report.get("checks") if isinstance(report.get("checks"), dict) else {})
    survival_checks = survival.get("checks") if isinstance(survival.get("checks"), dict) else {}
    checks.update({
        "survival_exit_criteria_ok": survival_ok,
        "survival_autoplay_evidence_ok": survival_checks.get("survival_autoplay_evidence_ok", survival_ok),
        "survival_response_ok": survival_checks.get("survival_response_ok", survival_ok),
        "survival_metric_source_ok": survival_checks.get("survival_metric_source_ok", survival_ok),
        "all_report_sections_ok": len(failed_section_ids) == 0,
    })
    remaining_real = [item for item in (report.get("remaining_real_gameplay_blockers") or []) if str(item) != "survival-exit-criteria"] if isinstance(report.get("remaining_real_gameplay_blockers"), list) else []
    if not survival_ok and "survival-exit-criteria" not in remaining_real:
        remaining_real.append("survival-exit-criteria")
    patched = dict(report)
    patched.update({
        "source": _BUNDLE_AR_SOURCE,
        "bundle_ar_survival_autoplay_evidence": True,
        "sections": sections,
        "checks": checks,
        "failed_checks": failed,
        "failed_section_ids": failed_section_ids,
        "remaining_real_gameplay_blockers": remaining_real,
        "advisory_ok": len([item for item in failed if item not in _BUNDLE_AR_SURVIVAL_FAILURES and item != "all_report_sections_ok"]) == 0,
        "ok": len(failed) == 0,
        "recommended_next_step": "review_live_1000_promotion_gates" if survival_ok else "fix_survival_exit_criteria",
    })
    _bundle_ar_write_json(directory / _BUNDLE_AR_REPORT_FILE, patched)
    return patched


def _bundle_ar_patch_health(directory: _BundleARPath, survival: _BundleARDict[str, _BundleARAny], report: _BundleARDict[str, _BundleARAny]) -> _BundleARDict[str, _BundleARAny]:
    health = _bundle_ar_load_json(directory / _BUNDLE_AR_HEALTH_FILE)
    if not health:
        health = {"format_version": "bundle_ar_autoplay_health_survival_patch_v1"}
    patched = dict(health)
    survival_ok = survival.get("ok") is True
    survival_checks = survival.get("checks") if isinstance(survival.get("checks"), dict) else {}
    patched.update({
        "source": _BUNDLE_AR_SOURCE,
        "bundle_ar_survival_autoplay_evidence": True,
        "survival_exit_criteria_ok": survival_ok,
        "survival_autoplay_evidence_ok": survival_checks.get("survival_autoplay_evidence_ok", survival_ok),
        "survival_response_ok": survival_checks.get("survival_response_ok", survival_ok),
        "survival_metric_source_ok": survival_checks.get("survival_metric_source_ok", survival_ok),
        "drink_water_count": survival.get("drink_water_count", 0),
        "eat_food_count": survival.get("eat_food_count", 0),
        "rest_count": survival.get("rest_count", 0),
        "thirst_balance_attention": survival.get("thirst_balance_attention"),
        "remaining_real_gameplay_blockers": report.get("remaining_real_gameplay_blockers", []) if report else ([] if survival_ok else ["survival-exit-criteria"]),
    })
    _bundle_ar_write_json(directory / _BUNDLE_AR_HEALTH_FILE, patched)
    return patched


def _bundle_ar_patch_gate_file(directory: _BundleARPath, filename: str, survival: _BundleARDict[str, _BundleARAny]) -> _BundleARDict[str, _BundleARAny]:
    payload = _bundle_ar_load_json(directory / filename)
    if not payload:
        return {}
    survival_ok = survival.get("ok") is True
    checks = dict(payload.get("checks") if isinstance(payload.get("checks"), dict) else {})
    checks["survival_exit_criteria_ok"] = survival_ok
    blockers_key = "truth_blocking_gates" if filename == _BUNDLE_AR_TRUTH_FILE else "failed_checks"
    blockers = [str(item) for item in payload.get(blockers_key, [])] if isinstance(payload.get(blockers_key), list) else []
    if survival_ok:
        blockers = [item for item in blockers if item not in _BUNDLE_AR_SURVIVAL_FAILURES]
    elif "survival_exit_criteria_ok" not in blockers:
        blockers.append("survival_exit_criteria_ok")
    patched = dict(payload)
    patched.update({"source": _BUNDLE_AR_SOURCE, "bundle_ar_survival_autoplay_evidence": True, "checks": checks, blockers_key: blockers})
    if filename == _BUNDLE_AR_TRUTH_FILE:
        patched["ok"] = len(blockers) == 0
    _bundle_ar_write_json(directory / filename, patched)
    return patched


def _bundle_ar_reconcile_dir(directory: _BundleARPath) -> _BundleARDict[str, _BundleARAny]:
    survival = _bundle_ar_patch_survival_summary(directory)
    report = _bundle_ar_patch_report(directory, survival)
    health = _bundle_ar_patch_health(directory, survival, report)
    truth = _bundle_ar_patch_gate_file(directory, _BUNDLE_AR_TRUTH_FILE, survival)
    aggregator = _bundle_ar_patch_gate_file(directory, _BUNDLE_AR_AGGREGATOR_FILE, survival)
    result = {
        "format_version": "bundle_ar_survival_autoplay_evidence_result_v1",
        "source": _BUNDLE_AR_SOURCE,
        "ok": survival.get("ok") is True,
        "advisory_only": False,
        "result_dir": str(directory),
        "survival_exit_criteria_ok": survival.get("ok") is True,
        "drink_water_count": survival.get("drink_water_count", 0),
        "eat_food_count": survival.get("eat_food_count", 0),
        "rest_count": survival.get("rest_count", 0),
        "thirst_balance_attention": survival.get("thirst_balance_attention"),
        "metric_source_files": survival.get("metric_source_files", []),
        "readiness_report_patched": bool(report),
        "health_patched": bool(health),
        "truth_patched": bool(truth),
        "aggregator_patched": bool(aggregator),
        "recommended_next_step": "survival_exit_criteria_passed" if survival.get("ok") is True else "rerun_with_survival_pressure_actions",
    }
    _bundle_ar_write_json(directory / _BUNDLE_AR_RECONCILIATION_FILE, result)
    return result


def _bundle_ar_finalize_output_dir(output_dir: str) -> _BundleARDict[str, _BundleARAny]:
    dirs = _bundle_ar_dirs_from_output_dir(output_dir)
    results: _BundleARDict[str, _BundleARAny] = {}
    for directory in dirs:
        results[str(directory)] = _bundle_ar_reconcile_dir(directory)
    summary = {
        "format_version": "bundle_ar_survival_autoplay_evidence_summary_v1",
        "source": _BUNDLE_AR_SOURCE,
        "ok": all(bool(item.get("ok")) for item in results.values()) if results else False,
        "advisory_only": False,
        "output_dir": output_dir,
        "result_count": len(results),
        "results": results,
        "recommended_next_step": "proceed_to_bundle_as_inventory_integration" if results and all(bool(item.get("ok")) for item in results.values()) else "rerun_250_with_survival_pressure_enabled",
    }
    for directory in dirs:
        _bundle_ar_write_json(directory / _BUNDLE_AR_RECONCILIATION_FILE, summary)
    return summary


def _bundle_ar_should_wrap_callable_name(name: str) -> bool:
    lowered = str(name).lower()
    if "bundle_ar" in lowered or lowered.startswith("_bundle_"):
        return False
    return any(token in lowered for token in (
        "player_agent", "choose_action", "select_action", "decide_action", "next_action", "suggested_action",
        "candidate_action", "action_context", "advisory", "goal_pressure", "progression_graph",
    ))


def _bundle_ar_force_choice_name(name: str) -> bool:
    lowered = str(name).lower()
    return any(token in lowered for token in ("choose_action", "select_action", "decide_action", "next_action", "player_agent"))


def _bundle_ar_wrap_callable(name: str, fn: _BundleARCallable[..., _BundleARAny]) -> _BundleARCallable[..., _BundleARAny]:
    if getattr(fn, "_bundle_ar_wrapped", False):
        return fn
    def _bundle_ar_callable_wrapper(*args, **kwargs):
        action = _bundle_ar_survival_pressure_action(args, kwargs)
        result = fn(*args, **kwargs)
        if not action:
            return result
        if _bundle_ar_force_choice_name(name):
            if isinstance(result, str):
                return action
            if isinstance(result, dict):
                patched = dict(_bundle_ar_apply_action_pressure(result, action))
                for key in ("action", "chosen_action", "player_action", "command"):
                    if key in patched:
                        patched["bundle_ar_survival_override_original_action"] = patched.get(key)
                        patched[key] = action
                        break
                return patched
        return _bundle_ar_apply_action_pressure(result, action)
    _bundle_ar_callable_wrapper._bundle_ar_wrapped = True
    _bundle_ar_callable_wrapper._bundle_ar_original = fn
    return _bundle_ar_callable_wrapper


def _bundle_ar_install_runtime_action_pressure() -> int:
    patched = 0
    for name, value in list(globals().items()):
        if not callable(value) or not _bundle_ar_should_wrap_callable_name(name):
            continue
        try:
            globals()[name] = _bundle_ar_wrap_callable(name, value)
            patched += 1
        except Exception:
            continue
    globals()["BUNDLE_AR_SURVIVAL_PRESSURE_WRAPPED_CALLABLES"] = patched
    return patched


def _bundle_ar_record_argv(argv=None) -> None:
    output_dir = _bundle_ar_arg_value(argv, "--output-dir", "")
    if output_dir:
        globals()["BUNDLE_AR_LAST_OUTPUT_DIR"] = output_dir


def _bundle_ar_atexit_run() -> None:
    output_dir = globals().get("BUNDLE_AR_LAST_OUTPUT_DIR")
    if not output_dir:
        return
    try:
        globals()["BUNDLE_AR_ATEXIT_RESULT"] = _bundle_ar_finalize_output_dir(str(output_dir))
    except Exception:
        pass


def _bundle_ar_main_wrapper(argv=None):
    _bundle_ar_record_argv(argv)
    original = globals().get("_BUNDLE_AR_ORIGINAL_MAIN")
    if not callable(original):
        _bundle_ar_atexit_run()
        return 0
    try:
        result = original(argv)
    finally:
        _bundle_ar_atexit_run()
    return result


def _bundle_ar_write_text_wrapper(self, data, *args, **kwargs):
    path = _BundleARPath(self)
    text = data
    try:
        if isinstance(data, str) and path.suffix.lower() == ".json" and _bundle_ar_relevant_action_payload_name(path):
            payload = _bundle_ar_json.loads(data)
            patched = _bundle_ar_patch_advisory_payload(payload)
            if patched is not payload and patched != payload:
                text = _bundle_ar_json.dumps(patched, indent=2, sort_keys=True, default=str) + "\n"
    except Exception:
        text = data
    result = _BUNDLE_AR_ORIGINAL_PATH_WRITE_TEXT(self, text, *args, **kwargs)
    try:
        if path.name in _BUNDLE_AR_TRIGGER_FILES or path.name.lower().endswith("summary.json") or _bundle_ar_relevant_evidence_name(path):
            parent = _bundle_ar_parent_from_path(path)
            _bundle_ar_finalize_output_dir(str(parent))
    except Exception:
        pass
    return result


if not globals().get("_BUNDLE_AR_SURVIVAL_AUTOPLAY_EVIDENCE_PATCHED"):
    _BUNDLE_AR_ORIGINAL_PATH_WRITE_TEXT = _BundleARPath.write_text
    _BundleARPath.write_text = _bundle_ar_write_text_wrapper
    _bundle_ar_install_runtime_action_pressure()
    main_fn = globals().get("main")
    if callable(main_fn) and not getattr(main_fn, "_bundle_ar_wrapped", False):
        globals()["_BUNDLE_AR_ORIGINAL_MAIN"] = main_fn
        _bundle_ar_main_wrapper._bundle_ar_wrapped = True
        globals()["main"] = _bundle_ar_main_wrapper
    _bundle_ar_atexit.register(_bundle_ar_atexit_run)
    globals()["_BUNDLE_AR_SURVIVAL_AUTOPLAY_EVIDENCE_PATCHED"] = True
