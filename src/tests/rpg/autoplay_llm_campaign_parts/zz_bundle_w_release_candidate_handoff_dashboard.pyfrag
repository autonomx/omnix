# Bundle W — Release Candidate Handoff Dashboard Rendering
#
# Product-facing dashboard for Bundle V's release-candidate handoff manifest.
# This fragment reads one-thousand-turn-release-candidate-handoff-manifest.json,
# writes a compact handoff dashboard summary, and injects a campaign report
# section with artifact checklist and command copy blocks.  It is advisory-only.

import html as _bundle_w_html
import json as _bundle_w_json
from pathlib import Path as _BundleWPath
from typing import Any as _BundleWAny, Dict as _BundleWDict, List as _BundleWList

_BUNDLE_W_HANDOFF_FILE = "one-thousand-turn-release-candidate-handoff-manifest.json"
_BUNDLE_W_DASHBOARD_FILE = "one-thousand-turn-release-candidate-handoff-dashboard-summary.json"


def _bundle_w_safe_html(value: _BundleWAny) -> str:
    return _bundle_w_html.escape("" if value is None else str(value), quote=True)


def _bundle_w_load_json_file(path: _BundleWPath) -> _BundleWDict[str, _BundleWAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_w_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_w_status_label(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    if handoff.get("release_candidate_handoff_ready") is True:
        return "Handoff Ready"
    if handoff:
        return "Handoff Blocked"
    return "Handoff Missing"


def _bundle_w_status_class(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    if handoff.get("release_candidate_handoff_ready") is True:
        return "pass"
    if handoff:
        return "warn"
    return "fail"


def _bundle_w_build_dashboard_summary(handoff: _BundleWDict[str, _BundleWAny]) -> _BundleWDict[str, _BundleWAny]:
    checklist = handoff.get("artifact_checklist") if isinstance(handoff.get("artifact_checklist"), dict) else {}
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    failures = handoff.get("advisory_failures") if isinstance(handoff.get("advisory_failures"), list) else []
    required_count = int(checklist.get("required_file_count") or 0)
    present_count = int(checklist.get("present_required_file_count") or 0)
    completion_percent = int((present_count / required_count) * 100) if required_count else 0
    return {
        "format_version": "bundle_w_release_candidate_handoff_dashboard_summary_v1",
        "source": "bundle_w_release_candidate_handoff_dashboard",
        "ok": handoff.get("release_candidate_handoff_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_w_status_label(handoff),
        "status_class": _bundle_w_status_class(handoff),
        "release_candidate_handoff_ready": handoff.get("release_candidate_handoff_ready") is True,
        "required_file_count": required_count,
        "present_required_file_count": present_count,
        "missing_required_file_count": len(checklist.get("missing_required") or []),
        "artifact_completion_percent": completion_percent,
        "command_count": len(commands),
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "recommended_next_step": handoff.get("recommended_next_step") or "write_release_candidate_handoff_manifest_first",
    }


def _bundle_w_write_dashboard_summary_if_possible(result_dir: _BundleWPath) -> _BundleWDict[str, _BundleWAny]:
    handoff = _bundle_w_load_json_file(result_dir / _BUNDLE_W_HANDOFF_FILE)
    dashboard = _bundle_w_build_dashboard_summary(handoff)
    if not handoff:
        dashboard["advisory_failures"] = [_BUNDLE_W_HANDOFF_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_release_candidate_handoff_manifest_first"
    _BUNDLE_W_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_W_DASHBOARD_FILE,
        _bundle_w_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_w_artifact_rows(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    checklist = handoff.get("artifact_checklist") if isinstance(handoff.get("artifact_checklist"), dict) else {}
    rows: _BundleWList[str] = []
    for group_name in ("required", "optional_product"):
        entries = checklist.get(group_name) if isinstance(checklist.get(group_name), list) else []
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            rows.append(
                "<tr>"
                f"<th scope=\"row\">{_bundle_w_safe_html(entry.get('file'))}</th>"
                f"<td>{_bundle_w_safe_html(group_name)}</td>"
                f"<td>{_bundle_w_safe_html('present' if entry.get('present') else 'missing')}</td>"
                f"<td>{_bundle_w_safe_html(entry.get('size_bytes', 0))}</td>"
                "</tr>"
            )
    return "".join(rows) or "<tr><th scope=\"row\">artifact</th><td colspan=\"3\">no artifact checklist available</td></tr>"


def _bundle_w_command_blocks(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    blocks: _BundleWList[str] = []
    for name, payload in commands.items():
        if not isinstance(payload, dict):
            continue
        blocks.append(
            '<div class="bundle-w-command">'
            f"<h4>{_bundle_w_safe_html(name)}</h4>"
            f"<pre><code>{_bundle_w_safe_html(payload.get('text'))}</code></pre>"
            "</div>"
        )
    return "".join(blocks) or '<div class="bundle-w-command"><h4>commands</h4><pre><code>no commands available</code></pre></div>'


def _bundle_w_render_dashboard_section(result_dir: _BundleWPath) -> str:
    handoff = _bundle_w_load_json_file(result_dir / _BUNDLE_W_HANDOFF_FILE)
    dashboard = _bundle_w_load_json_file(result_dir / _BUNDLE_W_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_w_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_w_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Handoff Missing"
    return (
        '<section id="bundle-w-release-candidate-handoff-dashboard" class="bundle-w-release-candidate-handoff-dashboard">'
        "<style>"
        ".bundle-w-release-candidate-handoff-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-w-release-candidate-handoff-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-w-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-w-badge-pass{background:rgba(34,197,94,.16)}.bundle-w-badge-warn{background:rgba(245,158,11,.16)}.bundle-w-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-w-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}"
        ".bundle-w-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72)}"
        ".bundle-w-table{width:100%;border-collapse:collapse;font-size:.9rem}.bundle-w-table th,.bundle-w-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-w-command pre,.bundle-w-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header><h2>1000-Turn Release Candidate Handoff</h2>"
        f'<span class="bundle-w-badge bundle-w-badge-{_bundle_w_safe_html(status_class)}">{_bundle_w_safe_html(status_label)}</span></header>'
        "<p>Final artifact checklist and copy-ready commands for the 1000-turn readiness pipeline.</p>"
        f"<p>Artifacts: {_bundle_w_safe_html(dashboard.get('present_required_file_count', 0))}/{_bundle_w_safe_html(dashboard.get('required_file_count', 0))} required present ({_bundle_w_safe_html(dashboard.get('artifact_completion_percent', 0))}%).</p>"
        f"<p>Recommended next step: {_bundle_w_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-w-grid">'
        '<div class="bundle-w-card"><h3>Artifact Checklist</h3><table class="bundle-w-table"><thead><tr><th>Artifact</th><th>Group</th><th>Status</th><th>Bytes</th></tr></thead><tbody>'
        f"{_bundle_w_artifact_rows(handoff)}"
        "</tbody></table></div>"
        '<div class="bundle-w-card"><h3>Commands</h3>'
        f"{_bundle_w_command_blocks(handoff)}"
        "</div></div>"
        '<details class="bundle-w-raw-details"><summary>Raw handoff dashboard JSON</summary>'
        f'<pre class="bundle-w-raw-json">{_bundle_w_safe_html(raw_json)}</pre></details></section>'
    )


def _bundle_w_looks_like_campaign_report(path: _BundleWPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-w-release-candidate-handoff-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_w_inject_dashboard_section(path: _BundleWPath, html_text: str) -> str:
    if not _bundle_w_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_w_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_W_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_W_ORIGINAL_PATH_WRITE_TEXT = _BundleWPath.write_text

    def _bundle_w_write_text_with_release_handoff_dashboard(self, data, *args, **kwargs):
        path = _BundleWPath(self)
        if isinstance(data, str) and _bundle_w_looks_like_campaign_report(path, data):
            try:
                data = _bundle_w_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle W dashboard injection skipped: " + _bundle_w_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_W_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_W_HANDOFF_FILE:
                _bundle_w_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _BundleWPath.write_text = _bundle_w_write_text_with_release_handoff_dashboard
    globals()["_BUNDLE_W_PATH_WRITE_TEXT_PATCHED"] = True
