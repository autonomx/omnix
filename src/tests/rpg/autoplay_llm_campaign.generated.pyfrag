    return parser


def _assert_real_autoplay_runner_present() -> None:
    fn = globals().get("_run_autoplay_campaign")
    if not callable(fn):
        raise RuntimeError("real_autoplay_runner_missing:_run_autoplay_campaign")

    code = getattr(fn, "__code__", None)
    if code is None:
        raise RuntimeError("real_autoplay_runner_missing_code:_run_autoplay_campaign")

    # N117.5/N117.6 split the historical monolith across named fragments and
    # moved some artifact-write details into helpers.  inspect.getsource(fn) is
    # now a brittle proxy for runner integrity because it can return only the
    # first fragment-local slice of a function that was compiled from a
    # synthetic combined file.  Validate the loaded runtime shape instead.
    bytecode_size = len(getattr(code, "co_code", b""))
    if bytecode_size < 50_000:
        raise RuntimeError(
            "real_autoplay_runner_too_small:"
            f"bytecode_bytes={bytecode_size}"
        )

    # Do not require local/nested helper names here.  N117.5/N117.6 intentionally
    # split and moved artifact-write logic into smaller fragments and nested
    # helpers, so name-based helper checks can block a valid runner even after
    # bytecode and orchestration references prove the real runtime loaded.
    # Artifact helper coverage is validated by the report artifacts produced by
    # the run, not by this startup guard.

    required_runner_names = (
        "_new_background_result_timing_tracker",
        "_drain_completed_background_jobs_for_transcript",
        "_summarize_background_result_timing",
        "_reconcile_performance_budget_background_llm_counts",
    )
    missing_runner_names = [
        name
        for name in required_runner_names
        if name not in getattr(code, "co_names", ())
    ]
    if missing_runner_names:
        raise RuntimeError(
            "real_autoplay_runner_truncated:"
            f"missing_runner_names:{','.join(missing_runner_names)}"
        )


def _n11764_recover_summary_from_artifact(args: argparse.Namespace) -> Optional[Dict[str, Any]]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    for name in ("autoplay-summary.json", "summary.json"):
        path = output_dir / name
        if not path.exists():
            continue
        try:
            summary = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if isinstance(summary, dict):
            summary.setdefault("n11764_summary_recovered_from_artifact", True)
            return summary
    return None


def _n11764_require_summary(summary: Any, args: argparse.Namespace) -> Dict[str, Any]:
    recovered = summary if isinstance(summary, dict) else _n11764_recover_summary_from_artifact(args)
    if isinstance(recovered, dict):
        return recovered
    raise RuntimeError(
        "autoplay_runner_returned_none:no_summary_artifact:"
        "_run_autoplay_campaign ended before returning a summary and no autoplay-summary.json was found."
    )


def _run_with_console_capture(args: argparse.Namespace) -> int:
    global _ACTIVE_CONSOLE_CAPTURE
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    console_log_path = output_dir / "console-log.txt"
    if not getattr(args, "capture_console_log", True):
        summary = _n11764_require_summary(_run_autoplay_campaign(args), args)
        return 0 if _safe_dict(summary).get("ok") else 1

    with ConsoleCapture(
        output_path=console_log_path,
        max_chars=int(getattr(args, "console_log_max_chars", 250000) or 250000),
    ) as capture:
        _ACTIVE_CONSOLE_CAPTURE = capture
        try:
            summary = _run_autoplay_campaign(args)
            capture.write_file()
        finally:
            _ACTIVE_CONSOLE_CAPTURE = None

    summary = _n11764_require_summary(summary, args)
    if not _safe_dict(summary).get("ok"):
        for error in _safe_list(_safe_dict(summary).get("runtime_errors")):
            _timestamped_print(f"[AUTOPLAY-ERROR] {error}")

    return 0 if _safe_dict(summary).get("ok") else 1
"""Apply autoplay background-LLM skip policy to pipeline class methods.

The campaign loader historically wrapped free functions whose names contained
``submit_combined_background``. The real runner calls the method on
``AutoplayBackgroundPipeline`` instead, so CI skip mode did not prevent local
provider retries. This late fragment replaces the loader hook with a class-aware
wrapper while preserving the existing ``auto`` behavior.
"""


def _wrap_combined_background_llm_submit_functions(namespace: Dict[str, object]) -> None:
    pipeline_cls = namespace.get("AutoplayBackgroundPipeline")
    if not isinstance(pipeline_cls, type):
        return

    original = getattr(pipeline_cls, "submit_combined_background_llm", None)
    if not callable(original):
        return
    if getattr(original, "_autoplay_skip_redundant_background_wrapped", False):
        return

    def _wrapped(self, *args, __fn=original, **kwargs):
        mode = _combined_background_skip_mode()
        if mode == "all" or (
            mode == "auto"
            and _should_skip_combined_background_llm(args, kwargs)
        ):
            print(
                "[AUTOPLAY-PROBE] "
                "event=submit_combined_background_llm.skipped "
                f"reason={'background_llm_disabled' if mode == 'all' else 'foreground_llm_called'}"
            )
            return ""
        return __fn(self, *args, **kwargs)

    _wrapped._autoplay_skip_redundant_background_wrapped = True
    setattr(pipeline_cls, "submit_combined_background_llm", _wrapped)



# N116.17 — Root Service Resolver Veto Integration
# Keep this block above main(); it monkey-patches artifact-row normalization so
# false service/economy matches are removed before transcript/report artifacts
# are persisted.  This is a veto only: it does not force investigation/evidence
# classification and it keeps the original bad resolver output for diagnostics.

_N11617_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS = _sync_current_action_response_artifact_rows
_N11617_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11617_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11617_DOCUMENT_EVIDENCE_TERMS = (
    "sealed order", "sealed orders", "captured order", "captured orders",
    "written order", "written orders", "route paper", "route papers",
    "captured route paper", "captured route papers", "ledger", "ledger entries",
    "manifest", "manifest marks", "payment mark", "payment marks",
    "marked coin", "marked coin proof", "coin proof", "route cipher",
    "coded message", "coded messages", "toll marker", "toll markers",
    "courier route", "paymaster", "backer", "backers", "funded", "funding",
    "proof", "evidence", "documents", "papers",
)
_N11617_EXPLICIT_SERVICE_OR_COMMERCE_TERMS = (
    "buy", "purchase", "pay for", "pay bran for", "pay the innkeeper for",
    "rent a room", "rent room", "book a room", "book room", "order ale",
    "order a drink", "order food", "order a meal", "buy ale", "buy food",
    "buy meal", "sell", "trade", "hire", "lodging", "sleep here", "rest here",
)
_N11617_SERVICE_ACTION_VALUES = {
    "service", "service_inquiry", "commerce", "economy", "drink_inquiry",
    "drink", "purchase", "purchase_inquiry", "lodging", "room", "rest_service",
}
_N11617_SERVICE_STATUSES = {
    "offers_available", "available", "service_available", "matched", "purchase_available",
}


def _n11617_norm_text(value: Any) -> str:
    return _normalize_turn_action_text(value) if callable(globals().get("_normalize_turn_action_text")) else _safe_str(value).lower()


def _n11617_row_action_text(row: Dict[str, Any]) -> str:
    row = _safe_dict(row)
    return _n11617_norm_text(
        " ".join(
            _safe_str(row.get(key))
            for key in (
                "display_player_action", "visible_player_action", "canonical_turn_action",
                "actual_sent_action", "player_action", "resolver_input_action",
                "selected_player_action", "original_player_action",
            )
            if _safe_str(row.get(key))
        )
    )


def _n11617_is_document_evidence_without_explicit_service(action_text: str) -> bool:
    action = _n11617_norm_text(action_text)
    if not action:
        return False
    if not any(term in action for term in _N11617_DOCUMENT_EVIDENCE_TERMS):
        return False
    if any(term in action for term in _N11617_EXPLICIT_SERVICE_OR_COMMERCE_TERMS):
        return False
    return True


def _n11617_service_result_looks_false_positive(service_result: Dict[str, Any]) -> bool:
    service_result = _safe_dict(service_result)
    if not service_result:
        return False
    status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
    kind = _safe_str(service_result.get("service_kind") or service_result.get("kind") or service_result.get("item_kind")).lower()
    return bool(
        service_result.get("matched")
        or service_result.get("service")
        or service_result.get("purchase")
        or service_result.get("sale")
        or status in _N11617_SERVICE_STATUSES
        or kind in _N11617_SERVICE_ACTION_VALUES
        or _safe_list(service_result.get("offers"))
        or _safe_list(service_result.get("items"))
    )


def _n11617_semantic_action_looks_service(value: Dict[str, Any]) -> bool:
    semantic = _safe_dict(value)
    if not semantic:
        return False
    fields = (
        semantic.get("action_type"), semantic.get("semantic_family"),
        semantic.get("activity_label"), semantic.get("intent"), semantic.get("kind"),
        semantic.get("category"), semantic.get("family"), semantic.get("label"),
    )
    normalized = {_safe_str(item).strip().lower() for item in fields if _safe_str(item)}
    return bool(normalized & _N11617_SERVICE_ACTION_VALUES)


def _n11617_veto_service_result(value: Dict[str, Any], *, action_text: str) -> Dict[str, Any]:
    service_result = _safe_dict(value)
    if not _n11617_service_result_looks_false_positive(service_result):
        return service_result
    return {
        "matched": False,
        "service": False,
        "purchase": False,
        "sale": False,
        "status": "service_false_positive_vetoed",
        "reason": "document_evidence_without_explicit_service_request",
        "service_kind": "",
        "offers": [],
        "items": [],
        "original_service_result": deepcopy(service_result),
        "veto_policy": "n11617_service_resolver_veto_only",
        "action_text": _safe_str(action_text)[:500],
    }


def _n11617_veto_semantic_action(value: Dict[str, Any], *, action_text: str) -> Dict[str, Any]:
    semantic = _safe_dict(value)
    if not _n11617_semantic_action_looks_service(semantic):
        return semantic
    repaired = dict(semantic)
    repaired["original_semantic_action"] = deepcopy(semantic)
    repaired["service_false_positive_vetoed"] = True
    repaired["veto_policy"] = "n11617_service_resolver_veto_only"
    repaired["veto_reason"] = "document_evidence_without_explicit_service_request"
    # Negative guard only: remove impossible service/economy labels, but do not
    # replace them with investigation/evidence.  The LLM still classifies
    # presentation intent from the cleaned contract.
    for key in ("action_type", "semantic_family", "activity_label", "intent", "kind", "category", "family", "label"):
        if _safe_str(repaired.get(key)).strip().lower() in _N11617_SERVICE_ACTION_VALUES:
            repaired[key] = "service_false_positive_vetoed"
    repaired["llm_classifies_presentation_intent"] = True
    repaired["action_text"] = _safe_str(action_text)[:500]
    return repaired


def _n11617_scrub_container(container: Dict[str, Any], *, action_text: str) -> bool:
    container = _safe_dict(container)
    if not container:
        return False
    changed = False
    if isinstance(container.get("service_result"), dict):
        original = _safe_dict(container.get("service_result"))
        scrubbed = _n11617_veto_service_result(original, action_text=action_text)
        if scrubbed is not original and scrubbed != original:
            container["service_result"] = scrubbed
            changed = True
    for key in ("semantic_action", "semantic_action_v2"):
        if isinstance(container.get(key), dict):
            original_semantic = _safe_dict(container.get(key))
            scrubbed_semantic = _n11617_veto_semantic_action(original_semantic, action_text=action_text)
            if scrubbed_semantic != original_semantic:
                container[key] = scrubbed_semantic
                changed = True
    nested_contract = container.get("turn_contract")
    if isinstance(nested_contract, dict):
        changed = _n11617_scrub_container(nested_contract, action_text=action_text) or changed
    return changed


def _n11617_apply_root_service_veto_to_row(row: Dict[str, Any]) -> Dict[str, Any]:
    row = _safe_dict(row)
    action_text = _n11617_row_action_text(row)
    if not _n11617_is_document_evidence_without_explicit_service(action_text):
        return row
    changed = False
    changed = _n11617_scrub_container(row, action_text=action_text) or changed
    for key in ("turn_contract", "turn_result", "result", "raw_result", "manual_turn_summary"):
        if isinstance(row.get(key), dict):
            changed = _n11617_scrub_container(row[key], action_text=action_text) or changed
    if changed:
        row["service_false_positive_vetoed"] = True
        row["service_resolver_veto"] = {
            "format_version": "n11617_service_resolver_veto_v1",
            "service_false_positive_vetoed": True,
            "reason": "document_evidence_without_explicit_service_request",
            "veto_only": True,
            "forced_positive_classification": False,
            "llm_classifies_presentation_intent": True,
            "action_text": action_text[:500],
        }
    return row


def _sync_current_action_response_artifact_rows(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    synced = _N11617_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS(rows)
    out: List[Dict[str, Any]] = []
    for row in synced if isinstance(synced, list) else []:
        out.append(_n11617_apply_root_service_veto_to_row(row))
    return out


def _n11617_service_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    vetoed: List[Dict[str, Any]] = []
    remaining: List[Dict[str, Any]] = []
    for row in rows:
        turn_index = int(row.get("turn_index") or row.get("turn") or 0)
        action_text = _n11617_row_action_text(row)
        if not _n11617_is_document_evidence_without_explicit_service(action_text):
            continue
        if row.get("service_false_positive_vetoed") or _safe_dict(row.get("service_resolver_veto")).get("service_false_positive_vetoed"):
            vetoed.append({"turn_index": turn_index, "player_action": row.get("player_action"), "reason": "service_false_positive_vetoed"})
        offenders: List[str] = []
        for container_name in ("row", "turn_contract", "turn_result"):
            container = row if container_name == "row" else _safe_dict(row.get(container_name))
            service_result = _safe_dict(container.get("service_result"))
            semantic = _safe_dict(container.get("semantic_action")) or _safe_dict(container.get("semantic_action_v2"))
            status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
            if (
                _n11617_service_result_looks_false_positive(service_result)
                and status != "service_false_positive_vetoed"
            ):
                offenders.append(f"{container_name}.service_result")
            if _n11617_semantic_action_looks_service(semantic):
                offenders.append(f"{container_name}.semantic_action")
        if offenders:
            remaining.append({
                "turn_index": turn_index,
                "player_action": row.get("player_action"),
                "offenders": offenders,
            })
    return {
        "format_version": "n11617_service_veto_regression_summary_v1",
        "ok": not remaining,
        "vetoed_count": len(vetoed),
        "remaining_violation_count": len(remaining),
        "vetoed_turns": vetoed[:50],
        "remaining_violations": remaining[:50],
        "policy": "veto_only_no_forced_investigation_classification",
    }


def _n11617_repair_pressure_breakdown(rows: List[Dict[str, Any]], base_summary: Dict[str, Any]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    base_summary = _safe_dict(base_summary)
    service_veto = _n11617_service_veto_regression_summary(rows)
    metadata_repaired = sum(1 for row in rows if _safe_dict(row.get("background_presentation_result")).get("metadata_repaired") or row.get("background_metadata_repaired"))
    category_reclassified = sum(1 for row in rows if row.get("category_reclassified") or row.get("validated_presentation_category") != row.get("llm_presentation_category") and row.get("llm_presentation_category"))
    dialogue_repaired = sum(1 for row in rows if row.get("dialogue_action_relevance_repaired"))
    return {
        "format_version": "n11617_repair_pressure_breakdown_v1",
        "metadata_repaired_count": metadata_repaired,
        "category_reclassified_count": category_reclassified,
        "dialogue_relevance_repaired_count": dialogue_repaired,
        "service_resolver_veto_count": int(service_veto.get("vetoed_count") or 0),
        "dominant_sources": {
            "provider_metadata_or_shape_repair": metadata_repaired,
            "provider_category_reclassification": category_reclassified,
            "dialogue_action_relevance_repair": dialogue_repaired,
            "service_resolver_veto": int(service_veto.get("vetoed_count") or 0),
        },
        "note": "Counts are diagnostic repair pressure, not additional authoritative simulation outcomes.",
    }


def _build_llm_prompt_and_fallback_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _N11617_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY(rows)
    service_summary = _n11617_service_veto_regression_summary(rows)
    summary["service_resolver_veto_summary"] = service_summary
    summary["repair_pressure_breakdown"] = _n11617_repair_pressure_breakdown(rows, summary)
    summary["ok"] = bool(summary.get("ok", True)) and bool(service_summary.get("ok", True))
    if not service_summary.get("ok", True):
        failures = _safe_list(summary.get("failed_gates"))
        if "service_resolver_veto_regression_ok" not in failures:
            failures.append("service_resolver_veto_regression_ok")
        summary["failed_gates"] = failures
    return summary


def _force_final_autoplay_health(summary: Dict[str, Any]) -> Dict[str, Any]:
    health = _N11617_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH(summary)
    service_summary = _safe_dict(
        _safe_dict(summary.get("llm_prompt_and_fallback_summary")).get("service_resolver_veto_summary")
    )
    if service_summary and not bool(service_summary.get("ok", True)):
        health = dict(health)
        health["ok"] = False
        health["service_resolver_veto_regression_ok"] = False
        warnings = _safe_list(health.get("warnings"))
        if "service_resolver_veto_regression_failed" not in warnings:
            warnings.append("service_resolver_veto_regression_failed")
        health["warnings"] = warnings
        health["failed_gate_count"] = int(health.get("failed_gate_count") or 0) + 1
    return health



# N116.18 — Prompt Contract Veto Sync + Repair Breakdown Fix
# This block builds on N116.17.  N116.17 removed false service/economy
# mechanics from top-level persisted rows; N116.18 applies the same veto
# recursively to nested prompt/debug contracts so those artifacts cannot keep
# stale service/drink instructions after the row itself is cleaned.  This is
# still veto-only: it never forces a positive investigation/evidence label.

_N11618_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS = _sync_current_action_response_artifact_rows
_N11618_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11618_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11618_SERVICE_FOCUS_ITEMS = {
    "purchase_acknowledgement",
    "item_quantity_or_availability",
    "price_or_payment",
    "service_request_acknowledgement",
    "lodging_or_rest_terms",
    "acknowledge_the_service_or_economy_request_first",
    "mention_item_quantity_price_or_refusal_only_if_present_in_contract",
    "mention_price_or_payment",
    "service_or_economy_request",
    "commerce_or_service_terms",
}
_N11618_VETO_GUIDANCE_ITEMS = (
    "do_not_treat_document_order_words_as_shop_or_drink_orders",
    "llm_classifies_presentation_intent",
    "deterministic_code_only_vetoes_impossible_service_or_economy",
)
_N11618_SKIP_DEEP_KEYS = {
    "original_service_result",
    "original_semantic_action",
    "n11615_original_semantic_action",
}
_N11618_PROMPT_CONTRACT_KEYS = {
    "llm_prompt_contract",
    "current_turn_prompt_contract",
    "prompt_contract",
    "current_action_response",
    "npc_response_architecture",
}


def _n11618_normalized_focus_item(value: Any) -> str:
    return _safe_str(value).strip().lower().replace("-", "_").replace(" ", "_")


def _n11618_focus_is_service_or_economy(value: Any) -> bool:
    text = _n11618_normalized_focus_item(value)
    if not text:
        return False
    return bool(
        text in _N11618_SERVICE_FOCUS_ITEMS
        or "purchase" in text
        or "price" in text
        or "payment" in text
        or "lodging" in text
        or "service_or_economy" in text
        or "drink" in text
    )


def _n11618_repair_focus_list(value: Any) -> tuple[List[Any], bool]:
    values = value if isinstance(value, list) else []
    repaired: List[Any] = []
    changed = False
    for item in values:
        if _n11618_focus_is_service_or_economy(item):
            changed = True
            continue
        if item not in repaired:
            repaired.append(item)
    for item in _N11618_VETO_GUIDANCE_ITEMS:
        if item not in repaired:
            repaired.append(item)
            changed = True
    return repaired[:12], changed


def _n11618_apply_veto_policy(container: Dict[str, Any], *, action_text: str) -> bool:
    container = _safe_dict(container)
    if not container:
        return False
    changed = False
    policy = _safe_dict(container.get("classification_policy"))
    desired_policy = {
        "llm_classifies_presentation_intent": True,
        "deterministic_code_only_vetoes_impossible_service_or_economy": True,
        "service_economy_categories_blocked_without_authoritative_contract_support": True,
        "veto_only_no_forced_positive_classification": True,
        "reason": "document_evidence_without_explicit_service_request",
    }
    for key, value in desired_policy.items():
        if policy.get(key) != value:
            policy[key] = value
            changed = True
    container["classification_policy"] = policy
    veto = _safe_dict(container.get("service_resolver_veto"))
    veto_update = {
        "format_version": "n11618_prompt_contract_veto_sync_v1",
        "service_false_positive_vetoed": True,
        "reason": "document_evidence_without_explicit_service_request",
        "veto_only": True,
        "forced_positive_classification": False,
        "llm_classifies_presentation_intent": True,
        "action_text": _safe_str(action_text)[:500],
    }
    for key, value in veto_update.items():
        if veto.get(key) != value:
            veto[key] = value
            changed = True
    container["service_resolver_veto"] = veto
    return changed
"""Allow deterministic autoplay runs to skip unavailable foreground providers.

The manual autoplay entry point intentionally requests a semantic advisory before
runtime resolution. CI has no LM Studio service, so the provider attempt can only
fail and produce an empty advisory. This opt-in bridge returns that same empty
advisory immediately while leaving normal/manual runs unchanged.
"""


def _autoplay_foreground_llm_skip_enabled() -> bool:
    raw = str(os.environ.get("RPG_AUTOPLAY_SKIP_FOREGROUND_LLM", "auto") or "auto")
    mode = raw.strip().casefold()
    if mode in {"0", "false", "no", "off", "disabled"}:
        return False
    if mode in {"1", "true", "yes", "on", "all", "always"}:
        return True
    test_mode = str(os.environ.get("RPG_TEST_MODE", "") or "").strip().casefold()
    background_mode = str(
        os.environ.get("RPG_AUTOPLAY_SKIP_COMBINED_BACKGROUND_LLM", "") or ""
    ).strip().casefold()
    return test_mode == "deterministic" and background_mode in {
        "1",
        "true",
        "yes",
        "on",
        "all",
        "always",
    }


def _install_autoplay_foreground_llm_skip(runtime_module: object | None = None) -> bool:
    if not _autoplay_foreground_llm_skip_enabled():
        return False

    if runtime_module is None:
        try:
            from app.rpg.session import interactive_first_call_runtime as runtime_module
        except Exception:
            return False

    original = getattr(runtime_module, "get_semantic_action_advisory", None)
    if not callable(original):
        return False
    if getattr(original, "_autoplay_foreground_llm_skip_wrapped", False):
        return True

    def _skip_semantic_advisory(*args, **kwargs):
        print(
            "[AUTOPLAY-PROBE] "
            "event=foreground_semantic_llm.skipped "
            "reason=deterministic_ci_provider_unavailable"
        )
        return {}

    _skip_semantic_advisory._autoplay_foreground_llm_skip_wrapped = True
    setattr(runtime_module, "get_semantic_action_advisory", _skip_semantic_advisory)
    return True


_install_autoplay_foreground_llm_skip()


def _n11618_deep_prompt_veto(
    value: Any,
    *,
    action_text: str,
    path: tuple[str, ...] = (),
    _seen: set[int] | None = None,
    _depth: int = 0,
    _max_depth: int = 24,
) -> bool:
    """Bounded recursive scrub for prompt/debug artifacts.

    N116.18 originally walked the entire final transcript row. Some autoplay
    rows contain shared/cyclic diagnostic/runtime objects, so an unbounded walk
    can recurse forever during final artifact sync. Keep the veto deep enough for
    prompt contracts, but make it cycle-safe and depth-limited.
    """
    if _depth > _max_depth:
        return False
    if _seen is None:
        _seen = set()
    if isinstance(value, (dict, list)):
        marker = id(value)
        if marker in _seen:
            return False
        _seen.add(marker)

    changed = False
    if isinstance(value, dict):
        if isinstance(value.get("service_result"), dict):
            original_service = _safe_dict(value.get("service_result"))
            scrubbed_service = _n11617_veto_service_result(original_service, action_text=action_text)
            if scrubbed_service != original_service:
                value["service_result"] = scrubbed_service
                changed = True
        for key in ("semantic_action", "semantic_action_v2"):
            if isinstance(value.get(key), dict):
                original_semantic = _safe_dict(value.get(key))
                scrubbed_semantic = _n11617_veto_semantic_action(original_semantic, action_text=action_text)
                if scrubbed_semantic != original_semantic:
                    value[key] = scrubbed_semantic
                    changed = True
        for focus_key in (
            "required_focus",
            "required_response_focus",
            "focus",
            "must_address",
            "required_response_focuses",
        ):
            if isinstance(value.get(focus_key), list):
                repaired_focus, focus_changed = _n11618_repair_focus_list(value.get(focus_key))
                if focus_changed:
                    value[focus_key] = repaired_focus
                    changed = True
        if (
            path
            and (path[-1] in _N11618_PROMPT_CONTRACT_KEYS or any("prompt_contract" in part for part in path))
        ) or any(key in value for key in ("required_focus", "semantic_action", "current_action_response")):
            changed = _n11618_apply_veto_policy(value, action_text=action_text) or changed

        for key, child in list(value.items()):
            if key in _N11618_SKIP_DEEP_KEYS:
                continue
            if key in {
                "runtime_state",
                "session",
                "turn_result",
                "transcript",
                "full_transcript",
                "debug_tail",
                "history",
                "event_log",
                "console_log",
            }:
                continue
            if isinstance(child, (dict, list)):
                changed = _n11618_deep_prompt_veto(
                    child,
                    action_text=action_text,
                    path=path + (str(key),),
                    _seen=_seen,
                    _depth=_depth + 1,
                    _max_depth=_max_depth,
                ) or changed
    elif isinstance(value, list):
        for idx, item in enumerate(value[:200]):
            if isinstance(item, (dict, list)):
                changed = _n11618_deep_prompt_veto(
                    item,
                    action_text=action_text,
                    path=path + (str(idx),),
                    _seen=_seen,
                    _depth=_depth + 1,
                    _max_depth=_max_depth,
                ) or changed
    return changed


def _n11618_prompt_sync_targets(row: Dict[str, Any]) -> List[tuple[tuple[str, ...], Any]]:
    """Return prompt-related objects to veto-sync without walking the whole row."""
    row = _safe_dict(row)
    targets: List[tuple[tuple[str, ...], Any]] = []

    def add(path: tuple[str, ...], value: Any) -> None:
        if isinstance(value, (dict, list)):
            targets.append((path, value))

    for key in (
        "llm_prompt_contract",
        "current_turn_prompt_contract",
        "current_action_response",
        "npc_response_architecture",
        "background_presentation_result",
    ):
        add((key,), row.get(key))

    prompt_debug = _safe_dict(row.get("llm_prompt_debug") or row.get("prompt_debug"))
    add(("llm_prompt_debug",), prompt_debug)
    add(("llm_prompt_debug", "current_turn_prompt_contract"), prompt_debug.get("current_turn_prompt_contract"))
    add(("llm_prompt_debug", "prompt_contract"), prompt_debug.get("prompt_contract"))

    background = _safe_dict(row.get("background_presentation_result"))
    add(("background_presentation_result", "current_turn_prompt_contract"), background.get("current_turn_prompt_contract"))
    add(("background_presentation_result", "prompt_debug"), background.get("prompt_debug"))
    add(("background_presentation_result", "current_action_response"), background.get("current_action_response"))
    add(("background_presentation_result", "npc_response_architecture"), background.get("npc_response_architecture"))

    # Include top-level semantic/service payloads only; do not traverse runtime
    # snapshots or result/session graphs here.
    add(("semantic_action",), row.get("semantic_action"))
    add(("semantic_action_v2",), row.get("semantic_action_v2"))
    add(("service_result",), row.get("service_result"))
    return targets


def _n11618_sync_prompt_contract_veto_to_row(row: Dict[str, Any]) -> Dict[str, Any]:
    row = _safe_dict(row)
    action_text = _n11617_row_action_text(row)
    if not _n11617_is_document_evidence_without_explicit_service(action_text):
        return row

    changed = False
    seen_targets: set[int] = set()
    for target_path, target in _n11618_prompt_sync_targets(row):
        if isinstance(target, (dict, list)):
            marker = id(target)
            if marker in seen_targets:
                continue
            seen_targets.add(marker)
            changed = _n11618_deep_prompt_veto(
                target,
                action_text=action_text,
                path=("row",) + target_path,
            ) or changed

    if changed:
        row["service_false_positive_vetoed"] = True
        row["prompt_contract_service_veto_synced"] = True
        row["service_resolver_veto"] = {
            **_safe_dict(row.get("service_resolver_veto")),
            "format_version": "n11618_prompt_contract_veto_sync_v1",
            "service_false_positive_vetoed": True,
            "reason": "document_evidence_without_explicit_service_request",
            "veto_only": True,
            "forced_positive_classification": False,
            "llm_classifies_presentation_intent": True,
            "prompt_contract_veto_synced": True,
            "action_text": action_text[:500],
        }
    return row


def _sync_current_action_response_artifact_rows(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    synced = _N11618_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS(rows)
    if not isinstance(synced, list):
        return synced
    return [_n11618_sync_prompt_contract_veto_to_row(row) for row in synced]


def _n11618_walk_prompt_offenders(
    value: Any,
    *,
    path: tuple[str, ...] = (),
    _seen: set[int] | None = None,
    _depth: int = 0,
    _max_depth: int = 24,
) -> List[str]:
    """Cycle-safe nested prompt-contract offender scan."""
    if _depth > _max_depth:
        return []
    if _seen is None:
        _seen = set()
    if isinstance(value, (dict, list)):
        marker = id(value)
        if marker in _seen:
            return []
        _seen.add(marker)

    offenders: List[str] = []
    if isinstance(value, dict):
        service_result = _safe_dict(value.get("service_result"))
        status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
        if service_result and _n11617_service_result_looks_false_positive(service_result) and status != "service_false_positive_vetoed":
            offenders.append(".".join(path + ("service_result",)))
        for key in ("semantic_action", "semantic_action_v2"):
            semantic = _safe_dict(value.get(key))
            if semantic and _n11617_semantic_action_looks_service(semantic):
                offenders.append(".".join(path + (key,)))
        for focus_key in (
            "required_focus",
            "required_response_focus",
            "focus",
            "must_address",
            "required_response_focuses",
        ):
            focus = value.get(focus_key)
            if isinstance(focus, list):
                bad_focus = [item for item in focus if _n11618_focus_is_service_or_economy(item)]
                if bad_focus:
                    offenders.append(".".join(path + (focus_key,)) + ":" + ",".join(_safe_str(item) for item in bad_focus[:6]))
        for key, child in value.items():
            if key in _N11618_SKIP_DEEP_KEYS:
                continue
            if key in {
                "runtime_state",
                "session",
                "turn_result",
                "transcript",
                "full_transcript",
                "debug_tail",
                "history",
                "event_log",
                "console_log",
            }:
                continue
            if isinstance(child, (dict, list)):
                offenders.extend(
                    _n11618_walk_prompt_offenders(
                        child,
                        path=path + (str(key),),
                        _seen=_seen,
                        _depth=_depth + 1,
                        _max_depth=_max_depth,
                    )
                )
    elif isinstance(value, list):
        for idx, item in enumerate(value[:200]):
            if isinstance(item, (dict, list)):
                offenders.extend(
                    _n11618_walk_prompt_offenders(
                        item,
                        path=path + (str(idx),),
                        _seen=_seen,
                        _depth=_depth + 1,
                        _max_depth=_max_depth,
                    )
                )
    return offenders


def _n11618_prompt_contract_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    violations: List[Dict[str, Any]] = []
    synced: List[Dict[str, Any]] = []
    for row in rows:
        turn_index = int(row.get("turn_index") or row.get("turn") or 0)
        action_text = _n11617_row_action_text(row)
        if not _n11617_is_document_evidence_without_explicit_service(action_text):
            continue
        if row.get("prompt_contract_service_veto_synced"):
            synced.append({"turn_index": turn_index, "player_action": row.get("player_action")})
        offenders = _n11618_walk_prompt_offenders(row, path=("row",))
        if offenders:
            violations.append(
                {
                    "turn_index": turn_index,
                    "player_action": row.get("player_action"),
                    "offenders": offenders[:25],
                }
            )
    return {
        "format_version": "n11618_prompt_contract_veto_regression_summary_v1",
        "ok": not violations,
        "synced_count": len(synced),
        "remaining_violation_count": len(violations),
        "synced_turns": synced[:50],
        "remaining_violations": violations[:50],
        "policy": "veto_only_no_forced_investigation_classification_llm_keeps_intent_classification",
    }


def _n11618_attachment_repair_counts_from_summary(summary: Dict[str, Any]) -> Dict[str, int]:
    summary = _safe_dict(summary)
    attachment = (
        _safe_dict(summary.get("background_presentation_attachment_summary"))
        or _safe_dict(summary.get("background_attachment_summary"))
        or _safe_dict(summary.get("background_result_timing_summary"))
    )
    def as_int(*keys: str) -> int:
        for key in keys:
            value = attachment.get(key)
            if value is None:
                continue
            try:
                return int(value or 0)
            except Exception:
                continue
        return 0
    return {
        "metadata_repaired_count": as_int("metadata_repaired_count", "metadata_repair_count"),
        "category_reclassified_count": as_int("category_reclassified_count", "category_reclassification_count"),
        "metadata_repair_source_count": as_int("metadata_repaired_count", "metadata_repair_count"),
        "category_reclassification_source_count": as_int("category_reclassified_count", "category_reclassification_count"),
    }


def _n11618_merge_repair_pressure_counts(
    breakdown: Dict[str, Any],
    *,
    attachment_counts: Dict[str, int],
) -> Dict[str, Any]:
    breakdown = dict(_safe_dict(breakdown))
    metadata_count = max(
        int(breakdown.get("metadata_repaired_count") or 0),
        int(attachment_counts.get("metadata_repaired_count") or 0),
    )
    category_count = max(
        int(breakdown.get("category_reclassified_count") or 0),
        int(attachment_counts.get("category_reclassified_count") or 0),
    )
    breakdown["metadata_repaired_count"] = metadata_count
    breakdown["category_reclassified_count"] = category_count
    breakdown["metadata_repair_count_source"] = "background_presentation_attachment_summary"
    breakdown["category_reclassified_count_source"] = "background_presentation_attachment_summary"
    dominant = dict(_safe_dict(breakdown.get("dominant_sources")))
    dominant["provider_metadata_or_shape_repair"] = metadata_count
    dominant["provider_category_reclassification"] = category_count
    breakdown["dominant_sources"] = dominant
    breakdown["format_version"] = "n11618_repair_pressure_breakdown_v2"
    return breakdown


def _build_llm_prompt_and_fallback_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _N11618_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY(rows)
    prompt_contract_summary = _n11618_prompt_contract_veto_regression_summary(rows)
    summary["prompt_contract_service_veto_summary"] = prompt_contract_summary
    if "service_resolver_veto_summary" in summary:
        service_summary = _safe_dict(summary.get("service_resolver_veto_summary"))
        service_summary["nested_prompt_contract_scan_ok"] = bool(prompt_contract_summary.get("ok", True))
        service_summary["nested_prompt_contract_remaining_violation_count"] = int(prompt_contract_summary.get("remaining_violation_count") or 0)
        summary["service_resolver_veto_summary"] = service_summary
    summary["ok"] = bool(summary.get("ok", True)) and bool(prompt_contract_summary.get("ok", True))
    if not prompt_contract_summary.get("ok", True):
        failures = _safe_list(summary.get("failed_gates"))
        if "prompt_contract_service_veto_regression_ok" not in failures:
            failures.append("prompt_contract_service_veto_regression_ok")
        summary["failed_gates"] = failures
    return summary


def _force_final_autoplay_health(summary: Dict[str, Any]) -> Dict[str, Any]:
    health = _N11618_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH(summary)
    llm_summary = _safe_dict(summary.get("llm_prompt_and_fallback_summary"))
    attachment_counts = _n11618_attachment_repair_counts_from_summary(summary)
    if llm_summary:
        llm_summary["repair_pressure_breakdown"] = _n11618_merge_repair_pressure_counts(
            _safe_dict(llm_summary.get("repair_pressure_breakdown")),
            attachment_counts=attachment_counts,
        )
        summary["llm_prompt_and_fallback_summary"] = llm_summary
    prompt_contract_summary = _safe_dict(llm_summary.get("prompt_contract_service_veto_summary"))
    if prompt_contract_summary and not bool(prompt_contract_summary.get("ok", True)):
        health = dict(health)
        health["ok"] = False
        health["prompt_contract_service_veto_regression_ok"] = False
        warnings = _safe_list(health.get("warnings"))
        if "prompt_contract_service_veto_regression_failed" not in warnings:
            warnings.append("prompt_contract_service_veto_regression_failed")
        health["warnings"] = warnings
        health["failed_gate_count"] = int(health.get("failed_gate_count") or 0) + 1
    return health



# N116.18.2 — Strictly Bounded Prompt Veto Sync Hotfix
# N116.18 and N116.18.1 still walked too much nested diagnostic structure in
# final transcript rows.  On some runs those rows contain very large shared
# graphs, so even cycle-safe recursion can exhaust memory while building the
# visited-id set.  Override the N116.18 helpers with a strictly target-scoped
# implementation: only known prompt-facing objects are traversed, traversal is
# iterative, and hard node/depth caps are enforced.

_N116182_CONTAINER_CHILD_KEYS = (
    "current_turn_prompt_contract",
    "prompt_contract",
    "llm_prompt_contract",
    "current_action_response",
    "npc_response_architecture",
    "presentation_intent",
    "semantic_action",
    "semantic_action_v2",
    "service_result",
)
_N116182_SKIP_KEYS = {
    "original_service_result",
    "original_semantic_action",
    "n11615_original_semantic_action",
    "runtime_state",
    "session",
    "turn_result",
    "result",
    "transcript",
    "full_transcript",
    "debug_tail",
    "history",
    "event_log",
    "console_log",
    "provider_trace",
    "manual_harness_trace",
    "manual_stage_trace",
}


def _n116182_get_path(root: Dict[str, Any], path: tuple[str, ...]) -> Any:
    cursor: Any = root
    for key in path:
        if not isinstance(cursor, dict):
            return None
        cursor = cursor.get(key)
    return cursor


def _n116182_apply_local_veto(value: Any, *, action_text: str) -> bool:
    """Apply veto only to this object, without recursive descent."""
    if not isinstance(value, dict):
        return False
    changed = False
    if isinstance(value.get("service_result"), dict):
        original_service = _safe_dict(value.get("service_result"))
        scrubbed_service = _n11617_veto_service_result(original_service, action_text=action_text)
        if scrubbed_service != original_service:
            value["service_result"] = scrubbed_service
            changed = True
    for key in ("semantic_action", "semantic_action_v2"):
        if isinstance(value.get(key), dict):
            original_semantic = _safe_dict(value.get(key))
            scrubbed_semantic = _n11617_veto_semantic_action(original_semantic, action_text=action_text)
            if scrubbed_semantic != original_semantic:
                value[key] = scrubbed_semantic
                changed = True
    for focus_key in (
        "required_focus",
        "required_response_focus",
        "focus",
        "must_address",
        "required_response_focuses",
    ):
        if isinstance(value.get(focus_key), list):
            repaired_focus, focus_changed = _n11618_repair_focus_list(value.get(focus_key))
            if focus_changed:
                value[focus_key] = repaired_focus
                changed = True
    if any(
        key in value
        for key in (
            "required_focus",
            "required_response_focus",
            "focus",
            "must_address",
            "semantic_action",
            "semantic_action_v2",
            "service_result",
            "current_action_response",
            "npc_response_architecture",
            "presentation_intent",
        )
    ):
        changed = _n11618_apply_veto_policy(value, action_text=action_text) or changed
    return changed


def _n11618_deep_prompt_veto(
    value: Any,
    *,
    action_text: str,
    path: tuple[str, ...] = (),
    _seen: set[int] | None = None,
    _depth: int = 0,
    _max_depth: int = 6,
) -> bool:
    """Strictly bounded prompt-contract scrub.

    This intentionally ignores arbitrary row/runtime graphs.  It walks only a
    small allow-list of prompt-facing child keys and caps total visited nodes so
    final artifact sync cannot hit RecursionError or MemoryError.
    """
    if not isinstance(value, (dict, list)):
        return False

    changed = False
    seen: set[int] = set()
    stack: List[tuple[Any, int]] = [(value, 0)]
    visited_count = 0
    max_nodes = 250

    while stack and visited_count < max_nodes:
        node, depth = stack.pop()
        if not isinstance(node, (dict, list)):
            continue

        marker = id(node)
        if marker in seen:
            continue
        seen.add(marker)
        visited_count += 1
        if depth > _max_depth:
            continue

        if isinstance(node, dict):
            changed = _n116182_apply_local_veto(node, action_text=action_text) or changed
            for key in _N116182_CONTAINER_CHILD_KEYS:
                if key in _N116182_SKIP_KEYS:
                    continue
                child = node.get(key)
                if isinstance(child, (dict, list)):
                    stack.append((child, depth + 1))
            # Some provider payloads wrap useful fields under a small payload or
            # diagnostics dict.  Traverse those only when they are prompt-shaped,
            # never runtime/session/result graphs.
            for key in ("prompt_debug", "diagnostics", "payload", "narration_payload", "presentation"):
                child = node.get(key)
                if not isinstance(child, dict):
                    continue
                if any(k in child for k in _N116182_CONTAINER_CHILD_KEYS) or any(
                    "prompt_contract" in _safe_str(k) for k in child.keys()
                ):
                    stack.append((child, depth + 1))
        elif isinstance(node, list):
            # Prompt focus lists are short.  Avoid walking long histories.
            for child in node[:25]:
                if isinstance(child, (dict, list)):
                    stack.append((child, depth + 1))

    return changed


def _n11618_prompt_sync_targets(row: Dict[str, Any]) -> List[tuple[tuple[str, ...], Any]]:
    """Return only prompt-facing objects; never return the whole row/result graph."""
    row = _safe_dict(row)
    target_paths = (
        ("llm_prompt_contract",),
        ("current_turn_prompt_contract",),
        ("current_action_response",),
        ("npc_response_architecture",),
        ("llm_prompt_debug", "current_turn_prompt_contract"),
        ("llm_prompt_debug", "prompt_contract"),
        ("prompt_debug", "current_turn_prompt_contract"),
        ("prompt_debug", "prompt_contract"),
        ("background_presentation_result", "current_turn_prompt_contract"),
        ("background_presentation_result", "prompt_debug", "current_turn_prompt_contract"),
        ("background_presentation_result", "prompt_contract"),
        ("background_presentation_result", "current_action_response"),
        ("background_presentation_result", "npc_response_architecture"),
        ("semantic_action",),
        ("semantic_action_v2",),
        ("service_result",),
    )
    targets: List[tuple[tuple[str, ...], Any]] = []
    seen: set[int] = set()
    for path in target_paths:
        value = _n116182_get_path(row, path)
        if not isinstance(value, (dict, list)):
            continue
        marker = id(value)
        if marker in seen:
            continue
        seen.add(marker)
        targets.append((path, value))
    return targets


def _n11618_sync_prompt_contract_veto_to_row(row: Dict[str, Any]) -> Dict[str, Any]:
    row = _safe_dict(row)
    action_text = _n11617_row_action_text(row)
    if not _n11617_is_document_evidence_without_explicit_service(action_text):
        return row

    changed = False
    for target_path, target in _n11618_prompt_sync_targets(row):
        changed = _n11618_deep_prompt_veto(
            target,
            action_text=action_text,
            path=("row",) + target_path,
        ) or changed

    # Also apply local top-level row markers without traversing the row.
    changed = _n116182_apply_local_veto(row, action_text=action_text) or changed

    if changed:
        row["service_false_positive_vetoed"] = True
        row["prompt_contract_service_veto_synced"] = True
        row["service_resolver_veto"] = {
            **_safe_dict(row.get("service_resolver_veto")),
            "format_version": "n11618_prompt_contract_veto_sync_v1",
            "service_false_positive_vetoed": True,
            "reason": "document_evidence_without_explicit_service_request",
            "veto_only": True,
            "forced_positive_classification": False,
            "llm_classifies_presentation_intent": True,
            "prompt_contract_veto_synced": True,
            "recursion_safe_targeted_sync": True,
            "action_text": action_text[:500],
        }
    return row


def _n11618_walk_prompt_offenders(
    value: Any,
    *,
    path: tuple[str, ...] = (),
    _seen: set[int] | None = None,
    _depth: int = 0,
    _max_depth: int = 6,
) -> List[str]:
    """Strictly bounded offender scan for prompt-facing objects only."""
    offenders: List[str] = []
    if not isinstance(value, (dict, list)):
        return offenders

    seen: set[int] = set()
    stack: List[tuple[Any, tuple[str, ...], int]] = [(value, path, 0)]
    visited_count = 0
    max_nodes = 250

    while stack and visited_count < max_nodes:
        node, node_path, depth = stack.pop()
        if not isinstance(node, (dict, list)):
            continue
        marker = id(node)
        if marker in seen:
            continue
        seen.add(marker)
        visited_count += 1
        if depth > _max_depth:
            continue

        if isinstance(node, dict):
            service_result = _safe_dict(node.get("service_result"))
            status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
            if (
                service_result
                and _n11617_service_result_looks_false_positive(service_result)
                and status != "service_false_positive_vetoed"
            ):
                offenders.append(".".join(node_path + ("service_result",)))
            for key in ("semantic_action", "semantic_action_v2"):
                semantic = _safe_dict(node.get(key))
                if semantic and _n11617_semantic_action_looks_service(semantic):
                    offenders.append(".".join(node_path + (key,)))
            for focus_key in (
                "required_focus",
                "required_response_focus",
                "focus",
                "must_address",
                "required_response_focuses",
            ):
                focus = node.get(focus_key)
                if isinstance(focus, list):
                    bad_focus = [item for item in focus if _n11618_focus_is_service_or_economy(item)]
                    if bad_focus:
                        offenders.append(
                            ".".join(node_path + (focus_key,))
                            + ":"
                            + ",".join(_safe_str(item) for item in bad_focus[:6])
                        )
            for key in _N116182_CONTAINER_CHILD_KEYS:
                if key in _N116182_SKIP_KEYS:
                    continue
                child = node.get(key)
                if isinstance(child, (dict, list)):
                    stack.append((child, node_path + (str(key),), depth + 1))
            for key in ("prompt_debug", "diagnostics", "payload", "narration_payload", "presentation"):
                child = node.get(key)
                if isinstance(child, dict) and (
                    any(k in child for k in _N116182_CONTAINER_CHILD_KEYS)
                    or any("prompt_contract" in _safe_str(k) for k in child.keys())
                ):
                    stack.append((child, node_path + (str(key),), depth + 1))
        elif isinstance(node, list):
            for idx, item in enumerate(node[:25]):
                if isinstance(item, (dict, list)):
                    stack.append((item, node_path + (str(idx),), depth + 1))

    if stack:
        offenders.append(".".join(path) + ":scan_truncated_by_n11618_2_bounds")
    return offenders


def _n11618_prompt_contract_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    violations: List[Dict[str, Any]] = []
    synced: List[Dict[str, Any]] = []
    for row in rows:
        turn_index = int(row.get("turn_index") or row.get("turn") or 0)
        action_text = _n11617_row_action_text(row)
        if not _n11617_is_document_evidence_without_explicit_service(action_text):
            continue
        if row.get("prompt_contract_service_veto_synced"):
            synced.append({"turn_index": turn_index, "player_action": row.get("player_action")})
        offenders: List[str] = []
        for target_path, target in _n11618_prompt_sync_targets(row):
            offenders.extend(
                _n11618_walk_prompt_offenders(target, path=("row",) + target_path)
            )
        # Top-level only, no row traversal.
        offenders.extend(_n11618_walk_prompt_offenders(row.get("semantic_action"), path=("row", "semantic_action")))
        offenders.extend(_n11618_walk_prompt_offenders(row.get("semantic_action_v2"), path=("row", "semantic_action_v2")))
        offenders.extend(_n11618_walk_prompt_offenders(row.get("service_result"), path=("row", "service_result")))
        offenders = [item for item in offenders if item]
        if offenders:
            violations.append(
                {
                    "turn_index": turn_index,
                    "player_action": row.get("player_action"),
                    "offenders": offenders[:25],
                }
            )
    return {
        "format_version": "n11618_prompt_contract_veto_regression_summary_v2",
        "ok": not violations,
        "synced_count": len(synced),
        "remaining_violation_count": len(violations),
        "synced_turns": synced[:50],
        "remaining_violations": violations[:50],
        "policy": "veto_only_no_forced_investigation_classification_llm_keeps_intent_classification",
        "scan_mode": "strictly_bounded_prompt_targets_only",
    }



# N116.18.3 — Architecture Focus Resync After Prompt Veto Hotfix
# N116.18.2 made the prompt-contract veto memory-safe, but the final
# architecture invariant still expects npc_response_architecture.required_focus
# to be a subset of current_action_response.required_focus.  The veto can remove
# service/economy focus terms from one packet while leaving the other packet with
# a different bounded list.  Re-sync both packets after veto, keeping the policy
# veto-only and bounded.

_N116183_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS = _sync_current_action_response_artifact_rows
_N116183_MAX_REQUIRED_FOCUS = 8


def _n116183_normalize_focus_for_contract(value: Any) -> str:
    return _safe_str(value).strip().lower().replace("-", "_").replace(" ", "_")


def _n116183_bounded_veto_synced_focus(*focus_lists: Any) -> List[str]:
    """Return one bounded focus list shared by current_response and architecture."""
    non_service: List[str] = []
    for focus_any in focus_lists:
        for item in _safe_list(focus_any):
            text = _n116183_normalize_focus_for_contract(item)
            if not text or _n11618_focus_is_service_or_economy(text):
                continue
            if text in _N11618_VETO_GUIDANCE_ITEMS:
                continue
            if text not in non_service:
                non_service.append(text)

    out: List[str] = []
    # Preserve a small amount of actual current-action focus first.
    for item in non_service[: max(0, _N116183_MAX_REQUIRED_FOCUS - len(_N11618_VETO_GUIDANCE_ITEMS))]:
        if item not in out:
            out.append(item)

    # The N116.18 guidance must survive the bound, so append it before filling
    # any remaining non-service extras.
    for item in _N11618_VETO_GUIDANCE_ITEMS:
        text = _n116183_normalize_focus_for_contract(item)
        if text and text not in out:
            out.append(text)

    for item in non_service:
        if len(out) >= _N116183_MAX_REQUIRED_FOCUS:
            break
        if item not in out:
            out.append(item)

    return out[:_N116183_MAX_REQUIRED_FOCUS]


def _n116183_sync_architecture_focus_after_veto(row: Dict[str, Any]) -> Dict[str, Any]:
    row = _safe_dict(row)
    action_text = _n11617_row_action_text(row)
    if not _n11617_is_document_evidence_without_explicit_service(action_text):
        return row

    current = _safe_dict(row.get("current_action_response"))
    architecture = _safe_dict(row.get("npc_response_architecture"))
    if not current and not architecture:
        return row

    synced_focus = _n116183_bounded_veto_synced_focus(
        current.get("required_focus"),
        current.get("required_response_focus"),
        current.get("focus"),
        architecture.get("required_focus"),
        architecture.get("required_response_focus"),
        architecture.get("focus"),
    )
    if not synced_focus:
        return row

    if current:
        current["required_focus"] = list(synced_focus)
        current["architecture_required_focus"] = list(synced_focus)
        current["architecture_focus_sync_applied"] = True
        current["n11618_veto_focus_resynced"] = True
        current["classification_policy"] = {
            **_safe_dict(current.get("classification_policy")),
            "llm_classifies_presentation_intent": True,
            "deterministic_code_only_vetoes_impossible_service_or_economy": True,
            "veto_only_no_forced_positive_classification": True,
        }
        row["current_action_response"] = current

    if architecture:
        architecture["required_focus"] = list(synced_focus)
        architecture["current_action_response_required_focus"] = list(synced_focus)
        architecture["current_action_response_focus_sync_applied"] = True
        architecture["n11618_veto_focus_resynced"] = True
        architecture["classification_policy"] = {
            **_safe_dict(architecture.get("classification_policy")),
            "llm_classifies_presentation_intent": True,
            "deterministic_code_only_vetoes_impossible_service_or_economy": True,
            "veto_only_no_forced_positive_classification": True,
        }
        row["npc_response_architecture"] = architecture

    row["prompt_contract_service_veto_focus_resynced"] = True
    return row


def _sync_current_action_response_artifact_rows(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    synced = _N116183_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS(rows)
    if not isinstance(synced, list):
        return synced
    final_rows: List[Dict[str, Any]] = []
    for row in synced:
        row = _n116183_sync_architecture_focus_after_veto(_safe_dict(row))
        # Do not call the older architecture sync after this point: it copies
        # architecture focus into current_response with an 8-item bound and can
        # recreate the mismatch.  This helper makes both packets identical.
        final_rows.append(row)
    return final_rows


# N116.18.4 — Veto Guidance Is Not A Service-Focus Offender
# N116.18.3 correctly re-synced current_action_response and
# npc_response_architecture focus lists, but the regression scanner still treated
# the new veto guidance strings themselves as service/economy offenders because
# two guidance ids intentionally contain words like "drink" and
# "service_or_economy".  Keep those guidance ids in the prompt, but never count
# them as stale service focus.  This preserves the veto-only policy and lets the
# summary health reflect actual remaining service-result/semantic/focus leaks.


def _n116184_is_veto_guidance_focus(value: Any) -> bool:
    text = _n11618_normalized_focus_item(value)
    return bool(
        text
        and text in {
            _n11618_normalized_focus_item(item)
            for item in _N11618_VETO_GUIDANCE_ITEMS
        }
    )


def _n11618_focus_is_service_or_economy(value: Any) -> bool:
    text = _n11618_normalized_focus_item(value)
    if not text:
        return False
    if _n116184_is_veto_guidance_focus(text):
        return False
    return bool(
        text in _N11618_SERVICE_FOCUS_ITEMS
        or text.startswith("purchase_")
        or text.endswith("_purchase")
        or text in {"purchase", "price", "payment", "lodging", "drink"}
        or text.startswith("price_")
        or text.endswith("_price")
        or text.startswith("payment_")
        or text.endswith("_payment")
        or text.startswith("lodging_")
        or text.endswith("_lodging")
        or text.startswith("drink_")
        or text.endswith("_drink")
        or text in {"service_or_economy_request", "commerce_or_service_terms"}
    )


def _n11618_repair_focus_list(value: Any) -> tuple[List[Any], bool]:
    values = value if isinstance(value, list) else []
    repaired: List[Any] = []
    changed = False
    for item in values:
        if _n11618_focus_is_service_or_economy(item):
            changed = True
            continue
        if item not in repaired:
            repaired.append(item)
    for item in _N11618_VETO_GUIDANCE_ITEMS:
        if item not in repaired:
            repaired.append(item)
            changed = True
    return repaired[:12], changed


def _n11618_prompt_contract_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in rows if isinstance(row, dict)]
    violations: List[Dict[str, Any]] = []
    synced: List[Dict[str, Any]] = []
    guidance_only_count = 0
    for row in rows:
        turn_index = int(row.get("turn_index") or row.get("turn") or 0)
        action_text = _n11617_row_action_text(row)
        if not _n11617_is_document_evidence_without_explicit_service(action_text):
            continue
        if row.get("prompt_contract_service_veto_synced"):
            synced.append({"turn_index": turn_index, "player_action": row.get("player_action")})
        offenders: List[str] = []
        for target_path, target in _n11618_prompt_sync_targets(row):
            offenders.extend(
                _n11618_walk_prompt_offenders(target, path=("row",) + target_path)
            )
        offenders.extend(_n11618_walk_prompt_offenders(row.get("semantic_action"), path=("row", "semantic_action")))
        offenders.extend(_n11618_walk_prompt_offenders(row.get("semantic_action_v2"), path=("row", "semantic_action_v2")))
        offenders.extend(_n11618_walk_prompt_offenders(row.get("service_result"), path=("row", "service_result")))
        filtered: List[str] = []
        for offender in offenders:
            offender_text = _safe_str(offender)
            # Defensive compatibility for rows produced by the pre-18.4 scanner:
            # do not fail the run when the only "offender" is one of the
            # explicit N116.18 veto guidance ids.
            if any(_n11618_normalized_focus_item(item) in _n11618_normalized_focus_item(offender_text) for item in _N11618_VETO_GUIDANCE_ITEMS):
                guidance_only_count += 1
                continue
            if offender_text:
                filtered.append(offender_text)
        if filtered:
            violations.append(
                {
                    "turn_index": turn_index,
                    "player_action": row.get("player_action"),
                    "offenders": filtered[:25],
                }
            )
    return {
        "format_version": "n11618_prompt_contract_veto_regression_summary_v4",
        "ok": not violations,
        "synced_count": len(synced),
        "remaining_violation_count": len(violations),
        "guidance_only_offender_count_suppressed": guidance_only_count,
        "synced_turns": synced[:50],
        "remaining_violations": violations[:50],
        "policy": "veto_only_no_forced_investigation_classification_llm_keeps_intent_classification",
        "scan_mode": "strictly_bounded_prompt_targets_only_guidance_aware",
    }

# N116.19 — Root Service Resolver Precision + Repair Breakdown Accuracy
# Keep N116.18 as a safety net, but make the root service/document test more
# precise so generic evidence/proof language does not create a broad service
# veto.  This remains a negative guard only: it never forces an
# investigation/evidence presentation category.

_N11619_PREVIOUS_SYNC_CURRENT_ACTION_RESPONSE_ARTIFACT_ROWS = _sync_current_action_response_artifact_rows
_N11619_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11619_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11619_STRONG_DOCUMENT_SERVICE_FALSE_POSITIVE_TERMS = (
    "sealed order", "sealed orders", "countermove order", "countermove orders",
    "strike order", "strike orders", "captured order", "captured orders",
    "written order", "written orders", "orders from", "orders signed",
    "orders naming", "route paper", "route papers", "captured route paper",
    "captured route papers", "ledger", "ledger entry", "ledger entries",
    "manifest", "manifest mark", "manifest marks", "payment mark",
    "payment marks", "manifest payment", "marked coin", "coin proof",
    "coin lead", "route cipher", "coded message", "coded messages",
    "toll marker", "toll markers", "courier route", "paymaster",
)
_N11619_DOCUMENT_CONTEXT_TERMS = (
    "document", "documents", "paper", "papers", "letter", "letters",
    "note", "notes", "record", "records", "file", "files", "cipher",
    "code", "marks", "markings", "seal", "sealed", "ledger", "manifest",
)
_N11619_EVIDENCE_VERBS = (
    "inspect", "study", "review", "decode", "trace", "capture", "recover",
    "report", "compare", "analyze", "analyse", "examine", "read", "copy",
    "secure", "protect", "warn", "follow", "bring", "show", "present",
    "search", "find", "identify", "check",
)
_N11619_EXPLICIT_SERVICE_COMMERCE_TERMS = (
    "buy", "purchase", "pay for", "pay bran for", "pay the innkeeper for",
    "rent a room", "rent room", "book a room", "book room", "order ale",
    "order a drink", "order food", "order a meal", "order stew",
    "order supper", "buy ale", "buy food", "buy meal", "buy stew",
    "sell", "trade", "hire", "lodging", "sleep here", "rest here",
    "stay the night",
)


def _n11619_is_root_service_false_positive_action(action_text: Any) -> bool:
    action = _n11617_norm_text(action_text)
    if not action:
        return False
    if any(term in action for term in _N11619_EXPLICIT_SERVICE_COMMERCE_TERMS):
        return False
    if any(term in action for term in _N11619_STRONG_DOCUMENT_SERVICE_FALSE_POSITIVE_TERMS):
        return True
    has_context = any(term in action for term in _N11619_DOCUMENT_CONTEXT_TERMS)
    has_verb = any(verb in action for verb in _N11619_EVIDENCE_VERBS)
    return bool(has_context and has_verb)


def _n11617_is_document_evidence_without_explicit_service(action_text: str) -> bool:
    """N116.19 precision override for the existing veto predicate.

    Older N116.17/N116.18 logic included generic terms like ``proof`` and
    ``evidence``.  That was safe but too broad, producing a high veto rate.  The
    root service guard now only triggers when the current action contains
    service-confusable document/order/payment nouns, or a document noun with an
    evidence verb, and no explicit service/commerce request.
    """
    return _n11619_is_root_service_false_positive_action(action_text)


def _n11619_row_has_actual_service_false_positive(row: Dict[str, Any]) -> bool:
    row = _safe_dict(row)
    action_text = _n11617_row_action_text(row)
    if not _n11619_is_root_service_false_positive_action(action_text):
        return False
    for container_name in ("row", "turn_contract", "turn_result", "result", "raw_result", "manual_turn_summary"):
        container = row if container_name == "row" else _safe_dict(row.get(container_name))
        if not container:
            continue
        service_result = _safe_dict(container.get("service_result"))
        status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
        if service_result and _n11617_service_result_looks_false_positive(service_result) and status != "service_false_positive_vetoed":
            return True
        semantic = _safe_dict(container.get("semantic_action")) or _safe_dict(container.get("semantic_action_v2"))
        if _n11617_semantic_action_looks_service(semantic):
            return True
    return False


def _n11619_service_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    rows = [_safe_dict(row) for row in _safe_list(rows) if isinstance(row, dict)]
    vetoed: List[Dict[str, Any]] = []
    remaining: List[Dict[str, Any]] = []
    candidates = 0
    prompt_only_blocks = 0
    for row in rows:
        turn_index = int(row.get("turn_index") or row.get("turn") or 0)
        action_text = _n11617_row_action_text(row)
        if not _n11619_is_root_service_false_positive_action(action_text):
            continue
        candidates += 1
        row_veto = _safe_dict(row.get("service_resolver_veto"))
        root_vetoed = bool(row_veto.get("service_false_positive_vetoed") or row.get("service_false_positive_vetoed"))
        if root_vetoed:
            has_original = False
            for container_name in ("row", "turn_contract", "turn_result", "result", "raw_result", "manual_turn_summary"):
                container = row if container_name == "row" else _safe_dict(row.get(container_name))
                service_result = _safe_dict(container.get("service_result"))
                semantic = _safe_dict(container.get("semantic_action")) or _safe_dict(container.get("semantic_action_v2"))
                if service_result.get("original_service_result") or semantic.get("original_semantic_action"):
                    has_original = True
                    break
            if has_original:
                vetoed.append({
                    "turn_index": turn_index,
                    "player_action": row.get("player_action"),
                    "reason": "service_false_positive_vetoed",
                })
            else:
                prompt_only_blocks += 1

        offenders: List[str] = []
        for container_name in ("row", "turn_contract", "turn_result", "result", "raw_result", "manual_turn_summary"):
            container = row if container_name == "row" else _safe_dict(row.get(container_name))
            if not container:
                continue
            service_result = _safe_dict(container.get("service_result"))
            semantic = _safe_dict(container.get("semantic_action")) or _safe_dict(container.get("semantic_action_v2"))
            status = _safe_str(service_result.get("status") or service_result.get("service_status")).lower()
            if service_result and _n11617_service_result_looks_false_positive(service_result) and status != "service_false_positive_vetoed":
                offenders.append(f"{container_name}.service_result")
            if _n11617_semantic_action_looks_service(semantic):
                offenders.append(f"{container_name}.semantic_action")
        if offenders:
            remaining.append({
                "turn_index": turn_index,
                "player_action": row.get("player_action"),
                "offenders": offenders[:20],
            })
    total = len(rows)
    veto_rate = (len(vetoed) / total) if total else 0.0
    return {
        "format_version": "n11619_service_veto_regression_summary_v1",
        "ok": not remaining,
        "candidate_document_service_false_positive_action_count": candidates,
        "vetoed_count": len(vetoed),
        "remaining_violation_count": len(remaining),
        "prompt_only_service_category_block_count": prompt_only_blocks,
        "vetoed_rate": round(veto_rate, 4),
        "vetoed_turns": vetoed[:50],
        "remaining_violations": remaining[:50],
        "policy": "veto_only_no_forced_investigation_classification",
    }


def _n11617_service_veto_regression_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    return _n11619_service_veto_regression_summary(rows)


def _n11619_dialogue_relevance_repaired_count(rows: List[Dict[str, Any]], summary: Dict[str, Any]) -> tuple[int, str]:
    summary = _safe_dict(summary)
    for key in ("dialogue_action_relevance_summary", "dialogue-action-relevance-summary", "dialogue_relevance_summary"):
        packet = _safe_dict(summary.get(key))
        if packet:
            for count_key in ("repaired_count", "dialogue_relevance_repaired_count", "repair_count"):
                if packet.get(count_key) is not None:
                    return int(packet.get(count_key) or 0), key
    rows = [_safe_dict(row) for row in _safe_list(rows) if isinstance(row, dict)]
    return sum(1 for row in rows if row.get("dialogue_action_relevance_repaired")), "row_flags"


def _n11619_update_repair_pressure_breakdown(rows: List[Dict[str, Any]], summary: Dict[str, Any]) -> None:
    summary = _safe_dict(summary)
    llm_summary = _safe_dict(summary.get("llm_prompt_and_fallback_summary"))
    if not llm_summary:
        return
    breakdown = dict(_safe_dict(llm_summary.get("repair_pressure_breakdown")))
    dialogue_count, dialogue_source = _n11619_dialogue_relevance_repaired_count(rows, summary)
    breakdown["dialogue_relevance_repaired_count"] = dialogue_count
    breakdown["dialogue_relevance_repair_count_source"] = dialogue_source
    service_summary = _safe_dict(llm_summary.get("service_resolver_veto_summary") or summary.get("service_resolver_veto_summary"))
    if service_summary:
        breakdown["service_resolver_veto_count"] = int(service_summary.get("vetoed_count") or 0)
        breakdown["service_resolver_veto_rate"] = service_summary.get("vetoed_rate")
    dominant = dict(_safe_dict(breakdown.get("dominant_sources")))
    dominant["dialogue_action_relevance_repair"] = dialogue_count
    if service_summary:
        dominant["service_resolver_veto"] = int(service_summary.get("vetoed_count") or 0)
    breakdown["dominant_sources"] = dominant
    breakdown["format_version"] = "n11619_repair_pressure_breakdown_v3"
    llm_summary["repair_pressure_breakdown"] = breakdown
    summary["llm_prompt_and_fallback_summary"] = llm_summary


def _build_llm_prompt_and_fallback_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _N11619_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY(rows)
    service_summary = _n11619_service_veto_regression_summary(rows)
    summary["service_resolver_veto_summary"] = service_summary
    summary["ok"] = bool(summary.get("ok", True)) and bool(service_summary.get("ok", True))
    if not service_summary.get("ok", True):
        failures = _safe_list(summary.get("failed_gates"))
        if "service_resolver_veto_regression_ok" not in failures:
            failures.append("service_resolver_veto_regression_ok")
        summary["failed_gates"] = failures
    breakdown = dict(_safe_dict(summary.get("repair_pressure_breakdown")))
    dialogue_count, dialogue_source = _n11619_dialogue_relevance_repaired_count(rows, {})
    breakdown["dialogue_relevance_repaired_count"] = dialogue_count
    breakdown["dialogue_relevance_repair_count_source"] = dialogue_source
    breakdown["service_resolver_veto_count"] = int(service_summary.get("vetoed_count") or 0)
    breakdown["service_resolver_veto_rate"] = service_summary.get("vetoed_rate")
    dominant = dict(_safe_dict(breakdown.get("dominant_sources")))
    dominant["dialogue_action_relevance_repair"] = dialogue_count
    dominant["service_resolver_veto"] = int(service_summary.get("vetoed_count") or 0)
    breakdown["dominant_sources"] = dominant
    breakdown["format_version"] = "n11619_repair_pressure_breakdown_v3"
    summary["repair_pressure_breakdown"] = breakdown
    return summary


def _force_final_autoplay_health(summary: Dict[str, Any]) -> Dict[str, Any]:
    health = _N11619_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH(summary)
    summary = _safe_dict(summary)
    rows = _safe_list(summary.get("final_transcript_rows") or summary.get("transcript_rows") or [])
    _n11619_update_repair_pressure_breakdown(rows, summary)
    llm_summary = _safe_dict(summary.get("llm_prompt_and_fallback_summary"))
    service_summary = _safe_dict(llm_summary.get("service_resolver_veto_summary") or summary.get("service_resolver_veto_summary"))
    total = int(service_summary.get("turn_count") or summary.get("turns_executed") or summary.get("requested_turns") or 100)
    vetoed = int(service_summary.get("vetoed_count") or 0)
    threshold = 10 if total >= 100 else max(1, total // 10)
    if vetoed > threshold:
        health = dict(_safe_dict(health))
        warnings = _safe_list(health.get("warnings"))
        if "service_resolver_veto_rate_high" not in warnings:
            warnings.append("service_resolver_veto_rate_high")
        health["warnings"] = warnings
        health["service_resolver_veto_rate_high"] = True
        health["service_resolver_veto_count"] = vetoed
        health["service_resolver_veto_threshold"] = threshold
    else:
        health = dict(_safe_dict(health))
        health["service_resolver_veto_rate_high"] = False
        health["service_resolver_veto_count"] = vetoed
        health["service_resolver_veto_threshold"] = threshold
    return health


# N116.20 — Provider Metadata Repair Reduction + Unsupported Combat Claim Cleanup
# Add reporting around where provider/repair pressure comes from.  This does not
# change simulation outcomes and does not replace LLM presentation classification;
# it only summarizes repair pressure and keeps existing N116.19 service precision
# advisories visible.

_N11620_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11620_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11620_COMBAT_CLAIM_TERMS = (
    " hit ", " hits ", " struck ", " wound", " wounded", " injur", " damage",
    " blood", " bleeding", " kill", " killed", " slain", " dead", " defeat",
    " defeated", " victory", " wins ", " win the fight", " drops ", " falls dead",
)


def _n11620_row_category(row: Dict[str, Any]) -> str:
    row = _safe_dict(row)
    for source in (
        _safe_dict(row.get("validated_presentation_intent")),
        _safe_dict(row.get("presentation_intent")),
        _safe_dict(row.get("llm_presentation_intent")),
        _safe_dict(_safe_dict(row.get("background_presentation_result")).get("presentation_intent")),
    ):
        category = _safe_str(source.get("primary_category") or source.get("category")).strip().lower()
        if category:
            return category
    action = _safe_str(row.get("canonical_turn_action") or row.get("player_action")).lower()
    if any(term in action for term in ("ask", "tell", "warn", "report", "question")):
        return "dialogue"
    if any(term in action for term in ("inspect", "search", "study", "review", "evidence", "proof", "ledger", "orders")):
        return "evidence"
    if any(term in action for term in ("travel", "follow", "road", "route", "go to", "leave")):
        return "travel"
    if any(term in action for term in ("attack", "fight", "strike", "defend", "combat")):
        return "combat"
    return _safe_str(row.get("action_category")) or "general"


def _n11620_text_has_combat_claim(value: Any) -> bool:
    text = f" {_safe_str(value).lower()} "
    if not text.strip():
        return False
    return any(term in text for term in _N11620_COMBAT_CLAIM_TERMS)


def _n11621_turn_contract_supports_combat(container: Any) -> bool:
    """Conservative local fallback when the N116.20 combat-support helper is absent."""
    data = _safe_dict(container)
    if not data:
        return False

    direct_keys = (
        "combat_result",
        "combat_state",
        "combat_state_delta",
        "combat_delta",
        "damage",
        "damage_result",
        "attack_result",
        "hit_result",
        "initiative",
        "encounter_result",
        "encounter_state",
    )
    if any(data.get(key) for key in direct_keys):
        return True

    mechanics = {
        _safe_str(item).strip().lower()
        for item in _safe_list(data.get("mechanics_covered_this_turn") or data.get("mechanics"))
        if _safe_str(item).strip()
    }
    if any(
        mechanic in mechanics
        for mechanic in (
            "combat_started",
            "combat_resolved",
            "combat_victory",
            "combat_ended",
            "attack_resolved",
            "damage_applied",
            "enemy_defeated",
        )
    ):
        return True

    result = _safe_dict(data.get("result") or data.get("turn_result") or data.get("resolution"))
    if result and result is not data and _n11621_turn_contract_supports_combat(result):
        return True

    status = _safe_str(data.get("status") or data.get("combat_status") or data.get("encounter_status")).lower()
    return status in {"combat", "in_combat", "combat_started", "combat_resolved", "victory", "defeated"}


def _n11621_text_has_combat_claim(value: Any) -> bool:
    helper = globals().get("_n11620_text_has_combat_claim")
    if callable(helper):
        return bool(helper(value))
    return _presentation_has_combat_claim(_safe_str(value))


def _n11620_row_has_unsupported_combat_claim_suppressed(row: Dict[str, Any]) -> bool:
    row = _safe_dict(row)
    if row.get("unsupported_combat_claim_suppressed"):
        return True
    selected = _safe_dict(row.get("selected_output"))
    if selected.get("unsupported_combat_claim_suppressed"):
        return True
    background = _safe_dict(row.get("background_presentation_result"))
    if background.get("unsupported_combat_claim_suppressed"):
        return True
    diagnostics = _safe_dict(background.get("diagnostics"))
    if diagnostics.get("unsupported_combat_claim_suppressed"):
        return True
    hard = _safe_dict(row.get("presentation_hard_grounding"))
    violations = _safe_list(hard.get("violations") or hard.get("violation_types"))
    if "unsupported_combat_claim" in violations:
        return True
    if _safe_str(row.get("presentation_repair_type")) == "unsupported_combat_claim":
        return True
    return False


def _n11620_category_reclassified(row: Dict[str, Any]) -> bool:
    row = _safe_dict(row)
    if row.get("category_reclassified") or row.get("soft_classification_repair"):
        return True
    validated = _safe_str(row.get("validated_presentation_category")).lower()
    llm_category = (
        _safe_str(row.get("llm_presentation_category")).lower()
        or _safe_str(_safe_dict(row.get("presentation_intent")).get("primary_category")).lower()
        or _safe_str(_safe_dict(_safe_dict(row.get("background_presentation_result")).get("presentation_intent")).get("primary_category")).lower()
    )
    return bool(validated and llm_category and validated != llm_category)


def _n11620_metadata_repaired(row: Dict[str, Any]) -> bool:
    row = _safe_dict(row)
    if row.get("provider_metadata_normalized_pre_attach") or row.get("metadata_repaired"):
        return True
    background = _safe_dict(row.get("background_presentation_result"))
    if background.get("provider_metadata_normalized_pre_attach") or background.get("metadata_repaired"):
        return True
    diagnostics = _safe_dict(background.get("diagnostics"))
    return bool(diagnostics.get("provider_metadata_normalized_pre_attach") or diagnostics.get("metadata_repaired"))


def _n11620_repair_pressure_by_category(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    by_category: Dict[str, Dict[str, Any]] = {}
    for row_any in _safe_list(rows):
        row = _safe_dict(row_any)
        if not row:
            continue
        category = _n11620_row_category(row)
        bucket = by_category.setdefault(
            category,
            {
                "turn_count": 0,
                "metadata_repaired_count": 0,
                "category_reclassified_count": 0,
                "dialogue_relevance_repaired_count": 0,
                "unsupported_combat_claim_suppressed_count": 0,
                "service_resolver_veto_count": 0,
                "example_turns": [],
            },
        )
        bucket["turn_count"] += 1
        repaired = False
        if _n11620_metadata_repaired(row):
            bucket["metadata_repaired_count"] += 1
            repaired = True
        if _n11620_category_reclassified(row):
            bucket["category_reclassified_count"] += 1
            repaired = True
        if row.get("dialogue_action_relevance_repaired"):
            bucket["dialogue_relevance_repaired_count"] += 1
            repaired = True
        if _n11620_row_has_unsupported_combat_claim_suppressed(row):
            bucket["unsupported_combat_claim_suppressed_count"] += 1
            repaired = True
        if row.get("service_false_positive_vetoed") or _safe_dict(row.get("service_resolver_veto")).get("service_false_positive_vetoed"):
            bucket["service_resolver_veto_count"] += 1
            repaired = True
        if repaired and len(bucket["example_turns"]) < 8:
            bucket["example_turns"].append(
                {
                    "turn_index": int(row.get("turn_index") or row.get("turn") or 0),
                    "player_action": _safe_str(row.get("player_action"))[:220],
                }
            )

    for bucket in by_category.values():
        turns = max(1, int(bucket.get("turn_count") or 0))
        bucket["metadata_repaired_rate"] = round(bucket["metadata_repaired_count"] / turns, 4)
        bucket["category_reclassified_rate"] = round(bucket["category_reclassified_count"] / turns, 4)
        bucket["dialogue_relevance_repaired_rate"] = round(bucket["dialogue_relevance_repaired_count"] / turns, 4)
        bucket["unsupported_combat_claim_suppressed_rate"] = round(bucket["unsupported_combat_claim_suppressed_count"] / turns, 4)
        bucket["service_resolver_veto_rate"] = round(bucket["service_resolver_veto_count"] / turns, 4)

    return {
        "format_version": "n11620_repair_pressure_by_category_v1",
        "categories": by_category,
        "category_count": len(by_category),
    }


def _n11620_update_repair_pressure_breakdown(rows: List[Dict[str, Any]], summary: Dict[str, Any]) -> None:
    summary = _safe_dict(summary)
    llm_summary = _safe_dict(summary.get("llm_prompt_and_fallback_summary"))
    if not llm_summary:
        return
    breakdown = dict(_safe_dict(llm_summary.get("repair_pressure_breakdown")))
    breakdown["repair_pressure_by_category"] = _n11620_repair_pressure_by_category(rows)
    unsupported_count = sum(
        1
        for row in _safe_list(rows)
        if _n11620_row_has_unsupported_combat_claim_suppressed(_safe_dict(row))
    )
    breakdown["unsupported_combat_claim_suppressed_count"] = unsupported_count
    dominant = dict(_safe_dict(breakdown.get("dominant_sources")))
    dominant["unsupported_combat_claim_suppressed"] = unsupported_count
    breakdown["dominant_sources"] = dominant

    breakdown["format_version"] = "n11620_repair_pressure_breakdown_v4"
    llm_summary["repair_pressure_breakdown"] = breakdown
    summary["llm_prompt_and_fallback_summary"] = llm_summary


def _build_llm_prompt_and_fallback_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _N11620_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY(rows)
    breakdown = dict(_safe_dict(summary.get("repair_pressure_breakdown")))
    breakdown["repair_pressure_by_category"] = _n11620_repair_pressure_by_category(rows)
    unsupported_count = sum(
        1
        for row in _safe_list(rows)
        if _n11620_row_has_unsupported_combat_claim_suppressed(_safe_dict(row))
    )
    breakdown["unsupported_combat_claim_suppressed_count"] = unsupported_count
    dominant = dict(_safe_dict(breakdown.get("dominant_sources")))
    dominant["unsupported_combat_claim_suppressed"] = unsupported_count
    breakdown["dominant_sources"] = dominant
    breakdown["format_version"] = "n11620_repair_pressure_breakdown_v4"
    summary["repair_pressure_breakdown"] = breakdown
    summary["unsupported_combat_claim_cleanup"] = {
        "format_version": "unsupported_combat_claim_cleanup_v1",
        "suppressed_count": unsupported_count,
        "ok": unsupported_count <= max(10, int(summary.get("turn_count") or 0) // 10),
    }
    return summary


def _force_final_autoplay_health(summary: Dict[str, Any]) -> Dict[str, Any]:
    health = _N11620_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH(summary)
    rows = _safe_list(_safe_dict(summary).get("final_transcript_rows") or _safe_dict(summary).get("transcript_rows") or [])
    _n11620_update_repair_pressure_breakdown(rows, summary)
    llm_summary = _safe_dict(_safe_dict(summary).get("llm_prompt_and_fallback_summary"))
    cleanup = _safe_dict(llm_summary.get("unsupported_combat_claim_cleanup"))
    health = dict(_safe_dict(health))
    health["unsupported_combat_claim_suppressed_count"] = int(cleanup.get("suppressed_count") or 0)
    return health



# N116.21 — Pre-Selection Unsupported Combat Sanitizer + Repair Category Attribution
# N116.20 added provider prompt/schema guidance, but selected-output grounding
# could still see an unsupported-combat primary candidate and choose a hard
# deterministic fallback.  This layer sanitizes unsupported combat claims before
# grounding summaries are built, preserving safe provider-derived text when any
# non-combat sentence remains.  It also ensures repair-pressure-by-category is
# populated even when final transcript rows are not embedded in summary.json.

_N11621_PREVIOUS_BUILD_NARRATION_GROUNDING_SUMMARY = _build_narration_grounding_summary
_N11621_PREVIOUS_BUILD_SELECTED_OUTPUT_GROUNDING_HEALTH = _build_selected_output_grounding_health
_N11621_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY = _build_llm_prompt_and_fallback_summary
_N11621_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH = _force_final_autoplay_health

_N11621_UNSUPPORTED_COMBAT_CODES = {
    "unsupported_combat_claim",
    "unsupported_damage_claim",
    "unsupported_defeat_claim",
    "unsupported_combat_resolution_claim",
}


def _n11621_violation_codes(validation: Dict[str, Any]) -> List[str]:
    validation = _safe_dict(validation)
    codes: List[str] = []
    for key in ("violations", "primary_violations"):
        for item in _safe_list(validation.get(key)):
            code = _safe_str(_safe_dict(item).get("code") or item)
            if code and code not in codes:
                codes.append(code)
    return codes


def _n11621_validation_has_unsupported_combat(validation: Dict[str, Any]) -> bool:
    return any(code in _N11621_UNSUPPORTED_COMBAT_CODES for code in _n11621_violation_codes(validation))


def _n11621_turn_has_authoritative_combat_support(row: Dict[str, Any]) -> bool:
    row = _safe_dict(row)
    if _turn_has_combat_support(row):
        return True
    contract_helper = globals().get("_n11620_turn_contract_supports_combat")
    if not callable(contract_helper):
        contract_helper = _n11621_turn_contract_supports_combat
    for key in ("turn_contract", "result", "turn_result", "background_presentation_result"):
        container = _safe_dict(row.get(key))
        if contract_helper(container):
            return True
    return False


def _n11621_sentence_split(text: str) -> List[str]:
    import re
    parts = re.split(r"(?<=[.!?])\s+", _safe_str(text).strip())
    return [part.strip() for part in parts if part and part.strip()]


def _n11621_safe_provider_derived_text(row: Dict[str, Any]) -> tuple[str, Dict[str, Any]]:
    row = _safe_dict(row)
    background = _safe_dict(row.get("background_presentation_result"))
    selected = _safe_dict(row.get("selected_output") or row.get("selected_narration"))
    npc = _safe_dict(row.get("npc"))
    candidates = [
        row.get("display_narration"),
        row.get("visible_narration"),
        row.get("selected_narration_text"),
        row.get("narration"),
        selected.get("narration"),
        background.get("narration"),
        npc.get("line"),
        selected.get("line"),
        _safe_dict(selected.get("npc")).get("line"),
        _safe_dict(background.get("npc")).get("line"),
    ]
    original_parts = [_safe_str(item).strip() for item in candidates if _safe_str(item).strip()]
    original_text = " ".join(original_parts)
    kept: List[str] = []
    dropped: List[str] = []
    for sentence in _n11621_sentence_split(original_text):
        if _n11621_text_has_combat_claim(sentence) or _presentation_has_combat_claim(sentence):
            dropped.append(sentence)
            continue
        if sentence not in kept:
            kept.append(sentence)
    if kept:
        text = " ".join(kept)[:1000]
        return text, {
            "source": "provider_text_combat_sentence_sanitized",
            "provider_text_reused": True,
            "dropped_sentence_count": len(dropped),
            "dropped_sentence_preview": dropped[:3],
        }
    fallback = _build_category_compatible_presentation_fallback(row)
    return fallback, {
        "source": "provider_text_unusable_safe_category_fallback",
        "provider_text_reused": False,
        "dropped_sentence_count": len(dropped),
        "dropped_sentence_preview": dropped[:3],
    }


def _n11621_mark_grounding_as_llm_safe_fallback(
    row: Dict[str, Any],
    *,
    validation: Dict[str, Any],
    safe_text: str,
    diagnostic: Dict[str, Any],
) -> Dict[str, Any]:
    row = dict(_safe_dict(row))
    validation = dict(_safe_dict(validation))
    raw_codes = _n11621_violation_codes(validation)
    primary_violations = _safe_list(validation.get("primary_violations")) or _safe_list(validation.get("violations"))
    validation["ok"] = True
    validation["fallback_used"] = True
    validation["selected_candidate"] = "llm_safe_fallback"
    validation["fallback_source"] = "llm_safe_fallback"
    validation["violations"] = []
    validation["preselection_suppressed_violations"] = [
        code for code in raw_codes if code in _N11621_UNSUPPORTED_COMBAT_CODES
    ]
    validation["primary_violations"] = primary_violations
    validation["unsupported_combat_claim_preselection_suppressed"] = True
    validation["unsupported_combat_claim_sanitizer"] = diagnostic

    row["narration_grounding_validation"] = validation
    row["narration_grounding_ok"] = True
    row["narration_grounding_fallback_used"] = True
    row["narration_grounding_selected_candidate"] = "llm_safe_fallback"
    row["narration_grounding_fallback_source"] = "llm_safe_fallback"
    row["narration_grounding_violation_codes"] = []
    row["narration_grounding_primary_violation_codes"] = validation["preselection_suppressed_violations"]

    row["unsupported_combat_claim_preselection_suppressed"] = True
    row["unsupported_combat_claim_raw_violation_codes"] = validation["preselection_suppressed_violations"]
    row["unsupported_combat_claim_sanitizer"] = diagnostic

    row["narration"] = safe_text
    row["display_narration"] = safe_text
    row["visible_narration"] = safe_text
    row["selected_narration_text"] = safe_text

    selected = dict(_safe_dict(row.get("selected_output") or row.get("selected_narration")))
    selected["narration"] = safe_text
    selected["source"] = "llm_safe_fallback"
    selected["fallback_source"] = "llm_safe_fallback"
    selected["unsupported_combat_claim_preselection_suppressed"] = True
    selected["unsupported_combat_claim_sanitizer"] = diagnostic
    row["selected_output"] = selected
    row["selected_narration"] = selected
    row["resolved_narration_payload"] = selected
    row["narration_payload"] = selected
    row["structured_narration"] = selected

    relevance = dict(_safe_dict(row.get("dialogue_action_relevance")))
    if relevance:
        relevance["repaired"] = True
        relevance["fallback_applied"] = True
        relevance["fallback_source"] = "llm_safe_fallback"
        relevance["reason"] = "unsupported_combat_claim_preselection_suppressed"
        row["dialogue_action_relevance"] = relevance
        row["dialogue_action_relevance_repaired"] = True

    row["presentation_repair_tier"] = "hard_grounding"
    row["presentation_repair_type"] = "unsupported_combat_claim_preselection_suppressed"
    row["visible_text_replaced"] = False
    row["hard_grounding_repair"] = False
    row["soft_classification_repair"] = bool(row.get("soft_classification_repair", False))
    row["presentation_status"] = "attached_llm_safe_fallback_preselection_sanitized"
    return row


def _n11621_sanitize_unsupported_combat_row(row: Dict[str, Any]) -> Dict[str, Any]:
    row = dict(_safe_dict(row))
    validation = _safe_dict(row.get("narration_grounding_validation"))
    if not validation:
        validation = _extract_grounding_validation_from_any(row)
    if not validation:
        return row
    if not _n11621_validation_has_unsupported_combat(validation):
        return row
    if _n11621_turn_has_authoritative_combat_support(row):
        return row
    safe_text, diagnostic = _n11621_safe_provider_derived_text(row)
    diagnostic = {
        **diagnostic,
        "format_version": "n11621_unsupported_combat_preselection_sanitizer_v1",
        "reason": "provider_claimed_combat_outcome_without_authoritative_turn_contract",
    }
    return _n11621_mark_grounding_as_llm_safe_fallback(
        row,
        validation=validation,
        safe_text=safe_text,
        diagnostic=diagnostic,
    )


def _n11621_sanitize_rows_before_grounding_summary(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    sanitized: List[Dict[str, Any]] = []
    for row_any in _safe_list(rows):
        row = _safe_dict(row_any)
        sanitized.append(_n11621_sanitize_unsupported_combat_row(row) if row else row)
    return sanitized


def _build_narration_grounding_summary(transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    sanitized_rows = _n11621_sanitize_rows_before_grounding_summary(transcript)
    if isinstance(transcript, list):
        transcript[:] = sanitized_rows
    summary = _N11621_PREVIOUS_BUILD_NARRATION_GROUNDING_SUMMARY(sanitized_rows)
    suppressed_count = sum(
        1 for row in _safe_list(sanitized_rows)
        if _safe_dict(row).get("unsupported_combat_claim_preselection_suppressed")
    )
    raw_count = suppressed_count + int(_safe_dict(summary.get("violation_counts")).get("unsupported_combat_claim") or 0)
    fallback_counts = dict(_safe_dict(summary.get("fallback_source_counts")))
    selected_counts = dict(_safe_dict(summary.get("selected_candidate_counts")))
    if suppressed_count:
        fallback_counts["llm_safe_fallback"] = int(fallback_counts.get("llm_safe_fallback") or 0) + suppressed_count
        fallback_counts["deterministic_fallback"] = max(0, int(fallback_counts.get("deterministic_fallback") or 0) - suppressed_count)
        selected_counts["llm_safe_fallback"] = int(selected_counts.get("llm_safe_fallback") or 0) + suppressed_count
        selected_counts["deterministic_fallback"] = max(0, int(selected_counts.get("deterministic_fallback") or 0) - suppressed_count)
        violation_counts = dict(_safe_dict(summary.get("violation_counts")))
        violation_counts.pop("unsupported_combat_claim", None)
        summary["violation_counts"] = dict(sorted(violation_counts.items()))
        summary["invalid_count"] = max(0, int(summary.get("invalid_count") or 0) - suppressed_count)
        summary["ok"] = int(summary.get("invalid_count") or 0) == 0
    summary["fallback_source_counts"] = dict(sorted(fallback_counts.items()))
    summary["selected_candidate_counts"] = dict(sorted(selected_counts.items()))
    summary["unsupported_combat_claim_preselection_suppressed_count"] = suppressed_count
    summary["raw_unsupported_combat_claim_count"] = raw_count
    summary["unsupported_combat_claim_preselection_suppression_match_ok"] = (suppressed_count == raw_count)
    summary["format_version"] = "narration_grounding_summary_v2_n11621"
    return summary


def _build_selected_output_grounding_health(
    narration_grounding_summary: Dict[str, Any],
    *,
    requested_turns: int,
) -> Dict[str, Any]:
    health = _N11621_PREVIOUS_BUILD_SELECTED_OUTPUT_GROUNDING_HEALTH(
        narration_grounding_summary,
        requested_turns=requested_turns,
    )
    summary = _safe_dict(narration_grounding_summary)
    suppressed = int(summary.get("unsupported_combat_claim_preselection_suppressed_count") or 0)
    raw_unsupported = int(summary.get("raw_unsupported_combat_claim_count") or 0)
    health = dict(_safe_dict(health))
    health["unsupported_combat_claim_preselection_suppressed_count"] = suppressed
    health["raw_unsupported_combat_claim_count"] = raw_unsupported
    health["unsupported_combat_claim_preselection_suppression_match_ok"] = (suppressed == raw_unsupported)
    if suppressed:
        fallback_counts = dict(_safe_dict(health.get("fallback_source_counts")))
        selected_counts = dict(_safe_dict(health.get("selected_candidate_counts")))
        fallback_counts["llm_safe_fallback"] = int(fallback_counts.get("llm_safe_fallback") or 0) + suppressed
        fallback_counts["deterministic_fallback"] = max(0, int(fallback_counts.get("deterministic_fallback") or 0) - suppressed)
        selected_counts["llm_safe_fallback"] = int(selected_counts.get("llm_safe_fallback") or 0) + suppressed
        selected_counts["deterministic_fallback"] = max(0, int(selected_counts.get("deterministic_fallback") or 0) - suppressed)
        health["fallback_source_counts"] = dict(sorted(fallback_counts.items()))
        health["selected_candidate_counts"] = dict(sorted(selected_counts.items()))
        health["deterministic_fallback_count"] = int(fallback_counts.get("deterministic_fallback") or 0)
        denominator = max(1, int(health.get("checked_count") or requested_turns or 1))
        health["deterministic_fallback_rate"] = health["deterministic_fallback_count"] / denominator
        health["llm_safe_fallback_count"] = int(fallback_counts.get("llm_safe_fallback") or 0)
        violation_counts = dict(_safe_dict(health.get("violation_counts")))
        violation_counts.pop("unsupported_combat_claim", None)
        health["violation_counts"] = dict(sorted(violation_counts.items()))
        health["raw_invalid_count"] = max(0, int(health.get("raw_invalid_count") or 0) - suppressed)
        health["ok"] = bool(health.get("ok", True)) and (suppressed == raw_unsupported)
    return health


def _n11621_category_bucket_for_action(action_text: Any) -> str:
    text = _safe_str(action_text).lower()
    if any(term in text for term in ("attack", "fight", "strike", "defend", "combat", "ambush")):
        return "combat"
    if any(term in text for term in ("travel", "follow", "road", "route", "warehouse", "gate", "leave", "go to")):
        return "travel"
    if any(term in text for term in ("inspect", "search", "study", "review", "decode", "evidence", "proof", "ledger", "orders", "manifest", "marks")):
        return "evidence"
    if any(term in text for term in ("ask", "tell", "warn", "report", "question", "confront", "present")):
        return "dialogue"
    return "general"


def _n11621_repair_pressure_by_category_from_summary(summary: Dict[str, Any], rows: List[Dict[str, Any]] | None = None) -> Dict[str, Any]:
    rows = _safe_list(rows)
    if rows:
        base = _n11620_repair_pressure_by_category(rows)
        if _safe_dict(base.get("categories")):
            base["format_version"] = "n11621_repair_pressure_by_category_v2"
            base["source"] = "final_transcript_rows"
            return base

    categories: Dict[str, Dict[str, Any]] = {}
    dialogue_summary = _safe_dict(summary.get("dialogue_action_relevance_summary"))
    for category, count in _safe_dict(dialogue_summary.get("by_action_kind")).items():
        bucket = categories.setdefault(
            _safe_str(category) or "unknown",
            {
                "turn_count": int(count or 0),
                "metadata_repaired_count": 0,
                "category_reclassified_count": 0,
                "dialogue_relevance_repaired_count": 0,
                "unsupported_combat_claim_suppressed_count": 0,
                "service_resolver_veto_count": 0,
                "example_turns": [],
            },
        )
        bucket["turn_count"] = max(bucket["turn_count"], int(count or 0))

    for example in _safe_list(dialogue_summary.get("examples")):
        example = _safe_dict(example)
        relevance = _safe_dict(example.get("relevance"))
        action = _safe_str(example.get("player_action"))
        category = _safe_str(relevance.get("validated_presentation_category")) or _n11621_category_bucket_for_action(action)
        bucket = categories.setdefault(
            category,
            {
                "turn_count": 0,
                "metadata_repaired_count": 0,
                "category_reclassified_count": 0,
                "dialogue_relevance_repaired_count": 0,
                "unsupported_combat_claim_suppressed_count": 0,
                "service_resolver_veto_count": 0,
                "example_turns": [],
            },
        )
        if example.get("repaired") or relevance.get("presentation_intent_sync_repaired"):
            bucket["dialogue_relevance_repaired_count"] += 1
        if len(bucket["example_turns"]) < 8:
            bucket["example_turns"].append({
                "turn_index": int(example.get("turn_index") or 0),
                "player_action": action[:220],
            })

    attachment = _safe_dict(summary.get("background_presentation_attachment_summary"))
    attachment_events = _safe_list(summary.get("background_presentation_attachment_events"))
    if attachment or attachment_events:
        bucket = categories.setdefault(
            "provider_attachment_all",
            {
                "turn_count": int(attachment.get("attached_row_count") or len(attachment_events) or 0),
                "metadata_repaired_count": 0,
                "category_reclassified_count": 0,
                "dialogue_relevance_repaired_count": 0,
                "unsupported_combat_claim_suppressed_count": 0,
                "service_resolver_veto_count": 0,
                "example_turns": [],
            },
        )
        bucket["turn_count"] = max(bucket["turn_count"], int(attachment.get("attached_row_count") or len(attachment_events) or 0))
        bucket["metadata_repaired_count"] = int(attachment.get("metadata_repaired_count") or 0)
        bucket["category_reclassified_count"] = int(attachment.get("category_reclassified_count") or 0)
        for event in attachment_events[:8]:
            event = _safe_dict(event)
            bucket["example_turns"].append({
                "turn_index": int(event.get("turn_index") or event.get("source_turn") or 0),
                "player_action": "background attachment event",
            })

    selected_health = _safe_dict(summary.get("selected_output_grounding_health"))
    unsupported = int(selected_health.get("unsupported_combat_claim_preselection_suppressed_count") or 0)
    if unsupported:
        bucket = categories.setdefault(
            "combat",
            {
                "turn_count": int(_safe_dict(dialogue_summary.get("by_action_kind")).get("combat") or 0),
                "metadata_repaired_count": 0,
                "category_reclassified_count": 0,
                "dialogue_relevance_repaired_count": 0,
                "unsupported_combat_claim_suppressed_count": 0,
                "service_resolver_veto_count": 0,
                "example_turns": [],
            },
        )
        bucket["unsupported_combat_claim_suppressed_count"] = unsupported

    for bucket in categories.values():
        turns = max(1, int(bucket.get("turn_count") or 0))
        bucket["metadata_repaired_rate"] = round(int(bucket.get("metadata_repaired_count") or 0) / turns, 4)
        bucket["category_reclassified_rate"] = round(int(bucket.get("category_reclassified_count") or 0) / turns, 4)
        bucket["dialogue_relevance_repaired_rate"] = round(int(bucket.get("dialogue_relevance_repaired_count") or 0) / turns, 4)
        bucket["unsupported_combat_claim_suppressed_rate"] = round(int(bucket.get("unsupported_combat_claim_suppressed_count") or 0) / turns, 4)
        bucket["service_resolver_veto_rate"] = round(int(bucket.get("service_resolver_veto_count") or 0) / turns, 4)

    return {
        "format_version": "n11621_repair_pressure_by_category_v2",
        "source": "summary_artifacts_and_attachment_events",
        "categories": categories,
        "category_count": len(categories),
    }


def _n11621_update_repair_pressure_breakdown(summary: Dict[str, Any], rows: List[Dict[str, Any]] | None = None) -> None:
    summary = _safe_dict(summary)
    llm_summary = _safe_dict(summary.get("llm_prompt_and_fallback_summary"))
    if not llm_summary:
        return
    breakdown = dict(_safe_dict(llm_summary.get("repair_pressure_breakdown")))
    by_category = _n11621_repair_pressure_by_category_from_summary(summary, rows)
    breakdown["repair_pressure_by_category"] = by_category
    selected_health = _safe_dict(summary.get("selected_output_grounding_health"))
    suppressed = int(selected_health.get("unsupported_combat_claim_preselection_suppressed_count") or 0)
    raw_unsupported = int(selected_health.get("raw_unsupported_combat_claim_count") or 0)
    breakdown["unsupported_combat_claim_preselection_suppressed_count"] = suppressed
    breakdown["raw_unsupported_combat_claim_count"] = raw_unsupported
    breakdown["unsupported_combat_claim_preselection_suppression_match_ok"] = (suppressed == raw_unsupported)
    dominant = dict(_safe_dict(breakdown.get("dominant_sources")))
    dominant["unsupported_combat_claim_preselection_suppressed"] = suppressed
    breakdown["dominant_sources"] = dominant
    breakdown["format_version"] = "n11621_repair_pressure_breakdown_v5"
    llm_summary["repair_pressure_breakdown"] = breakdown
    llm_summary["unsupported_combat_claim_cleanup"] = {
        "format_version": "unsupported_combat_claim_cleanup_v2_n11621",
        "preselection_suppressed_count": suppressed,
        "raw_unsupported_combat_claim_count": raw_unsupported,
        "suppression_match_ok": suppressed == raw_unsupported,
        "ok": suppressed == raw_unsupported,
        "policy": "unsupported combat claims are sanitized into llm_safe_fallback before deterministic fallback selection",
    }
    summary["llm_prompt_and_fallback_summary"] = llm_summary


def _build_llm_prompt_and_fallback_summary(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    sanitized_rows = _n11621_sanitize_rows_before_grounding_summary(rows)
    if isinstance(rows, list):
        rows[:] = sanitized_rows
    summary = _N11621_PREVIOUS_BUILD_LLM_PROMPT_AND_FALLBACK_SUMMARY(sanitized_rows)
    pseudo_summary = {"llm_prompt_and_fallback_summary": summary}
    _n11621_update_repair_pressure_breakdown(pseudo_summary, sanitized_rows)
    return _safe_dict(pseudo_summary.get("llm_prompt_and_fallback_summary"))


def _force_final_autoplay_health(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    rows = _safe_list(summary.get("final_transcript_rows") or summary.get("transcript_rows") or summary.get("transcript") or [])
    if rows:
        sanitized_rows = _n11621_sanitize_rows_before_grounding_summary(rows)
        if isinstance(summary.get("final_transcript_rows"), list):
            summary["final_transcript_rows"] = sanitized_rows
        elif isinstance(summary.get("transcript_rows"), list):
            summary["transcript_rows"] = sanitized_rows
        elif isinstance(summary.get("transcript"), list):
            summary["transcript"] = sanitized_rows
    if summary.get("narration_grounding_summary"):
        summary["selected_output_grounding_health"] = _build_selected_output_grounding_health(
            _safe_dict(summary.get("narration_grounding_summary")),
            requested_turns=int(summary.get("requested_turns") or summary.get("turns_executed") or 100),
        )
    _n11621_update_repair_pressure_breakdown(summary, rows)
    health = _N11621_PREVIOUS_FORCE_FINAL_AUTOPLAY_HEALTH(summary)
    selected_health = _safe_dict(summary.get("selected_output_grounding_health"))
    cleanup = _safe_dict(_safe_dict(summary.get("llm_prompt_and_fallback_summary")).get("unsupported_combat_claim_cleanup"))
    health = dict(_safe_dict(health))
    health["unsupported_combat_claim_preselection_suppressed_count"] = int(selected_health.get("unsupported_combat_claim_preselection_suppressed_count") or 0)
    health["raw_unsupported_combat_claim_count"] = int(selected_health.get("raw_unsupported_combat_claim_count") or 0)
    health["unsupported_combat_claim_preselection_suppression_match_ok"] = bool(
        selected_health.get("unsupported_combat_claim_preselection_suppression_match_ok", True)
    )
    if cleanup and not bool(cleanup.get("ok", True)):
        health["ok"] = False
        warnings = _safe_list(health.get("warnings"))
        if "unsupported_combat_claim_preselection_suppression_mismatch" not in warnings:
            warnings.append("unsupported_combat_claim_preselection_suppression_mismatch")
        health["warnings"] = warnings
        health["failed_gate_count"] = int(health.get("failed_gate_count") or 0) + 1
    return health

# =============================================================================
# N117.2 — 1000-Turn Readiness Gap Hardening Report
# =============================================================================
# Keep the existing 100-turn readiness gates authoritative, but add a separate
# 1000-turn candidate/gap report so scaffold coverage is not mistaken for real
# endurance readiness.
_N1172_PREVIOUS_BUILD_100_TURN_READINESS_SUMMARY = _build_100_turn_readiness_summary


def _n1172_count_any(mapping: Dict[str, Any], *keys: str) -> int:
    mapping = _safe_dict(mapping)
    total = 0
    for key in keys:
        value = mapping.get(key)
        if isinstance(value, bool):
            total += 1 if value else 0
            continue
        try:
            total += int(value or 0)
        except Exception:
            if isinstance(value, (list, tuple, set, dict)):
                total += len(value)
    return total


def _n1172_float_any(mapping: Dict[str, Any], *keys: str) -> float:
    mapping = _safe_dict(mapping)
    for key in keys:
        try:
            value = mapping.get(key)
            if value is not None:
                return float(value or 0.0)
        except Exception:
            continue
    return 0.0


def _n1172_summary_from_args(summary: Dict[str, Any], explicit: Optional[Dict[str, Any]], key: str) -> Dict[str, Any]:
    explicit_dict = _safe_dict(explicit)
    if explicit_dict:
        return explicit_dict
    return _safe_dict(_safe_dict(summary).get(key))


def _n1172_gate(ok: bool, *, value: Any, expected: str, message: str, severity: str = "advisory") -> Dict[str, Any]:
    return {
        "ok": bool(ok),
        "severity": severity,
        "value": value,
        "expected": expected,
        "message": message,
    }


def _n1172_transcript_growth_summary(summary: Dict[str, Any], transcript: List[Dict[str, Any]], requested_turns: int) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    turns = max(1, int(summary.get("turns_executed") or len(_safe_list(transcript)) or requested_turns or 1))
    explicit_bytes = int(
        summary.get("full_transcript_json_bytes_estimate")
        or summary.get("transcript_json_bytes_estimate")
        or _safe_dict(summary.get("transcript_artifact_quality_summary")).get("full_transcript_json_bytes_estimate")
        or 0
    )
    if explicit_bytes <= 0:
        try:
            explicit_bytes = len(json.dumps(_safe_list(transcript), ensure_ascii=False, default=str).encode("utf-8"))
        except Exception:
            explicit_bytes = 0
    bytes_per_turn = float(explicit_bytes) / float(turns) if turns else 0.0
    projected_1000 = int(bytes_per_turn * 1000.0) if bytes_per_turn else 0
    # Advisory budget: keep full transcript artifacts under 750 MB for 1000-turn runs.
    budget_1000 = 750 * 1024 * 1024
    return {
        "turns_sampled": turns,
        "bytes_sampled": explicit_bytes,
        "bytes_per_turn": round(bytes_per_turn, 2),
        "projected_1000_turn_bytes": projected_1000,
        "budget_1000_turn_bytes": budget_1000,
        "ok": bool(projected_1000 <= budget_1000) if projected_1000 else True,
    }


def _n1172_build_1000_turn_readiness_gap_report(
    *,
    summary: Dict[str, Any],
    transcript: List[Dict[str, Any]],
    requested_turns: int,
    hundred_turn_readiness: Dict[str, Any],
    world_state_compression_summary: Optional[Dict[str, Any]] = None,
    npc_agency_summary: Optional[Dict[str, Any]] = None,
    economy_pressure_summary: Optional[Dict[str, Any]] = None,
    combat_lifecycle_summary: Optional[Dict[str, Any]] = None,
    faction_consequence_summary: Optional[Dict[str, Any]] = None,
    dialogue_action_relevance_summary: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    transcript = _safe_list(transcript)
    hundred_turn_readiness = _safe_dict(hundred_turn_readiness)
    world_compression = _n1172_summary_from_args(summary, world_state_compression_summary, "world_state_compression_summary")
    npc_agency = _n1172_summary_from_args(summary, npc_agency_summary, "npc_agency_summary")
    economy_pressure = _n1172_summary_from_args(summary, economy_pressure_summary, "economy_pressure_summary")
    combat_lifecycle = _n1172_summary_from_args(summary, combat_lifecycle_summary, "combat_lifecycle_summary")
    faction_consequence = _n1172_summary_from_args(summary, faction_consequence_summary, "faction_consequence_summary")
    dialogue_relevance = _n1172_summary_from_args(summary, dialogue_action_relevance_summary, "dialogue_action_relevance_summary")

    compression_event_count = _n1172_count_any(world_compression, "compression_event_count", "event_count")
    latest_state_budget = _safe_dict(world_compression.get("latest_state_budget"))
    state_budget_ok = bool(latest_state_budget.get("ok", True))
    memory_aging_count = _n1172_count_any(
        world_compression,
        "npc_memory_dropped_count",
        "npc_memory_summarized_count",
        "memory_dropped_count",
        "memory_summarized_count",
        "aged_memory_count",
        "expired_memory_count",
    )
    compaction_count = _n1172_count_any(
        world_compression,
        "compacted_arc_count",
        "compacted_faction_count",
        "arc_history_compacted_count",
        "faction_history_compacted_count",
        "pressure_event_summarized_count",
        "old_pressure_event_summarized_count",
    )

    schedule_event_count = _n1172_count_any(npc_agency, "schedule_event_count")
    agency_event_count = _n1172_count_any(npc_agency, "agency_event_count", "autonomous_goal_event_count")
    goal_count = _n1172_count_any(npc_agency, "autonomous_goal_count", "goal_count", "active_goal_count")
    movement_count = _n1172_count_any(npc_agency, "movement_event_count", "location_movement_count", "schedule_event_count")

    economy_event_count = _n1172_count_any(economy_pressure, "event_count")
    recurring_expense_count = _n1172_count_any(economy_pressure, "recurring_expense_count", "upkeep_event_count", "paid_count")
    stock_refresh_count = _n1172_count_any(economy_pressure, "stock_refresh_count", "merchant_stock_refresh_count")
    scarcity_count = _n1172_count_any(economy_pressure, "scarcity_event_count", "price_variation_count", "location_price_modifier_count")

    encounter_count = _n1172_count_any(combat_lifecycle, "encounter_count")
    combat_event_count = _n1172_count_any(combat_lifecycle, "event_count")
    round_event_count = _n1172_count_any(combat_lifecycle, "total_round_events", "round_event_count", "initiative_event_count")
    resolved_encounter_count = _n1172_count_any(combat_lifecycle, "resolved_encounter_count")
    injury_count = _n1172_count_any(combat_lifecycle, "injury_count")
    direct_graph_combat_count = _n1172_count_any(combat_lifecycle, "direct_graph_combat_count")

    faction_event_count = _n1172_count_any(faction_consequence, "event_count", "world_signal_count")
    faction_compaction_count = _n1172_count_any(world_compression, "compacted_faction_count", "faction_history_compacted_count")
    dialogue_repair_rate = _n1172_float_any(dialogue_relevance, "repair_rate", "mismatch_rate")
    dialogue_repaired_count = _n1172_count_any(dialogue_relevance, "repaired_count")

    growth = _n1172_transcript_growth_summary(summary, transcript, requested_turns)

    gates = {
        "compression_loop_present": _n1172_gate(
            compression_event_count >= 1 and state_budget_ok,
            value={
                "compression_event_count": compression_event_count,
                "latest_state_budget": latest_state_budget,
            },
            expected="compression events occur and state budget remains OK",
            message="The long-run compression loop must be active before 1000-turn runs.",
        ),
        "memory_aging_real": _n1172_gate(
            memory_aging_count >= 1,
            value={
                "memory_aging_count": memory_aging_count,
                "npc_memory_dropped_count": world_compression.get("npc_memory_dropped_count"),
                "npc_memory_summarized_count": world_compression.get("npc_memory_summarized_count"),
            },
            expected="old NPC memories are dropped or summarized by deterministic budget policy",
            message="Memory aging is not yet proven; 1000-turn state may grow without bound.",
        ),
        "arc_faction_compaction_real": _n1172_gate(
            compaction_count >= 1,
            value={
                "compaction_count": compaction_count,
                "compacted_arc_count": world_compression.get("compacted_arc_count"),
                "compacted_faction_count": world_compression.get("compacted_faction_count"),
                "pressure_event_summarized_count": world_compression.get("pressure_event_summarized_count"),
            },
            expected="old arc/faction/pressure history is compacted or summarized",
            message="Arc/faction compaction is not yet proven for endurance runs.",
        ),
        "npc_schedule_present": _n1172_gate(
            schedule_event_count >= 1 and movement_count >= 1,
            value={
                "schedule_event_count": schedule_event_count,
                "movement_count": movement_count,
                "npc_count": npc_agency.get("npc_count"),
            },
            expected="NPC schedules/movement exist",
            message="Schedule-driven NPC presence should be visible before endurance runs.",
        ),
        "npc_goal_agency_real": _n1172_gate(
            agency_event_count >= 1 and goal_count >= 1,
            value={
                "agency_event_count": agency_event_count,
                "autonomous_goal_count": goal_count,
                "schedule_event_count": schedule_event_count,
                "memory_event_count": npc_agency.get("memory_event_count"),
            },
            expected="NPCs pursue autonomous goals, not only schedule/memory events",
            message="NPC agency is still mostly schedule/memory scaffolding.",
        ),
        "economy_pressure_foundation": _n1172_gate(
            economy_event_count >= 1 and recurring_expense_count >= 1,
            value={
                "event_count": economy_event_count,
                "recurring_expense_count": recurring_expense_count,
                "paid_count": economy_pressure.get("paid_count"),
                "warning_count": economy_pressure.get("warning_count"),
            },
            expected="recurring upkeep/resource pressure exists",
            message="Economy pressure should include recurring costs before endurance tests.",
        ),
        "economy_long_term_sinks_real": _n1172_gate(
            stock_refresh_count >= 1 and scarcity_count >= 1,
            value={
                "stock_refresh_count": stock_refresh_count,
                "scarcity_or_price_variation_count": scarcity_count,
            },
            expected="merchant stock refresh and scarcity/price variation are exercised",
            message="Long-term economy is missing stock refresh/scarcity pressure.",
        ),
        "combat_coverage_present": _n1172_gate(
            encounter_count >= 1 and combat_event_count >= 1,
            value={
                "encounter_count": encounter_count,
                "event_count": combat_event_count,
                "direct_graph_combat_count": direct_graph_combat_count,
            },
            expected="some deterministic combat/consequence coverage exists",
            message="Combat must at least appear in the deterministic run.",
        ),
        "combat_rounds_real": _n1172_gate(
            round_event_count >= 1 and (resolved_encounter_count >= 1 or injury_count >= 1),
            value={
                "round_event_count": round_event_count,
                "resolved_encounter_count": resolved_encounter_count,
                "injury_count": injury_count,
                "direct_graph_combat_count": direct_graph_combat_count,
            },
            expected="initiative/rounds plus injury/resolution lifecycle are exercised",
            message="Combat is still direct-graph/scaffold coverage, not a real lifecycle.",
        ),
        "faction_consequence_present": _n1172_gate(
            faction_event_count >= 1,
            value={
                "event_count": faction_consequence.get("event_count"),
                "world_signal_count": faction_consequence.get("world_signal_count"),
                "faction_compaction_count": faction_compaction_count,
            },
            expected="faction consequences exist",
            message="Faction consequences should remain visible in endurance reports.",
        ),
        "dialogue_repair_pressure_bounded": _n1172_gate(
            dialogue_repair_rate <= 0.35,
            value={
                "repaired_count": dialogue_repaired_count,
                "repair_or_mismatch_rate": dialogue_repair_rate,
            },
            expected="dialogue/action relevance repairs stay below 35%",
            message="High repair pressure can hide provider drift in long runs.",
        ),
        "transcript_growth_budget_projected_1000": _n1172_gate(
            bool(growth.get("ok", True)),
            value=growth,
            expected="projected 1000-turn transcript artifact stays below budget",
            message="Full transcript artifacts may become too large for 1000-turn endurance runs.",
        ),
    }

    blocked_reasons = [name for name, gate in gates.items() if not bool(_safe_dict(gate).get("ok"))]
    hard_blockers = [
        name
        for name, gate in gates.items()
        if not bool(_safe_dict(gate).get("ok")) and _safe_str(_safe_dict(gate).get("severity") or "advisory") == "hard"
    ]
    # For now these are hardening/advisory diagnostics: a 100-turn run can pass
    # while still clearly reporting why a 1000-turn run is blocked.
    readiness = {
        "format_version": "n1172_1000_turn_readiness_gap_report_v1",
        "ok": True,
        "requested_turns": requested_turns,
        "profile": "1000_turn_gap_hardening",
        "hundred_turn_ready": bool(hundred_turn_readiness.get("ok")),
        "one_thousand_turn_candidate": not blocked_reasons,
        "one_thousand_turn_blocked_reasons": blocked_reasons,
        "one_thousand_turn_hard_blockers": hard_blockers,
        "gates": gates,
        "rollup": {
            "compression_loop_present": bool(_safe_dict(gates.get("compression_loop_present")).get("ok")),
            "memory_compaction_real": bool(_safe_dict(gates.get("memory_aging_real")).get("ok"))
            and bool(_safe_dict(gates.get("arc_faction_compaction_real")).get("ok")),
            "npc_schedule_present": bool(_safe_dict(gates.get("npc_schedule_present")).get("ok")),
            "npc_goal_agency_real": bool(_safe_dict(gates.get("npc_goal_agency_real")).get("ok")),
            "economy_pressure_foundation": bool(_safe_dict(gates.get("economy_pressure_foundation")).get("ok")),
            "economy_long_term_sinks_real": bool(_safe_dict(gates.get("economy_long_term_sinks_real")).get("ok")),
            "combat_coverage_present": bool(_safe_dict(gates.get("combat_coverage_present")).get("ok")),
            "combat_rounds_real": bool(_safe_dict(gates.get("combat_rounds_real")).get("ok")),
            "transcript_growth_budget_ok": bool(_safe_dict(gates.get("transcript_growth_budget_projected_1000")).get("ok")),
        },
        "notes": [
            "This report is advisory for 100-turn runs and does not flip hundred_turn_readiness_summary.ok.",
            "It separates scaffold/direct-graph coverage from real endurance lifecycle readiness.",
            "Run 1000-turn tests only after one_thousand_turn_candidate is true or after accepting listed risks.",
        ],
    }
    return readiness


def _build_100_turn_readiness_summary(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    readiness = _N1172_PREVIOUS_BUILD_100_TURN_READINESS_SUMMARY(*args, **kwargs)
    try:
        gap_report = _n1172_build_1000_turn_readiness_gap_report(
            summary=_safe_dict(kwargs.get("summary")),
            transcript=_safe_list(kwargs.get("transcript")),
            requested_turns=int(kwargs.get("requested_turns") or 0),
            hundred_turn_readiness=_safe_dict(readiness),
            world_state_compression_summary=kwargs.get("world_state_compression_summary"),
            npc_agency_summary=kwargs.get("npc_agency_summary"),
            economy_pressure_summary=kwargs.get("economy_pressure_summary"),
            combat_lifecycle_summary=kwargs.get("combat_lifecycle_summary"),
            faction_consequence_summary=kwargs.get("faction_consequence_summary"),
            dialogue_action_relevance_summary=kwargs.get("dialogue_action_relevance_summary"),
        )
        readiness = dict(_safe_dict(readiness))
        readiness["one_thousand_turn_readiness_gap_report"] = gap_report
        readiness["one_thousand_turn_candidate"] = bool(gap_report.get("one_thousand_turn_candidate"))
        readiness["one_thousand_turn_blocked_reasons"] = _safe_list(gap_report.get("one_thousand_turn_blocked_reasons"))
        readiness["readiness_grades"] = {
            "hundred_turn_ready": bool(readiness.get("ok")),
            "one_thousand_turn_candidate": bool(gap_report.get("one_thousand_turn_candidate")),
            "one_thousand_turn_blocked_reasons": _safe_list(gap_report.get("one_thousand_turn_blocked_reasons")),
        }
    except Exception as exc:
        readiness = dict(_safe_dict(readiness))
        readiness["one_thousand_turn_readiness_gap_report"] = {
            "format_version": "n1172_1000_turn_readiness_gap_report_v1",
            "ok": False,
            "error": f"{type(exc).__name__}: {exc}",
            "one_thousand_turn_candidate": False,
            "one_thousand_turn_blocked_reasons": ["gap_report_builder_exception"],
        }
        readiness["one_thousand_turn_candidate"] = False
        readiness["one_thousand_turn_blocked_reasons"] = ["gap_report_builder_exception"]
    return readiness


def _n1172_html_escape(value: Any) -> str:
    return _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _n1172_render_1000_turn_gap_section(final_summary: Dict[str, Any]) -> str:
    final_summary = _safe_dict(final_summary)
    readiness = _safe_dict(final_summary.get("hundred_turn_readiness_summary"))
    gap = _safe_dict(
        final_summary.get("one_thousand_turn_readiness_gap_report")
        or readiness.get("one_thousand_turn_readiness_gap_report")
    )
    if not gap:
        return ""
    esc = _n1172_html_escape
    blocked = _safe_list(gap.get("one_thousand_turn_blocked_reasons"))
    rollup = _safe_dict(gap.get("rollup"))
    rows = []
    for key, gate_any in _safe_dict(gap.get("gates")).items():
        gate = _safe_dict(gate_any)
        status = "OK" if bool(gate.get("ok")) else "Gap"
        css = "quality" if bool(gate.get("ok")) else "danger"
        rows.append(
            f"""
            <tr>
              <td>{esc(key)}</td>
              <td><span class=\"badge {css}\">{esc(status)}</span></td>
              <td>{esc(gate.get('expected'))}</td>
              <td>{esc(gate.get('message'))}</td>
            </tr>
            """
        )
    return f"""
    <section class=\"card\" id=\"one-thousand-turn-readiness-gaps\">
      <h2>1000-Turn Readiness Gaps</h2>
      <p class=\"muted\">Separates 100-turn scaffold coverage from true endurance readiness. This section is advisory for 100-turn runs.</p>
      <div class=\"grid metrics-grid\">
        <div class=\"metric\"><strong>100-Turn Ready</strong><span>{esc(gap.get('hundred_turn_ready'))}</span></div>
        <div class=\"metric\"><strong>1000-Turn Candidate</strong><span>{esc(gap.get('one_thousand_turn_candidate'))}</span></div>
        <div class=\"metric\"><strong>Blocked Reasons</strong><span>{esc(len(blocked))}</span></div>
      </div>
      <h3>Blocked Reasons</h3>
      <pre>{esc(json.dumps(blocked, ensure_ascii=False, indent=2, default=str))}</pre>
      <h3>Rollup</h3>
      <pre>{esc(json.dumps(rollup, ensure_ascii=False, indent=2, default=str))}</pre>
      <h3>Gate Details</h3>
      <table class=\"readiness-table\">
        <thead><tr><th>Gate</th><th>Status</th><th>Expected</th><th>Message</th></tr></thead>
        <tbody>{''.join(rows)}</tbody>
      </table>
      <details>
        <summary>Raw 1000-turn readiness gap report</summary>
        <pre>{esc(json.dumps(gap, ensure_ascii=False, indent=2, default=str))}</pre>
      </details>
    </section>
    """



# =============================================================================
# N117.2.1 — Readiness Gap Report Source Consistency
# =============================================================================
# The N117.2 1000-turn gap report can be first embedded while the 100-turn
# readiness summary is being built.  Later artifact summaries can be refined
# (notably dialogue-action-relevance-summary.json).  Refresh the gap report
# before HTML/ZIP persistence so report values and artifact values agree.

_N11721_GATE_SOURCES: Dict[str, str] = {
    "compression_loop_present": "world-state-compression-summary.json",
    "memory_aging_real": "world-state-compression-summary.json",

    "arc_faction_compaction_real": "world-state-compression-summary.json + faction-consequence-summary.json",
    "npc_schedule_present": "npc-agency-summary.json",
    "npc_goal_agency_real": "npc-agency-summary.json",
    "economy_pressure_foundation": "economy-pressure-summary.json",
    "economy_long_term_sinks_real": "economy-pressure-summary.json",
    "combat_coverage_present": "combat-lifecycle-summary.json",
    "combat_rounds_real": "combat-lifecycle-summary.json",
    "faction_consequence_present": "faction-consequence-summary.json",
    "dialogue_repair_pressure_bounded": "dialogue-action-relevance-summary.json",
    "transcript_growth_budget_projected_1000": "transcript-size-summary.json + final transcript rows",
}


def _n11721_dialogue_summary_for_gap_report(summary: Dict[str, Any]) -> tuple[Dict[str, Any], str]:
    summary = _safe_dict(summary)
    dialogue_action = _safe_dict(summary.get("dialogue_action_relevance_summary"))
    if dialogue_action:
        return dialogue_action, "dialogue-action-relevance-summary.json"

    dialogue_repair_quality = _safe_dict(summary.get("dialogue_repair_quality_summary"))
    if dialogue_repair_quality:
        # Keep the same count/rate field names expected by the N117.2 builder.
        normalized = dict(dialogue_repair_quality)
        if "repaired_count" not in normalized and "dialogue_relevance_repaired_count" in normalized:
            normalized["repaired_count"] = normalized.get("dialogue_relevance_repaired_count")
        if "repair_rate" not in normalized and "dialogue_relevance_repair_rate" in normalized:
            normalized["repair_rate"] = normalized.get("dialogue_relevance_repair_rate")
        return normalized, "dialogue-repair-quality-summary.json"

    embedded = _safe_dict(summary.get("dialogue_relevance_summary"))
    if embedded:
        return embedded, "summary.dialogue_relevance_summary"
    return {}, "missing"


def _n11721_gate_value_repaired_count(gap_report: Dict[str, Any]) -> int:
    gate = _safe_dict(_safe_dict(gap_report).get("gates")).get("dialogue_repair_pressure_bounded")
    value = _safe_dict(_safe_dict(gate).get("value"))
    try:
        return int(value.get("repaired_count") or 0)
    except Exception:
        return 0


def _n11721_gate_value_repair_rate(gap_report: Dict[str, Any]) -> float:
    gate = _safe_dict(_safe_dict(gap_report).get("gates")).get("dialogue_repair_pressure_bounded")
    value = _safe_dict(_safe_dict(gate).get("value"))
    try:
        return float(value.get("repair_or_mismatch_rate") or 0.0)
    except Exception:
        return 0.0


def _n11721_add_gap_gate_sources(gap_report: Dict[str, Any], *, dialogue_source: str) -> Dict[str, Any]:
    gap_report = dict(_safe_dict(gap_report))
    gates = {}
    for name, gate_any in _safe_dict(gap_report.get("gates")).items():
        gate = dict(_safe_dict(gate_any))
        source = _N11721_GATE_SOURCES.get(name, "summary.json")
        if name == "dialogue_repair_pressure_bounded" and dialogue_source:
            source = dialogue_source
        gate.setdefault("source", source)
        gate.setdefault("source_artifact", source)
        gates[name] = gate
    gap_report["gates"] = gates
    gap_report["source_fields_added"] = True
    gap_report["source_map"] = dict(_N11721_GATE_SOURCES)
    if dialogue_source:
        gap_report["source_map"]["dialogue_repair_pressure_bounded"] = dialogue_source
    return gap_report


def _n11721_build_gap_report_source_consistency(
    *,
    previous_gap_report: Dict[str, Any],
    refreshed_gap_report: Dict[str, Any],
    dialogue_summary: Dict[str, Any],
    dialogue_source: str,
) -> Dict[str, Any]:
    previous_count = _n11721_gate_value_repaired_count(previous_gap_report)
    refreshed_count = _n11721_gate_value_repaired_count(refreshed_gap_report)
    artifact_count = _n1172_count_any(_safe_dict(dialogue_summary), "repaired_count")
    previous_rate = _n11721_gate_value_repair_rate(previous_gap_report)
    refreshed_rate = _n11721_gate_value_repair_rate(refreshed_gap_report)
    artifact_rate = _n1172_float_any(_safe_dict(dialogue_summary), "repair_rate", "mismatch_rate")
    return {
        "format_version": "n11721_readiness_gap_source_consistency_v1",
        "ok": refreshed_count == artifact_count,
        "advisory_only": True,
        "dialogue_repair_count_source": dialogue_source,
        "previous_gap_dialogue_repaired_count": previous_count,
        "refreshed_gap_dialogue_repaired_count": refreshed_count,
        "artifact_dialogue_repaired_count": artifact_count,
        "previous_gap_repair_or_mismatch_rate": previous_rate,
        "refreshed_gap_repair_or_mismatch_rate": refreshed_rate,
        "artifact_repair_or_mismatch_rate": artifact_rate,
        "changed_by_refresh": previous_count != refreshed_count or previous_rate != refreshed_rate,
        "message": "1000-turn readiness gap report was refreshed from final artifact summaries before persistence.",
    }


def _n11721_refresh_1000_turn_readiness_gap_report_sources(
    summary: Dict[str, Any],
    transcript: List[Dict[str, Any]],
    *,
    requested_turns: int,
) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    if not summary:
        return summary

    readiness = dict(_safe_dict(summary.get("hundred_turn_readiness_summary")))
    previous_gap = _safe_dict(
        summary.get("one_thousand_turn_readiness_gap_report")
        or readiness.get("one_thousand_turn_readiness_gap_report")
    )
    dialogue_summary, dialogue_source = _n11721_dialogue_summary_for_gap_report(summary)

    try:
        refreshed = _n1172_build_1000_turn_readiness_gap_report(
            summary=summary,
            transcript=_safe_list(transcript),
            requested_turns=int(
                requested_turns
                or summary.get("requested_turns")
                or summary.get("turns_executed")
                or len(_safe_list(transcript))
                or 0
            ),
            hundred_turn_readiness=readiness,
            world_state_compression_summary=summary.get("world_state_compression_summary"),
            npc_agency_summary=summary.get("npc_agency_summary"),
            economy_pressure_summary=summary.get("economy_pressure_summary"),
            combat_lifecycle_summary=summary.get("combat_lifecycle_summary"),
            faction_consequence_summary=summary.get("faction_consequence_summary"),
            dialogue_action_relevance_summary=dialogue_summary,
        )
        refreshed = _n11721_add_gap_gate_sources(
            refreshed,
            dialogue_source=dialogue_source,
        )
        consistency = _n11721_build_gap_report_source_consistency(
            previous_gap_report=previous_gap,
            refreshed_gap_report=refreshed,
            dialogue_summary=dialogue_summary,
            dialogue_source=dialogue_source,
        )
        refreshed["source_consistency"] = consistency
        refreshed["format_version"] = "n11721_1000_turn_readiness_gap_report_v2"
        refreshed["refreshed_before_artifact_write"] = True

        summary["one_thousand_turn_readiness_gap_report"] = refreshed
        readiness["one_thousand_turn_readiness_gap_report"] = refreshed
        readiness["one_thousand_turn_candidate"] = bool(refreshed.get("one_thousand_turn_candidate"))
        readiness["one_thousand_turn_blocked_reasons"] = _safe_list(refreshed.get("one_thousand_turn_blocked_reasons"))
        readiness["readiness_grades"] = {
            "hundred_turn_ready": bool(readiness.get("ok")),
            "one_thousand_turn_candidate": bool(refreshed.get("one_thousand_turn_candidate")),
            "one_thousand_turn_blocked_reasons": _safe_list(refreshed.get("one_thousand_turn_blocked_reasons")),
        }
        summary["hundred_turn_readiness_summary"] = readiness
        summary["n11721_readiness_gap_source_consistency"] = consistency
    except Exception as exc:
        summary["n11721_readiness_gap_source_consistency"] = {
            "format_version": "n11721_readiness_gap_source_consistency_v1",
            "ok": False,
            "advisory_only": True,
            "refresh_error": f"{type(exc).__name__}: {exc}",
            "message": "Failed to refresh 1000-turn readiness gap report from final artifact summaries; 100-turn run remains authoritative.",
        }
    return summary

def _n1172_inject_1000_turn_gap_section(html_report: Any, final_summary: Dict[str, Any]) -> str:
    html = _safe_str(html_report)
    section = _n1172_render_1000_turn_gap_section(final_summary)
    if not section or "one-thousand-turn-readiness-gaps" in html:
        return html
    nav_link = '<a href="#one-thousand-turn-readiness-gaps">1000-Turn Readiness</a>'
    if "<nav" in html and nav_link not in html:
        html = html.replace("</nav>", f"{nav_link}</nav>", 1)
    marker = '<section class="card" id="summary">'
    if marker in html:
        return html.replace(marker, section + "\n" + marker, 1)
    body_marker = "</body>"
    if body_marker in html:
        return html.replace(body_marker, section + "\n" + body_marker, 1)
    return html + section

def main(argv: List[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    args = _apply_autoplay_profile_defaults(args)
    _assert_real_autoplay_runner_present()
    if (
        _safe_str(getattr(args, "autoplay_profile", "")) == "smoke_100"
        and int(getattr(args, "turns", 0) or 0) != 100
    ):
        _timestamped_print(
            f"[AUTOPLAY-WARN] smoke_100 profile running with explicit --turns={getattr(args, 'turns', None)}"
        )
    if getattr(args, "list_scenario_seeds", False):
        for name in available_campaign_seeds():
            _timestamped_print(name)
        return 0
    return _run_with_console_capture(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

# N117.8 -- Quality Gate Rollup Consistency + Background Provider Error Classification
# Loaded late so it can wrap split-fragment helpers without touching the run-loop
# fragments directly.
_N1178_PREVIOUS_SUMMARIZE_QUALITY_GATES = globals().get("_summarize_quality_gates")
_N1178_PREVIOUS_FINAL_LIFECYCLE_QUALITY_GATES = globals().get("_final_lifecycle_quality_gates")
_N1178_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N1178_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")
_N1178_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")


def _n1178_html_escape(value: Any) -> str:
    return _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def _n1178_unique_lines(lines: List[Any]) -> List[str]:
    out: List[str] = []
    seen = set()
    for line in _safe_list(lines):
        text = _safe_str(line).strip()
        if not text or text in seen:
            continue
        seen.add(text)
        out.append(text)
    return out


def _n1178_console_error_lines(summary: Dict[str, Any]) -> List[str]:
    console = _safe_dict(_safe_dict(summary).get("console_log_summary"))
    lines: List[Any] = []
    lines.extend(_safe_list(console.get("turn_errors")))
    lines.extend(_safe_list(console.get("errors")))
    for warning in _safe_list(_safe_dict(summary).get("long_run_warning_summary").get("warnings")):
        details = _safe_dict(_safe_dict(warning).get("details"))
        lines.extend(_safe_list(details.get("turn_errors")))
    return _n1178_unique_lines(lines)


def _n1178_parse_background_provider_error(line: str) -> Dict[str, Any]:
    import re

    text = _safe_str(line).strip()
    pattern = re.compile(
        r"^Error in (?P<phase>combined background LLM job|background LLM job|deferred narration job|deferred advisory job) "
        r"for turn (?P<turn>\d+): (?P<message>.*)$"
    )
    match = pattern.match(text)
    if not match:
        return {}

    message = _safe_str(match.group("message"))
    status_match = re.search(r"HTTP error\s+(?P<status>\d+)", message)
    url_match = re.search(r"url:\s*(?P<url>[^;\s]+)", message)
    no_model = "no models loaded" in message.lower()
    invalid_request = "invalid_request_error" in message.lower() or "bad request" in message.lower()
    return {
        "turn_index": int(match.group("turn") or 0),
        "phase": _safe_str(match.group("phase")),
        "status_code": int(status_match.group("status")) if status_match else None,
        "url": _safe_str(url_match.group("url")) if url_match else "",
        "category": "background_llm_provider_error",
        "provider_failure_kind": "no_model_loaded" if no_model else ("invalid_request" if invalid_request else "provider_error"),
        "message": message[:800],
        "raw_line": text[:1000],
    }


def _n1178_build_provider_error_classification_summary(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    console = _safe_dict(summary.get("console_log_summary"))
    raw_turn_error_count = int(console.get("turn_error_count") or 0)
    lines = _n1178_console_error_lines(summary)

    provider_errors: List[Dict[str, Any]] = []
    deterministic_turn_errors: List[str] = []
    for line in lines:
        parsed = _n1178_parse_background_provider_error(line)
        if parsed:
            provider_errors.append(parsed)
        elif line.lower().startswith("error in ") or " turn " in line.lower() or "traceback" in line.lower():
            deterministic_turn_errors.append(line[:1000])

    # If console_log_summary.turn_error_count was larger than the visible retained
    # turn_errors list, keep the unknown remainder visible instead of declaring it
    # deterministic. The retained lines are enough to classify the known cause.
    classified_provider_count = len(provider_errors)
    deterministic_count = len(deterministic_turn_errors)
    unknown_retained_turn_error_count = max(0, raw_turn_error_count - classified_provider_count - deterministic_count)

    by_phase: Dict[str, int] = {}
    by_status: Dict[str, int] = {}
    by_kind: Dict[str, int] = {}
    turns: List[int] = []
    for item in provider_errors:
        phase = _safe_str(item.get("phase") or "unknown")
        status = _safe_str(item.get("status_code") or "unknown")
        kind = _safe_str(item.get("provider_failure_kind") or "provider_error")
        by_phase[phase] = int(by_phase.get(phase, 0)) + 1
        by_status[status] = int(by_status.get(status, 0)) + 1
        by_kind[kind] = int(by_kind.get(kind, 0)) + 1
        turn_index = int(item.get("turn_index") or 0)
        if turn_index:
            turns.append(turn_index)

    return {
        "format_version": "n1178_provider_error_classification_summary_v1",
        "ok": deterministic_count == 0,
        "raw_console_turn_error_count": raw_turn_error_count,
        "background_provider_error_count": classified_provider_count,
        "deterministic_turn_error_count": deterministic_count,
        "unknown_retained_turn_error_count": unknown_retained_turn_error_count,
        "provider_errors_are_runtime_errors": False,
        "classification_note": (
            "Background LLM provider failures are reported separately from deterministic turn-loop/runtime errors."
        ),
        "by_phase": dict(sorted(by_phase.items())),
        "by_status_code": dict(sorted(by_status.items())),
        "by_provider_failure_kind": dict(sorted(by_kind.items())),
        "first_turn": min(turns) if turns else None,
        "last_turn": max(turns) if turns else None,
        "turns": sorted(set(turns))[:200],
        "provider_errors": provider_errors[:100],
        "deterministic_turn_errors": deterministic_turn_errors[:50],
    }


def _n1178_long_run_warnings_only_provider_errors(summary: Dict[str, Any], provider_summary: Dict[str, Any]) -> bool:
    long_run = _safe_dict(_safe_dict(summary).get("long_run_warning_summary"))
    warnings = [_safe_dict(item) for item in _safe_list(long_run.get("warnings"))]
    if not warnings:
        return False
    if int(provider_summary.get("background_provider_error_count") or 0) <= 0:
        return False
    if int(provider_summary.get("deterministic_turn_error_count") or 0) > 0:
        return False
    return all(_safe_str(item.get("code")) == "console_turn_errors" for item in warnings)


def _n1178_apply_provider_error_classification(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    provider_summary = _n1178_build_provider_error_classification_summary(summary)
    summary["provider_error_classification_summary"] = provider_summary

    console = _safe_dict(summary.get("console_log_summary"))
    if console:
        console["background_provider_error_count"] = provider_summary.get("background_provider_error_count")
        console["deterministic_turn_error_count"] = provider_summary.get("deterministic_turn_error_count")
        console["effective_turn_error_count"] = provider_summary.get("deterministic_turn_error_count")
        console["provider_error_classification_applied"] = True
        summary["console_log_summary"] = console

    if _n1178_long_run_warnings_only_provider_errors(summary, provider_summary):
        long_run = dict(_safe_dict(summary.get("long_run_warning_summary")))
        warnings = []
        for warning in _safe_list(long_run.get("warnings")):
            item = dict(_safe_dict(warning))
            item["severity"] = "warning"
            item["provider_error_reclassified"] = True
            item["message"] = "Background provider errors were classified separately from deterministic turn errors."
            warnings.append(item)
        long_run["ok"] = True
        long_run["error_count"] = 0
        long_run["warning_count"] = len(warnings)
        long_run["warnings"] = warnings
        long_run["provider_error_classification_applied"] = True
        summary["long_run_warning_summary"] = long_run

    return summary


def _n1178_gate_bool(value: Any) -> bool:
    if isinstance(value, dict) and "ok" in value:
        return bool(value.get("ok"))
    return bool(value)


def _n1178_fix_quality_gate_rollup(gate_summary: Dict[str, Any], summary: Dict[str, Any]) -> Dict[str, Any]:
    gate_summary = dict(_safe_dict(gate_summary))
    gates = dict(_safe_dict(gate_summary.get("gates")))
    summary = _n1178_apply_provider_error_classification(summary)
    provider_summary = _safe_dict(summary.get("provider_error_classification_summary"))

    hundred_eval = _safe_dict(summary.get("hundred_turn_evaluation")) or _safe_dict(summary.get("hundred_turn_eval_summary"))
    if hundred_eval:
        gates["hundred_turn_eval_ok"] = bool(hundred_eval.get("ok", True))

    if provider_summary:
        gates["console_turn_errors_absent"] = int(provider_summary.get("deterministic_turn_error_count") or 0) == 0
        if _n1178_long_run_warnings_only_provider_errors(summary, provider_summary):
            gates["long_run_warnings_ok"] = True
        gates["background_provider_errors_classified"] = True

    failed = [name for name, value in gates.items() if not _n1178_gate_bool(value)]
    gate_summary["gates"] = gates
    gate_summary["failed_gates"] = failed
    gate_summary["ok"] = not failed
    gate_summary["n1178_rollup_consistency_applied"] = True
    return gate_summary


def _summarize_quality_gates(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N1178_PREVIOUS_SUMMARIZE_QUALITY_GATES):
        gate_summary = _N1178_PREVIOUS_SUMMARIZE_QUALITY_GATES(*args, **kwargs)
    else:
        gate_summary = {"ok": True, "gates": {}}
    summary = _safe_dict(kwargs.get("summary"))
    return _n1178_fix_quality_gate_rollup(gate_summary, summary)


def _final_lifecycle_quality_gates(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _n1178_apply_provider_error_classification(summary)
    if callable(_N1178_PREVIOUS_FINAL_LIFECYCLE_QUALITY_GATES):
        gate_summary = _N1178_PREVIOUS_FINAL_LIFECYCLE_QUALITY_GATES(summary)
    else:
        gate_summary = _safe_dict(summary.get("quality_gate_summary")) or {"ok": True, "gates": {}}
    return _n1178_fix_quality_gate_rollup(gate_summary, summary)


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N1178_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N1178_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    return _n1178_apply_provider_error_classification(summary)


def _n1178_provider_error_html_section(summary: Dict[str, Any]) -> str:
    provider = _safe_dict(_safe_dict(summary).get("provider_error_classification_summary"))
    if not provider:
        provider = _n1178_build_provider_error_classification_summary(summary)
    rows = []
    for item in _safe_list(provider.get("provider_errors"))[:20]:
        item = _safe_dict(item)
        rows.append(
            "<tr>"
            f"<td>{_n1178_html_escape(item.get('turn_index'))}</td>"
            f"<td>{_n1178_html_escape(item.get('phase'))}</td>"
            f"<td>{_n1178_html_escape(item.get('status_code'))}</td>"
            f"<td>{_n1178_html_escape(item.get('provider_failure_kind'))}</td>"
            f"<td>{_n1178_html_escape(item.get('message'))}</td>"
            "</tr>"
        )
    body = "".join(rows) or "<tr><td colspan=\"5\">No background provider failures classified.</td></tr>"
    return (
        "<section id=\"provider-error-classification\" class=\"card\">"
        "<h2>N117.8 Provider Error Classification</h2>"
        "<p>Background LLM provider failures are separated from deterministic turn-loop/runtime errors.</p>"
        "<ul>"
        f"<li>Background provider errors: {_n1178_html_escape(provider.get('background_provider_error_count'))}</li>"
        f"<li>Deterministic turn errors: {_n1178_html_escape(provider.get('deterministic_turn_error_count'))}</li>"
        f"<li>Status counts: {_n1178_html_escape(provider.get('by_status_code'))}</li>"
        f"<li>Failure kinds: {_n1178_html_escape(provider.get('by_provider_failure_kind'))}</li>"
        "</ul>"
        "<table><thead><tr><th>Turn</th><th>Phase</th><th>Status</th><th>Kind</th><th>Message</th></tr></thead>"
        f"<tbody>{body}</tbody></table>"
        "</section>"
    )


def _n1178_inject_provider_error_classification_section(html_report: str, summary: Dict[str, Any]) -> str:
    html_text = _safe_str(html_report)
    if "id=\"provider-error-classification\"" in html_text:
        return html_text
    section = _n1178_provider_error_html_section(summary)
    lower = html_text.lower()
    index = lower.rfind("</body>")
    if index >= 0:
        return html_text[:index] + section + html_text[index:]
    return html_text + section


def _n1172_inject_1000_turn_gap_section(html_report: str, final_summary: Dict[str, Any]) -> str:
    if callable(_N1178_PREVIOUS_N1172_INJECT_1000_SECTION):
        html_report = _N1178_PREVIOUS_N1172_INJECT_1000_SECTION(html_report, final_summary)
    return _n1178_inject_provider_error_classification_section(html_report, final_summary)


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N1178_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N1178_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    provider_summary = _safe_dict(_n1178_apply_provider_error_classification(value).get("provider_error_classification_summary"))
    artifact_name = "provider-error-classification-summary.json"
    generated_files = artifact_manifest.setdefault("generated_files", [])
    if artifact_name in generated_files:
        return result
    serialized = json.dumps(provider_summary, ensure_ascii=False, indent=2, sort_keys=True, default=str)
    zip_handle.writestr(artifact_name, serialized)
    generated_files.append(artifact_name)
    if callable(_N1178_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        _N1178_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(
            zip_handle,
            artifact_manifest,
            artifact_name,
            provider_summary,
            serialized_text=serialized,
            force=True,
        )
    return result

# N118 -- Real Combat Lifecycle Evidence + 1000-Turn Gate Wiring
# Late-loaded wrapper: keeps the split runtime stable while adding a stricter
# distinction between direct-graph combat coverage and real round/damage/
# resolution lifecycle evidence.
_N118_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N118_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")
_N118_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")


def _n1178_console_error_lines(summary: Dict[str, Any]) -> List[str]:
    """N118 carry-forward: make the N117.8 provider classifier null-safe."""
    console = _safe_dict(_safe_dict(summary).get("console_log_summary"))
    lines: List[Any] = []
    lines.extend(_safe_list(console.get("turn_errors")))
    lines.extend(_safe_list(console.get("errors")))
    long_run = _safe_dict(_safe_dict(summary).get("long_run_warning_summary"))
    for warning in _safe_list(long_run.get("warnings")):
        details = _safe_dict(_safe_dict(warning).get("details"))
        lines.extend(_safe_list(details.get("turn_errors")))
    if "_n1178_unique_lines" in globals() and callable(globals().get("_n1178_unique_lines")):
        return globals()["_n1178_unique_lines"](lines)
    out: List[str] = []
    seen = set()
    for line in lines:
        text = _safe_str(line).strip()
        if text and text not in seen:
            seen.add(text)
            out.append(text)
    return out


def _n118_walk_values(value: Any) -> List[Any]:
    stack = [value]
    out: List[Any] = []
    while stack:
        item = stack.pop()
        out.append(item)
        if isinstance(item, dict):
            stack.extend(item.values())
        elif isinstance(item, list):
            stack.extend(item)
    return out


def _n118_event_text(event: Dict[str, Any]) -> str:
    event = _safe_dict(event)
    parts: List[str] = []
    for key in (
        "type", "kind", "subtype", "event_type", "mechanic", "mechanics",
        "action", "action_type", "status", "outcome", "summary", "message",
        "reason", "effect", "changed_parts",
    ):
        value = event.get(key)
        if isinstance(value, list):
            parts.extend(_safe_str(v) for v in value)
        else:
            parts.append(_safe_str(value))
    return " ".join(part for part in parts if part).lower()


def _n118_collect_event_dicts(row: Dict[str, Any]) -> List[Dict[str, Any]]:
    row = _safe_dict(row)
    events: List[Dict[str, Any]] = []
    preferred_keys = (
        "events", "world_events", "runtime_events", "mechanics_events",
        "combat_events", "lifecycle_events", "state_events",
        "direct_graph_events", "turn_events", "progress_events",
    )
    for key in preferred_keys:
        for item in _safe_list(row.get(key)):
            item = _safe_dict(item)
            if item:
                events.append(item)
    for value in _n118_walk_values(row):
        if not isinstance(value, dict):
            continue
        text = _n118_event_text(value)
        if any(token in text for token in ("combat", "initiative", "attack", "damage", "defeat", "wound", "hp")):
            events.append(value)
    unique: List[Dict[str, Any]] = []
    seen = set()
    for event in events:
        marker = json.dumps(event, sort_keys=True, default=str)[:2000]
        if marker in seen:
            continue
        seen.add(marker)
        unique.append(event)
    return unique


def _n118_turn_text(row: Dict[str, Any]) -> str:
    row = _safe_dict(row)
    parts = [
        row.get("player_action"),
        row.get("canonical_turn_action"),
        row.get("narration"),
        row.get("selected_narration"),
    ]
    direct = _safe_dict(row.get("direct_graph_action_completion"))
    parts.extend(_safe_list(direct.get("mechanics")))
    parts.extend(_safe_list(direct.get("changed_parts")))
    parts.append(direct.get("action_id"))
    return " ".join(_safe_str(part) for part in parts if part).lower()


def _n118_is_direct_graph_only(row: Dict[str, Any]) -> bool:
    direct = _safe_dict(_safe_dict(row).get("direct_graph_action_completion"))
    if bool(direct.get("completed")):
        mechanics = " ".join(_safe_str(v) for v in _safe_list(direct.get("mechanics"))).lower()
        changed = " ".join(_safe_str(v) for v in _safe_list(direct.get("changed_parts"))).lower()
        action_id = _safe_str(direct.get("action_id")).lower()
        return any(token in " ".join([mechanics, changed, action_id]) for token in ("combat", "attack", "defeat"))
    return False


def _n118_classify_combat_event(event: Dict[str, Any]) -> Dict[str, bool]:
    text = _n118_event_text(event)
    has_round = any(token in text for token in ("combat_round", "round", "initiative", "turn_order", "combat_turn"))
    has_damage = any(token in text for token in ("damage", "hp", "wound", "injury", "hit_points"))
    has_resolution = any(token in text for token in ("defeat", "defeated", "resolved", "victory", "fled", "surrender"))
    has_attack = any(token in text for token in ("attack", "strike", "enemy_ai", "combat_ai"))
    return {
        "round": has_round,
        "damage": has_damage,
        "resolution": has_resolution,
        "attack": has_attack,
        "combat": "combat" in text or has_round or has_damage or has_resolution or has_attack,
    }


def _n118_build_real_combat_lifecycle_summary(
    summary: Dict[str, Any],
    transcript: List[Dict[str, Any]],
) -> Dict[str, Any]:
    existing = _safe_dict(_safe_dict(summary).get("combat_lifecycle_summary"))
    rows = [_safe_dict(row) for row in _safe_list(transcript)]
    round_events: List[Dict[str, Any]] = []
    damage_events: List[Dict[str, Any]] = []
    attack_events: List[Dict[str, Any]] = []
    resolution_events: List[Dict[str, Any]] = []
    direct_graph_turns: List[int] = []
    combat_text_turns: List[int] = []
    examples: List[Dict[str, Any]] = []

    for row in rows:
        turn = int(row.get("turn_index") or row.get("turn") or 0)
        text = _n118_turn_text(row)
        if any(token in text for token in ("combat", "attack", "bandit", "ambush", "defeat")):
            combat_text_turns.append(turn)
        if _n118_is_direct_graph_only(row):
            direct_graph_turns.append(turn)
        for event in _n118_collect_event_dicts(row):
            flags = _n118_classify_combat_event(event)
            if not flags.get("combat"):
                continue
            row_event = {
                "turn": turn,
                "type": event.get("type") or event.get("kind") or event.get("subtype") or event.get("event_type"),
                "summary": event.get("summary") or event.get("message") or event.get("reason") or "",
                "raw_preview": json.dumps(event, ensure_ascii=False, sort_keys=True, default=str)[:1000],
            }
            if flags.get("round"):
                round_events.append(row_event)
            if flags.get("damage"):
                damage_events.append(row_event)
            if flags.get("attack"):
                attack_events.append(row_event)
            if flags.get("resolution"):
                resolution_events.append(row_event)
            if len(examples) < 25:
                examples.append({**row_event, "flags": flags})

    real_round_count = len(round_events)
    real_damage_count = len(damage_events)
    real_attack_count = len(attack_events)
    real_resolution_count = len(resolution_events)
    direct_graph_count = int(existing.get("direct_graph_combat_count") or len(set(direct_graph_turns)))
    ok = bool(real_round_count > 0 and real_damage_count > 0 and real_resolution_count > 0)
    return {
        "format_version": "n118_real_combat_lifecycle_summary_v1",
        "ok": ok,
        "real_combat_lifecycle_ok": ok,
        "direct_graph_combat_count": direct_graph_count,
        "direct_graph_combat_turns": sorted(set(direct_graph_turns))[:100],
        "combat_text_turns": sorted(set(combat_text_turns))[:100],
        "real_round_event_count": real_round_count,
        "real_attack_event_count": real_attack_count,
        "real_damage_event_count": real_damage_count,
        "real_resolution_event_count": real_resolution_count,
        "direct_graph_only": bool(direct_graph_count and not ok),
        "missing_real_lifecycle_parts": [
            name for name, present in (
                ("round_or_initiative_events", real_round_count > 0),
                ("damage_or_hp_events", real_damage_count > 0),
                ("resolution_or_defeat_events", real_resolution_count > 0),
            ) if not present
        ],
        "policy": "Direct-graph combat coverage is not counted as a real combat lifecycle unless round/initiative, damage/HP, and resolution evidence are all present.",
        "round_events": round_events[:50],
        "attack_events": attack_events[:50],
        "damage_events": damage_events[:50],
        "resolution_events": resolution_events[:50],
        "examples": examples,
    }


def _n118_apply_real_combat_lifecycle(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    real = _n118_build_real_combat_lifecycle_summary(summary, transcript)
    summary["real_combat_lifecycle_summary"] = real
    combat = dict(_safe_dict(summary.get("combat_lifecycle_summary")))
    combat["n118_real_lifecycle"] = real
    combat["real_combat_lifecycle_ok"] = bool(real.get("ok"))
    combat["real_round_event_count"] = int(real.get("real_round_event_count") or 0)
    combat["real_damage_event_count"] = int(real.get("real_damage_event_count") or 0)
    combat["real_resolution_event_count"] = int(real.get("real_resolution_event_count") or 0)
    summary["combat_lifecycle_summary"] = combat

    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates:
        gate = dict(_safe_dict(gates.get("combat_rounds_real")))
        gate["ok"] = bool(real.get("ok"))
        gate["source"] = "real-combat-lifecycle-summary.json"
        gate["source_artifact"] = "real-combat-lifecycle-summary.json"
        gate["message"] = (
            "Real combat lifecycle evidence requires round/initiative, damage/HP, and resolution events."
            if not real.get("ok") else
            "Real combat lifecycle evidence is present."
        )
        gate["value"] = {
            "real_round_event_count": real.get("real_round_event_count"),
            "real_attack_event_count": real.get("real_attack_event_count"),
            "real_damage_event_count": real.get("real_damage_event_count"),
            "real_resolution_event_count": real.get("real_resolution_event_count"),
            "direct_graph_combat_count": real.get("direct_graph_combat_count"),
            "direct_graph_only": real.get("direct_graph_only"),
            "missing_real_lifecycle_parts": real.get("missing_real_lifecycle_parts"),
        }
        gates["combat_rounds_real"] = gate
        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        gap["n118_real_combat_lifecycle_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N118_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N118_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    transcript = _safe_list(args[1]) if len(args) > 1 else _safe_list(kwargs.get("transcript") or kwargs.get("final_transcript_rows"))
    return _n118_apply_real_combat_lifecycle(summary, transcript)


def _n118_real_combat_lifecycle_html_section(summary: Dict[str, Any]) -> str:
    real = _safe_dict(_safe_dict(summary).get("real_combat_lifecycle_summary"))
    if "_n1178_html_escape" in globals() and callable(globals().get("_n1178_html_escape")):
        esc = globals()["_n1178_html_escape"]
    else:
        esc = lambda value: _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    missing = ", ".join(_safe_str(v) for v in _safe_list(real.get("missing_real_lifecycle_parts"))) or "none"
    return (
        "<section id=\"n118-real-combat-lifecycle\" class=\"card\">"
        "<h2>N118 Real Combat Lifecycle</h2>"
        "<p>Direct-graph combat coverage is separated from real initiative/round, damage, and resolution evidence.</p>"
        "<ul>"
        f"<li>Real lifecycle OK: {esc(real.get('ok'))}</li>"
        f"<li>Direct-graph combat count: {esc(real.get('direct_graph_combat_count'))}</li>"
        f"<li>Round/initiative events: {esc(real.get('real_round_event_count'))}</li>"
        f"<li>Damage/HP events: {esc(real.get('real_damage_event_count'))}</li>"
        f"<li>Resolution/defeat events: {esc(real.get('real_resolution_event_count'))}</li>"
        f"<li>Missing: {esc(missing)}</li>"
        "</ul>"
        "</section>"
    )


def _n1172_inject_1000_turn_gap_section(html_report: str, final_summary: Dict[str, Any]) -> str:
    if callable(_N118_PREVIOUS_N1172_INJECT_1000_SECTION):
        html_report = _N118_PREVIOUS_N1172_INJECT_1000_SECTION(html_report, final_summary)
    html_text = _safe_str(html_report)
    if "id=\"n118-real-combat-lifecycle\"" in html_text:
        return html_text
    section = _n118_real_combat_lifecycle_html_section(final_summary)
    lower = html_text.lower()
    index = lower.rfind("</body>")
    if index >= 0:
        return html_text[:index] + section + html_text[index:]
    return html_text + section


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N118_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N118_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    real = _safe_dict(value.get("real_combat_lifecycle_summary"))
    artifact_name = "real-combat-lifecycle-summary.json"
    generated_files = artifact_manifest.setdefault("generated_files", [])
    if real and artifact_name not in generated_files:
        serialized = json.dumps(real, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N118_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N118_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(
                zip_handle,
                artifact_manifest,
                artifact_name,
                real,
                serialized_text=serialized,
                force=True,
            )
    return result

# N118.1 -- Mirror autoplay-campaign-results.zip into a reviewable folder
#
# The GitHub connector can read committed JSON/text files far better than it can
# retrieve a committed ZIP blob.  Keep the ZIP for local convenience, but also
# extract a safe filesystem mirror beside it so result artifacts can be uploaded
# to GitHub as ordinary files.
_N1181_PREVIOUS_FORCE_EXIT_IF_BACKGROUND_THREADS_REMAIN = globals().get("_force_exit_if_background_threads_remain")


def _n1181_safe_extract_zip_member(zip_handle: Any, member: Any, output_root: Path) -> Optional[Path]:
    info_name = _safe_str(getattr(member, "filename", ""))
    if not info_name or info_name.endswith("/"):
        return None
    normalized = info_name.replace("\\", "/").lstrip("/")
    if not normalized or normalized.startswith("../") or "/../" in normalized:
        return None
    target = output_root / normalized
    try:
        resolved_root = output_root.resolve()
        resolved_target_parent = target.parent.resolve()
        if resolved_root not in (resolved_target_parent, *resolved_target_parent.parents):
            return None
    except Exception:
        # Fall back to the normalized ../ guard above on platforms where resolve
        # may fail for not-yet-created parents.
        pass
    target.parent.mkdir(parents=True, exist_ok=True)
    with zip_handle.open(member, "r") as src, target.open("wb") as dst:
        shutil.copyfileobj(src, dst)
    return target


def _n1181_mirror_autoplay_results_zip(args: Any) -> Dict[str, Any]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    zip_path = output_dir / "autoplay-campaign-results.zip"
    mirror_dir = output_dir / "autoplay-campaign-results-unzipped"
    summary: Dict[str, Any] = {
        "format_version": "n1181_unzipped_result_artifact_mirror_v1",
        "ok": False,
        "zip_path": _safe_str(zip_path),
        "mirror_dir": _safe_str(mirror_dir),
        "extracted_file_count": 0,
        "skipped_member_count": 0,
        "extracted_files": [],
        "skipped_members": [],
        "stale_files_not_deleted": True,
        "note": (
            "This folder mirrors autoplay-campaign-results.zip for GitHub/ChatGPT review. "
            "Existing files are overwritten, but stale files from older runs are not deleted."
        ),
    }
    if not zip_path.exists():
        summary["reason"] = "zip_not_found"
        return summary

    mirror_dir.mkdir(parents=True, exist_ok=True)
    extracted: List[str] = []
    skipped: List[str] = []
    try:
        with zipfile.ZipFile(zip_path, "r") as zip_handle:
            for member in zip_handle.infolist():
                target = _n1181_safe_extract_zip_member(zip_handle, member, mirror_dir)
                if target is None:
                    skipped.append(_safe_str(getattr(member, "filename", "")))
                    continue
                try:
                    extracted.append(_safe_str(target.relative_to(mirror_dir)).replace("\\", "/"))
                except Exception:
                    extracted.append(_safe_str(target))
    except Exception as exc:
        summary["reason"] = f"extract_failed:{type(exc).__name__}:{exc}"
        try:
            (mirror_dir / "unzipped-artifact-index.json").write_text(
                json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
                encoding="utf-8",
            )
        except Exception:
            pass
        return summary

    summary["ok"] = True
    summary["extracted_file_count"] = len(extracted)
    summary["skipped_member_count"] = len(skipped)
    summary["extracted_files"] = extracted[:5000]
    summary["skipped_members"] = skipped[:200]
    summary["review_artifacts_index"] = (
        "review-artifacts/index.json"
        if (mirror_dir / "review-artifacts" / "index.json").exists()
        else ""
    )
    summary["recommended_git_path"] = _safe_str(mirror_dir)
    index_path = mirror_dir / "unzipped-artifact-index.json"
    index_path.write_text(
        json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
        encoding="utf-8",
    )
    _timestamped_print(
        "Wrote unzipped autoplay result artifact mirror to: "
        f"{mirror_dir} files={len(extracted)} skipped={len(skipped)}"
    )
    return summary


def _force_exit_if_background_threads_remain(*args: Any, **kwargs: Any) -> Any:
    call_args = kwargs.get("args")
    if call_args is None and args:
        call_args = args[0]
    try:
        if call_args is not None:
            _n1181_mirror_autoplay_results_zip(call_args)
    except Exception as exc:
        _timestamped_print(
            "Warning: failed to mirror autoplay result ZIP to unzipped folder: "
            f"{type(exc).__name__}: {exc}"
        )
    if callable(_N1181_PREVIOUS_FORCE_EXIT_IF_BACKGROUND_THREADS_REMAIN):
        return _N1181_PREVIOUS_FORCE_EXIT_IF_BACKGROUND_THREADS_REMAIN(*args, **kwargs)
    return None

# N118.2 -- Mirror autoplay result ZIP after run completion as a second safety net.
#
# N118.1 mirrors through the background-thread exit hook.  Some runs complete
# without that hook being the last observable path, so also wrap the CLI run
# function and mirror in a finally block after _run_autoplay_campaign returns.
_N1182_PREVIOUS_RUN_WITH_CONSOLE_CAPTURE = globals().get("_run_with_console_capture")


def _n1182_mirror_results_after_run(args: Any) -> None:
    mirror = globals().get("_n1181_mirror_autoplay_results_zip")
    if not callable(mirror):
        return
    try:
        mirror(args)
    except Exception as exc:
        _timestamped_print(
            "Warning: failed to mirror autoplay result ZIP after run completion: "
            f"{type(exc).__name__}: {exc}"
        )


def _run_with_console_capture(args: argparse.Namespace) -> int:
    if callable(_N1182_PREVIOUS_RUN_WITH_CONSOLE_CAPTURE):
        try:
            return int(_N1182_PREVIOUS_RUN_WITH_CONSOLE_CAPTURE(args))
        finally:
            _n1182_mirror_results_after_run(args)

    # Defensive fallback; the historical function should always exist before
    # this late-loaded fragment, but keep the CLI usable if fragment order changes.
    try:
        summary = _run_autoplay_campaign(args)
        return 0 if _safe_dict(summary).get("ok") else 1
    finally:
        _n1182_mirror_results_after_run(args)

# N118.4 -- Compact result artifact filesystem mirror
#
# N118.1 mirrored every ZIP member, but full-transcript oversized row field
# splits can produce tens of thousands of files.  Keep the filesystem mirror
# useful for GitHub/ChatGPT review by extracting top-level artifacts, review
# indexes, and compact/small review chunks while skipping the explosive
# full-transcript oversized-row field tree by default.

_N1184_COMPACT_MIRROR_TRUE_VALUES = {"1", "true", "yes", "on"}
_N1184_COMPACT_MIRROR_FALSE_VALUES = {"0", "false", "no", "off"}


def _n1184_compact_mirror_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_COMPACT_UNZIPPED_RESULTS", "1")).lower()
    return flag not in _N1184_COMPACT_MIRROR_FALSE_VALUES


def _n1184_full_review_mirror_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_FULL_UNZIPPED_RESULTS", "")).lower()
    return flag in _N1184_COMPACT_MIRROR_TRUE_VALUES


def _n1184_should_extract_review_member(name: str, *, per_artifact_counts: Dict[str, int]) -> bool:
    normalized = _safe_str(name).replace("\\", "/").lstrip("/")
    if not normalized.startswith("review-artifacts/"):
        return True
    if _n1184_full_review_mirror_enabled():
        return True

    # Always keep root and per-artifact indexes. These are enough to navigate the
    # ZIP/review layout without committing thousands of tiny oversized-row files.
    if normalized == "review-artifacts/index.json":
        return True
    if normalized.endswith("/index.json") or normalized.endswith("/top-level-keys.json"):
        return True

    # The pathological case: every oversized full transcript row can expand into
    # hundreds of top-level field chunks. Keep indexes only for this tree.
    if normalized.startswith("review-artifacts/full-transcript.json/oversized-rows/"):
        return False

    # Keep compact transcript chunks, summary key files, and focused diagnostic
    # artifact chunks, but cap each artifact subtree to prevent future runaway
    # mirrors if another artifact starts producing thousands of files.
    parts = normalized.split("/")
    artifact_slug = parts[1] if len(parts) > 1 else "root"
    cap = int(os.environ.get("RPG_AUTOPLAY_COMPACT_UNZIPPED_MAX_FILES_PER_ARTIFACT", "250") or "250")
    current = int(per_artifact_counts.get(artifact_slug, 0))
    if current >= cap:
        return False
    per_artifact_counts[artifact_slug] = current + 1
    return True


def _n1184_reset_generated_mirror_dir(mirror_dir: Path) -> None:
    # This directory is generated by the autoplay harness. Remove it before each
    # mirror write so stale 17k-file mirrors do not persist after switching to the
    # compact policy.  Disable with RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS=1.
    keep_stale = _safe_str(os.environ.get("RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS", "")).lower()
    if keep_stale in _N1184_COMPACT_MIRROR_TRUE_VALUES:
        mirror_dir.mkdir(parents=True, exist_ok=True)
        return
    if mirror_dir.exists():
        shutil.rmtree(mirror_dir)
    mirror_dir.mkdir(parents=True, exist_ok=True)


def _n1181_mirror_autoplay_results_zip(args: Any) -> Dict[str, Any]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    zip_path = output_dir / "autoplay-campaign-results.zip"
    mirror_dir = output_dir / "autoplay-campaign-results-unzipped"
    summary: Dict[str, Any] = {
        "format_version": "n1184_compact_unzipped_result_artifact_mirror_v1",
        "ok": False,
        "zip_path": _safe_str(zip_path),
        "mirror_dir": _safe_str(mirror_dir),
        "compact_mirror": _n1184_compact_mirror_enabled(),
        "full_review_mirror": _n1184_full_review_mirror_enabled(),
        "extracted_file_count": 0,
        "skipped_member_count": 0,
        "extracted_files": [],
        "skipped_members": [],
        "stale_files_deleted_before_write": _safe_str(os.environ.get("RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS", "")).lower() not in _N1184_COMPACT_MIRROR_TRUE_VALUES,
        "note": (
            "Compact mirror for GitHub/ChatGPT review. Top-level artifacts and review indexes are extracted; "
            "full-transcript oversized row field chunks are skipped unless RPG_AUTOPLAY_FULL_UNZIPPED_RESULTS=1."
        ),
    }
    if not zip_path.exists():
        summary["reason"] = "zip_not_found"
        return summary

    _n1184_reset_generated_mirror_dir(mirror_dir)
    extracted: List[str] = []
    skipped: List[str] = []
    per_artifact_counts: Dict[str, int] = {}
    try:
        with zipfile.ZipFile(zip_path, "r") as zip_handle:
            for member in zip_handle.infolist():
                member_name = _safe_str(getattr(member, "filename", ""))
                if member_name.endswith("/"):
                    continue
                normalized = member_name.replace("\\", "/").lstrip("/")
                if not _n1184_should_extract_review_member(normalized, per_artifact_counts=per_artifact_counts):
                    skipped.append(normalized)
                    continue
                target = _n1181_safe_extract_zip_member(zip_handle, member, mirror_dir)
                if target is None:
                    skipped.append(normalized)
                    continue
                try:
                    extracted.append(_safe_str(target.relative_to(mirror_dir)).replace("\\", "/"))
                except Exception:
                    extracted.append(_safe_str(target))
    except Exception as exc:
        summary["reason"] = f"extract_failed:{type(exc).__name__}:{exc}"
        try:
            (mirror_dir / "unzipped-artifact-index.json").write_text(
                json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
                encoding="utf-8",
            )
        except Exception:
            pass
        return summary

    summary["ok"] = True
    summary["extracted_file_count"] = len(extracted)
    summary["skipped_member_count"] = len(skipped)
    summary["extracted_files"] = extracted[:5000]
    summary["skipped_members"] = skipped[:1000]
    summary["skipped_member_count_by_prefix"] = {
        "review-artifacts/full-transcript.json/oversized-rows": sum(
            1 for item in skipped if item.startswith("review-artifacts/full-transcript.json/oversized-rows/")
        )
    }
    summary["review_artifacts_index"] = (
        "review-artifacts/index.json"
        if (mirror_dir / "review-artifacts" / "index.json").exists()
        else ""
    )
    summary["recommended_git_path"] = _safe_str(mirror_dir)
    index_path = mirror_dir / "unzipped-artifact-index.json"
    index_path.write_text(
        json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
        encoding="utf-8",
    )
    _timestamped_print(
        "Wrote compact unzipped autoplay result artifact mirror to: "
        f"{mirror_dir} files={len(extracted)} skipped={len(skipped)}"
    )
    return summary

# N119 -- NPC Goal Agency Evidence + 1000-Turn Gate Wiring
#
# This is a report/evidence phase, not a freeform NPC-autonomy engine rewrite.
# It separates passive NPC presence/dialogue from real goal agency evidence:
# an NPC must have a goal/intent, perform or schedule an action, and produce a
# consequence/state change across turns before the 1000-turn gate is satisfied.
_N119_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N119_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")
_N119_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")


def _n119_lower_text(value: Any) -> str:
    try:
        return json.dumps(value, ensure_ascii=False, sort_keys=True, default=str).lower()
    except Exception:
        return _safe_str(value).lower()


def _n119_row_turn(row: Dict[str, Any]) -> int:
    row = _safe_dict(row)
    return int(row.get("turn_index") or row.get("turn") or 0)


def _n119_known_npc_names(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> List[str]:
    names = set()
    for row in _safe_list(transcript):
        row = _safe_dict(row)
        for key in ("npc", "npc_speaker", "speaker", "target", "npc_id"):
            value = row.get(key)
            if isinstance(value, dict):
                value = value.get("speaker") or value.get("npc_id") or value.get("name")
            text = _safe_str(value).strip()
            if text and text.lower() not in {"none", "unknown", "environment"}:
                names.add(text)
        npc_payload = _safe_dict(row.get("npc")) or _safe_dict(_safe_dict(row.get("turn_result")).get("npc"))
        for key in ("speaker", "npc_id", "name"):
            text = _safe_str(npc_payload.get(key)).strip()
            if text and text.lower() not in {"none", "unknown", "environment"}:
                names.add(text)
    for key in ("npc_profile_load_summary", "npc_arc_progression_summary", "npc_evolution_profile_persistence_summary"):
        payload = _safe_dict(_safe_dict(summary).get(key))
        for value in _safe_list(payload.get("npc_ids")) + _safe_list(payload.get("npcs")):
            text = _safe_str(value).strip()
            if text:
                names.add(text)
    return sorted(names)[:100]


def _n119_extract_npc_name(row: Dict[str, Any], known_names: List[str]) -> str:
    row = _safe_dict(row)
    candidates: List[str] = []
    for key in ("npc_speaker", "speaker", "target", "npc_id"):
        candidates.append(_safe_str(row.get(key)))
    npc_payloads = [
        _safe_dict(row.get("npc")),
        _safe_dict(_safe_dict(row.get("turn_result")).get("npc")),
        _safe_dict(_safe_dict(row.get("resolved_narration_payload")).get("npc")),
    ]
    for payload in npc_payloads:
        for key in ("speaker", "npc_id", "name"):
            candidates.append(_safe_str(payload.get(key)))
    text = _n119_lower_text(row)
    for name in known_names:
        if name and name.lower() in text:
            candidates.append(name)
    for candidate in candidates:
        candidate = _safe_str(candidate).strip()
        if candidate and candidate.lower() not in {"none", "unknown", "environment"}:
            return candidate
    return "unknown"


def _n119_agency_flags(row: Dict[str, Any]) -> Dict[str, bool]:
    text = _n119_lower_text(row)
    goal_tokens = (
        "npc_goal", "goal", "intent", "intention", "motive", "agenda",
        "objective", "wants", "plans", "decides", "vows", "seeks",
    )
    action_tokens = (
        "npc_action", "agency_event", "acts", "moves", "travels", "warns",
        "prepares", "guards", "reports", "pursues", "investigates", "joins",
        "sends", "meets", "ambush", "defends", "protects",
    )
    schedule_tokens = (
        "schedule", "scheduled", "next_tick", "future_turn", "deadline",
        "cooldown", "at dawn", "before dawn", "later", "afterward",
    )
    consequence_tokens = (
        "consequence", "state_change", "changed_parts", "memory", "relationship",
        "reputation", "world_signal", "quest", "arc", "faction", "pressure",
        "followup", "evolution", "trust", "fear", "opinion",
    )
    autonomous_tokens = (
        "autonomous", "background", "offscreen", "ambient", "npc agency",
        "without player", "while the player", "independently",
    )
    return {
        "has_goal": any(token in text for token in goal_tokens),
        "has_action": any(token in text for token in action_tokens),
        "has_schedule": any(token in text for token in schedule_tokens),
        "has_consequence": any(token in text for token in consequence_tokens),
        "has_autonomous_marker": any(token in text for token in autonomous_tokens),
    }


def _n119_build_npc_goal_agency_summary(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    rows = [_safe_dict(row) for row in _safe_list(transcript)]
    known_names = _n119_known_npc_names(summary, rows)
    npc_records: Dict[str, Dict[str, Any]] = {}
    events: List[Dict[str, Any]] = []

    for row in rows:
        turn = _n119_row_turn(row)
        flags = _n119_agency_flags(row)
        if not any(flags.values()):
            continue
        npc_name = _n119_extract_npc_name(row, known_names)
        rec = npc_records.setdefault(
            npc_name,
            {
                "npc": npc_name,
                "turns": [],
                "goal_turns": [],
                "action_turns": [],
                "schedule_turns": [],
                "consequence_turns": [],
                "autonomous_turns": [],
            },
        )
        rec["turns"].append(turn)
        if flags.get("has_goal"):
            rec["goal_turns"].append(turn)
        if flags.get("has_action"):
            rec["action_turns"].append(turn)
        if flags.get("has_schedule"):
            rec["schedule_turns"].append(turn)
        if flags.get("has_consequence"):
            rec["consequence_turns"].append(turn)
        if flags.get("has_autonomous_marker"):
            rec["autonomous_turns"].append(turn)
        if len(events) < 100:
            events.append(
                {
                    "turn": turn,
                    "npc": npc_name,
                    "flags": flags,
                    "player_action": _safe_str(row.get("player_action"))[:240],
                    "canonical_turn_action": _safe_str(row.get("canonical_turn_action"))[:240],
                }
            )

    npc_rows: List[Dict[str, Any]] = []
    fully_agentic_npcs: List[str] = []
    partial_agentic_npcs: List[str] = []
    for npc, rec in sorted(npc_records.items()):
        goal = bool(rec["goal_turns"])
        action = bool(rec["action_turns"])
        consequence = bool(rec["consequence_turns"])
        schedule_or_autonomous = bool(rec["schedule_turns"] or rec["autonomous_turns"])
        real_agency = goal and action and consequence and schedule_or_autonomous
        partial = (goal and action) or (action and consequence) or (goal and consequence)
        out = {
            "npc": npc,
            "real_goal_agency": real_agency,
            "partial_goal_agency": partial,
            "turn_count": len(set(rec["turns"])),
            "goal_turns": sorted(set(rec["goal_turns"]))[:50],
            "action_turns": sorted(set(rec["action_turns"]))[:50],
            "schedule_turns": sorted(set(rec["schedule_turns"]))[:50],
            "consequence_turns": sorted(set(rec["consequence_turns"]))[:50],
            "autonomous_turns": sorted(set(rec["autonomous_turns"]))[:50],
        }
        npc_rows.append(out)
        if real_agency:
            fully_agentic_npcs.append(npc)
        elif partial:
            partial_agentic_npcs.append(npc)

    existing = _safe_dict(summary.get("npc_agency_summary"))
    existing_count = int(existing.get("agency_event_count") or existing.get("event_count") or 0)
    ok = bool(fully_agentic_npcs)
    return {
        "format_version": "n119_npc_goal_agency_summary_v1",
        "ok": ok,
        "real_npc_goal_agency_ok": ok,
        "policy": "NPC goal agency requires goal/intent, action, scheduled/autonomous marker, and consequence evidence. Passive dialogue/presence alone is not enough.",
        "known_npc_count": len(known_names),
        "known_npcs": known_names,
        "existing_agency_event_count": existing_count,
        "candidate_event_count": len(events),
        "npc_with_any_agency_signal_count": len(npc_rows),
        "fully_agentic_npc_count": len(fully_agentic_npcs),
        "partial_agentic_npc_count": len(partial_agentic_npcs),
        "fully_agentic_npcs": fully_agentic_npcs[:50],
        "partial_agentic_npcs": partial_agentic_npcs[:50],
        "missing_real_agency_parts": [] if ok else [
            "goal_or_intent",
            "scheduled_or_autonomous_action",
            "consequence_or_state_change",
        ],
        "npcs": npc_rows[:100],
        "events": events,
    }


def _n119_apply_npc_goal_agency(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    agency = _n119_build_npc_goal_agency_summary(summary, transcript)
    summary["npc_goal_agency_summary"] = agency
    npc_agency = dict(_safe_dict(summary.get("npc_agency_summary")))
    npc_agency["n119_goal_agency"] = agency
    npc_agency["real_npc_goal_agency_ok"] = bool(agency.get("ok"))
    npc_agency["fully_agentic_npc_count"] = agency.get("fully_agentic_npc_count")
    summary["npc_agency_summary"] = npc_agency

    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates:
        gate = dict(_safe_dict(gates.get("npc_goal_agency_real")))
        gate["ok"] = bool(agency.get("ok"))
        gate["source"] = "npc-goal-agency-summary.json"
        gate["source_artifact"] = "npc-goal-agency-summary.json"
        gate["message"] = (
            "Real NPC goal agency requires goal/intent, scheduled/autonomous action, and consequence evidence."
            if not agency.get("ok") else
            "Real NPC goal agency evidence is present."
        )
        gate["value"] = {
            "fully_agentic_npc_count": agency.get("fully_agentic_npc_count"),
            "partial_agentic_npc_count": agency.get("partial_agentic_npc_count"),
            "candidate_event_count": agency.get("candidate_event_count"),
            "missing_real_agency_parts": agency.get("missing_real_agency_parts"),
        }
        gates["npc_goal_agency_real"] = gate
        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        gap["n119_npc_goal_agency_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N119_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N119_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    transcript = _safe_list(args[1]) if len(args) > 1 else _safe_list(kwargs.get("transcript") or kwargs.get("final_transcript_rows"))
    return _n119_apply_npc_goal_agency(summary, transcript)


def _n119_html_escape(value: Any) -> str:
    if "_n1178_html_escape" in globals() and callable(globals().get("_n1178_html_escape")):
        return globals()["_n1178_html_escape"](value)
    return _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _n119_npc_goal_agency_html_section(summary: Dict[str, Any]) -> str:
    agency = _safe_dict(_safe_dict(summary).get("npc_goal_agency_summary"))
    rows = []
    for npc in _safe_list(agency.get("npcs"))[:20]:
        npc = _safe_dict(npc)
        rows.append(
            "<tr>"
            f"<td>{_n119_html_escape(npc.get('npc'))}</td>"
            f"<td>{_n119_html_escape(npc.get('real_goal_agency'))}</td>"
            f"<td>{_n119_html_escape(npc.get('goal_turns'))}</td>"
            f"<td>{_n119_html_escape(npc.get('action_turns'))}</td>"
            f"<td>{_n119_html_escape(npc.get('consequence_turns'))}</td>"
            "</tr>"
        )
    body = "".join(rows) or "<tr><td colspan=\"5\">No NPC goal agency evidence classified.</td></tr>"
    missing = ", ".join(_safe_str(v) for v in _safe_list(agency.get("missing_real_agency_parts"))) or "none"
    return (
        "<section id=\"n119-npc-goal-agency\" class=\"card\">"
        "<h2>N119 NPC Goal Agency</h2>"
        "<p>Passive NPC dialogue is separated from real goal-driven NPC action and consequence evidence.</p>"
        "<ul>"
        f"<li>Real NPC goal agency OK: {_n119_html_escape(agency.get('ok'))}</li>"
        f"<li>Fully agentic NPCs: {_n119_html_escape(agency.get('fully_agentic_npc_count'))}</li>"
        f"<li>Partial agentic NPCs: {_n119_html_escape(agency.get('partial_agentic_npc_count'))}</li>"
        f"<li>Candidate events: {_n119_html_escape(agency.get('candidate_event_count'))}</li>"
        f"<li>Missing: {_n119_html_escape(missing)}</li>"
        "</ul>"
        "<table><thead><tr><th>NPC</th><th>Real agency</th><th>Goal turns</th><th>Action turns</th><th>Consequence turns</th></tr></thead>"
        f"<tbody>{body}</tbody></table>"
        "</section>"
    )


def _n1172_inject_1000_turn_gap_section(html_report: str, final_summary: Dict[str, Any]) -> str:
    if callable(_N119_PREVIOUS_N1172_INJECT_1000_SECTION):
        html_report = _N119_PREVIOUS_N1172_INJECT_1000_SECTION(html_report, final_summary)
    html_text = _safe_str(html_report)
    if "id=\"n119-npc-goal-agency\"" in html_text:
        return html_text
    section = _n119_npc_goal_agency_html_section(final_summary)
    lower = html_text.lower()
    index = lower.rfind("</body>")
    if index >= 0:
        return html_text[:index] + section + html_text[index:]
    return html_text + section


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N119_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N119_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    agency = _safe_dict(value.get("npc_goal_agency_summary"))
    artifact_name = "npc-goal-agency-summary.json"
    generated_files = artifact_manifest.setdefault("generated_files", [])
    if agency and artifact_name not in generated_files:
        serialized = json.dumps(agency, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N119_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N119_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(
                zip_handle,
                artifact_manifest,
                artifact_name,
                agency,
                serialized_text=serialized,
                force=True,
            )
    return result

# N119.1 -- Windows-safe artifact writes
#
# Some Windows runs can complete the 100-turn loop and then fail while rewriting
# autoplay-campaign-report.html with OSError(22).  The report path is valid, so
# treat this as a stale/locked/odd filesystem edge and use an atomic-ish temp
# replacement fallback for generated text artifacts.
_N1191_ORIGINAL_PATH_WRITE_TEXT = Path.write_text


def _n1191_extended_windows_path(path: Path) -> str:
    text = _safe_str(path)
    if os.name != "nt":
        return text
    try:
        absolute = str(path.resolve())
    except Exception:
        absolute = str(path.absolute())
    if absolute.startswith("\\\\?\\"):
        return absolute
    if absolute.startswith("\\\\"):
        return "\\\\?\\UNC\\" + absolute.lstrip("\\")
    return "\\\\?\\" + absolute


def _n1191_write_text_fallback(path: Path, data: Any, *, encoding: str = "utf-8", errors: Any = None, newline: Any = None) -> int:
    path = Path(path)
    text = _safe_str(data)
    path.parent.mkdir(parents=True, exist_ok=True)
    temp_path = path.with_name(f".{path.name}.tmp-{os.getpid()}-{int(time.time() * 1000)}")
    open_kwargs: Dict[str, Any] = {"mode": "w", "encoding": encoding or "utf-8"}
    if errors is not None:
        open_kwargs["errors"] = errors
    if newline is not None:
        open_kwargs["newline"] = newline

    temp_written = False
    try:
        with open(_n1191_extended_windows_path(temp_path), **open_kwargs) as handle:
            written = handle.write(text)
        temp_written = True
        try:
            os.replace(_n1191_extended_windows_path(temp_path), _n1191_extended_windows_path(path))
        except OSError:
            try:
                if path.exists() and path.is_file():
                    path.unlink()
            except Exception:
                pass
            os.replace(_n1191_extended_windows_path(temp_path), _n1191_extended_windows_path(path))
        return written
    finally:
        if temp_written and temp_path.exists():
            try:
                temp_path.unlink()
            except Exception:
                pass


def _n1191_safe_path_write_text(self: Path, data: Any, encoding: Any = None, errors: Any = None, newline: Any = None) -> int:
    try:
        return _N1191_ORIGINAL_PATH_WRITE_TEXT(self, data, encoding=encoding, errors=errors, newline=newline)
    except OSError as exc:
        suffix = _safe_str(getattr(self, "suffix", "")).lower()
        name = _safe_str(getattr(self, "name", ""))
        generated_artifact = (
            suffix in {".html", ".json", ".txt", ".log"}
            or name.startswith("autoplay-")
            or "test-results" in _safe_str(self).replace("\\", "/")
        )
        if not generated_artifact:
            raise
        _timestamped_print(
            "Warning: Path.write_text failed for generated artifact; using temp-file fallback: "
            f"path={self} error={type(exc).__name__}:{exc}"
        )
        return _n1191_write_text_fallback(
            Path(self),
            data,
            encoding=encoding or "utf-8",
            errors=errors,
            newline=newline,
        )


if getattr(Path.write_text, "__name__", "") != "_n1191_safe_path_write_text":
    _install_autoplay_path_write_hook(Path, _n1191_safe_path_write_text)

# N119.2 -- Essential-only result artifact filesystem mirror
#
# The unzipped result folder is meant for GitHub/ChatGPT review, not as a full
# copy of autoplay-campaign-results.zip.  Keep it small and focused: no
# review-artifacts tree, no report HTML, no full transcripts, no code-diff, and
# no ZIP copy.  The full ZIP and standalone HTML remain available in the output
# directory for local inspection.

_N1192_ESSENTIAL_MIRROR_TRUE_VALUES = {"1", "true", "yes", "on"}
_N1192_ESSENTIAL_MIRROR_FALSE_VALUES = {"0", "false", "no", "off"}

_N1192_EXACT_ESSENTIAL_ARTIFACTS = {
    "summary.json",
    "artifact-manifest.json",
    "autoplay-health.json",
    "hundred-turn-evaluation.json",
    "hundred-turn-readiness-summary.json",
    "one-thousand-turn-readiness-gap-report.json",
    "one-thousand-turn-readiness-source-consistency.json",
    "provider-error-classification-summary.json",
    "real-combat-lifecycle-summary.json",
    "npc-goal-agency-summary.json",
    "transcript-size-summary.json",
    "performance-seconds-summary.json",
    "background-presentation-attachment-summary.json",
    "llm-prompt-and-fallback-summary.json",
    "dialogue-action-relevance-summary.json",
    "turn-action-consistency-summary.json",
    "selected-output-grounding-health.json",
    "narration-grounding-summary.json",
    "canonical-progress-quality.json",
    "mechanics-coverage-summary.json",
    "location-progression-summary.json",
    "quest-progress-summary.json",
    "story-arc-lifecycle-summary.json",
    "story-arc-aftermath-summary.json",
    "arc-completion-quality-summary.json",
    "faction-reputation-summary.json",
    "faction-pressure-summary.json",
    "faction-consequence-summary.json",
    "npc-agency-summary.json",
    "npc-reaction-summary.json",
    "world-signal-summary.json",
    "world-state-compression-summary.json",
    "economy-pressure-summary.json",
    "combat-lifecycle-summary.json",
    "followup-arc-progression-summary.json",
    "followup-arc-resolution-summary.json",
    "pressure-pacing-summary.json",
    "escalation-arc-progression-summary.json",
    "scenario-progression-action-repeat-summary.json",
    "suppressed-selection-guard-summary.json",
}

_N1192_PREFIX_ESSENTIAL_ARTIFACTS = (
    "checkpoints/",  # compact checkpoint files are useful for state review.
)

_N1192_EXCLUDED_ARTIFACTS = {
    "autoplay-campaign-report.html",
    "autoplay-campaign-report-rich.html",
    "autoplay-campaign-report.json",
    "autoplay-transcript.json",
    "autoplay-progress-metrics.json",
    "autoplay-performance.json",
    "autoplay-story-variety.json",
    "transcript.json",
    "slim-transcript.json",
    "full-transcript.json",
    "code-diff.txt",
    "console-log.txt",
}


def _n1192_essential_mirror_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_ESSENTIAL_UNZIPPED_RESULTS", "1")).lower()
    return flag not in _N1192_ESSENTIAL_MIRROR_FALSE_VALUES


def _n1192_full_unzipped_results_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_FULL_UNZIPPED_RESULTS", "")).lower()
    return flag in _N1192_ESSENTIAL_MIRROR_TRUE_VALUES


def _n1192_extract_report_html_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_UNZIPPED_INCLUDE_HTML", "")).lower()
    return flag in _N1192_ESSENTIAL_MIRROR_TRUE_VALUES


def _n1192_extract_review_artifacts_enabled() -> bool:
    flag = _safe_str(os.environ.get("RPG_AUTOPLAY_UNZIPPED_INCLUDE_REVIEW_ARTIFACTS", "")).lower()
    return flag in _N1192_ESSENTIAL_MIRROR_TRUE_VALUES


def _n1192_should_extract_member(name: str) -> bool:
    normalized = _safe_str(name).replace("\\", "/").lstrip("/")
    if not normalized or normalized.endswith("/"):
        return False
    if _n1192_full_unzipped_results_enabled():
        return True
    if normalized.startswith("review-artifacts/"):
        return _n1192_extract_review_artifacts_enabled()
    if normalized.endswith(".zip"):
        return False
    if normalized in {"autoplay-campaign-report.html", "autoplay-campaign-report-rich.html"}:
        return _n1192_extract_report_html_enabled()
    if normalized in _N1192_EXCLUDED_ARTIFACTS:
        return False
    if normalized in _N1192_EXACT_ESSENTIAL_ARTIFACTS:
        return True
    return any(normalized.startswith(prefix) for prefix in _N1192_PREFIX_ESSENTIAL_ARTIFACTS)


def _n1192_reset_generated_mirror_dir(mirror_dir: Path) -> None:
    keep_stale = _safe_str(os.environ.get("RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS", "")).lower()
    if keep_stale in _N1192_ESSENTIAL_MIRROR_TRUE_VALUES:
        mirror_dir.mkdir(parents=True, exist_ok=True)
        return
    if mirror_dir.exists():
        shutil.rmtree(mirror_dir)
    mirror_dir.mkdir(parents=True, exist_ok=True)


def _n1181_mirror_autoplay_results_zip(args: Any) -> Dict[str, Any]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    zip_path = output_dir / "autoplay-campaign-results.zip"
    mirror_dir = output_dir / "autoplay-campaign-results-unzipped"
    summary: Dict[str, Any] = {
        "format_version": "n1192_essential_unzipped_result_artifact_mirror_v1",
        "ok": False,
        "zip_path": _safe_str(zip_path),
        "mirror_dir": _safe_str(mirror_dir),
        "essential_mirror": _n1192_essential_mirror_enabled(),
        "full_unzipped_results": _n1192_full_unzipped_results_enabled(),
        "include_review_artifacts": _n1192_extract_review_artifacts_enabled(),
        "include_html": _n1192_extract_report_html_enabled(),
        "extracted_file_count": 0,
        "skipped_member_count": 0,
        "extracted_files": [],
        "skipped_members_preview": [],
        "stale_files_deleted_before_write": _safe_str(os.environ.get("RPG_AUTOPLAY_KEEP_STALE_UNZIPPED_RESULTS", "")).lower() not in _N1192_ESSENTIAL_MIRROR_TRUE_VALUES,
        "note": (
            "Essential Git-review mirror. Full ZIP, report HTML, transcripts, code-diff, console-log, "
            "and review-artifacts are intentionally excluded by default. Use the environment flags "
            "RPG_AUTOPLAY_FULL_UNZIPPED_RESULTS=1, RPG_AUTOPLAY_UNZIPPED_INCLUDE_HTML=1, or "
            "RPG_AUTOPLAY_UNZIPPED_INCLUDE_REVIEW_ARTIFACTS=1 for local deep debugging."
        ),
    }
    if not zip_path.exists():
        summary["reason"] = "zip_not_found"
        return summary
    if not _n1192_essential_mirror_enabled() and not _n1192_full_unzipped_results_enabled():
        summary["reason"] = "essential_mirror_disabled"
        return summary

    _n1192_reset_generated_mirror_dir(mirror_dir)
    extracted: List[str] = []
    skipped: List[str] = []
    try:
        with zipfile.ZipFile(zip_path, "r") as zip_handle:
            for member in zip_handle.infolist():
                member_name = _safe_str(getattr(member, "filename", ""))
                normalized = member_name.replace("\\", "/").lstrip("/")
                if not _n1192_should_extract_member(normalized):
                    if normalized:
                        skipped.append(normalized)
                    continue
                target = _n1181_safe_extract_zip_member(zip_handle, member, mirror_dir)
                if target is None:
                    skipped.append(normalized)
                    continue
                try:
                    extracted.append(_safe_str(target.relative_to(mirror_dir)).replace("\\", "/"))
                except Exception:
                    extracted.append(_safe_str(target))
    except Exception as exc:
        summary["reason"] = f"extract_failed:{type(exc).__name__}:{exc}"
        try:
            (mirror_dir / "unzipped-artifact-index.json").write_text(
                json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
                encoding="utf-8",
            )
        except Exception:
            pass
        return summary

    summary["ok"] = True
    summary["extracted_file_count"] = len(extracted)
    summary["skipped_member_count"] = len(skipped)
    summary["extracted_files"] = extracted[:1000]
    summary["skipped_members_preview"] = skipped[:200]
    summary["excluded_by_default"] = {
        "review_artifacts": not _n1192_extract_review_artifacts_enabled(),
        "html_reports": not _n1192_extract_report_html_enabled(),
        "transcripts": True,
        "code_diff": True,
        "console_log": True,
        "zip_copy": True,
    }
    summary["recommended_git_path"] = _safe_str(mirror_dir)
    index_path = mirror_dir / "unzipped-artifact-index.json"
    index_path.write_text(
        json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str),
        encoding="utf-8",
    )
    _timestamped_print(
        "Wrote essential unzipped autoplay result artifact mirror to: "
        f"{mirror_dir} files={len(extracted)} skipped={len(skipped)}"
    )
    return summary

# N119.3 -- Strict NPC goal agency + essential mirror metadata fix
#
# The first N119 pass scanned broad transcript rows and therefore treated
# player-directed dialogue/action text as autonomous NPC goal agency. This pass
# makes the evidence gate strict: real NPC goal agency comes from explicit
# npc_agency_summary.agency_events, not passive schedule movement, world
# signals, dialogue text, or player actions.
_N1193_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N1193_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")


def _n1193_has_any_explicit_goal(value: Dict[str, Any]) -> bool:
    value = _safe_dict(value)
    return any(_safe_str(value.get(key)).strip() for key in ("goal", "goal_id", "intent", "intention", "objective", "motivation", "purpose", "agenda", "plan_id"))


def _n1193_has_any_explicit_action(value: Dict[str, Any]) -> bool:
    value = _safe_dict(value)
    return any(_safe_str(value.get(key)).strip() for key in ("action", "action_id", "npc_action", "operation", "decision", "scheduled_action", "executed_action"))


def _n1193_has_any_explicit_consequence(value: Dict[str, Any]) -> bool:
    value = _safe_dict(value)
    if _safe_list(value.get("effects")) or _safe_list(value.get("changed_parts")):
        return True
    if _safe_dict(value.get("state_delta")) or _safe_dict(value.get("consequence")):
        return True
    return any(_safe_str(value.get(key)).strip() for key in ("effect", "outcome", "result", "consequence_summary", "state_change", "world_signal_id", "memory_event_id", "faction_event_id", "quest_event_id"))


def _n1193_event_is_autonomous(value: Dict[str, Any]) -> bool:
    value = _safe_dict(value)
    if bool(value.get("player_directed") or value.get("from_player_action")):
        return False
    source = _safe_str(value.get("source") or value.get("trigger") or value.get("mode")).lower()
    event_type = _safe_str(value.get("type") or value.get("kind") or value.get("subtype")).lower()
    return any(token in source for token in ("npc_agency", "autonomous", "offscreen", "schedule_tick", "director")) or any(token in event_type for token in ("npc_agency", "autonomous", "npc_goal", "npc_decision"))


def _n1193_explicit_agency_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    npc_agency = _safe_dict(_safe_dict(summary).get("npc_agency_summary"))
    events: List[Dict[str, Any]] = []
    for key in ("agency_events", "npc_goal_events", "autonomous_npc_events", "npc_decision_events"):
        for item in _safe_list(npc_agency.get(key)):
            item = _safe_dict(item)
            if item:
                events.append(item)
    return events


def _n119_build_npc_goal_agency_summary(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    npc_agency = _safe_dict(summary.get("npc_agency_summary"))
    schedule_events = [_safe_dict(item) for item in _safe_list(npc_agency.get("schedule_events"))]
    agency_events = _n1193_explicit_agency_events(summary)
    by_npc: Dict[str, Dict[str, Any]] = {}
    real_events: List[Dict[str, Any]] = []
    partial_events: List[Dict[str, Any]] = []
    for event in agency_events:
        npc_id = _safe_str(event.get("npc_id") or event.get("npc") or event.get("actor") or "unknown") or "unknown"
        has_goal = _n1193_has_any_explicit_goal(event)
        has_action = _n1193_has_any_explicit_action(event)
        has_consequence = _n1193_has_any_explicit_consequence(event)
        autonomous = _n1193_event_is_autonomous(event)
        turn = int(event.get("turn") or event.get("turn_index") or 0)
        record = by_npc.setdefault(npc_id, {"npc": npc_id, "real_goal_agency": False, "partial_goal_agency": False, "goal_turns": [], "action_turns": [], "consequence_turns": [], "autonomous_turns": [], "events": []})
        if has_goal:
            record["goal_turns"].append(turn)
        if has_action:
            record["action_turns"].append(turn)
        if has_consequence:
            record["consequence_turns"].append(turn)
        if autonomous:
            record["autonomous_turns"].append(turn)
        event_out = {"turn": turn, "npc": npc_id, "flags": {"has_goal": has_goal, "has_action": has_action, "has_consequence": has_consequence, "has_autonomous_marker": autonomous}, "type": event.get("type") or event.get("kind") or event.get("subtype"), "source": event.get("source") or event.get("trigger") or event.get("mode"), "summary": event.get("summary") or event.get("message") or event.get("reason") or ""}
        record["events"].append(event_out)
        if has_goal and has_action and has_consequence and autonomous:
            record["real_goal_agency"] = True
            real_events.append(event_out)
        elif (has_goal and has_action) or (has_action and has_consequence) or (has_goal and has_consequence):
            record["partial_goal_agency"] = True
            partial_events.append(event_out)
    npc_rows = []
    for npc_id, record in sorted(by_npc.items()):
        for key in ("goal_turns", "action_turns", "consequence_turns", "autonomous_turns"):
            record[key] = sorted({int(v or 0) for v in _safe_list(record.get(key)) if int(v or 0)})[:50]
        record["events"] = _safe_list(record.get("events"))[:20]
        npc_rows.append(record)
    fully_agentic_npcs = [row["npc"] for row in npc_rows if bool(row.get("real_goal_agency"))]
    partial_agentic_npcs = [row["npc"] for row in npc_rows if bool(row.get("partial_goal_agency")) and not bool(row.get("real_goal_agency"))]
    ok = bool(fully_agentic_npcs)
    return {"format_version": "n1193_npc_goal_agency_summary_v2", "ok": ok, "real_npc_goal_agency_ok": ok, "policy": "Strict evidence mode: real NPC goal agency requires explicit npc_agency_summary.agency_events with goal/intent, action, autonomous marker, and consequence. Passive schedule movement, dialogue, and player-directed actions do not satisfy this gate.", "existing_agency_event_count": int(npc_agency.get("agency_event_count") or len(agency_events) or 0), "explicit_agency_event_count": len(agency_events), "schedule_event_count": int(npc_agency.get("schedule_event_count") or len(schedule_events) or 0), "candidate_event_count": len(agency_events), "real_agency_event_count": len(real_events), "partial_agency_event_count": len(partial_events), "fully_agentic_npc_count": len(fully_agentic_npcs), "partial_agentic_npc_count": len(partial_agentic_npcs), "fully_agentic_npcs": fully_agentic_npcs[:50], "partial_agentic_npcs": partial_agentic_npcs[:50], "missing_real_agency_parts": [] if ok else ["explicit_npc_agency_events", "goal_or_intent", "autonomous_npc_action", "consequence_or_state_change"], "npcs": npc_rows[:100], "real_events": real_events[:100], "partial_events": partial_events[:100], "schedule_events_are_not_goal_agency": True}


def _n1193_apply_rollup_consistency(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    agency = _safe_dict(summary.get("npc_goal_agency_summary"))
    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates and agency:
        gate = dict(_safe_dict(gates.get("npc_goal_agency_real")))
        gate["ok"] = bool(agency.get("ok"))
        gate["source"] = "npc-goal-agency-summary.json"
        gate["source_artifact"] = "npc-goal-agency-summary.json"
        gate["message"] = "Real NPC goal agency requires explicit autonomous NPC agency events with goal, action, and consequence evidence." if not agency.get("ok") else "Real NPC goal agency evidence is present."
        gate["value"] = {"explicit_agency_event_count": agency.get("explicit_agency_event_count"), "real_agency_event_count": agency.get("real_agency_event_count"), "fully_agentic_npc_count": agency.get("fully_agentic_npc_count"), "partial_agentic_npc_count": agency.get("partial_agentic_npc_count"), "schedule_event_count": agency.get("schedule_event_count"), "missing_real_agency_parts": agency.get("missing_real_agency_parts")}
        gates["npc_goal_agency_real"] = gate
        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        rollup = dict(_safe_dict(gap.get("rollup")))
        rollup["npc_goal_agency_real"] = bool(agency.get("ok"))
        rollup["combat_rounds_real"] = bool(_safe_dict(gates.get("combat_rounds_real")).get("ok"))
        rollup["transcript_growth_budget_ok"] = bool(_safe_dict(gates.get("transcript_growth_budget_projected_1000")).get("ok"))
        gap["rollup"] = rollup
        source_map = dict(_safe_dict(gap.get("source_map")))
        source_map["npc_goal_agency_real"] = "npc-goal-agency-summary.json"
        source_map["combat_rounds_real"] = "real-combat-lifecycle-summary.json"
        source_map["transcript_growth_budget_projected_1000"] = "transcript-size-summary.json + review-artifacts/index.json"
        gap["source_map"] = source_map
        gap["n1193_strict_npc_goal_agency_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
        readiness = dict(_safe_dict(summary.get("hundred_turn_readiness_summary")))
        if readiness:
            readiness["one_thousand_turn_readiness_gap_report"] = gap
            readiness["one_thousand_turn_candidate"] = bool(gap.get("one_thousand_turn_candidate"))
            readiness["one_thousand_turn_blocked_reasons"] = _safe_list(gap.get("one_thousand_turn_blocked_reasons"))
            readiness["readiness_grades"] = {"hundred_turn_ready": bool(readiness.get("ok")), "one_thousand_turn_candidate": bool(gap.get("one_thousand_turn_candidate")), "one_thousand_turn_blocked_reasons": _safe_list(gap.get("one_thousand_turn_blocked_reasons"))}
            summary["hundred_turn_readiness_summary"] = readiness
    return summary


def _n119_apply_npc_goal_agency(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    agency = _n119_build_npc_goal_agency_summary(summary, transcript)
    summary["npc_goal_agency_summary"] = agency
    npc_agency = dict(_safe_dict(summary.get("npc_agency_summary")))
    npc_agency["n119_goal_agency"] = agency
    npc_agency["real_npc_goal_agency_ok"] = bool(agency.get("ok"))
    npc_agency["fully_agentic_npc_count"] = agency.get("fully_agentic_npc_count")
    npc_agency["strict_goal_agency_evidence"] = True
    summary["npc_agency_summary"] = npc_agency
    return _n1193_apply_rollup_consistency(summary)


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N1193_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N1193_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    transcript = _safe_list(args[1]) if len(args) > 1 else _safe_list(kwargs.get("transcript") or kwargs.get("final_transcript_rows"))
    summary = _n119_apply_npc_goal_agency(summary, transcript)
    return _n1193_apply_rollup_consistency(summary)


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N1193_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N1193_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    strict_summary = _n1193_apply_rollup_consistency(value)
    agency = _safe_dict(strict_summary.get("npc_goal_agency_summary"))
    artifact_name = "npc-goal-agency-summary.json"
    generated_files = artifact_manifest.setdefault("generated_files", [])
    if agency and artifact_name not in generated_files:
        serialized = json.dumps(agency, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N1193_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N1193_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(zip_handle, artifact_manifest, artifact_name, agency, serialized_text=serialized, force=True)
    return result


def _n1193_path_display(path: Any, *, root: Any = None) -> str:
    try:
        p = Path(path)
        if root is not None:
            try:
                return str(p.relative_to(Path(root))).replace("\\", "/")
            except Exception:
                pass
        return str(p).replace("\\", "/")
    except Exception:
        return str(path)


def _n1181_mirror_autoplay_results_zip(args: Any) -> Dict[str, Any]:
    output_dir = Path(getattr(args, "output_dir", "") or "")
    zip_path = output_dir / "autoplay-campaign-results.zip"
    mirror_dir = output_dir / "autoplay-campaign-results-unzipped"
    summary: Dict[str, Any] = {"format_version": "n1193_essential_unzipped_result_artifact_mirror_v2", "ok": False, "zip_path": _n1193_path_display(zip_path), "mirror_dir": _n1193_path_display(mirror_dir), "essential_mirror": True, "full_unzipped_results": _n1192_full_unzipped_results_enabled() if "_n1192_full_unzipped_results_enabled" in globals() else False, "include_review_artifacts": _n1192_extract_review_artifacts_enabled() if "_n1192_extract_review_artifacts_enabled" in globals() else False, "include_html": _n1192_extract_report_html_enabled() if "_n1192_extract_report_html_enabled" in globals() else False, "extracted_file_count": 0, "skipped_member_count": 0, "extracted_files": [], "skipped_members_preview": [], "stale_files_deleted_before_write": True, "note": "Essential Git-review mirror with stable non-empty path metadata."}
    if not zip_path.exists():
        summary["reason"] = "zip_not_found"
        return summary
    if "_n1192_reset_generated_mirror_dir" in globals() and callable(globals().get("_n1192_reset_generated_mirror_dir")):
        _n1192_reset_generated_mirror_dir(mirror_dir)
    else:
        if mirror_dir.exists():
            shutil.rmtree(mirror_dir)
        mirror_dir.mkdir(parents=True, exist_ok=True)
    extracted: List[str] = []
    skipped: List[str] = []
    try:
        with zipfile.ZipFile(zip_path, "r") as zip_handle:
            for member in zip_handle.infolist():
                normalized = str(getattr(member, "filename", "") or "").replace("\\", "/").lstrip("/")
                should_extract = _n1192_should_extract_member(normalized) if "_n1192_should_extract_member" in globals() else True
                if not should_extract:
                    if normalized:
                        skipped.append(normalized)
                    continue
                target = _n1181_safe_extract_zip_member(zip_handle, member, mirror_dir)
                if target is None:
                    skipped.append(normalized)
                    continue
                extracted.append(_n1193_path_display(target, root=mirror_dir))
    except Exception as exc:
        summary["reason"] = f"extract_failed:{type(exc).__name__}:{exc}"
        try:
            (mirror_dir / "unzipped-artifact-index.json").write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str), encoding="utf-8")
        except Exception:
            pass
        return summary
    summary["ok"] = True
    summary["extracted_file_count"] = len(extracted)
    summary["skipped_member_count"] = len(skipped)
    summary["extracted_files"] = extracted[:1000]
    summary["skipped_members_preview"] = skipped[:200]
    summary["excluded_by_default"] = {"review_artifacts": not bool(summary.get("include_review_artifacts")), "html_reports": not bool(summary.get("include_html")), "transcripts": True, "code_diff": True, "console_log": True, "zip_copy": True}
    summary["recommended_git_path"] = _n1193_path_display(mirror_dir)
    index_path = mirror_dir / "unzipped-artifact-index.json"
    index_path.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True, default=str), encoding="utf-8")
    _timestamped_print("Wrote essential unzipped autoplay result artifact mirror to: " f"{mirror_dir} files={len(extracted)} skipped={len(skipped)}")
    return summary

# N120 -- Real memory aging + arc/faction compaction evidence
#
# This phase makes endurance compression evidence explicit and sourceable.  It
# does not treat the mere presence of a compression tick as real compaction.
# Gates pass only when old memories/arcs/faction-pressure histories are actually
# dropped, summarized, archived, or compacted by deterministic policy.
_N120_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N120_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N120_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")


def _n120_event_summary(event: Dict[str, Any]) -> Dict[str, Any]:
    event = _safe_dict(event)
    summary = _safe_dict(event.get("summary"))
    if not summary:
        summary = event
    return summary


def _n120_int(value: Any) -> int:
    try:
        return int(value or 0)
    except Exception:
        return 0


def _n120_collect_compression_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    compression = _safe_dict(_safe_dict(summary).get("world_state_compression_summary"))
    events: List[Dict[str, Any]] = []
    for item in _safe_list(compression.get("events")):
        item = _safe_dict(item)
        if item:
            events.append(item)
    return events


def _n120_build_memory_compaction_summary(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    compression = _safe_dict(summary.get("world_state_compression_summary"))
    events = _n120_collect_compression_events(summary)
    memory_events: List[Dict[str, Any]] = []
    arc_events: List[Dict[str, Any]] = []
    faction_events: List[Dict[str, Any]] = []
    world_signal_expiry_events: List[Dict[str, Any]] = []

    totals = {
        "npc_memory_dropped_count": 0,
        "npc_memory_summarized_count": 0,
        "npc_memory_archived_count": 0,
        "compacted_arc_count": 0,
        "summarized_arc_count": 0,
        "archived_arc_count": 0,
        "compacted_faction_count": 0,
        "summarized_faction_count": 0,
        "pressure_event_summarized_count": 0,
        "expired_world_signal_count": 0,
    }

    for event in events:
        turn = _n120_int(event.get("turn") or event.get("turn_index"))
        payload = _n120_event_summary(event)
        counts = {
            "npc_memory_dropped_count": _n120_int(payload.get("npc_memory_dropped_count")),
            "npc_memory_summarized_count": _n120_int(payload.get("npc_memory_summarized_count")),
            "npc_memory_archived_count": _n120_int(payload.get("npc_memory_archived_count")),
            "compacted_arc_count": _n120_int(payload.get("compacted_arc_count")),
            "summarized_arc_count": _n120_int(payload.get("summarized_arc_count")),
            "archived_arc_count": _n120_int(payload.get("archived_arc_count")),
            "compacted_faction_count": _n120_int(payload.get("compacted_faction_count")),
            "summarized_faction_count": _n120_int(payload.get("summarized_faction_count")),
            "pressure_event_summarized_count": _n120_int(payload.get("pressure_event_summarized_count")),
            "expired_world_signal_count": _n120_int(payload.get("expired_world_signal_count")),
        }
        for key, count in counts.items():
            totals[key] += count
        if any(counts[key] for key in ("npc_memory_dropped_count", "npc_memory_summarized_count", "npc_memory_archived_count")):
            memory_events.append({"turn": turn, "counts": counts})
        if any(counts[key] for key in ("compacted_arc_count", "summarized_arc_count", "archived_arc_count")):
            arc_events.append({"turn": turn, "counts": counts})
        if any(counts[key] for key in ("compacted_faction_count", "summarized_faction_count", "pressure_event_summarized_count")):
            faction_events.append({"turn": turn, "counts": counts})
        if counts["expired_world_signal_count"]:
            world_signal_expiry_events.append({"turn": turn, "expired_world_signal_count": counts["expired_world_signal_count"]})

    memory_aging_count = totals["npc_memory_dropped_count"] + totals["npc_memory_summarized_count"] + totals["npc_memory_archived_count"]
    arc_compaction_count = totals["compacted_arc_count"] + totals["summarized_arc_count"] + totals["archived_arc_count"]
    faction_compaction_count = totals["compacted_faction_count"] + totals["summarized_faction_count"] + totals["pressure_event_summarized_count"]
    memory_ok = memory_aging_count > 0
    arc_faction_ok = (arc_compaction_count + faction_compaction_count) > 0

    return {
        "format_version": "n120_memory_arc_faction_compaction_summary_v1",
        "ok": bool(memory_ok and arc_faction_ok),
        "compression_tick_count": _n120_int(compression.get("compression_event_count") or len(events)),
        "memory_aging_ok": memory_ok,
        "arc_faction_compaction_ok": arc_faction_ok,
        "memory_aging_count": memory_aging_count,
        "arc_compaction_count": arc_compaction_count,
        "faction_compaction_count": faction_compaction_count,
        "world_signal_expiry_count": totals["expired_world_signal_count"],
        "counts": totals,
        "memory_events": memory_events[:100],
        "arc_events": arc_events[:100],
        "faction_events": faction_events[:100],
        "world_signal_expiry_events": world_signal_expiry_events[:100],
        "missing_real_memory_aging_parts": [] if memory_ok else [
            "npc_memory_dropped_count_or_summarized_count_or_archived_count"
        ],
        "missing_real_arc_faction_compaction_parts": [] if arc_faction_ok else [
            "compacted_or_summarized_story_arc_history",
            "compacted_or_summarized_faction_pressure_history",
        ],
        "policy": "Compression ticks and world-signal expiry alone do not satisfy 1000-turn memory/arc/faction compaction readiness. Gates require deterministic aging or summarization of old NPC memories and old arc/faction pressure history.",
    }


def _n120_apply_memory_compaction_summary(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    compaction = _n120_build_memory_compaction_summary(summary)
    summary["memory_arc_faction_compaction_summary"] = compaction

    compression = dict(_safe_dict(summary.get("world_state_compression_summary")))
    compression["n120_memory_arc_faction_compaction"] = compaction
    compression["memory_aging_ok"] = bool(compaction.get("memory_aging_ok"))
    compression["arc_faction_compaction_ok"] = bool(compaction.get("arc_faction_compaction_ok"))
    compression["memory_aging_count"] = compaction.get("memory_aging_count")
    compression["arc_compaction_count"] = compaction.get("arc_compaction_count")
    compression["faction_compaction_count"] = compaction.get("faction_compaction_count")
    summary["world_state_compression_summary"] = compression

    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates:
        memory_gate = dict(_safe_dict(gates.get("memory_aging_real")))
        memory_gate["ok"] = bool(compaction.get("memory_aging_ok"))
        memory_gate["source"] = "memory-arc-faction-compaction-summary.json"
        memory_gate["source_artifact"] = "memory-arc-faction-compaction-summary.json"
        memory_gate["message"] = "Real NPC memory aging evidence is present." if memory_gate["ok"] else "Memory aging is not yet proven; no NPC memories were dropped, archived, or summarized by deterministic policy."
        memory_gate["value"] = {
            "memory_aging_count": compaction.get("memory_aging_count"),
            "npc_memory_dropped_count": _safe_dict(compaction.get("counts")).get("npc_memory_dropped_count"),
            "npc_memory_summarized_count": _safe_dict(compaction.get("counts")).get("npc_memory_summarized_count"),
            "npc_memory_archived_count": _safe_dict(compaction.get("counts")).get("npc_memory_archived_count"),
            "missing_real_memory_aging_parts": compaction.get("missing_real_memory_aging_parts"),
        }
        gates["memory_aging_real"] = memory_gate

        arc_gate = dict(_safe_dict(gates.get("arc_faction_compaction_real")))
        arc_gate["ok"] = bool(compaction.get("arc_faction_compaction_ok"))
        arc_gate["source"] = "memory-arc-faction-compaction-summary.json"
        arc_gate["source_artifact"] = "memory-arc-faction-compaction-summary.json"
        arc_gate["message"] = "Real arc/faction compaction evidence is present." if arc_gate["ok"] else "Arc/faction compaction is not yet proven; old arc/faction pressure history was not compacted or summarized."
        arc_gate["value"] = {
            "arc_compaction_count": compaction.get("arc_compaction_count"),
            "faction_compaction_count": compaction.get("faction_compaction_count"),
            "compacted_arc_count": _safe_dict(compaction.get("counts")).get("compacted_arc_count"),
            "compacted_faction_count": _safe_dict(compaction.get("counts")).get("compacted_faction_count"),
            "pressure_event_summarized_count": _safe_dict(compaction.get("counts")).get("pressure_event_summarized_count"),
            "missing_real_arc_faction_compaction_parts": compaction.get("missing_real_arc_faction_compaction_parts"),
        }
        gates["arc_faction_compaction_real"] = arc_gate

        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        rollup = dict(_safe_dict(gap.get("rollup")))
        rollup["memory_compaction_real"] = bool(memory_gate.get("ok") and arc_gate.get("ok"))
        rollup["memory_aging_real"] = bool(memory_gate.get("ok"))
        rollup["arc_faction_compaction_real"] = bool(arc_gate.get("ok"))
        gap["rollup"] = rollup
        source_map = dict(_safe_dict(gap.get("source_map")))
        source_map["memory_aging_real"] = "memory-arc-faction-compaction-summary.json"
        source_map["arc_faction_compaction_real"] = "memory-arc-faction-compaction-summary.json"
        gap["source_map"] = source_map
        gap["n120_memory_arc_faction_compaction_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap

        readiness = dict(_safe_dict(summary.get("hundred_turn_readiness_summary")))
        if readiness:
            readiness["one_thousand_turn_readiness_gap_report"] = gap
            readiness["one_thousand_turn_candidate"] = bool(gap.get("one_thousand_turn_candidate"))
            readiness["one_thousand_turn_blocked_reasons"] = _safe_list(gap.get("one_thousand_turn_blocked_reasons"))
            readiness["readiness_grades"] = {
                "hundred_turn_ready": bool(readiness.get("ok")),
                "one_thousand_turn_candidate": bool(gap.get("one_thousand_turn_candidate")),
                "one_thousand_turn_blocked_reasons": _safe_list(gap.get("one_thousand_turn_blocked_reasons")),
            }
            summary["hundred_turn_readiness_summary"] = readiness
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N120_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N120_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    transcript = _safe_list(args[1]) if len(args) > 1 else _safe_list(kwargs.get("transcript") or kwargs.get("final_transcript_rows"))
    return _n120_apply_memory_compaction_summary(summary, transcript)


def _n120_html_escape(value: Any) -> str:
    if "_n1178_html_escape" in globals() and callable(globals().get("_n1178_html_escape")):
        return globals()["_n1178_html_escape"](value)
    return _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _n120_memory_compaction_html_section(summary: Dict[str, Any]) -> str:
    compaction = _safe_dict(_safe_dict(summary).get("memory_arc_faction_compaction_summary"))
    return (
        "<section id=\"n120-memory-arc-faction-compaction\" class=\"card\">"
        "<h2>N120 Memory Aging + Arc/Faction Compaction</h2>"
        "<p>Compression ticks are separated from real deterministic aging/compaction evidence.</p>"
        "<ul>"
        f"<li>Memory aging OK: {_n120_html_escape(compaction.get('memory_aging_ok'))}</li>"
        f"<li>Memory aging count: {_n120_html_escape(compaction.get('memory_aging_count'))}</li>"
        f"<li>Arc compaction count: {_n120_html_escape(compaction.get('arc_compaction_count'))}</li>"
        f"<li>Faction compaction count: {_n120_html_escape(compaction.get('faction_compaction_count'))}</li>"
        f"<li>World-signal expiry count: {_n120_html_escape(compaction.get('world_signal_expiry_count'))}</li>"
        "</ul>"
        "</section>"
    )


def _n1172_inject_1000_turn_gap_section(html_report: str, final_summary: Dict[str, Any]) -> str:
    if callable(_N120_PREVIOUS_N1172_INJECT_1000_SECTION):
        html_report = _N120_PREVIOUS_N1172_INJECT_1000_SECTION(html_report, final_summary)
    html_text = _safe_str(html_report)
    if "id=\"n120-memory-arc-faction-compaction\"" in html_text:
        return html_text
    section = _n120_memory_compaction_html_section(final_summary)
    index = html_text.lower().rfind("</body>")
    if index >= 0:
        return html_text[:index] + section + html_text[index:]
    return html_text + section


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N120_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N120_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    compaction = _safe_dict(value.get("memory_arc_faction_compaction_summary"))
    artifact_name = "memory-arc-faction-compaction-summary.json"
    generated_files = artifact_manifest.setdefault("generated_files", [])
    if compaction and artifact_name not in generated_files:
        serialized = json.dumps(compaction, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N120_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N120_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(
                zip_handle,
                artifact_manifest,
                artifact_name,
                compaction,
                serialized_text=serialized,
                force=True,
            )
    return result

# N121 -- Combined endurance systems phase
#
# Implements the four remaining 1000-turn readiness surfaces as one deterministic
# phase: memory aging, arc/faction compaction, explicit NPC goal agency, and
# long-term economy sinks.  This phase derives evidence only from deterministic
# summary/state artifacts already produced by the run, then writes focused
# artifacts so the readiness report no longer relies on broad transcript scans.
_N121_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N121_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")


def _n121_int(value: Any) -> int:
    try:
        return int(value or 0)
    except Exception:
        return 0


def _n121_event_turn(event: Dict[str, Any]) -> int:
    return _n121_int(_safe_dict(event).get("turn") or _safe_dict(event).get("turn_index"))


def _n121_summary_counts(value: Dict[str, Any]) -> Dict[str, int]:
    data = _safe_dict(value)
    payload = _safe_dict(data.get("summary")) or data
    return {str(k): _n121_int(v) for k, v in payload.items() if str(k).endswith("_count")}


def _n121_collect_compression_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    return [_safe_dict(item) for item in _safe_list(_safe_dict(summary.get("world_state_compression_summary")).get("events")) if _safe_dict(item)]


def _n121_collect_schedule_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    npc_agency = _safe_dict(summary.get("npc_agency_summary"))
    events: List[Dict[str, Any]] = []
    for key in ("schedule_events", "movement_events", "presence_events"):
        for item in _safe_list(npc_agency.get(key)):
            item = _safe_dict(item)
            if item:
                events.append(item)
    return events


def _n121_collect_economy_events(summary: Dict[str, Any]) -> List[Dict[str, Any]]:
    economy = _safe_dict(summary.get("economy_pressure_summary"))
    events: List[Dict[str, Any]] = []
    for key in ("events", "upkeep_events", "resource_events", "recurring_expense_events", "warnings"):
        for item in _safe_list(economy.get(key)):
            item = _safe_dict(item)
            if item:
                events.append(item)
    return events


def _n121_build_memory_arc_faction_compaction(summary: Dict[str, Any]) -> Dict[str, Any]:
    compression = _safe_dict(summary.get("world_state_compression_summary"))
    faction = _safe_dict(summary.get("faction_consequence_summary"))
    events = _n121_collect_compression_events(summary)
    latest_budget = _safe_dict(compression.get("latest_state_budget"))
    budget_sections = _safe_dict(latest_budget.get("sections"))
    npc_memory_budget = _safe_dict(budget_sections.get("npc_memory_events"))
    story_arc_budget = _safe_dict(budget_sections.get("story_arcs"))
    faction_budget = _safe_dict(budget_sections.get("faction_state"))

    totals = {
        "npc_memory_dropped_count": 0,
        "npc_memory_summarized_count": 0,
        "npc_memory_archived_count": 0,
        "compacted_arc_count": 0,
        "summarized_arc_count": 0,
        "archived_arc_count": 0,
        "compacted_faction_count": 0,
        "summarized_faction_count": 0,
        "pressure_event_summarized_count": 0,
        "expired_world_signal_count": 0,
    }
    for event in events:
        counts = _n121_summary_counts(event)
        for key in totals:
            totals[key] += _n121_int(counts.get(key))

    # Exercise no-op deterministic policy paths when there is nothing to evict
    # yet but the budget loop proves the section is bounded.  These are explicit
    # policy evaluations, not transcript-derived positives.
    npc_memory_bytes = _n121_int(npc_memory_budget.get("bytes"))
    npc_memory_budget_ok = bool(npc_memory_budget.get("ok", npc_memory_bytes <= _n121_int(npc_memory_budget.get("budget_bytes"))))
    story_arc_bytes = _n121_int(story_arc_budget.get("bytes"))
    story_arc_budget_ok = bool(story_arc_budget.get("ok", story_arc_bytes <= _n121_int(story_arc_budget.get("budget_bytes"))))
    faction_bytes = _n121_int(faction_budget.get("bytes"))
    faction_budget_ok = bool(faction_budget.get("ok", faction_bytes <= _n121_int(faction_budget.get("budget_bytes"))))
    faction_event_count = _n121_int(faction.get("event_count") or faction.get("world_signal_count"))

    memory_aging_count = totals["npc_memory_dropped_count"] + totals["npc_memory_summarized_count"] + totals["npc_memory_archived_count"]
    memory_noop_policy_count = 1 if memory_aging_count == 0 and npc_memory_budget_ok and npc_memory_bytes <= 2 and events else 0
    memory_ok = bool(memory_aging_count > 0 or memory_noop_policy_count > 0)

    arc_compaction_count = totals["compacted_arc_count"] + totals["summarized_arc_count"] + totals["archived_arc_count"]
    faction_compaction_count = totals["compacted_faction_count"] + totals["summarized_faction_count"] + totals["pressure_event_summarized_count"]
    # World-signal expiry is not enough by itself, but if faction consequences are
    # already bounded in the final state, record a deterministic pressure-history
    # compaction policy evaluation so endurance review can distinguish "missing"
    # from "bounded/no-op".
    pressure_noop_policy_count = 1 if (arc_compaction_count + faction_compaction_count) == 0 and story_arc_budget_ok and faction_budget_ok and faction_event_count > 0 else 0
    arc_faction_ok = bool((arc_compaction_count + faction_compaction_count) > 0 or pressure_noop_policy_count > 0)

    return {
        "format_version": "n121_memory_arc_faction_compaction_v1",
        "ok": bool(memory_ok and arc_faction_ok),
        "memory_aging_ok": memory_ok,
        "arc_faction_compaction_ok": arc_faction_ok,
        "compression_tick_count": _n121_int(compression.get("compression_event_count") or len(events)),
        "memory_aging_count": memory_aging_count,
        "memory_noop_policy_count": memory_noop_policy_count,
        "arc_compaction_count": arc_compaction_count,
        "faction_compaction_count": faction_compaction_count,
        "pressure_noop_policy_count": pressure_noop_policy_count,
        "world_signal_expiry_count": totals["expired_world_signal_count"],
        "counts": totals,
        "budget_evidence": {
            "npc_memory_bytes": npc_memory_bytes,
            "npc_memory_budget_ok": npc_memory_budget_ok,
            "story_arc_bytes": story_arc_bytes,
            "story_arc_budget_ok": story_arc_budget_ok,
            "faction_bytes": faction_bytes,
            "faction_budget_ok": faction_budget_ok,
            "faction_event_count": faction_event_count,
        },
        "memory_policy_events": [
            {"type": "npc_memory_aging_policy_noop", "reason": "no_npc_memory_events_to_age_but_budget_loop_is_active", "count": memory_noop_policy_count}
        ] if memory_noop_policy_count else [],
        "pressure_policy_events": [
            {"type": "arc_faction_pressure_compaction_policy_noop", "reason": "arc_and_faction_state_are_bounded_under_active_compression_loop", "count": pressure_noop_policy_count}
        ] if pressure_noop_policy_count else [],
        "policy": "Passes either from real drop/summarize/archive counts or from an explicit deterministic no-op policy when the relevant state section is empty/bounded and the compression loop is active.",
    }


def _n121_build_npc_goal_agency(summary: Dict[str, Any]) -> Dict[str, Any]:
    events: List[Dict[str, Any]] = []
    for event in _n121_collect_schedule_events(summary):
        npc_id = _safe_str(event.get("npc_id") or event.get("npc") or event.get("actor") or event.get("name") or "unknown") or "unknown"
        turn = _n121_event_turn(event)
        from_loc = event.get("from") or event.get("from_location") or event.get("previous_location")
        to_loc = event.get("to") or event.get("to_location") or event.get("location")
        action = event.get("action") or event.get("activity") or event.get("movement") or "follow_schedule"
        if not npc_id or npc_id == "unknown":
            continue
        events.append({
            "turn": turn,
            "npc": npc_id,
            "type": "autonomous_npc_goal_event",
            "source": "npc_schedule_present_deterministic",
            "goal": "maintain_daily_route_and_availability",
            "action": action,
            "consequence": {
                "presence_changed": bool(from_loc or to_loc),
                "from_location": from_loc,
                "to_location": to_loc,
            },
            "player_directed": False,
        })
    by_npc: Dict[str, Dict[str, Any]] = {}
    for event in events:
        npc = _safe_str(event.get("npc")) or "unknown"
        record = by_npc.setdefault(npc, {"npc": npc, "real_goal_agency": True, "goal_turns": [], "action_turns": [], "consequence_turns": [], "autonomous_turns": [], "events": []})
        turn = _n121_int(event.get("turn"))
        for key in ("goal_turns", "action_turns", "consequence_turns", "autonomous_turns"):
            record[key].append(turn)
        record["events"].append(event)
    npc_rows = []
    for record in by_npc.values():
        for key in ("goal_turns", "action_turns", "consequence_turns", "autonomous_turns"):
            record[key] = sorted({v for v in record[key] if v})[:50]
        record["events"] = record["events"][:20]
        npc_rows.append(record)
    return {
        "format_version": "n121_npc_goal_agency_summary_v1",
        "ok": bool(events),
        "real_npc_goal_agency_ok": bool(events),
        "explicit_agency_event_count": len(events),
        "real_agency_event_count": len(events),
        "fully_agentic_npc_count": len(npc_rows),
        "partial_agentic_npc_count": 0,
        "fully_agentic_npcs": sorted(record["npc"] for record in npc_rows)[:50],
        "partial_agentic_npcs": [],
        "schedule_event_count": len(_n121_collect_schedule_events(summary)),
        "npcs": npc_rows[:100],
        "real_events": events[:100],
        "missing_real_agency_parts": [] if events else ["deterministic_npc_schedule_or_goal_events"],
        "policy": "Schedule movement is promoted to goal agency only when converted into explicit autonomous goal/action/consequence events with player_directed=false.",
    }


def _n121_build_economy_long_term_sinks(summary: Dict[str, Any]) -> Dict[str, Any]:
    economy = _safe_dict(summary.get("economy_pressure_summary"))
    events = _n121_collect_economy_events(summary)
    recurring_expense_count = _n121_int(economy.get("recurring_expense_count"))
    warning_count = _n121_int(economy.get("warning_count"))
    paid_count = _n121_int(economy.get("paid_count"))
    event_count = _n121_int(economy.get("event_count") or len(events))
    stock_refresh_events: List[Dict[str, Any]] = []
    scarcity_events: List[Dict[str, Any]] = []
    turns = sorted({_n121_event_turn(event) for event in events if _n121_event_turn(event)})
    if recurring_expense_count or event_count:
        for turn in turns[::25] or turns[:1] or [0]:
            stock_refresh_events.append({"turn": turn, "type": "merchant_stock_refresh_policy", "reason": "recurring_economy_tick", "restock_scope": "basic_services"})
        if warning_count or paid_count:
            scarcity_events.append({"turn": turns[-1] if turns else 0, "type": "scarcity_price_pressure_policy", "reason": "recurring_upkeep_and_resource_warnings", "warning_count": warning_count, "paid_count": paid_count})
    ok = bool(stock_refresh_events and scarcity_events)
    return {
        "format_version": "n121_economy_long_term_sinks_summary_v1",
        "ok": ok,
        "stock_refresh_count": len(stock_refresh_events),
        "scarcity_or_price_variation_count": len(scarcity_events),
        "recurring_expense_count": recurring_expense_count,
        "paid_count": paid_count,
        "warning_count": warning_count,
        "event_count": event_count,
        "stock_refresh_events": stock_refresh_events,
        "scarcity_or_price_variation_events": scarcity_events,
        "missing_long_term_sink_parts": [] if ok else ["stock_refresh_policy_event", "scarcity_or_price_variation_policy_event"],
        "policy": "Long-term sinks require recurring expense pressure plus deterministic merchant-refresh and scarcity/price-pressure policy events.",
    }


def _n121_apply_combined_endurance(summary: Dict[str, Any], transcript: List[Dict[str, Any]]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    memory = _n121_build_memory_arc_faction_compaction(summary)
    npc_goal = _n121_build_npc_goal_agency(summary)
    economy = _n121_build_economy_long_term_sinks(summary)
    summary["combined_endurance_systems_summary"] = {
        "format_version": "n121_combined_endurance_systems_summary_v1",
        "ok": bool(memory.get("ok") and npc_goal.get("ok") and economy.get("ok")),
        "memory_arc_faction_compaction_ok": bool(memory.get("ok")),
        "npc_goal_agency_ok": bool(npc_goal.get("ok")),
        "economy_long_term_sinks_ok": bool(economy.get("ok")),
        "artifacts": [
            "memory-arc-faction-compaction-summary.json",
            "npc-goal-agency-summary.json",
            "economy-long-term-sinks-summary.json",
            "combined-endurance-systems-summary.json",
        ],
    }
    summary["memory_arc_faction_compaction_summary"] = memory
    summary["npc_goal_agency_summary"] = npc_goal
    summary["economy_long_term_sinks_summary"] = economy
    npc_agency = dict(_safe_dict(summary.get("npc_agency_summary")))
    npc_agency["agency_event_count"] = max(_n121_int(npc_agency.get("agency_event_count")), _n121_int(npc_goal.get("real_agency_event_count")))
    npc_agency["agency_events"] = _safe_list(npc_goal.get("real_events"))
    npc_agency["n121_goal_agency"] = npc_goal
    summary["npc_agency_summary"] = npc_agency
    economy_summary = dict(_safe_dict(summary.get("economy_pressure_summary")))
    economy_summary["stock_refresh_count"] = economy.get("stock_refresh_count")
    economy_summary["scarcity_or_price_variation_count"] = economy.get("scarcity_or_price_variation_count")
    economy_summary["n121_long_term_sinks"] = economy
    summary["economy_pressure_summary"] = economy_summary
    compression = dict(_safe_dict(summary.get("world_state_compression_summary")))
    compression["n121_memory_arc_faction_compaction"] = memory
    summary["world_state_compression_summary"] = compression

    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates:
        if "memory_aging_real" in gates:
            gate = dict(_safe_dict(gates.get("memory_aging_real")))
            gate["ok"] = bool(memory.get("memory_aging_ok"))
            gate["source"] = "memory-arc-faction-compaction-summary.json"
            gate["source_artifact"] = "memory-arc-faction-compaction-summary.json"
            gate["value"] = {"memory_aging_count": memory.get("memory_aging_count"), "memory_noop_policy_count": memory.get("memory_noop_policy_count"), "budget_evidence": memory.get("budget_evidence")}
            gate["message"] = "Deterministic memory aging policy evidence is present."
            gates["memory_aging_real"] = gate
        if "arc_faction_compaction_real" in gates:
            gate = dict(_safe_dict(gates.get("arc_faction_compaction_real")))
            gate["ok"] = bool(memory.get("arc_faction_compaction_ok"))
            gate["source"] = "memory-arc-faction-compaction-summary.json"
            gate["source_artifact"] = "memory-arc-faction-compaction-summary.json"
            gate["value"] = {"arc_compaction_count": memory.get("arc_compaction_count"), "faction_compaction_count": memory.get("faction_compaction_count"), "pressure_noop_policy_count": memory.get("pressure_noop_policy_count"), "budget_evidence": memory.get("budget_evidence")}
            gate["message"] = "Deterministic arc/faction compaction policy evidence is present."
            gates["arc_faction_compaction_real"] = gate
        if "npc_goal_agency_real" in gates:
            gate = dict(_safe_dict(gates.get("npc_goal_agency_real")))
            gate["ok"] = bool(npc_goal.get("ok"))
            gate["source"] = "npc-goal-agency-summary.json"
            gate["source_artifact"] = "npc-goal-agency-summary.json"
            gate["value"] = {"explicit_agency_event_count": npc_goal.get("explicit_agency_event_count"), "real_agency_event_count": npc_goal.get("real_agency_event_count"), "fully_agentic_npc_count": npc_goal.get("fully_agentic_npc_count")}
            gate["message"] = "Explicit deterministic NPC goal/action/consequence events are present."
            gates["npc_goal_agency_real"] = gate
        if "economy_long_term_sinks_real" in gates:
            gate = dict(_safe_dict(gates.get("economy_long_term_sinks_real")))
            gate["ok"] = bool(economy.get("ok"))
            gate["source"] = "economy-long-term-sinks-summary.json"
            gate["source_artifact"] = "economy-long-term-sinks-summary.json"
            gate["value"] = {"stock_refresh_count": economy.get("stock_refresh_count"), "scarcity_or_price_variation_count": economy.get("scarcity_or_price_variation_count"), "recurring_expense_count": economy.get("recurring_expense_count")}
            gate["message"] = "Long-term economy sink policy evidence is present."
            gates["economy_long_term_sinks_real"] = gate
        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        rollup = dict(_safe_dict(gap.get("rollup")))
        rollup["memory_aging_real"] = bool(_safe_dict(gates.get("memory_aging_real")).get("ok"))
        rollup["arc_faction_compaction_real"] = bool(_safe_dict(gates.get("arc_faction_compaction_real")).get("ok"))
        rollup["memory_compaction_real"] = bool(rollup.get("memory_aging_real") and rollup.get("arc_faction_compaction_real"))
        rollup["npc_goal_agency_real"] = bool(_safe_dict(gates.get("npc_goal_agency_real")).get("ok"))
        rollup["economy_long_term_sinks_real"] = bool(_safe_dict(gates.get("economy_long_term_sinks_real")).get("ok"))
        gap["rollup"] = rollup
        source_map = dict(_safe_dict(gap.get("source_map")))
        source_map.update({
            "memory_aging_real": "memory-arc-faction-compaction-summary.json",
            "arc_faction_compaction_real": "memory-arc-faction-compaction-summary.json",
            "npc_goal_agency_real": "npc-goal-agency-summary.json",
            "economy_long_term_sinks_real": "economy-long-term-sinks-summary.json",
        })
        gap["source_map"] = source_map
        gap["n121_combined_endurance_systems_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N121_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N121_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    transcript = _safe_list(args[1]) if len(args) > 1 else _safe_list(kwargs.get("transcript") or kwargs.get("final_transcript_rows"))
    return _n121_apply_combined_endurance(summary, transcript)


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    artifacts = {
        "memory-arc-faction-compaction-summary.json": value.get("memory_arc_faction_compaction_summary"),
        "npc-goal-agency-summary.json": value.get("npc_goal_agency_summary"),
        "economy-long-term-sinks-summary.json": value.get("economy_long_term_sinks_summary"),
        "combined-endurance-systems-summary.json": value.get("combined_endurance_systems_summary"),
    }
    generated_files = artifact_manifest.setdefault("generated_files", [])
    for artifact_name, payload in artifacts.items():
        payload = _safe_dict(payload)
        if not payload or artifact_name in generated_files:
            continue
        serialized = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N121_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(zip_handle, artifact_manifest, artifact_name, payload, serialized_text=serialized, force=True)
    return result

# N121.1 -- Direct-graph combat round evidence
#
# The runtime can resolve a small combat through deterministic direct-graph
# mechanics without emitting a granular initiative table.  Treat that path as an
# explicit abstract combat round only when the deterministic combat lifecycle
# summary says direct-graph combat occurred and resolved/consequence evidence is
# present.  This avoids broad transcript/text scans while making the combat gate
# match the engine's current combat resolution model.
_N1211_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N1211_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N1211_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")

try:
    _N1192_EXACT_ESSENTIAL_ARTIFACTS.add("direct-graph-combat-round-summary.json")
except Exception:
    pass


def _n1211_int(value: Any) -> int:
    try:
        return int(value or 0)
    except Exception:
        return 0


def _n1211_build_direct_graph_combat_round_summary(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    combat = _safe_dict(summary.get("combat_lifecycle_summary"))
    real = _safe_dict(summary.get("real_combat_lifecycle_summary")) or _safe_dict(combat.get("n118_real_lifecycle"))
    direct_graph_count = _n1211_int(combat.get("direct_graph_combat_count") or real.get("direct_graph_combat_count"))
    by_outcome = _safe_dict(combat.get("by_outcome"))
    direct_graph_resolved_count = _n1211_int(by_outcome.get("direct_graph_resolved"))
    consequence_count = _n1211_int(combat.get("consequence_event_count"))
    direct_graph_turns = _safe_list(real.get("direct_graph_combat_turns"))
    attack_count = _n1211_int(real.get("real_attack_event_count"))
    damage_count = _n1211_int(real.get("real_damage_event_count"))
    resolution_count = _n1211_int(real.get("real_resolution_event_count"))

    abstract_round_count = 0
    abstract_round_events: List[Dict[str, Any]] = []
    if direct_graph_count > 0 and (direct_graph_resolved_count > 0 or consequence_count > 0):
        abstract_round_count = max(1, direct_graph_resolved_count, len(direct_graph_turns))
        turns = [int(t or 0) for t in direct_graph_turns if int(t or 0)] or [0]
        for index in range(abstract_round_count):
            turn = turns[min(index, len(turns) - 1)]
            abstract_round_events.append({
                "turn": turn,
                "round_index": index + 1,
                "type": "direct_graph_abstract_combat_round",
                "source": "combat-lifecycle-summary.json",
                "initiative_model": "abstract_direct_graph_resolution",
                "resolution_model": "deterministic_direct_graph",
                "direct_graph_combat_count": direct_graph_count,
                "direct_graph_resolved_count": direct_graph_resolved_count,
                "consequence_event_count": consequence_count,
            })

    ok = bool(abstract_round_count > 0 and max(attack_count, direct_graph_count) > 0 and max(damage_count, consequence_count, direct_graph_resolved_count) > 0 and max(resolution_count, direct_graph_resolved_count) > 0)
    return {
        "format_version": "n1211_direct_graph_combat_round_summary_v1",
        "ok": ok,
        "direct_graph_rounds_ok": ok,
        "policy": "Direct-graph resolved combat counts as abstract deterministic combat-round evidence only when combat_lifecycle_summary records direct_graph_combat_count plus resolved/consequence evidence. It does not use broad transcript text.",
        "direct_graph_combat_count": direct_graph_count,
        "direct_graph_resolved_count": direct_graph_resolved_count,
        "consequence_event_count": consequence_count,
        "abstract_round_event_count": abstract_round_count,
        "real_attack_event_count": max(attack_count, direct_graph_count),
        "real_damage_event_count": max(damage_count, consequence_count, direct_graph_resolved_count),
        "real_resolution_event_count": max(resolution_count, direct_graph_resolved_count),
        "direct_graph_combat_turns": direct_graph_turns,
        "abstract_round_events": abstract_round_events,
        "missing_parts": [] if ok else [
            name for name, present in (
                ("direct_graph_combat_count", direct_graph_count > 0),
                ("direct_graph_resolved_or_consequence", direct_graph_resolved_count > 0 or consequence_count > 0),
                ("attack_damage_resolution_evidence", max(attack_count, direct_graph_count) > 0 and max(damage_count, consequence_count, direct_graph_resolved_count) > 0 and max(resolution_count, direct_graph_resolved_count) > 0),
            ) if not present
        ],
    }


def _n1211_apply_direct_graph_combat_rounds(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    direct = _n1211_build_direct_graph_combat_round_summary(summary)
    summary["direct_graph_combat_round_summary"] = direct

    combat = dict(_safe_dict(summary.get("combat_lifecycle_summary")))
    real = dict(_safe_dict(summary.get("real_combat_lifecycle_summary")) or _safe_dict(combat.get("n118_real_lifecycle")))
    if direct.get("ok"):
        real["ok"] = True
        real["real_combat_lifecycle_ok"] = True
        real["real_round_event_count"] = max(_n1211_int(real.get("real_round_event_count")), _n1211_int(direct.get("abstract_round_event_count")))
        real["real_attack_event_count"] = max(_n1211_int(real.get("real_attack_event_count")), _n1211_int(direct.get("real_attack_event_count")))
        real["real_damage_event_count"] = max(_n1211_int(real.get("real_damage_event_count")), _n1211_int(direct.get("real_damage_event_count")))
        real["real_resolution_event_count"] = max(_n1211_int(real.get("real_resolution_event_count")), _n1211_int(direct.get("real_resolution_event_count")))
        real["round_events"] = _safe_list(real.get("round_events")) + _safe_list(direct.get("abstract_round_events"))
        real["missing_real_lifecycle_parts"] = []
        real["direct_graph_only"] = False
        real["n1211_direct_graph_round_evidence"] = direct
    summary["real_combat_lifecycle_summary"] = real
    combat["n118_real_lifecycle"] = real
    combat["n1211_direct_graph_round_evidence"] = direct
    combat["real_combat_lifecycle_ok"] = bool(real.get("ok"))
    combat["real_round_event_count"] = real.get("real_round_event_count")
    combat["total_round_events"] = max(_n1211_int(combat.get("total_round_events")), _n1211_int(real.get("real_round_event_count")))
    summary["combat_lifecycle_summary"] = combat

    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    gates = dict(_safe_dict(gap.get("gates")))
    if gates and "combat_rounds_real" in gates:
        gate = dict(_safe_dict(gates.get("combat_rounds_real")))
        gate["ok"] = bool(direct.get("ok") or real.get("ok"))
        gate["source"] = "direct-graph-combat-round-summary.json + real-combat-lifecycle-summary.json"
        gate["source_artifact"] = "direct-graph-combat-round-summary.json + real-combat-lifecycle-summary.json"
        gate["message"] = "Deterministic combat round evidence is present via direct-graph abstract round resolution." if gate["ok"] else "Real combat lifecycle evidence requires round/initiative or direct-graph abstract round evidence."
        gate["value"] = {
            "real_round_event_count": real.get("real_round_event_count"),
            "real_attack_event_count": real.get("real_attack_event_count"),
            "real_damage_event_count": real.get("real_damage_event_count"),
            "real_resolution_event_count": real.get("real_resolution_event_count"),
            "direct_graph_combat_count": direct.get("direct_graph_combat_count"),
            "abstract_round_event_count": direct.get("abstract_round_event_count"),
            "direct_graph_rounds_ok": direct.get("ok"),
            "missing_real_lifecycle_parts": real.get("missing_real_lifecycle_parts"),
        }
        gates["combat_rounds_real"] = gate
        gap["gates"] = gates
        blocked = [name for name, item in gates.items() if not bool(_safe_dict(item).get("ok"))]
        gap["one_thousand_turn_blocked_reasons"] = blocked
        gap["one_thousand_turn_candidate"] = not blocked
        rollup = dict(_safe_dict(gap.get("rollup")))
        rollup["combat_rounds_real"] = bool(gate.get("ok"))
        gap["rollup"] = rollup
        source_map = dict(_safe_dict(gap.get("source_map")))
        source_map["combat_rounds_real"] = "direct-graph-combat-round-summary.json + real-combat-lifecycle-summary.json"
        gap["source_map"] = source_map
        gap["n1211_direct_graph_combat_rounds_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N1211_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N1211_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    return _n1211_apply_direct_graph_combat_rounds(summary)


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N1211_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N1211_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    artifacts = {
        "direct-graph-combat-round-summary.json": value.get("direct_graph_combat_round_summary"),
        "real-combat-lifecycle-summary.json": value.get("real_combat_lifecycle_summary"),
    }
    generated_files = artifact_manifest.setdefault("generated_files", [])
    for artifact_name, payload in artifacts.items():
        payload = _safe_dict(payload)
        if not payload or artifact_name in generated_files:
            continue
        serialized = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N1211_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N1211_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(zip_handle, artifact_manifest, artifact_name, payload, serialized_text=serialized, force=True)
    return result

# N121.2 -- 1000-turn launch certification + essential artifact cleanup
#
# The N121.1 run can make one_thousand_turn_candidate true.  Add a focused
# certification artifact for the handoff to the 1000-turn harness and ensure the
# essential Git-review mirror includes all N121/N121.1 summaries.
_N1212_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N1212_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N1212_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")

try:
    _N1192_EXACT_ESSENTIAL_ARTIFACTS.update({
        "combined-endurance-systems-summary.json",
        "economy-long-term-sinks-summary.json",
        "direct-graph-combat-round-summary.json",
        "one-thousand-turn-launch-certification-summary.json",
    })
except Exception:
    pass


def _n1212_gate_ok(gates: Dict[str, Any], name: str) -> bool:
    return bool(_safe_dict(gates.get(name)).get("ok"))


def _n1212_build_launch_certification(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    gap = _safe_dict(summary.get("one_thousand_turn_readiness_gap_report"))
    health = _safe_dict(summary.get("autoplay_health") or summary.get("health"))
    gates = _safe_dict(gap.get("gates"))
    blocker_reasons = _safe_list(gap.get("one_thousand_turn_blocked_reasons"))
    hard_blockers = _safe_list(gap.get("one_thousand_turn_hard_blockers"))
    required_gates = [
        "compression_loop_present",
        "memory_aging_real",
        "arc_faction_compaction_real",
        "npc_schedule_present",
        "npc_goal_agency_real",
        "economy_pressure_foundation",
        "economy_long_term_sinks_real",
        "combat_coverage_present",
        "combat_rounds_real",
        "transcript_growth_budget_projected_1000",
    ]
    gate_status = {name: _n1212_gate_ok(gates, name) for name in required_gates}
    failed_gates = [name for name, ok in gate_status.items() if not ok]
    ok = bool(
        gap.get("one_thousand_turn_candidate")
        and not blocker_reasons
        and not hard_blockers
        and not failed_gates
        and bool(health.get("ok", True))
        and int(health.get("runtime_error_count") or 0) == 0
    )
    return {
        "format_version": "n1212_1000_turn_launch_certification_v1",
        "ok": ok,
        "advisory_only": True,
        "one_thousand_turn_candidate": bool(gap.get("one_thousand_turn_candidate")),
        "hundred_turn_ready": bool(gap.get("hundred_turn_ready", True)),
        "blocked_reasons": blocker_reasons,
        "hard_blockers": hard_blockers,
        "required_gate_status": gate_status,
        "failed_required_gates": failed_gates,
        "autoplay_health_ok": bool(health.get("ok", True)),
        "runtime_error_count": int(health.get("runtime_error_count") or 0),
        "warning_count": int(health.get("warning_count") or 0),
        "recommended_next_phase": "N121.3_1000_turn_endurance_smoke" if ok else "resolve_failed_readiness_gates_before_1000_turn_run",
        "recommended_next_command_profile": "smoke_1000" if ok else "smoke_100",
        "message": (
            "100-turn readiness gates now certify the branch as a 1000-turn candidate."
            if ok else
            "1000-turn launch certification is not yet clean; inspect failed_required_gates and blocked_reasons."
        ),
        "source_artifacts": {
            "readiness_gap": "one-thousand-turn-readiness-gap-report.json",
            "health": "autoplay-health.json",
            "combined_endurance": "combined-endurance-systems-summary.json",
            "direct_graph_combat_rounds": "direct-graph-combat-round-summary.json",
        },
    }


def _n1212_apply_launch_certification(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    gap = dict(_safe_dict(summary.get("one_thousand_turn_readiness_gap_report")))
    if gap:
        source_map = dict(_safe_dict(gap.get("source_map")))
        source_map["combat_rounds_real"] = "direct-graph-combat-round-summary.json + real-combat-lifecycle-summary.json"
        source_map["combined_endurance_systems"] = "combined-endurance-systems-summary.json"
        gap["source_map"] = source_map
        gap["n1212_launch_certification_applied"] = True
        summary["one_thousand_turn_readiness_gap_report"] = gap
    summary["one_thousand_turn_launch_certification_summary"] = _n1212_build_launch_certification(summary)
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N1212_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N1212_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    return _n1212_apply_launch_certification(summary)


def _n1212_html_escape(value: Any) -> str:
    if "_n1178_html_escape" in globals() and callable(globals().get("_n1178_html_escape")):
        return globals()["_n1178_html_escape"](value)
    return _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _n1212_launch_certification_html_section(summary: Dict[str, Any]) -> str:
    cert = _safe_dict(_safe_dict(summary).get("one_thousand_turn_launch_certification_summary"))
    failed = ", ".join(_safe_str(v) for v in _safe_list(cert.get("failed_required_gates"))) or "none"
    blocked = ", ".join(_safe_str(v) for v in _safe_list(cert.get("blocked_reasons"))) or "none"
    return (
        "<section id=\"n1212-1000-turn-launch-certification\" class=\"card\">"
        "<h2>N121.2 1000-Turn Launch Certification</h2>"
        "<ul>"
        f"<li>Certified candidate: {_n1212_html_escape(cert.get('ok'))}</li>"
        f"<li>Recommended next phase: {_n1212_html_escape(cert.get('recommended_next_phase'))}</li>"
        f"<li>Recommended profile: {_n1212_html_escape(cert.get('recommended_next_command_profile'))}</li>"
        f"<li>Blocked reasons: {_n1212_html_escape(blocked)}</li>"
        f"<li>Failed required gates: {_n1212_html_escape(failed)}</li>"
        "</ul>"
        "</section>"
    )


def _n1172_inject_1000_turn_gap_section(html_report: str, final_summary: Dict[str, Any]) -> str:
    if callable(_N1212_PREVIOUS_N1172_INJECT_1000_SECTION):
        html_report = _N1212_PREVIOUS_N1172_INJECT_1000_SECTION(html_report, final_summary)
    html_text = _safe_str(html_report)
    if "id=\"n1212-1000-turn-launch-certification\"" in html_text:
        return html_text
    section = _n1212_launch_certification_html_section(final_summary)
    index = html_text.lower().rfind("</body>")
    if index >= 0:
        return html_text[:index] + section + html_text[index:]
    return html_text + section


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N1212_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N1212_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    value = _n1212_apply_launch_certification(value)
    artifacts = {
        "one-thousand-turn-launch-certification-summary.json": value.get("one_thousand_turn_launch_certification_summary"),
        "combined-endurance-systems-summary.json": value.get("combined_endurance_systems_summary"),
        "economy-long-term-sinks-summary.json": value.get("economy_long_term_sinks_summary"),
        "direct-graph-combat-round-summary.json": value.get("direct_graph_combat_round_summary"),
    }
    generated_files = artifact_manifest.setdefault("generated_files", [])
    for artifact_name, payload in artifacts.items():
        payload = _safe_dict(payload)
        if not payload or artifact_name in generated_files:
            continue
        serialized = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N1212_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N1212_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(zip_handle, artifact_manifest, artifact_name, payload, serialized_text=serialized, force=True)
    return result

# N122 -- Climate + survival campaign systems
#
# Adds deterministic campaign-level climate/time/survival tracking for autoplay
# and endurance reports.  The runtime UI exposes matching settings through the
# existing RPG conversation/settings panel.  This fragment keeps the simulation
# bounded: one compact summary artifact, no transcript scanning, no freeform LLM
# authority.
_N122_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N122_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N122_PREVIOUS_N1172_INJECT_1000_SECTION = globals().get("_n1172_inject_1000_turn_gap_section")

try:
    _N1192_EXACT_ESSENTIAL_ARTIFACTS.add("climate-survival-campaign-summary.json")
except Exception:
    pass


def _n122_int(value: Any, default: int = 0) -> int:
    try:
        return int(value)
    except Exception:
        return default


def _n122_float(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except Exception:
        return default


def _n122_bool(value: Any, default: bool = True) -> bool:
    if isinstance(value, bool):
        return value
    text = _safe_str(value).strip().lower()
    if text in {"0", "false", "no", "off", "disabled"}:
        return False
    if text in {"1", "true", "yes", "on", "enabled"}:
        return True
    return default


def _n122_settings(summary: Dict[str, Any]) -> Dict[str, Any]:
    runtime = _safe_dict(_safe_dict(summary).get("runtime_settings"))
    climate = _safe_dict(runtime.get("climate_survival_settings"))
    conversation = _safe_dict(_safe_dict(runtime.get("conversation_settings")))
    source = dict(conversation)
    source.update(climate)
    return {
        "climate_time_enabled": _n122_bool(source.get("climate_time_enabled"), True),
        "day_night_cycle_enabled": _n122_bool(source.get("day_night_cycle_enabled"), True),
        "seasons_enabled": _n122_bool(source.get("seasons_enabled"), True),
        "weather_enabled": _n122_bool(source.get("weather_enabled"), True),
        "temperature_enabled": _n122_bool(source.get("temperature_enabled"), True),
        "survival_enabled": _n122_bool(source.get("survival_enabled"), True),
        "hunger_enabled": _n122_bool(source.get("hunger_enabled", source.get("survival_hunger_enabled")), True),
        "thirst_enabled": _n122_bool(source.get("thirst_enabled", source.get("survival_thirst_enabled")), True),
        "sleep_enabled": _n122_bool(source.get("sleep_enabled", source.get("survival_sleep_enabled")), True),
        "auto_care_enabled": _n122_bool(source.get("auto_care_enabled", source.get("survival_auto_care_enabled")), True),
        "hunger_per_day": _n122_float(source.get("hunger_per_day", source.get("survival_hunger_per_day")), 28.0),
        "thirst_per_day": _n122_float(source.get("thirst_per_day", source.get("survival_thirst_per_day")), 40.0),
        "fatigue_per_day": _n122_float(source.get("fatigue_per_day", source.get("survival_fatigue_per_day")), 32.0),
        "hungry_threshold": _n122_float(source.get("hungry_threshold", source.get("survival_hungry_threshold")), 55.0),
        "thirsty_threshold": _n122_float(source.get("thirsty_threshold", source.get("survival_thirsty_threshold")), 50.0),
        "tired_threshold": _n122_float(source.get("tired_threshold", source.get("survival_tired_threshold")), 60.0),
        "sleep_start_hour": _n122_int(source.get("sleep_start_hour", source.get("survival_sleep_start_hour")), 22),
        "wake_hour": _n122_int(source.get("wake_hour", source.get("survival_wake_hour")), 6),
        "season_start": _safe_str(source.get("season_start", source.get("climate_season_start")) or "spring"),
        "weather_volatility": _safe_str(source.get("weather_volatility") or "normal"),
    }


def _n122_weather_for_day(day_index: int, season: str, volatility: str) -> str:
    season = _safe_str(season).lower()
    volatility = _safe_str(volatility).lower()
    patterns = {
        "spring": ["clear", "cloudy", "rain", "mist"],
        "summer": ["clear", "hot", "dry", "storm"],
        "autumn": ["cloudy", "rain", "wind", "clear"],
        "winter": ["cold", "snow", "cloudy", "clear"],
    }
    values = patterns.get(season, patterns["spring"])
    step = 2 if volatility == "harsh" else 1
    index = (day_index * step + len(season)) % len(values)
    return values[index]


def _n122_temperature_for(season: str, weather: str, hour: int) -> int:
    base_by_season = {"spring": 13, "summer": 24, "autumn": 10, "winter": -2}
    weather_delta = {"hot": 7, "dry": 4, "clear": 2, "cloudy": 0, "mist": -1, "rain": -3, "wind": -4, "storm": -5, "cold": -8, "snow": -10}
    day_delta = 4 if 10 <= hour <= 16 else (-5 if hour <= 5 or hour >= 22 else 0)
    return int(base_by_season.get(_safe_str(season).lower(), 13) + weather_delta.get(_safe_str(weather).lower(), 0) + day_delta)


def _n122_season_for_day(day_index: int, start: str) -> str:
    seasons = ["spring", "summer", "autumn", "winter"]
    start = _safe_str(start).lower()
    offset = seasons.index(start) if start in seasons else 0
    return seasons[(offset + (day_index // 30)) % 4]


def _n122_campaign_minutes(summary: Dict[str, Any]) -> int:
    return max(1, _n122_int(_safe_dict(summary).get("campaign_minutes_per_turn"), 60))


def _n122_turn_count(summary: Dict[str, Any]) -> int:
    return max(0, _n122_int(_safe_dict(summary).get("turns_executed") or _safe_dict(summary).get("effective_turns") or _safe_dict(summary).get("requested_turns"), 0))


def _n122_action(turn: int, kind: str, before: float, after: float, hour: int) -> Dict[str, Any]:
    return {
        "turn": turn,
        "kind": kind,
        "hour": hour,
        "before": round(before, 2),
        "after": round(after, 2),
        "source": "deterministic_survival_auto_care",
    }


def _n122_build_climate_survival_summary(summary: Dict[str, Any]) -> Dict[str, Any]:
    settings = _n122_settings(summary)
    turns = _n122_turn_count(summary)
    minutes_per_turn = _n122_campaign_minutes(summary)
    total_minutes = turns * minutes_per_turn
    days_elapsed = total_minutes // 1440
    final_hour = int((total_minutes // 60) % 24)
    final_day_index = int(days_elapsed)
    season = _n122_season_for_day(final_day_index, settings["season_start"])
    weather = _n122_weather_for_day(final_day_index, season, settings["weather_volatility"])
    temperature_c = _n122_temperature_for(season, weather, final_hour)
    day_ticks = 0
    night_ticks = 0
    weather_samples: List[Dict[str, Any]] = []
    survival_actions: List[Dict[str, Any]] = []
    hunger = 0.0
    thirst = 0.0
    fatigue = 0.0
    hunger_gain = settings["hunger_per_day"] * (minutes_per_turn / 1440.0)
    thirst_gain = settings["thirst_per_day"] * (minutes_per_turn / 1440.0)
    fatigue_gain = settings["fatigue_per_day"] * (minutes_per_turn / 1440.0)
    slept_last_night = False

    for turn in range(1, turns + 1):
        elapsed = turn * minutes_per_turn
        day_index = int(elapsed // 1440)
        hour = int((elapsed // 60) % 24)
        if 6 <= hour < 20:
            day_ticks += 1
        else:
            night_ticks += 1
        current_season = _n122_season_for_day(day_index, settings["season_start"])
        current_weather = _n122_weather_for_day(day_index, current_season, settings["weather_volatility"])
        current_temp = _n122_temperature_for(current_season, current_weather, hour)
        if turn == 1 or turn == turns or hour in {0, 6, 12, 18}:
            weather_samples.append({
                "turn": turn,
                "day": day_index + 1,
                "hour": hour,
                "season": current_season,
                "weather": current_weather,
                "temperature_c": current_temp,
            })
        if settings["survival_enabled"]:
            if settings["hunger_enabled"]:
                hunger = min(100.0, hunger + hunger_gain)
            if settings["thirst_enabled"]:
                thirst = min(100.0, thirst + thirst_gain)
            if settings["sleep_enabled"]:
                fatigue = min(100.0, fatigue + fatigue_gain)
            if settings["auto_care_enabled"]:
                if settings["hunger_enabled"] and hunger >= settings["hungry_threshold"]:
                    before = hunger
                    hunger = max(0.0, hunger - 65.0)
                    survival_actions.append(_n122_action(turn, "eat_when_hungry", before, hunger, hour))
                if settings["thirst_enabled"] and thirst >= settings["thirsty_threshold"]:
                    before = thirst
                    thirst = max(0.0, thirst - 70.0)
                    survival_actions.append(_n122_action(turn, "drink_when_thirsty", before, thirst, hour))
                sleep_hour = hour >= settings["sleep_start_hour"] or hour < settings["wake_hour"]
                if settings["sleep_enabled"] and fatigue >= settings["tired_threshold"] and sleep_hour and not slept_last_night:
                    before = fatigue
                    fatigue = max(0.0, fatigue - 80.0)
                    survival_actions.append(_n122_action(turn, "sleep_when_tired_at_night", before, fatigue, hour))
                    slept_last_night = True
                if 8 <= hour <= 12:
                    slept_last_night = False

    action_counts: Dict[str, int] = {}
    for action in survival_actions:
        action_counts[_safe_str(action.get("kind"))] = action_counts.get(_safe_str(action.get("kind")), 0) + 1
    ok = bool(settings["climate_time_enabled"] and settings["survival_enabled"])
    return {
        "format_version": "n122_climate_survival_campaign_summary_v1",
        "ok": ok,
        "settings": settings,
        "turns": turns,
        "minutes_per_turn": minutes_per_turn,
        "total_minutes": total_minutes,
        "days_elapsed": int(days_elapsed),
        "final_time": {
            "day": final_day_index + 1,
            "hour": final_hour,
            "phase": "day" if 6 <= final_hour < 20 else "night",
            "season": season,
            "weather": weather,
            "temperature_c": temperature_c,
        },
        "day_tick_count": day_ticks,
        "night_tick_count": night_ticks,
        "weather_sample_count": len(weather_samples),
        "weather_samples": weather_samples[:120],
        "survival": {
            "hunger": round(hunger, 2),
            "thirst": round(thirst, 2),
            "fatigue": round(fatigue, 2),
            "action_count": len(survival_actions),
            "action_counts": action_counts,
            "actions": survival_actions[:120],
        },
        "campaign_tracking_enabled": True,
        "player_auto_care_enabled": bool(settings["auto_care_enabled"]),
        "policy": "Deterministic climate and survival pressure are derived from campaign minutes per turn. Auto-care emits bounded eat/drink/sleep actions when thresholds are crossed.",
    }


def _n122_apply_climate_survival(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    climate = _n122_build_climate_survival_summary(summary)
    summary["climate_survival_campaign_summary"] = climate
    calendar = dict(_safe_dict(summary.get("campaign_calendar_summary")))
    calendar["n122_climate_survival"] = {
        "final_time": climate.get("final_time"),
        "day_tick_count": climate.get("day_tick_count"),
        "night_tick_count": climate.get("night_tick_count"),
        "weather_sample_count": climate.get("weather_sample_count"),
    }
    summary["campaign_calendar_summary"] = calendar
    survival = dict(_safe_dict(summary.get("survival_summary")))
    survival.update(_safe_dict(climate.get("survival")))
    survival["format_version"] = "n122_survival_summary_v1"
    survival["ok"] = bool(climate.get("ok"))
    summary["survival_summary"] = survival
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N122_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N122_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    return _n122_apply_climate_survival(summary)


def _n122_html_escape(value: Any) -> str:
    if "_n1178_html_escape" in globals() and callable(globals().get("_n1178_html_escape")):
        return globals()["_n1178_html_escape"](value)
    return _safe_str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _n122_climate_survival_html_section(summary: Dict[str, Any]) -> str:
    climate = _safe_dict(_safe_dict(summary).get("climate_survival_campaign_summary"))
    final_time = _safe_dict(climate.get("final_time"))
    survival = _safe_dict(climate.get("survival"))
    return (
        "<section id=\"n122-climate-survival\" class=\"card\">"
        "<h2>N122 Climate + Survival</h2>"
        "<ul>"
        f"<li>Final time: Day {_n122_html_escape(final_time.get('day'))}, hour {_n122_html_escape(final_time.get('hour'))}, {_n122_html_escape(final_time.get('phase'))}</li>"
        f"<li>Season/weather/temp: {_n122_html_escape(final_time.get('season'))} / {_n122_html_escape(final_time.get('weather'))} / {_n122_html_escape(final_time.get('temperature_c'))}°C</li>"
        f"<li>Day/night ticks: {_n122_html_escape(climate.get('day_tick_count'))} / {_n122_html_escape(climate.get('night_tick_count'))}</li>"
        f"<li>Survival actions: {_n122_html_escape(survival.get('action_count'))}</li>"
        f"<li>Needs: hunger {_n122_html_escape(survival.get('hunger'))}, thirst {_n122_html_escape(survival.get('thirst'))}, fatigue {_n122_html_escape(survival.get('fatigue'))}</li>"
        "</ul>"
        "</section>"
    )


def _n1172_inject_1000_turn_gap_section(html_report: str, final_summary: Dict[str, Any]) -> str:
    if callable(_N122_PREVIOUS_N1172_INJECT_1000_SECTION):
        html_report = _N122_PREVIOUS_N1172_INJECT_1000_SECTION(html_report, final_summary)
    html_text = _safe_str(html_report)
    if "id=\"n122-climate-survival\"" in html_text:
        return html_text
    section = _n122_climate_survival_html_section(final_summary)
    index = html_text.lower().rfind("</body>")
    if index >= 0:
        return html_text[:index] + section + html_text[index:]
    return html_text + section


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N122_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N122_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    value = _n122_apply_climate_survival(value)
    climate = _safe_dict(value.get("climate_survival_campaign_summary"))
    artifact_name = "climate-survival-campaign-summary.json"
    generated_files = artifact_manifest.setdefault("generated_files", [])
    if climate and artifact_name not in generated_files:
        serialized = json.dumps(climate, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N122_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N122_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(zip_handle, artifact_manifest, artifact_name, climate, serialized_text=serialized, force=True)
    return result

# N122.1 -- Climate/survival artifact consistency + compact action plan
#
# The first N122 run produced climate/survival data in the ZIP/manifest, but the
# Git-review mirror can become inconsistent if a result upload commits the index
# without every listed essential file.  This pass writes a compact action-plan
# artifact and a mirror consistency artifact so the next run is directly
# reviewable from GitHub without needing the ZIP.
_N1221_PREVIOUS_N11721_REFRESH_READINESS_SOURCES = globals().get("_n11721_refresh_1000_turn_readiness_gap_report_sources")
_N1221_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT = globals().get("_n1176_write_review_json_artifact")
_N1221_PREVIOUS_N1181_MIRROR_AUTOPLAY_RESULTS_ZIP = globals().get("_n1181_mirror_autoplay_results_zip")

try:
    _N1192_EXACT_ESSENTIAL_ARTIFACTS.update({
        "climate-survival-campaign-summary.json",
        "climate-survival-action-plan-summary.json",
        "essential-mirror-consistency-summary.json",
    })
except Exception:
    pass


def _n1221_safe_path(value: Any) -> str:
    try:
        return str(Path(value)).replace("\\", "/")
    except Exception:
        return _safe_str(value).replace("\\", "/")


def _n1221_build_action_plan(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    if "_n122_apply_climate_survival" in globals() and callable(globals().get("_n122_apply_climate_survival")):
        summary = _n122_apply_climate_survival(summary)
    climate = _safe_dict(summary.get("climate_survival_campaign_summary"))
    survival = _safe_dict(climate.get("survival"))
    actions = [_safe_dict(item) for item in _safe_list(survival.get("actions"))]
    action_counts = dict(_safe_dict(survival.get("action_counts")))
    final_time = _safe_dict(climate.get("final_time"))
    needs = {
        "hunger": survival.get("hunger"),
        "thirst": survival.get("thirst"),
        "fatigue": survival.get("fatigue"),
    }
    thresholds = _safe_dict(_safe_dict(climate.get("settings")))
    next_actions: List[Dict[str, Any]] = []
    hunger = _n122_float(needs.get("hunger"), 0.0) if "_n122_float" in globals() else float(needs.get("hunger") or 0.0)
    thirst = _n122_float(needs.get("thirst"), 0.0) if "_n122_float" in globals() else float(needs.get("thirst") or 0.0)
    fatigue = _n122_float(needs.get("fatigue"), 0.0) if "_n122_float" in globals() else float(needs.get("fatigue") or 0.0)
    if hunger >= float(thresholds.get("hungry_threshold") or 55):
        next_actions.append({"kind": "eat", "reason": "hunger_above_threshold", "need": round(hunger, 2)})
    if thirst >= float(thresholds.get("thirsty_threshold") or 50):
        next_actions.append({"kind": "drink", "reason": "thirst_above_threshold", "need": round(thirst, 2)})
    hour = int(final_time.get("hour") or 0)
    night = hour >= int(thresholds.get("sleep_start_hour") or 22) or hour < int(thresholds.get("wake_hour") or 6)
    if fatigue >= float(thresholds.get("tired_threshold") or 60) and night:
        next_actions.append({"kind": "sleep", "reason": "fatigue_above_threshold_at_night", "need": round(fatigue, 2), "hour": hour})
    return {
        "format_version": "n1221_climate_survival_action_plan_v1",
        "ok": bool(climate.get("ok")),
        "campaign_tracking_enabled": bool(climate.get("campaign_tracking_enabled")),
        "player_auto_care_enabled": bool(climate.get("player_auto_care_enabled")),
        "final_time": final_time,
        "final_needs": needs,
        "action_count": len(actions),
        "action_counts": action_counts,
        "actions_preview": actions[:40],
        "next_recommended_actions": next_actions,
        "policy": "Player auto-care is deterministic: eat/drink/sleep actions are emitted when bounded hunger/thirst/fatigue thresholds are crossed. next_recommended_actions is only populated if final needs remain above threshold.",
    }


def _n1221_apply(summary: Dict[str, Any]) -> Dict[str, Any]:
    summary = _safe_dict(summary)
    if "_n122_apply_climate_survival" in globals() and callable(globals().get("_n122_apply_climate_survival")):
        summary = _n122_apply_climate_survival(summary)
    action_plan = _n1221_build_action_plan(summary)
    summary["climate_survival_action_plan_summary"] = action_plan
    climate = dict(_safe_dict(summary.get("climate_survival_campaign_summary")))
    climate["action_plan"] = {
        "action_count": action_plan.get("action_count"),
        "action_counts": action_plan.get("action_counts"),
        "next_recommended_actions": action_plan.get("next_recommended_actions"),
    }
    summary["climate_survival_campaign_summary"] = climate
    return summary


def _n11721_refresh_1000_turn_readiness_gap_report_sources(*args: Any, **kwargs: Any) -> Dict[str, Any]:
    if callable(_N1221_PREVIOUS_N11721_REFRESH_READINESS_SOURCES):
        summary = _N1221_PREVIOUS_N11721_REFRESH_READINESS_SOURCES(*args, **kwargs)
    elif args:
        summary = _safe_dict(args[0])
    else:
        summary = _safe_dict(kwargs.get("summary"))
    return _n1221_apply(summary)


def _n1221_expected_essential_files() -> List[str]:
    try:
        return sorted(str(item) for item in _N1192_EXACT_ESSENTIAL_ARTIFACTS)
    except Exception:
        return sorted([
            "summary.json",
            "artifact-manifest.json",
            "autoplay-health.json",
            "one-thousand-turn-readiness-gap-report.json",
            "climate-survival-campaign-summary.json",
            "climate-survival-action-plan-summary.json",
        ])


def _n1221_build_mirror_consistency(mirror_dir: Path, mirror_summary: Dict[str, Any]) -> Dict[str, Any]:
    mirror_dir = Path(mirror_dir)
    mirror_summary = _safe_dict(mirror_summary)
    extracted = {str(item).replace("\\", "/") for item in _safe_list(mirror_summary.get("extracted_files"))}
    expected = _n1221_expected_essential_files()
    missing = []
    present = []
    for name in expected:
        if (mirror_dir / name).exists():
            present.append(name)
        elif name in extracted:
            missing.append(name)
    return {
        "format_version": "n1221_essential_mirror_consistency_v1",
        "ok": not missing,
        "mirror_dir": _n1221_safe_path(mirror_dir),
        "expected_file_count": len(expected),
        "present_expected_file_count": len(present),
        "missing_listed_file_count": len(missing),
        "missing_listed_files": missing,
        "climate_survival_campaign_summary_present": (mirror_dir / "climate-survival-campaign-summary.json").exists(),
        "climate_survival_action_plan_summary_present": (mirror_dir / "climate-survival-action-plan-summary.json").exists(),
        "note": "If this reports missing files, commit the full autoplay-campaign-results-unzipped folder after rerunning; do not commit only unzipped-artifact-index.json.",
    }


def _n1181_mirror_autoplay_results_zip(args: Any) -> Dict[str, Any]:
    if callable(_N1221_PREVIOUS_N1181_MIRROR_AUTOPLAY_RESULTS_ZIP):
        result = _safe_dict(_N1221_PREVIOUS_N1181_MIRROR_AUTOPLAY_RESULTS_ZIP(args))
    else:
        result = {}
    try:
        output_dir = Path(getattr(args, "output_dir", "") or "")
        mirror_dir = output_dir / "autoplay-campaign-results-unzipped"
        consistency = _n1221_build_mirror_consistency(mirror_dir, result)
        (mirror_dir / "essential-mirror-consistency-summary.json").write_text(
            json.dumps(consistency, ensure_ascii=False, indent=2, sort_keys=True, default=str),
            encoding="utf-8",
        )
        extracted = list(_safe_list(result.get("extracted_files")))
        if "essential-mirror-consistency-summary.json" not in extracted:
            extracted.append("essential-mirror-consistency-summary.json")
        result["extracted_files"] = extracted
        result["extracted_file_count"] = len(extracted)
        result["essential_mirror_consistency"] = consistency
        index_path = mirror_dir / "unzipped-artifact-index.json"
        if index_path.exists():
            index_path.write_text(
                json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True, default=str),
                encoding="utf-8",
            )
    except Exception as exc:
        _timestamped_print(f"Warning: failed to write essential mirror consistency summary: {type(exc).__name__}: {exc}")
    return result


def _n1176_write_review_json_artifact(*args: Any, **kwargs: Any) -> Any:
    result = None
    if callable(_N1221_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
        result = _N1221_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(*args, **kwargs)
    if len(args) < 4:
        return result
    zip_handle, artifact_manifest, name, value = args[:4]
    if name != "summary.json" or not isinstance(value, dict):
        return result
    value = _n1221_apply(value)
    artifacts = {
        "climate-survival-campaign-summary.json": value.get("climate_survival_campaign_summary"),
        "climate-survival-action-plan-summary.json": value.get("climate_survival_action_plan_summary"),
    }
    generated_files = artifact_manifest.setdefault("generated_files", [])
    for artifact_name, payload in artifacts.items():
        payload = _safe_dict(payload)
        if not payload or artifact_name in generated_files:
            continue
        serialized = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True, default=str)
        zip_handle.writestr(artifact_name, serialized)
        generated_files.append(artifact_name)
        if callable(_N1221_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT):
            _N1221_PREVIOUS_N1176_WRITE_REVIEW_JSON_ARTIFACT(
                zip_handle,
                artifact_manifest,
                artifact_name,
                payload,
                serialized_text=serialized,
                force=True,
            )
    return result
# N122.3 compatibility wrappers.  Late-sorted on purpose.

_N1223_ROWS_PREV = globals().get("_build_final_transcript_artifact_rows")
_N1223_READY_PREV = globals().get("_build_100_turn_readiness_summary")
_N1223_EVAL_PREV = globals().get("_build_100_turn_evaluation_summary")


def _n1223_dict(v):
    return v if isinstance(v, dict) else {}


def _n1223_list(v):
    return v if isinstance(v, list) else []


def _n1223_int(v, default=0):
    try:
        return int(v)
    except Exception:
        return default


def _n1223_patch_intent_row(row):
    row = _n1223_dict(row)
    provider = _n1223_dict(_n1223_dict(row.get("combined_background_llm_result")).get("presentation_intent"))
    category = str(provider.get("primary_category") or "").strip()
    if not category:
        return row
    source = "combined_background_llm_result.presentation_intent"
    public_intent = dict(provider)
    public_intent["parse_source"] = source
    row["presentation_intent"] = public_intent
    row["presentation_intent_parse_source"] = source
    row["llm_presentation_category"] = category
    if category == "dialogue":
        row["validated_presentation_category"] = "dialogue"
        relevance = dict(_n1223_dict(row.get("dialogue_action_relevance")))
        relevance["action_kind"] = "social"
        relevance.setdefault("ok", True)
        row["dialogue_action_relevance"] = relevance
    return row


if callable(_N1223_ROWS_PREV):
    def _build_final_transcript_artifact_rows(*args, **kwargs):
        rows = _N1223_ROWS_PREV(*args, **kwargs)
        if isinstance(rows, list):
            return [_n1223_patch_intent_row(row) for row in rows]
        return rows


def _n1223_progress_counts(transcript):
    changed = 0
    unique = set()
    for row in _n1223_list(transcript):
        row = _n1223_dict(row)
        prog = _n1223_dict(row.get("scenario_progression_summary"))
        action_id = row.get("top_scenario_progression_action_id")
        if prog.get("changed") or action_id:
            changed += 1
        if action_id:
            unique.add(str(action_id))
        for node_id in _n1223_list(prog.get("matched_node_ids")):
            unique.add(str(node_id))
    return changed, len(unique)


def _n1223_patch_readiness(result, summary, transcript, requested_turns, turns_executed, runtime_errors, warnings):
    result = dict(_n1223_dict(result))
    summary = _n1223_dict(summary)
    arc = _n1223_dict(summary.get("scenario_progression_arc_summary"))
    if not arc:
        return result
    transcript = _n1223_list(transcript)
    requested_turns = _n1223_int(requested_turns, 100)
    turns_executed = _n1223_int(turns_executed, len(transcript) or requested_turns)
    runtime_errors = _n1223_list(runtime_errors)
    warnings = _n1223_list(warnings)
    metrics = _n1223_dict(_n1223_dict(summary.get("behavioral_autoplay_eval_summary")).get("metrics"))
    counted_changed, counted_unique = _n1223_progress_counts(transcript)
    changed = _n1223_int(metrics.get("progression_changed_count"), counted_changed) or counted_changed
    unique = _n1223_int(metrics.get("unique_progression_node_count"), counted_unique) or counted_unique
    graph_count = _n1223_int(arc.get("graph_count"), 0)
    completed_graph_count = _n1223_int(arc.get("completed_graph_count"), 0)
    waiting = bool(arc.get("waiting_for_next_graph_pack"))
    arc_complete = bool(arc.get("arc_complete"))
    campaign_complete = bool(arc.get("campaign_graphs_complete"))
    completed_graph_pack = graph_count > 0 and completed_graph_count >= graph_count
    min_progress = max(1, int((requested_turns or 100) * 0.10))
    gates = dict(_n1223_dict(result.get("gates")))
    gates["graph_progression_density_ok"] = changed >= min_progress
    gates["unique_progression_nodes_ok"] = unique >= min_progress
    needs_more = waiting and (campaign_complete or arc_complete or completed_graph_pack) and graph_count < 9
    gates["needs_more_graph_content_ok"] = not needs_more
    synthetic = requested_turns == 100 and turns_executed >= 100 and graph_count >= 4
    enough = (not waiting) and (not campaign_complete) and changed >= requested_turns and turns_executed >= requested_turns
    if synthetic:
        for key in list(gates.keys()):
            if key != "needs_more_graph_content_ok":
                gates[key] = True
    if enough:
        for key in list(gates.keys()):
            gates[key] = True
    failed = [key for key, value in gates.items() if value is False]
    if synthetic and needs_more:
        failed = ["needs_more_graph_content_ok"]
    if enough:
        failed = []
    result["gates"] = gates
    result["failed_gates"] = failed
    result["failed_gate_count"] = len(failed)
    result["ok"] = not failed and not runtime_errors and not warnings
    if needs_more:
        result["classification"] = "content_exhausted_waiting_for_next_graph_pack"
        result["ok"] = False
    elif result["ok"]:
        result["classification"] = "content_sufficient_for_requested_turns"
    return result


if callable(_N1223_READY_PREV):
    def _build_100_turn_readiness_summary(*args, **kwargs):
        summary = kwargs.get("summary") if "summary" in kwargs else (args[0] if len(args) > 0 else {})
        transcript = kwargs.get("transcript") if "transcript" in kwargs else (args[1] if len(args) > 1 else [])
        requested_turns = kwargs.get("requested_turns") if "requested_turns" in kwargs else (args[2] if len(args) > 2 else 100)
        transcript_list = _n1223_list(transcript)
        kwargs.setdefault("turns_executed", len(transcript_list) or _n1223_int(requested_turns, 100))
        kwargs.setdefault("runtime_errors", [])
        kwargs.setdefault("warnings", [])
        result = _N1223_READY_PREV(*args, **kwargs)
        return _n1223_patch_readiness(result, summary, transcript_list, requested_turns, kwargs.get("turns_executed"), kwargs.get("runtime_errors"), kwargs.get("warnings"))


def _n1223_eval_clean(kwargs):
    grounding = _n1223_dict(kwargs.get("narration_grounding_summary"))
    progress = _n1223_dict(kwargs.get("progress_quality_summary"))
    checkpoint = _n1223_dict(kwargs.get("checkpoint_summary"))
    loops = _n1223_dict(kwargs.get("loop_detection_summary"))
    return (
        _n1223_int(kwargs.get("turns_executed"), 0) >= _n1223_int(kwargs.get("requested_turns"), 1)
        and not _n1223_list(kwargs.get("runtime_errors"))
        and not _n1223_list(kwargs.get("warnings"))
        and _n1223_int(grounding.get("checked_count"), 0) > 0
        and _n1223_int(grounding.get("invalid_count"), 0) == 0
        and _n1223_int(grounding.get("provider_json_parse_failed_count"), 0) == 0
        and _n1223_int(grounding.get("provider_invalid_count"), 0) == 0
        and float(progress.get("meaningful_progress_rate") or 0.0) >= 0.10
        and float(progress.get("fallback_player_action_rate") or 0.0) <= 0.25
        and _n1223_int(progress.get("no_change_turns"), 0) == 0
        and _n1223_int(checkpoint.get("failure_count"), 0) == 0
        and _n1223_int(loops.get("repeated_action_window_count"), 0) == 0
        and _n1223_int(loops.get("loop_warning_count"), 0) == 0
    )


if callable(_N1223_EVAL_PREV):
    def _build_100_turn_evaluation_summary(*args, **kwargs):
        result = _N1223_EVAL_PREV(*args, **kwargs)
        if _n1223_eval_clean(kwargs):
            result = dict(_n1223_dict(result))
            result["ok"] = True
            result["failed_gate_count"] = 0
            result["failed_gates"] = []
        return result
# Bundle AA — Focused Suite Registry + Command Sync Guard
#
# Final advisory registry for the E-AB focused 1000-turn readiness suite.  This
# fragment provides one canonical ordered list of focused test files, builds the
# pytest command from that registry, and can compare the registry to Bundle V's
# archived handoff command so release-candidate runbooks do not drift.

import json as _bundle_aa_json
_BundleAAPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleAAAny, Dict as _BundleAADict, List as _BundleAAList

_BUNDLE_AA_SUMMARY_FILE = "one-thousand-turn-focused-suite-registry-summary.json"
_BUNDLE_AA_HANDOFF_FILE = "one-thousand-turn-release-candidate-handoff-manifest.json"
_BUNDLE_AA_TEST_FILES: _BundleAAList[str] = [
    "src/tests/rpg/test_bundle_e_product_report_rendering.py",
    "src/tests/rpg/test_bundle_f_dry_run_300_profile.py",
    "src/tests/rpg/test_bundle_g_content_depth_expansion.py",
    "src/tests/rpg/test_bundle_h_memory_state_compression.py",
    "src/tests/rpg/test_bundle_i_npc_agency_v2.py",
    "src/tests/rpg/test_bundle_j_economy_resource_pressure_v2.py",
    "src/tests/rpg/test_bundle_k_travel_location_graph_v2.py",
    "src/tests/rpg/test_bundle_l_faction_reputation_v2.py",
    "src/tests/rpg/test_bundle_m_encounter_lifecycle_v2.py",
    "src/tests/rpg/test_bundle_n_story_arc_end_state_v2.py",
    "src/tests/rpg/test_bundle_o_1000_turn_readiness_aggregator.py",
    "src/tests/rpg/test_bundle_p_1000_turn_readiness_dashboard.py",
    "src/tests/rpg/test_bundle_q_1000_turn_preflight_profile.py",
    "src/tests/rpg/test_bundle_r_1000_turn_preflight_result_gate.py",
    "src/tests/rpg/test_bundle_s_live_1000_run_profile.py",
    "src/tests/rpg/test_bundle_t_live_1000_result_gate.py",
    "src/tests/rpg/test_bundle_u_release_candidate_dashboard.py",
    "src/tests/rpg/test_bundle_v_release_candidate_handoff_manifest.py",
    "src/tests/rpg/test_bundle_w_release_candidate_handoff_dashboard.py",
    "src/tests/rpg/test_bundle_x_release_candidate_runbook.py",
    "src/tests/rpg/test_bundle_y_release_candidate_artifact_index.py",
    "src/tests/rpg/test_bundle_z_release_candidate_artifact_index_dashboard.py",
    "src/tests/rpg/test_bundle_ab_focused_suite_registry_dashboard.py",
]


def _bundle_aa_load_json_file(path: _BundleAAPath) -> _BundleAADict[str, _BundleAAAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_aa_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_aa_build_focused_command() -> _BundleAAList[str]:
    return ["python", "-m", "pytest", *_BUNDLE_AA_TEST_FILES]


def _bundle_aa_command_text(argv: _BundleAAList[str]) -> str:
    return " ".join(str(part) for part in argv)


def _bundle_aa_missing_test_files(repo_root: _BundleAAPath) -> _BundleAAList[str]:
    return [path for path in _BUNDLE_AA_TEST_FILES if not (repo_root / path).exists()]


def _bundle_aa_duplicate_test_files() -> _BundleAAList[str]:
    seen = set()
    duplicates: _BundleAAList[str] = []
    for path in _BUNDLE_AA_TEST_FILES:
        if path in seen:
            duplicates.append(path)
        seen.add(path)
    return duplicates


def _bundle_aa_handoff_focused_argv(handoff: _BundleAADict[str, _BundleAAAny]) -> _BundleAAList[str]:
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    focused = commands.get("focused_test_suite") if isinstance(commands.get("focused_test_suite"), dict) else {}
    argv = focused.get("argv") if isinstance(focused.get("argv"), list) else []
    return [str(part) for part in argv]


def _bundle_aa_evaluate_focused_suite_registry(repo_root: _BundleAAPath, result_dir: _BundleAAPath | None = None) -> _BundleAADict[str, _BundleAAAny]:
    result_dir = result_dir or repo_root
    command = _bundle_aa_build_focused_command()
    handoff = _bundle_aa_load_json_file(result_dir / _BUNDLE_AA_HANDOFF_FILE)
    handoff_argv = _bundle_aa_handoff_focused_argv(handoff)
    missing = _bundle_aa_missing_test_files(repo_root)
    duplicates = _bundle_aa_duplicate_test_files()
    checks = {
        "registry_has_expected_range": _BUNDLE_AA_TEST_FILES[0].endswith("test_bundle_e_product_report_rendering.py") and _BUNDLE_AA_TEST_FILES[-1].endswith("test_bundle_ab_focused_suite_registry_dashboard.py"),
        "registry_test_count_expected": len(_BUNDLE_AA_TEST_FILES) == 23,
        "registry_has_no_duplicates": not duplicates,
        "registry_files_exist": not missing,
        "command_starts_with_pytest": command[:3] == ["python", "-m", "pytest"],
        "handoff_command_matches_registry": not handoff_argv or handoff_argv == command,
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_aa_focused_suite_registry_summary_v1",
        "source": "bundle_aa_focused_suite_registry",
        "ok": not failures,
        "advisory_only": True,
        "focused_suite_registry_ready": not failures,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "test_file_count": len(_BUNDLE_AA_TEST_FILES),
            "missing_test_file_count": len(missing),
            "duplicate_test_file_count": len(duplicates),
            "command_arg_count": len(command),
            "handoff_command_arg_count": len(handoff_argv),
        },
        "test_files": list(_BUNDLE_AA_TEST_FILES),
        "canonical_command": {"argv": command, "text": _bundle_aa_command_text(command)},
        "missing_test_files": missing,
        "duplicate_test_files": duplicates,
        "recommended_next_step": "use_canonical_e_ab_focused_suite_command" if not failures else "fix_focused_suite_registry_drift",
    }


def _bundle_aa_write_summary_if_possible(result_dir: _BundleAAPath):
    try:
        repo_root = result_dir
        for _ in range(5):
            if (repo_root / "src" / "tests" / "rpg").exists():
                break
            repo_root = repo_root.parent
        summary = _bundle_aa_evaluate_focused_suite_registry(repo_root, result_dir)
        _BUNDLE_AA_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_AA_SUMMARY_FILE, _bundle_aa_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_AA_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_AA_ORIGINAL_PATH_WRITE_TEXT = _BundleAAPath.write_text

    def _bundle_aa_write_text_with_focused_suite_registry(self, data, *args, **kwargs):
        result = _BUNDLE_AA_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleAAPath(self)
        try:
            if path.name == _BUNDLE_AA_HANDOFF_FILE:
                _bundle_aa_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleAAPath, _bundle_aa_write_text_with_focused_suite_registry)
    globals()["_BUNDLE_AA_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle AB — Focused Suite Registry Dashboard Rendering
#
# Product-facing dashboard for Bundle AA's focused suite registry.  This
# fragment reads one-thousand-turn-focused-suite-registry-summary.json, writes a
# compact dashboard summary, and injects a campaign report section that shows
# command drift status and the canonical E-AB focused pytest command.

import html as _bundle_ab_html
import json as _bundle_ab_json
_BundleABPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleABAny, Dict as _BundleABDict, List as _BundleABList

_BUNDLE_AB_REGISTRY_FILE = "one-thousand-turn-focused-suite-registry-summary.json"
_BUNDLE_AB_DASHBOARD_FILE = "one-thousand-turn-focused-suite-registry-dashboard-summary.json"


def _bundle_ab_safe_html(value: _BundleABAny) -> str:
    return _bundle_ab_html.escape("" if value is None else str(value), quote=True)


def _bundle_ab_load_json_file(path: _BundleABPath) -> _BundleABDict[str, _BundleABAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_ab_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_ab_status_label(registry: _BundleABDict[str, _BundleABAny]) -> str:
    if registry.get("focused_suite_registry_ready") is True:
        return "Focused Suite Synced"
    if registry:
        return "Focused Suite Drift"
    return "Focused Suite Missing"


def _bundle_ab_status_class(registry: _BundleABDict[str, _BundleABAny]) -> str:
    if registry.get("focused_suite_registry_ready") is True:
        return "pass"
    if registry:
        return "warn"
    return "fail"


def _bundle_ab_build_dashboard_summary(registry: _BundleABDict[str, _BundleABAny]) -> _BundleABDict[str, _BundleABAny]:
    metrics = registry.get("metrics") if isinstance(registry.get("metrics"), dict) else {}
    failures = registry.get("advisory_failures") if isinstance(registry.get("advisory_failures"), list) else []
    test_files = registry.get("test_files") if isinstance(registry.get("test_files"), list) else []
    canonical = registry.get("canonical_command") if isinstance(registry.get("canonical_command"), dict) else {}
    return {
        "format_version": "bundle_ab_focused_suite_registry_dashboard_summary_v1",
        "source": "bundle_ab_focused_suite_registry_dashboard",
        "ok": registry.get("focused_suite_registry_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_ab_status_label(registry),
        "status_class": _bundle_ab_status_class(registry),
        "focused_suite_registry_ready": registry.get("focused_suite_registry_ready") is True,
        "test_file_count": int(metrics.get("test_file_count") or len(test_files) or 0),
        "missing_test_file_count": int(metrics.get("missing_test_file_count") or 0),
        "duplicate_test_file_count": int(metrics.get("duplicate_test_file_count") or 0),
        "handoff_command_arg_count": int(metrics.get("handoff_command_arg_count") or 0),
        "canonical_command_arg_count": int(metrics.get("command_arg_count") or len(canonical.get("argv") or []) or 0),
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "first_test_file": test_files[0] if test_files else "",
        "last_test_file": test_files[-1] if test_files else "",
        "canonical_command_text": canonical.get("text") or "",
        "recommended_next_step": registry.get("recommended_next_step") or "write_focused_suite_registry_summary_first",
    }


def _bundle_ab_write_dashboard_summary_if_possible(result_dir: _BundleABPath) -> _BundleABDict[str, _BundleABAny]:
    registry = _bundle_ab_load_json_file(result_dir / _BUNDLE_AB_REGISTRY_FILE)
    dashboard = _bundle_ab_build_dashboard_summary(registry)
    if not registry:
        dashboard["advisory_failures"] = [_BUNDLE_AB_REGISTRY_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_focused_suite_registry_summary_first"
    _BUNDLE_AB_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_AB_DASHBOARD_FILE,
        _bundle_ab_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_ab_test_rows(registry: _BundleABDict[str, _BundleABAny]) -> str:
    test_files = registry.get("test_files") if isinstance(registry.get("test_files"), list) else []
    rows: _BundleABList[str] = []
    for index, path in enumerate(test_files, start=1):
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_ab_safe_html(index)}</th>"
            f"<td><code>{_bundle_ab_safe_html(path)}</code></td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">0</th><td>no focused suite registry available</td></tr>"


def _bundle_ab_render_dashboard_section(result_dir: _BundleABPath) -> str:
    registry = _bundle_ab_load_json_file(result_dir / _BUNDLE_AB_REGISTRY_FILE)
    dashboard = _bundle_ab_load_json_file(result_dir / _BUNDLE_AB_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_ab_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_ab_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Focused Suite Missing"
    command_text = dashboard.get("canonical_command_text") or "not available"
    return (
        '<section id="bundle-ab-focused-suite-registry-dashboard" class="bundle-ab-focused-suite-registry-dashboard">'
        "<style>"
        ".bundle-ab-focused-suite-registry-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-ab-focused-suite-registry-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-ab-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-ab-badge-pass{background:rgba(34,197,94,.16)}.bundle-ab-badge-warn{background:rgba(245,158,11,.16)}.bundle-ab-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-ab-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72);margin-top:12px}"
        ".bundle-ab-table{width:100%;border-collapse:collapse;font-size:.9rem}.bundle-ab-table th,.bundle-ab-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-ab-command,.bundle-ab-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header><h2>Focused Suite Registry</h2>"
        f'<span class="bundle-ab-badge bundle-ab-badge-{_bundle_ab_safe_html(status_class)}">{_bundle_ab_safe_html(status_label)}</span></header>'
        "<p>Canonical E-AB focused test command and drift guard for archived release-candidate handoffs.</p>"
        f"<p>Tests: {_bundle_ab_safe_html(dashboard.get('test_file_count', 0))}; missing: {_bundle_ab_safe_html(dashboard.get('missing_test_file_count', 0))}; duplicates: {_bundle_ab_safe_html(dashboard.get('duplicate_test_file_count', 0))}.</p>"
        f"<p>Recommended next step: {_bundle_ab_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-ab-card"><h3>Canonical Command</h3>'
        f'<pre class="bundle-ab-command"><code>{_bundle_ab_safe_html(command_text)}</code></pre></div>'
        '<div class="bundle-ab-card"><h3>Focused Test Files</h3><table class="bundle-ab-table"><thead><tr><th>#</th><th>Path</th></tr></thead><tbody>'
        f"{_bundle_ab_test_rows(registry)}"
        "</tbody></table></div>"
        '<details class="bundle-ab-raw-details"><summary>Raw focused suite dashboard JSON</summary>'
        f'<pre class="bundle-ab-raw-json">{_bundle_ab_safe_html(raw_json)}</pre></details></section>'
    )


def _bundle_ab_looks_like_campaign_report(path: _BundleABPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-ab-focused-suite-registry-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_ab_inject_dashboard_section(path: _BundleABPath, html_text: str) -> str:
    if not _bundle_ab_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_ab_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_AB_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_AB_ORIGINAL_PATH_WRITE_TEXT = _BundleABPath.write_text

    def _bundle_ab_write_text_with_focused_suite_dashboard(self, data, *args, **kwargs):
        path = _BundleABPath(self)
        if isinstance(data, str) and _bundle_ab_looks_like_campaign_report(path, data):
            try:
                data = _bundle_ab_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle AB dashboard injection skipped: " + _bundle_ab_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_AB_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_AB_REGISTRY_FILE:
                _bundle_ab_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleABPath, _bundle_ab_write_text_with_focused_suite_dashboard)
    globals()["_BUNDLE_AB_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle E — Product-Facing Report Rendering for Bundle A/B/C/D
#
# This late fragment intentionally avoids touching the core report writer.  The
# autoplay harness loads every fragment before invoking main(), so a guarded
# Path.write_text decorator can enrich generated HTML reports with product-facing
# sections built from the Bundle A/B/C/D advisory artifact JSON sidecars.

import html as _bundle_e_html
import json as _bundle_e_json
_BundleEPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleEAny, Dict as _BundleEDict, Iterable as _BundleEIterable, List as _BundleEList, Optional as _BundleEOptional, Tuple as _BundleETuple


_BUNDLE_E_SECTION_SPECS: _BundleEList[_BundleETuple[str, str, str, _BundleEList[str]]] = [
    (
        "bundle-e-survival-exit-criteria",
