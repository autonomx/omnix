            "total_spent",
            "currency_delta",
            "unpaid_count",
            "blocked_relief_count",
            "survival_intervention_count",
            "resource_pressure_ok",
        ],
    ),
]

_BUNDLE_E_DIGEST_FILE = "artifact-manifest-digest.json"
_BUNDLE_E_MARKER = 'id="bundle-e-product-reporting"'


def _bundle_e_safe_html(value: _BundleEAny) -> str:
    return _bundle_e_html.escape("" if value is None else str(value), quote=True)


def _bundle_e_load_json_file(path: _BundleEPath) -> _BundleEOptional[_BundleEDict[str, _BundleEAny]]:
    try:
        if not path.exists() or not path.is_file():
            return None
        data = _bundle_e_json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {
            "ok": False,
            "source": path.name,
            "load_error": f"{type(exc).__name__}: {exc}",
        }
    if isinstance(data, dict):
        data.setdefault("source", path.name)
        return data
    return {
        "ok": False,
        "source": path.name,
        "load_error": f"expected JSON object, got {type(data).__name__}",
    }


def _bundle_e_find_existing_artifact_payload(
    artifact_map: _BundleEDict[str, _BundleEDict[str, _BundleEAny]],
    file_name: str,
) -> _BundleEOptional[_BundleEDict[str, _BundleEAny]]:
    payload = artifact_map.get(file_name)
    if isinstance(payload, dict):
        return payload
    lower_name = file_name.lower()
    for key, value in artifact_map.items():
        if str(key).lower().endswith(lower_name) and isinstance(value, dict):
            return value
    return None


def _bundle_e_load_artifact_map(result_dir: _BundleEPath) -> _BundleEDict[str, _BundleEDict[str, _BundleEAny]]:
    artifacts: _BundleEDict[str, _BundleEDict[str, _BundleEAny]] = {}
    for _, _, file_name, _ in _BUNDLE_E_SECTION_SPECS:
        payload = _bundle_e_load_json_file(result_dir / file_name)
        if payload is not None:
            artifacts[file_name] = payload
    digest = _bundle_e_load_json_file(result_dir / _BUNDLE_E_DIGEST_FILE)
    if digest is not None:
        artifacts[_BUNDLE_E_DIGEST_FILE] = digest
    return artifacts


def _bundle_e_truthy_status(payload: _BundleEOptional[_BundleEDict[str, _BundleEAny]]) -> _BundleETuple[str, str]:
    if not payload:
        return ("missing", "Missing")

    # Prefer explicit failure/error fields before optimistic status fields.
    hard_failure_count = payload.get("hard_failure_count")
    try:
        if hard_failure_count is not None and int(hard_failure_count) > 0:
            return ("fail", "Fail")
    except Exception:
        pass

    failed_checks = payload.get("failed_checks") or payload.get("invariant_failed_checks")
    if isinstance(failed_checks, list) and failed_checks:
        return ("fail", "Fail")

    for key in (
        "ok",
        "gate_ok",
        "budget_ok",
        "ready",
        "ready_for_300_turns",
        "survival_ok",
        "resource_pressure_ok",
        "invariant_ok",
        "manifest_ok",
    ):
        if key not in payload:
            continue
        value = payload.get(key)
        if value is True:
            return ("pass", "Pass")
        if value is False:
            return ("warn", "Advisory")

    warnings = payload.get("warnings")
    if isinstance(warnings, list) and warnings:
        return ("warn", "Advisory")
    warning_count = payload.get("warning_count")
    try:
        if warning_count is not None and int(warning_count) > 0:
            return ("warn", "Advisory")
    except Exception:
        pass

    return ("info", "Info")


def _bundle_e_summarize_payload(payload: _BundleEOptional[_BundleEDict[str, _BundleEAny]], title: str) -> str:
    if not payload:
        return f"{title} artifact is not present in this result directory."

    status_class, status_label = _bundle_e_truthy_status(payload)
    source = payload.get("source") or "artifact JSON"
    blockers = payload.get("blockers")
    warnings = payload.get("warnings")

    if status_class == "pass":
        prefix = "Passing advisory evidence found"
    elif status_class == "fail":
        prefix = "Blocking evidence found"
    elif status_class == "warn":
        prefix = "Advisory warning evidence found"
    else:
        prefix = "Artifact evidence found"

    details: _BundleEList[str] = [f"{prefix} in {source}."]
    if isinstance(blockers, list) and blockers:
        details.append(f"Blockers: {len(blockers)}.")
    if isinstance(warnings, list) and warnings:
        details.append(f"Warnings: {len(warnings)}.")
    failed_checks = payload.get("failed_checks") or payload.get("invariant_failed_checks")
    if isinstance(failed_checks, list) and failed_checks:
        details.append(f"Failed checks: {len(failed_checks)}.")
    if status_label == "Advisory":
        details.append("This is advisory report evidence, not a normal 100-turn hard failure.")
    return " ".join(details)


def _bundle_e_metric_rows(
    payload: _BundleEOptional[_BundleEDict[str, _BundleEAny]],
    preferred_keys: _BundleEIterable[str],
) -> str:
    if not payload:
        return (
            "<tr>"
            "<th scope=\"row\">status</th>"
            "<td>missing</td>"
            "</tr>"
        )

    rows: _BundleEList[str] = []
    emitted = set()
    for key in preferred_keys:
        if key not in payload:
            continue
        value = payload.get(key)
        if isinstance(value, (dict, list)):
            continue
        emitted.add(key)
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_e_safe_html(key)}</th>"
            f"<td>{_bundle_e_safe_html(value)}</td>"
            "</tr>"
        )

    if len(rows) < 5:
        for key in sorted(payload.keys()):
            if key in emitted or key.startswith("_"):
                continue
            value = payload.get(key)
            if isinstance(value, (dict, list)):
                continue
            emitted.add(key)
            rows.append(
                "<tr>"
                f"<th scope=\"row\">{_bundle_e_safe_html(key)}</th>"
                f"<td>{_bundle_e_safe_html(value)}</td>"
                "</tr>"
            )
            if len(rows) >= 8:
                break

    if not rows:
        rows.append(
            "<tr>"
            "<th scope=\"row\">source</th>"
            f"<td>{_bundle_e_safe_html(payload.get('source', 'artifact JSON'))}</td>"
            "</tr>"
        )
    return "\n".join(rows)


def _bundle_e_raw_json_details(payload: _BundleEOptional[_BundleEDict[str, _BundleEAny]], title: str) -> str:
    if payload is None:
        raw_json = _bundle_e_json.dumps(
            {"ok": False, "missing": True, "title": title},
            indent=2,
            sort_keys=True,
        )
    else:
        raw_json = _bundle_e_json.dumps(payload, indent=2, sort_keys=True, default=str)
    return (
        '<details class="bundle-e-raw-details">'
        "<summary>Raw JSON details</summary>"
        f'<pre class="bundle-e-raw-json">{_bundle_e_safe_html(raw_json)}</pre>'
        "</details>"
    )


def _bundle_e_render_digest_summary(
    artifact_map: _BundleEDict[str, _BundleEDict[str, _BundleEAny]]
) -> str:
    digest = artifact_map.get(_BUNDLE_E_DIGEST_FILE)
    status_class, status_label = _bundle_e_truthy_status(digest)
    preferred = [
        "ok",
        "manifest_byte_size",
        "manifest_sha256",
        "embedded_artifact_count",
        "zip_manifest_valid_count",
        "invariant_ok",
        "manifest_hard_finalized",
        "manifest_final_write_after_all_wrappers",
    ]
    return (
        '<section id="bundle-e-artifact-manifest-digest" class="bundle-e-card bundle-e-digest-card">'
        "<header>"
        "<h3>Artifact Manifest Digest</h3>"
        f'<span class="bundle-e-badge bundle-e-badge-{_bundle_e_safe_html(status_class)}">{_bundle_e_safe_html(status_label)}</span>'
        "</header>"
        "<p>Small review surface for the large artifact manifest and zip-level manifest invariant.</p>"
        '<table class="bundle-e-metrics"><tbody>'
        f"{_bundle_e_metric_rows(digest, preferred)}"
        "</tbody></table>"
        f"{_bundle_e_raw_json_details(digest, 'Artifact Manifest Digest')}"
        "</section>"
    )


def _bundle_e_render_section(
    section_id: str,
    title: str,
    file_name: str,
    preferred_keys: _BundleEIterable[str],
    artifact_map: _BundleEDict[str, _BundleEDict[str, _BundleEAny]],
) -> str:
    payload = _bundle_e_find_existing_artifact_payload(artifact_map, file_name)
    status_class, status_label = _bundle_e_truthy_status(payload)
    return (
        f'<section id="{_bundle_e_safe_html(section_id)}" class="bundle-e-card">'
        "<header>"
        f"<h3>{_bundle_e_safe_html(title)}</h3>"
        f'<span class="bundle-e-badge bundle-e-badge-{_bundle_e_safe_html(status_class)}">{_bundle_e_safe_html(status_label)}</span>'
        "</header>"
        f"<p>{_bundle_e_safe_html(_bundle_e_summarize_payload(payload, title))}</p>"
        '<table class="bundle-e-metrics"><tbody>'
        f"{_bundle_e_metric_rows(payload, preferred_keys)}"
        "</tbody></table>"
        f"{_bundle_e_raw_json_details(payload, title)}"
        "</section>"
    )


def _bundle_e_render_product_report_sections(result_dir: _BundleEPath) -> str:
    artifact_map = _bundle_e_load_artifact_map(result_dir)
    nav_links = [
        (
            "bundle-e-artifact-manifest-digest",
            "Artifact Manifest Digest",
        )
    ] + [(section_id, title) for section_id, title, _, _ in _BUNDLE_E_SECTION_SPECS]

    nav_html = "".join(
        f'<a href="#{_bundle_e_safe_html(section_id)}">{_bundle_e_safe_html(title)}</a>'
        for section_id, title in nav_links
    )
    cards = [_bundle_e_render_digest_summary(artifact_map)]
    cards.extend(
        _bundle_e_render_section(section_id, title, file_name, preferred_keys, artifact_map)
        for section_id, title, file_name, preferred_keys in _BUNDLE_E_SECTION_SPECS
    )

    return (
        '<section id="bundle-e-product-reporting" class="bundle-e-product-reporting">'
        "<style>"
        ".bundle-e-product-reporting{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-e-product-reporting h2{margin:0 0 8px 0}"
        ".bundle-e-product-reporting .bundle-e-subtitle{margin:0 0 14px 0;opacity:.78}"
        ".bundle-e-nav{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 18px 0}"
        ".bundle-e-nav a{padding:6px 10px;border:1px solid rgba(148,163,184,.35);border-radius:999px;text-decoration:none}"
        ".bundle-e-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}"
        ".bundle-e-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72)}"
        ".bundle-e-card header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}"
        ".bundle-e-card h3{margin:0;font-size:1rem}"
        ".bundle-e-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-e-badge-pass{background:rgba(34,197,94,.16)}"
        ".bundle-e-badge-warn{background:rgba(245,158,11,.16)}"
        ".bundle-e-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-e-badge-missing{background:rgba(100,116,139,.16)}"
        ".bundle-e-badge-info{background:rgba(59,130,246,.14)}"
        ".bundle-e-metrics{width:100%;border-collapse:collapse;margin-top:10px;font-size:.9rem}"
        ".bundle-e-metrics th,.bundle-e-metrics td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-e-metrics th{width:44%;font-weight:650}"
        ".bundle-e-raw-details{margin-top:10px}"
        ".bundle-e-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<h2>Bundle A/B/C/D Advisory Evidence</h2>"
        '<p class="bundle-e-subtitle">Product-facing summaries rendered from final advisory artifacts. Raw JSON stays collapsed by default.</p>'
        f'<nav class="bundle-e-nav" aria-label="Bundle A/B/C/D report sections">{nav_html}</nav>'
        '<div class="bundle-e-grid">'
        f"{''.join(cards)}"
        "</div>"
        "</section>"
    )


def _bundle_e_html_insertion_index(html_text: str) -> int:
    lower_html = html_text.lower()
    for marker in ("<main", "<body"):
        idx = lower_html.find(marker)
        if idx < 0:
            continue
        close_idx = lower_html.find(">", idx)
        if close_idx >= 0:
            return close_idx + 1
    for marker in ("</main>", "</body>", "</html>"):
        idx = lower_html.find(marker)
        if idx >= 0:
            return idx
    return len(html_text)


def _bundle_e_looks_like_campaign_report(path: _BundleEPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower_path = str(path).lower()
    lower_html = html_text.lower()
    if "bundle-e-product-reporting" in lower_html:
        return False
    if "autoplay" in lower_path and "report" in lower_path:
        return True
    return (
        "autoplay campaign report" in lower_html
        or "campaign chronicle" in lower_html
        or "campaign report" in lower_html and "artifact-manifest" in lower_html
    )


def _bundle_e_inject_product_sections_into_html(path: _BundleEPath, html_text: str) -> str:
    if not _bundle_e_looks_like_campaign_report(path, html_text):
        return html_text
    insertion = _bundle_e_html_insertion_index(html_text)
    bundle_e_html = _bundle_e_render_product_report_sections(path.parent)
    return html_text[:insertion] + "\n" + bundle_e_html + "\n" + html_text[insertion:]


if not globals().get("_BUNDLE_E_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_E_ORIGINAL_PATH_WRITE_TEXT = _BundleEPath.write_text

    def _bundle_e_write_text_with_product_sections(self, data, *args, **kwargs):
        if isinstance(data, str):
            try:
                data = _bundle_e_inject_product_sections_into_html(_BundleEPath(self), data)
            except Exception as exc:
                # Report rendering must never break autoplay result export.  Leave a
                # small HTML comment so failures are inspectable without making the
                # 100-turn smoke run fail.
                if str(self).lower().endswith((".html", ".htm")):
                    data = (
                        data
                        + "\n<!-- Bundle E product report injection skipped: "
                        + _bundle_e_safe_html(f"{type(exc).__name__}: {exc}")
                        + " -->\n"
                    )
        return _BUNDLE_E_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)

    _install_autoplay_path_write_hook(_BundleEPath, _bundle_e_write_text_with_product_sections)
    globals()["_BUNDLE_E_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle F — 300-Turn Dry-Run Profile + Endurance Gate
#
# Late fragment integration points:
# - Expose an explicit dry_run_300 profile descriptor.
# - Provide deterministic gate math for 300-turn endurance readiness.
# - Opportunistically write dry-run-300-endurance-gate-summary.json whenever
#   Bundle A/B/C/D advisory sidecars are present in a result directory.
# - Keep normal 100-turn runs advisory-only; this fragment does not raise or
#   fail the autoplay process.

import json as _bundle_f_json
import os as _bundle_f_os
_BundleFPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleFAny, Dict as _BundleFDict, Iterable as _BundleFIterable, List as _BundleFList, Optional as _BundleFOptional, Tuple as _BundleFTuple


_BUNDLE_F_PROFILE_NAME = "dry_run_300"
_BUNDLE_F_GATE_FILE = "dry-run-300-endurance-gate-summary.json"
_BUNDLE_F_TARGET_TURNS = 300
_BUNDLE_F_DEFAULT_MAX_PROJECTED_TRANSCRIPT_BYTES = 64 * 1024 * 1024
_BUNDLE_F_DEFAULT_MAX_PROJECTED_STATE_BYTES = 16 * 1024 * 1024
_BUNDLE_F_RELEVANT_INPUT_FILES = {
    "artifact-manifest-digest.json",
    "content-exhaustion-forecast-summary.json",
    "long-run-dry-run-projection-summary.json",
    "readiness-report-projection-summary.json",
    "survival-exit-criteria-summary.json",
    "transcript-payload-budget-summary.json",
    "quality-gate-summary.json",
    "summary.json",
}

_BUNDLE_F_DRY_RUN_300_PROFILE: _BundleFDict[str, _BundleFAny] = {
    "name": _BUNDLE_F_PROFILE_NAME,
    "format_version": "bundle_f_dry_run_300_profile_v1",
    "target_turns": _BUNDLE_F_TARGET_TURNS,
    "intent": "Intermediate endurance profile before full 1000-turn LLM runs.",
    "defaults": {
        "turns": _BUNDLE_F_TARGET_TURNS,
        "narration_mode": "deferred",
        "background_llm_mode": "combined",
        "checkpoint_interval": 25,
        "artifact_detail": "full",
        "compact_transcript_mode": True,
        "final_background_drain_required": True,
    },
    "advisory_gate": {
        "min_content_exhaustion_estimate": _BUNDLE_F_TARGET_TURNS,
        "max_projected_transcript_bytes": _BUNDLE_F_DEFAULT_MAX_PROJECTED_TRANSCRIPT_BYTES,
        "max_projected_state_bytes": _BUNDLE_F_DEFAULT_MAX_PROJECTED_STATE_BYTES,
        "require_manifest_digest_ok": True,
        "require_no_runtime_errors": True,
        "require_no_unresolved_final_background_jobs": True,
    },
    "canonical_cli_args": [
        "--turns",
        "300",
        "--narration-mode",
        "deferred",
        "--background-llm-mode",
        "combined",
        "--checkpoint-interval",
        "25",
        "--artifact-detail",
        "full",
        "--compact-transcript-mode",
    ],
}


def _bundle_f_load_json_file(path: _BundleFPath) -> _BundleFDict[str, _BundleFAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_f_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {"_load_error": f"expected object, got {type(data).__name__}"}
    except Exception as exc:
        return {"_load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_f_first_scalar(payloads: _BundleFIterable[_BundleFDict[str, _BundleFAny]], *keys: str) -> _BundleFAny:
    for payload in payloads:
        for key in keys:
            if key in payload and not isinstance(payload.get(key), (dict, list)):
                return payload.get(key)
    return None


def _bundle_f_to_int(value: _BundleFAny, default: int = 0) -> int:
    if value is None:
        return default
    if isinstance(value, bool):
        return int(value)
    try:
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_f_to_bool(value: _BundleFAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, (int, float)):
        return bool(value)
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "y", "ok", "pass", "passed"}:
        return True
    if text in {"0", "false", "no", "n", "fail", "failed"}:
        return False
    return default


def _bundle_f_failure_count(payload: _BundleFDict[str, _BundleFAny], *keys: str) -> int:
    total = 0
    for key in keys:
        value = payload.get(key)
        if isinstance(value, list):
            total += len(value)
        else:
            total += _bundle_f_to_int(value, 0)
    return total


def _bundle_f_projected_value(
    observed_value: _BundleFAny,
    observed_turns: _BundleFAny,
    target_turns: int,
) -> int:
    observed = _bundle_f_to_int(observed_value, 0)
    turns = max(1, _bundle_f_to_int(observed_turns, 0))
    if observed <= 0:
        return 0
    return int((observed / turns) * target_turns)


def _bundle_f_artifacts_from_result_dir(result_dir: _BundleFPath) -> _BundleFDict[str, _BundleFDict[str, _BundleFAny]]:
    artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]] = {}
    for file_name in sorted(_BUNDLE_F_RELEVANT_INPUT_FILES):
        payload = _bundle_f_load_json_file(result_dir / file_name)
        if payload:
            artifacts[file_name] = payload
    return artifacts


def _bundle_f_content_exhaustion_estimate(artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]]) -> int:
    content = artifacts.get("content-exhaustion-forecast-summary.json", {})
    readiness = artifacts.get("readiness-report-projection-summary.json", {})
    projection = artifacts.get("long-run-dry-run-projection-summary.json", {})
    return _bundle_f_to_int(
        _bundle_f_first_scalar(
            [content, readiness, projection],
            "content_exhaustion_estimate",
            "estimated_supported_turns",
            "estimated_turns_supported",
            "turns_supported_estimate",
        ),
        0,
    )


def _bundle_f_projected_transcript_bytes(artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]]) -> int:
    transcript = artifacts.get("transcript-payload-budget-summary.json", {})
    projection = artifacts.get("long-run-dry-run-projection-summary.json", {})
    explicit = _bundle_f_first_scalar(
        [projection, transcript],
        "projected_300_turn_transcript_bytes",
        "projected_transcript_bytes_300",
        "projected_transcript_bytes",
        "projected_1000_turn_bytes",
    )
    if explicit is not None:
        # A 1000-turn projection is still useful as a conservative upper-bound.
        return _bundle_f_to_int(explicit, 0)
    turn_count = _bundle_f_first_scalar([transcript, projection], "turn_count", "completed_turns", "requested_turns")
    observed_bytes = _bundle_f_first_scalar([transcript], "total_bytes", "transcript_bytes", "payload_bytes")
    return _bundle_f_projected_value(observed_bytes, turn_count, _BUNDLE_F_TARGET_TURNS)


def _bundle_f_projected_state_bytes(artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]]) -> int:
    projection = artifacts.get("long-run-dry-run-projection-summary.json", {})
    summary = artifacts.get("summary.json", {})
    explicit = _bundle_f_first_scalar(
        [projection, summary],
        "projected_300_turn_state_bytes",
        "projected_state_bytes_300",
        "projected_state_bytes",
        "state_bytes_projected",
    )
    if explicit is not None:
        return _bundle_f_to_int(explicit, 0)
    turn_count = _bundle_f_first_scalar([summary, projection], "turn_count", "completed_turns", "requested_turns")
    observed_bytes = _bundle_f_first_scalar([summary, projection], "state_bytes", "final_state_bytes", "state_size_bytes")
    return _bundle_f_projected_value(observed_bytes, turn_count, _BUNDLE_F_TARGET_TURNS)


def _bundle_f_manifest_digest_ok(artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]]) -> bool:
    digest = artifacts.get("artifact-manifest-digest.json", {})
    if not digest:
        return False
    if digest.get("manifest_exists") is False:
        return False
    checks = [
        digest.get("ok"),
        digest.get("manifest_ok"),
        digest.get("invariant_ok"),
    ]
    explicit_checks = [value for value in checks if value is not None]
    if explicit_checks and not all(_bundle_f_to_bool(value, False) for value in explicit_checks):
        return False
    if _bundle_f_failure_count(digest, "invariant_failed_checks", "failed_checks") > 0:
        return False
    zip_valid = digest.get("zip_manifest_valid_count")
    if zip_valid is not None and _bundle_f_to_int(zip_valid, 0) <= 0:
        return False
    return True


def _bundle_f_runtime_error_count(artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]]) -> int:
    summary = artifacts.get("summary.json", {})
    quality = artifacts.get("quality-gate-summary.json", {})
    survival = artifacts.get("survival-exit-criteria-summary.json", {})
    return (
        _bundle_f_failure_count(summary, "runtime_error_count", "error_count", "errors")
        + _bundle_f_failure_count(quality, "runtime_error_count", "error_count", "errors")
        + _bundle_f_failure_count(survival, "runtime_error_count", "error_count", "hard_failures")
    )


def _bundle_f_unresolved_background_jobs(artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]]) -> int:
    summary = artifacts.get("summary.json", {})
    projection = artifacts.get("long-run-dry-run-projection-summary.json", {})
    quality = artifacts.get("quality-gate-summary.json", {})
    return _bundle_f_to_int(
        _bundle_f_first_scalar(
            [summary, projection, quality],
            "unresolved_final_background_jobs",
            "unfinished_background_jobs",
            "final_background_jobs_unresolved",
            "cancelled_background_jobs",
        ),
        0,
    )


def _bundle_f_evaluate_300_turn_endurance(
    artifacts: _BundleFDict[str, _BundleFDict[str, _BundleFAny]],
    *,
    target_turns: int = _BUNDLE_F_TARGET_TURNS,
    max_projected_transcript_bytes: int = _BUNDLE_F_DEFAULT_MAX_PROJECTED_TRANSCRIPT_BYTES,
    max_projected_state_bytes: int = _BUNDLE_F_DEFAULT_MAX_PROJECTED_STATE_BYTES,
) -> _BundleFDict[str, _BundleFAny]:
    content_estimate = _bundle_f_content_exhaustion_estimate(artifacts)
    transcript_bytes = _bundle_f_projected_transcript_bytes(artifacts)
    state_bytes = _bundle_f_projected_state_bytes(artifacts)
    manifest_ok = _bundle_f_manifest_digest_ok(artifacts)
    runtime_errors = _bundle_f_runtime_error_count(artifacts)
    unresolved_jobs = _bundle_f_unresolved_background_jobs(artifacts)

    checks = {
        "transcript_payload_bounded": transcript_bytes <= max_projected_transcript_bytes,
        "state_size_bounded": state_bytes <= max_projected_state_bytes,
        "content_exhaustion_supports_300": content_estimate >= target_turns,
        "artifact_manifest_digest_ok": manifest_ok,
        "no_runtime_errors": runtime_errors == 0,
        "no_unresolved_final_background_jobs": unresolved_jobs == 0,
    }
    advisory_failures = [name for name, ok in checks.items() if not ok]

    return {
        "format_version": "bundle_f_dry_run_300_endurance_gate_v1",
        "source": "bundle_f_dry_run_300_profile",
        "profile": _BUNDLE_F_PROFILE_NAME,
        "target_turns": target_turns,
        "ok": not advisory_failures,
        "advisory_only": True,
        "checks": checks,
        "advisory_failures": advisory_failures,
        "metrics": {
            "content_exhaustion_estimate": content_estimate,
            "projected_transcript_bytes": transcript_bytes,
            "projected_state_bytes": state_bytes,
            "max_projected_transcript_bytes": max_projected_transcript_bytes,
            "max_projected_state_bytes": max_projected_state_bytes,
            "runtime_error_count": runtime_errors,
            "unresolved_final_background_jobs": unresolved_jobs,
            "manifest_digest_present": bool(artifacts.get("artifact-manifest-digest.json")),
            "manifest_digest_ok": manifest_ok,
        },
        "profile_defaults": dict(_BUNDLE_F_DRY_RUN_300_PROFILE["defaults"]),
        "recommended_next_run": "dry_run_300" if not advisory_failures else "fix_advisory_failures_before_dry_run_300",
    }


def _bundle_f_write_gate_summary_if_possible(result_dir: _BundleFPath) -> _BundleFOptional[_BundleFDict[str, _BundleFAny]]:
    try:
        artifacts = _bundle_f_artifacts_from_result_dir(result_dir)
        if not artifacts:
            return None
        summary = _bundle_f_evaluate_300_turn_endurance(artifacts)
        path = result_dir / _BUNDLE_F_GATE_FILE
        _BUNDLE_F_ORIGINAL_PATH_WRITE_TEXT(
            path,
            _bundle_f_json.dumps(summary, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        return summary
    except Exception:
        return None


def _bundle_f_apply_dry_run_300_env(profile_name: str) -> bool:
    if profile_name != _BUNDLE_F_PROFILE_NAME:
        return False
    defaults = _BUNDLE_F_DRY_RUN_300_PROFILE["defaults"]
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_PROFILE", _BUNDLE_F_PROFILE_NAME)
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_TURNS", str(defaults["turns"]))
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_NARRATION_MODE", str(defaults["narration_mode"]))
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_BACKGROUND_LLM_MODE", str(defaults["background_llm_mode"]))
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_CHECKPOINT_INTERVAL", str(defaults["checkpoint_interval"]))
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_ARTIFACT_DETAIL", str(defaults["artifact_detail"]))
    _bundle_f_os.environ.setdefault("RPG_AUTOPLAY_COMPACT_TRANSCRIPT_MODE", "1")
    return True


def _bundle_f_strip_profile_args(argv: _BundleFList[str]) -> _BundleFTuple[_BundleFList[str], bool]:
    result: _BundleFList[str] = []
    applied = False
    index = 0
    profile_flags = {"--profile", "--autoplay-profile", "--dry-run-profile"}
    while index < len(argv):
        item = argv[index]
        if item in profile_flags and index + 1 < len(argv):
            value = argv[index + 1]
            if _bundle_f_apply_dry_run_300_env(value):
                applied = True
                index += 2
                continue
        if item.startswith("--profile=") or item.startswith("--autoplay-profile=") or item.startswith("--dry-run-profile="):
            value = item.split("=", 1)[1]
            if _bundle_f_apply_dry_run_300_env(value):
                applied = True
                index += 1
                continue
        result.append(item)
        index += 1
    return result, applied


def _bundle_f_append_missing_profile_args(argv: _BundleFList[str]) -> _BundleFList[str]:
    # Use conservative, documented defaults, but only add a flag when the caller
    # has not already supplied it.  Existing CLI choices always win.
    flag_values = [
        ("--turns", "300"),
        ("--narration-mode", "deferred"),
        ("--background-llm-mode", "combined"),
        ("--checkpoint-interval", "25"),
        ("--artifact-detail", "full"),
    ]
    flag_set = {item.split("=", 1)[0] for item in argv if item.startswith("--")}
    expanded = list(argv)
    for flag, value in flag_values:
        if flag not in flag_set:
            expanded.extend([flag, value])
    if "--compact-transcript-mode" not in flag_set:
        expanded.append("--compact-transcript-mode")
    return expanded


if not globals().get("_BUNDLE_F_MAIN_PATCHED") and callable(globals().get("main")):
    _BUNDLE_F_ORIGINAL_MAIN = globals()["main"]

    def _bundle_f_main(argv=None):
        args = list(argv or [])
        args, applied = _bundle_f_strip_profile_args(args)
        if applied:
            args = _bundle_f_append_missing_profile_args(args)
        return _BUNDLE_F_ORIGINAL_MAIN(args)

    globals()["main"] = _bundle_f_main
    globals()["_BUNDLE_F_MAIN_PATCHED"] = True


if not globals().get("_BUNDLE_F_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_F_ORIGINAL_PATH_WRITE_TEXT = _BundleFPath.write_text

    def _bundle_f_write_text_with_gate_summary(self, data, *args, **kwargs):
        result = _BUNDLE_F_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            path = _BundleFPath(self)
            if path.name in _BUNDLE_F_RELEVANT_INPUT_FILES and path.parent.exists():
                _bundle_f_write_gate_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleFPath, _bundle_f_write_text_with_gate_summary)
    globals()["_BUNDLE_F_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle G — Content Exhaustion Expansion Pack for 300 Turns
#
# This is a bounded/advisory content-depth layer for the 300-turn readiness
# path.  It does not let the LLM invent outcomes; it exposes deterministic
# second-act objectives, rumor leads, NPC hooks, travel complications, and
# location unlocks as artifact evidence and enriches content exhaustion forecasts
# to account for the added available content budget.

import json as _bundle_g_json
_BundleGPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleGAny, Dict as _BundleGDict, Iterable as _BundleGIterable, List as _BundleGList, Optional as _BundleGOptional, Set as _BundleGSet


