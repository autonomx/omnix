        "source": "bundle_m_encounter_lifecycle_v2",
        "ok": not failures,
        "advisory_only": True,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "participant_role_count": role_count,
            "round_phase_count": phase_count,
            "action_count": action_count,
            "resolution_rule_count": resolution_rule_count,
            "outcome_state_count": outcome_state_count,
            "recovery_hook_count": recovery_hook_count,
            "existing_encounter_count": existing_encounter_count,
        },
        "encounter_lifecycle_model": model,
        "recommended_next_step": "wire_encounter_lifecycle_v2_into_runtime" if not failures else "fix_encounter_lifecycle_v2_advisory_failures",
    }


def _bundle_m_write_summary_if_possible(result_dir: _BundleMPath):
    try:
        summary = _bundle_m_evaluate_encounter_lifecycle_v2(_bundle_m_artifacts_from_result_dir(result_dir))
        _BUNDLE_M_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_M_SUMMARY_FILE, _bundle_m_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_M_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_M_ORIGINAL_PATH_WRITE_TEXT = _BundleMPath.write_text

    def _bundle_m_write_text_with_encounter_lifecycle_v2(self, data, *args, **kwargs):
        result = _BUNDLE_M_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleMPath(self)
        try:
            if path.name in _BUNDLE_M_INPUT_FILES:
                _bundle_m_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleMPath, _bundle_m_write_text_with_encounter_lifecycle_v2)
    globals()["_BUNDLE_M_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle N — Story Arc Resolution + Campaign End-State v2
#
# Advisory layer for long-run story readiness.  This fragment exports a compact
# story arc lifecycle model, campaign end-state rules, pacing checks, and gate
# metrics.  It writes story-arc-end-state-v2-summary.json and does not mutate
# authoritative simulation state.

import json as _bundle_n_json
_BundleNPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleNAny, Dict as _BundleNDict

_BUNDLE_N_SUMMARY_FILE = "story-arc-end-state-v2-summary.json"
_BUNDLE_N_BASE_FILE = "story-arc-summary.json"
_BUNDLE_N_INPUT_FILES = {
    "summary.json",
    _BUNDLE_N_BASE_FILE,
    "content-depth-expansion-pack-summary.json",
    "npc-agency-v2-summary.json",
    "economy-resource-pressure-v2-summary.json",
    "travel-location-graph-v2-summary.json",
    "faction-reputation-v2-summary.json",
    "encounter-lifecycle-v2-summary.json",
    "memory-state-compression-summary.json",
    "artifact-manifest-digest.json",
}

_BUNDLE_N_MODEL: _BundleNDict[str, _BundleNAny] = {
    "format_version": "bundle_n_story_arc_end_state_v2_model_v1",
    "source": "bundle_n_story_arc_end_state_v2",
    "arc_states": ["locked", "available", "active", "advanced", "resolved", "archived"],
    "campaign_states": ["opening", "investigating", "committing", "resolving", "epilogue", "complete"],
    "story_arcs": [
        {
            "id": "inn_trust_arc",
            "title": "Inn Trust Arc",
            "required_signals": ["fair_payment", "staff_help", "ledger_hint"],
            "resolution_conditions": ["trust_threshold_met", "ledger_thread_closed"],
            "end_state_flags": ["inn_staff_status_known", "lodging_access_settled"],
        },
        {
            "id": "road_readiness_arc",
            "title": "Road Readiness Arc",
            "required_signals": ["travel_supply_ready", "guide_contact", "route_checked"],
            "resolution_conditions": ["safe_route_selected", "route_cost_paid_or_waived"],
            "end_state_flags": ["route_plan_committed", "travel_pressure_accounted"],
        },
        {
            "id": "town_record_arc",
            "title": "Town Record Arc",
            "required_signals": ["clear_evidence", "council_review", "public_order_choice"],
            "resolution_conditions": ["record_delivered", "claim_status_resolved"],
            "end_state_flags": ["council_standing_updated", "case_summary_available"],
        },
        {
            "id": "local_knowledge_arc",
            "title": "Local Knowledge Arc",
            "required_signals": ["new_location_reported", "route_note_added", "guide_feedback"],
            "resolution_conditions": ["map_summary_updated", "local_knowledge_rewarded"],
            "end_state_flags": ["location_graph_summary_ready", "guide_reputation_updated"],
        },
    ],
    "pacing_rules": [
        {"id": "no_same_arc_three_times", "window": 6, "max_repeats": 2},
        {"id": "advance_or_branch_by_window", "window": 12, "required_progress": 1},
        {"id": "recap_before_epilogue", "window": 20, "required_summary": True},
        {"id": "resolved_arcs_leave_followup", "window": 10, "required_followup": True},
    ],
    "end_state_rules": [
        {"id": "at_least_one_primary_arc_resolved", "requires": "resolved_arc_count>=1"},
        {"id": "active_arc_count_bounded", "requires": "active_arc_count<=4"},
        {"id": "unresolved_blocker_count_bounded", "requires": "unresolved_blocker_count<=3"},
        {"id": "epilogue_summary_available", "requires": "campaign_summary_present"},
        {"id": "no_open_system_tasks", "requires": "open_system_task_count==0"},
    ],
    "determinism_contract": {
        "arc_progress_requires_authoritative_signal": True,
        "end_state_uses_structured_flags_only": True,
        "llm_may_summarize_but_not_resolve_arcs": True,
        "resolved_arc_becomes_archivable": True,
        "pacing_rules_are_advisory": True,
    },
}


def _bundle_n_to_int(value: _BundleNAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_n_load_json_file(path: _BundleNPath) -> _BundleNDict[str, _BundleNAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_n_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _bundle_n_artifacts_from_result_dir(result_dir: _BundleNPath) -> _BundleNDict[str, _BundleNDict[str, _BundleNAny]]:
    artifacts = {}
    for file_name in sorted(_BUNDLE_N_INPUT_FILES):
        payload = _bundle_n_load_json_file(result_dir / file_name)
        if payload:
            artifacts[file_name] = payload
    return artifacts


def _bundle_n_ids_unique(items) -> bool:
    ids = [item.get("id") for item in items if isinstance(item, dict)]
    return len(ids) == len(set(ids)) and all(ids)


def _bundle_n_count_existing_arcs(payload: _BundleNAny, keys) -> int:
    if isinstance(payload, dict):
        for key in keys:
            if key in payload:
                return _bundle_n_to_int(payload.get(key), 0)
        total = 0
        for value in payload.values():
            if isinstance(value, dict):
                total = max(total, _bundle_n_count_existing_arcs(value, keys))
            elif isinstance(value, list):
                for item in value:
                    if isinstance(item, dict):
                        total = max(total, _bundle_n_count_existing_arcs(item, keys))
        return total
    return 0


def _bundle_n_evaluate_story_arc_end_state_v2(artifacts: _BundleNDict[str, _BundleNDict[str, _BundleNAny]]):
    model = _BUNDLE_N_MODEL
    arc_count = len(model["story_arcs"])
    arc_state_count = len(model["arc_states"])
    campaign_state_count = len(model["campaign_states"])
    pacing_rule_count = len(model["pacing_rules"])
    end_state_rule_count = len(model["end_state_rules"])
    signal_count = sum(len(arc.get("required_signals", [])) for arc in model["story_arcs"])
    resolution_condition_count = sum(len(arc.get("resolution_conditions", [])) for arc in model["story_arcs"])
    end_flag_count = sum(len(arc.get("end_state_flags", [])) for arc in model["story_arcs"])
    resolved_arc_count = max([_bundle_n_count_existing_arcs(payload, ("resolved_arc_count", "resolved_story_arc_count")) for payload in artifacts.values()] or [0])
    active_arc_count = max([_bundle_n_count_existing_arcs(payload, ("active_arc_count", "active_story_arc_count")) for payload in artifacts.values()] or [0])
    unresolved_blocker_count = max([_bundle_n_count_existing_arcs(payload, ("unresolved_blocker_count", "open_blocker_count")) for payload in artifacts.values()] or [0])
    contract = model["determinism_contract"]
    checks = {
        "story_arc_catalog_present": arc_count >= 4,
        "arc_state_machine_present": arc_state_count >= 6 and campaign_state_count >= 6,
        "arc_ids_unique": _bundle_n_ids_unique(model["story_arcs"]),
        "pacing_rules_present": pacing_rule_count >= 4 and _bundle_n_ids_unique(model["pacing_rules"]),
        "end_state_rules_present": end_state_rule_count >= 5 and _bundle_n_ids_unique(model["end_state_rules"]),
        "required_signals_present": signal_count >= 10,
        "resolution_conditions_present": resolution_condition_count >= 8,
        "end_state_flags_present": end_flag_count >= 8,
        "active_arc_count_bounded": active_arc_count <= 4,
        "unresolved_blocker_count_bounded": unresolved_blocker_count <= 3,
        "determinism_contract_present": bool(contract.get("arc_progress_requires_authoritative_signal")) and bool(contract.get("llm_may_summarize_but_not_resolve_arcs")),
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_n_story_arc_end_state_v2_summary_v1",
        "source": "bundle_n_story_arc_end_state_v2",
        "ok": not failures,
        "advisory_only": True,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "story_arc_count": arc_count,
            "arc_state_count": arc_state_count,
            "campaign_state_count": campaign_state_count,
            "pacing_rule_count": pacing_rule_count,
            "end_state_rule_count": end_state_rule_count,
            "required_signal_count": signal_count,
            "resolution_condition_count": resolution_condition_count,
            "end_state_flag_count": end_flag_count,
            "resolved_arc_count": resolved_arc_count,
            "active_arc_count": active_arc_count,
            "unresolved_blocker_count": unresolved_blocker_count,
        },
        "story_arc_end_state_model": model,
        "recommended_next_step": "wire_story_arc_end_state_v2_into_runtime" if not failures else "fix_story_arc_end_state_v2_advisory_failures",
    }


def _bundle_n_write_summary_if_possible(result_dir: _BundleNPath):
    try:
        summary = _bundle_n_evaluate_story_arc_end_state_v2(_bundle_n_artifacts_from_result_dir(result_dir))
        _BUNDLE_N_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_N_SUMMARY_FILE, _bundle_n_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_N_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_N_ORIGINAL_PATH_WRITE_TEXT = _BundleNPath.write_text

    def _bundle_n_write_text_with_story_arc_end_state_v2(self, data, *args, **kwargs):
        result = _BUNDLE_N_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleNPath(self)
        try:
            if path.name in _BUNDLE_N_INPUT_FILES:
                _bundle_n_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleNPath, _bundle_n_write_text_with_story_arc_end_state_v2)
    globals()["_BUNDLE_N_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle O — 1000-Turn Readiness Aggregator
#
# Advisory rollup layer for long-run campaign readiness.  This fragment reads
# the Bundle F-N summary artifacts, computes one normalized readiness snapshot,
# and writes one-thousand-turn-readiness-aggregator-summary.json.  It does not
# mutate authoritative simulation state and does not make 100-turn runs fail.

import json as _bundle_o_json
_BundleOPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleOAny, Dict as _BundleODict, List as _BundleOList

_BUNDLE_O_SUMMARY_FILE = "one-thousand-turn-readiness-aggregator-summary.json"
_BUNDLE_O_INPUT_FILES = {
    "dry-run-300-endurance-gate-summary.json": "dry_run_300_endurance",
    "content-depth-expansion-pack-summary.json": "content_depth",
    "memory-state-compression-summary.json": "memory_state_compression",
    "npc-agency-v2-summary.json": "npc_agency_v2",
    "economy-resource-pressure-v2-summary.json": "economy_resource_pressure_v2",
    "travel-location-graph-v2-summary.json": "travel_location_graph_v2",
    "faction-reputation-v2-summary.json": "faction_reputation_v2",
    "encounter-lifecycle-v2-summary.json": "encounter_lifecycle_v2",
    "story-arc-end-state-v2-summary.json": "story_arc_end_state_v2",
    "artifact-manifest-digest.json": "artifact_manifest_digest",
    "summary.json": "autoplay_summary",
}

_BUNDLE_O_REQUIRED_GATES = {
    "dry_run_300_endurance",
    "content_depth",
    "memory_state_compression",
    "npc_agency_v2",
    "economy_resource_pressure_v2",
    "travel_location_graph_v2",
    "faction_reputation_v2",
    "encounter_lifecycle_v2",
    "story_arc_end_state_v2",
}

_BUNDLE_O_GATE_CATEGORIES = {
    "dry_run_300_endurance": "endurance",
    "content_depth": "content",
    "memory_state_compression": "bounded_state",
    "npc_agency_v2": "living_world",
    "economy_resource_pressure_v2": "systems",
    "travel_location_graph_v2": "systems",
    "faction_reputation_v2": "consequences",
    "encounter_lifecycle_v2": "systems",
    "story_arc_end_state_v2": "campaign",
    "artifact_manifest_digest": "artifacts",
    "autoplay_summary": "run_summary",
}


def _bundle_o_load_json_file(path: _BundleOPath) -> _BundleODict[str, _BundleOAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_o_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_o_truth(value: _BundleOAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, (int, float)):
        return bool(value)
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "pass", "passed", "ok"}:
        return True
    if text in {"0", "false", "no", "fail", "failed"}:
        return False
    return default


def _bundle_o_to_int(value: _BundleOAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_o_gate_status(name: str, payload: _BundleODict[str, _BundleOAny]) -> _BundleODict[str, _BundleOAny]:
    present = bool(payload)
    checks = payload.get("checks") if isinstance(payload.get("checks"), dict) else {}
    failures = payload.get("advisory_failures") if isinstance(payload.get("advisory_failures"), list) else []
    metrics = payload.get("metrics") if isinstance(payload.get("metrics"), dict) else {}
    if not present:
        ok = False
        failures = ["missing_summary_artifact"]
    else:
        ok = _bundle_o_truth(payload.get("ok"), default=not failures)
        if checks and any(value is False for value in checks.values()):
            ok = False
        if failures:
            ok = False
    return {
        "name": name,
        "category": _BUNDLE_O_GATE_CATEGORIES.get(name, "other"),
        "present": present,
        "ok": ok,
        "check_count": len(checks),
        "failed_check_count": len([value for value in checks.values() if value is False]),
        "advisory_failure_count": len(failures),
        "advisory_failures": failures,
        "metrics": metrics,
    }


def _bundle_o_artifacts_from_result_dir(result_dir: _BundleOPath) -> _BundleODict[str, _BundleODict[str, _BundleOAny]]:
    artifacts: _BundleODict[str, _BundleODict[str, _BundleOAny]] = {}
    for file_name, gate_name in _BUNDLE_O_INPUT_FILES.items():
        payload = _bundle_o_load_json_file(result_dir / file_name)
        if payload:
            artifacts[gate_name] = payload
    return artifacts


def _bundle_o_evaluate_1000_turn_readiness(artifacts: _BundleODict[str, _BundleODict[str, _BundleOAny]]):
    gate_statuses: _BundleOList[_BundleODict[str, _BundleOAny]] = []
    for gate_name in sorted(_BUNDLE_O_REQUIRED_GATES):
        gate_statuses.append(_bundle_o_gate_status(gate_name, artifacts.get(gate_name, {})))
    optional_statuses = [
        _bundle_o_gate_status(name, artifacts.get(name, {}))
        for name in ("artifact_manifest_digest", "autoplay_summary")
        if artifacts.get(name)
    ]
    all_statuses = gate_statuses + optional_statuses

    missing_required = [status["name"] for status in gate_statuses if not status["present"]]
    failing_required = [status["name"] for status in gate_statuses if status["present"] and not status["ok"]]
    total_failed_checks = sum(status["failed_check_count"] for status in all_statuses)
    total_advisory_failures = sum(status["advisory_failure_count"] for status in all_statuses)

    category_rollup: _BundleODict[str, _BundleODict[str, _BundleOAny]] = {}
    for status in all_statuses:
        category = status["category"]
        bucket = category_rollup.setdefault(category, {"gate_count": 0, "pass_count": 0, "fail_count": 0})
        bucket["gate_count"] += 1
        if status["ok"]:
            bucket["pass_count"] += 1
        else:
            bucket["fail_count"] += 1

    ready_for_1000_turn_preflight = not missing_required and not failing_required
    ready_for_live_1000_turn_run = ready_for_1000_turn_preflight and total_failed_checks == 0 and total_advisory_failures == 0

    return {
        "format_version": "bundle_o_1000_turn_readiness_aggregator_summary_v1",
        "source": "bundle_o_1000_turn_readiness_aggregator",
        "ok": ready_for_1000_turn_preflight,
        "advisory_only": True,
        "ready_for_1000_turn_preflight": ready_for_1000_turn_preflight,
        "ready_for_live_1000_turn_run": ready_for_live_1000_turn_run,
        "required_gate_count": len(_BUNDLE_O_REQUIRED_GATES),
        "present_required_gate_count": len([status for status in gate_statuses if status["present"]]),
        "passing_required_gate_count": len([status for status in gate_statuses if status["ok"]]),
        "missing_required_gates": missing_required,
        "failing_required_gates": failing_required,
        "total_failed_check_count": total_failed_checks,
        "total_advisory_failure_count": total_advisory_failures,
        "gate_statuses": gate_statuses,
        "optional_gate_statuses": optional_statuses,
        "category_rollup": category_rollup,
        "recommended_next_step": "run_1000_turn_preflight" if ready_for_1000_turn_preflight else "fix_required_readiness_gates_before_1000_turn_preflight",
    }


def _bundle_o_write_summary_if_possible(result_dir: _BundleOPath):
    try:
        summary = _bundle_o_evaluate_1000_turn_readiness(_bundle_o_artifacts_from_result_dir(result_dir))
        _BUNDLE_O_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_O_SUMMARY_FILE, _bundle_o_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_O_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_O_ORIGINAL_PATH_WRITE_TEXT = _BundleOPath.write_text

    def _bundle_o_write_text_with_1000_turn_readiness(self, data, *args, **kwargs):
        result = _BUNDLE_O_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleOPath(self)
        try:
            if path.name in _BUNDLE_O_INPUT_FILES:
                _bundle_o_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleOPath, _bundle_o_write_text_with_1000_turn_readiness)
    globals()["_BUNDLE_O_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle P — 1000-Turn Readiness Dashboard Rendering
#
# Product-facing dashboard for the Bundle O readiness aggregator.  This fragment
# reads one-thousand-turn-readiness-aggregator-summary.json, writes a compact
# dashboard summary, and injects a campaign report section.  It is advisory-only
# and never mutates authoritative simulation state.

import html as _bundle_p_html
import json as _bundle_p_json
_BundlePPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundlePAny, Dict as _BundlePDict, List as _BundlePList

_BUNDLE_P_AGGREGATOR_FILE = "one-thousand-turn-readiness-aggregator-summary.json"
_BUNDLE_P_DASHBOARD_FILE = "one-thousand-turn-readiness-dashboard-summary.json"
_BUNDLE_P_MARKER = 'id="bundle-p-1000-turn-readiness-dashboard"'


def _bundle_p_safe_html(value: _BundlePAny) -> str:
    return _bundle_p_html.escape("" if value is None else str(value), quote=True)


def _bundle_p_load_json_file(path: _BundlePPath) -> _BundlePDict[str, _BundlePAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_p_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_p_status_label(payload: _BundlePDict[str, _BundlePAny]) -> str:
    if payload.get("ready_for_live_1000_turn_run") is True:
        return "Live Ready"
    if payload.get("ready_for_1000_turn_preflight") is True:
        return "Preflight Ready"
    return "Not Ready"


def _bundle_p_status_class(payload: _BundlePDict[str, _BundlePAny]) -> str:
    if payload.get("ready_for_live_1000_turn_run") is True:
        return "pass"
    if payload.get("ready_for_1000_turn_preflight") is True:
        return "warn"
    return "fail"


def _bundle_p_build_dashboard_summary(aggregator: _BundlePDict[str, _BundlePAny]) -> _BundlePDict[str, _BundlePAny]:
    gate_statuses = aggregator.get("gate_statuses") if isinstance(aggregator.get("gate_statuses"), list) else []
    failing = aggregator.get("failing_required_gates") if isinstance(aggregator.get("failing_required_gates"), list) else []
    missing = aggregator.get("missing_required_gates") if isinstance(aggregator.get("missing_required_gates"), list) else []
    category_rollup = aggregator.get("category_rollup") if isinstance(aggregator.get("category_rollup"), dict) else {}
    required_gate_count = int(aggregator.get("required_gate_count") or len(gate_statuses) or 0)
    passing_gate_count = int(aggregator.get("passing_required_gate_count") or 0)
    completion_percent = int((passing_gate_count / required_gate_count) * 100) if required_gate_count else 0

    return {
        "format_version": "bundle_p_1000_turn_readiness_dashboard_summary_v1",
        "source": "bundle_p_1000_turn_readiness_dashboard",
        "ok": aggregator.get("ready_for_1000_turn_preflight") is True,
        "advisory_only": True,
        "status_label": _bundle_p_status_label(aggregator),
        "status_class": _bundle_p_status_class(aggregator),
        "ready_for_1000_turn_preflight": aggregator.get("ready_for_1000_turn_preflight") is True,
        "ready_for_live_1000_turn_run": aggregator.get("ready_for_live_1000_turn_run") is True,
        "required_gate_count": required_gate_count,
        "passing_required_gate_count": passing_gate_count,
        "missing_required_gate_count": len(missing),
        "failing_required_gate_count": len(failing),
        "completion_percent": completion_percent,
        "missing_required_gates": list(missing),
        "failing_required_gates": list(failing),
        "category_rollup": category_rollup,
        "recommended_next_step": aggregator.get("recommended_next_step") or "run_required_readiness_checks",
    }


def _bundle_p_write_dashboard_summary_if_possible(result_dir: _BundlePPath) -> _BundlePDict[str, _BundlePAny]:
    aggregator = _bundle_p_load_json_file(result_dir / _BUNDLE_P_AGGREGATOR_FILE)
    if not aggregator:
        dashboard = {
            "format_version": "bundle_p_1000_turn_readiness_dashboard_summary_v1",
            "source": "bundle_p_1000_turn_readiness_dashboard",
            "ok": False,
            "advisory_only": True,
            "status_label": "Missing Aggregator",
            "status_class": "fail",
            "missing_required_gates": ["one-thousand-turn-readiness-aggregator-summary.json"],
            "recommended_next_step": "write_1000_turn_readiness_aggregator_first",
        }
    else:
        dashboard = _bundle_p_build_dashboard_summary(aggregator)
    _BUNDLE_P_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_P_DASHBOARD_FILE,
        _bundle_p_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_p_gate_rows(aggregator: _BundlePDict[str, _BundlePAny]) -> str:
    rows: _BundlePList[str] = []
    gate_statuses = aggregator.get("gate_statuses") if isinstance(aggregator.get("gate_statuses"), list) else []
    for status in gate_statuses:
        if not isinstance(status, dict):
            continue
        label = "pass" if status.get("ok") is True else "advisory"
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_p_safe_html(status.get('name'))}</th>"
            f"<td>{_bundle_p_safe_html(status.get('category'))}</td>"
            f"<td>{_bundle_p_safe_html(label)}</td>"
            f"<td>{_bundle_p_safe_html(status.get('advisory_failure_count', 0))}</td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">status</th><td colspan=\"3\">no gate rows available</td></tr>"


def _bundle_p_category_rows(dashboard: _BundlePDict[str, _BundlePAny]) -> str:
    rows: _BundlePList[str] = []
    rollup = dashboard.get("category_rollup") if isinstance(dashboard.get("category_rollup"), dict) else {}
    for category, data in sorted(rollup.items()):
        if not isinstance(data, dict):
            continue
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_p_safe_html(category)}</th>"
            f"<td>{_bundle_p_safe_html(data.get('gate_count', 0))}</td>"
            f"<td>{_bundle_p_safe_html(data.get('pass_count', 0))}</td>"
            f"<td>{_bundle_p_safe_html(data.get('fail_count', 0))}</td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">category</th><td colspan=\"3\">no category rollup available</td></tr>"


def _bundle_p_render_dashboard_section(result_dir: _BundlePPath) -> str:
    aggregator = _bundle_p_load_json_file(result_dir / _BUNDLE_P_AGGREGATOR_FILE)
    dashboard = _bundle_p_load_json_file(result_dir / _BUNDLE_P_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_p_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_p_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Not Ready"
    return (
        '<section id="bundle-p-1000-turn-readiness-dashboard" class="bundle-p-1000-turn-readiness-dashboard">'
        "<style>"
        ".bundle-p-1000-turn-readiness-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-p-1000-turn-readiness-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-p-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-p-badge-pass{background:rgba(34,197,94,.16)}"
        ".bundle-p-badge-warn{background:rgba(245,158,11,.16)}"
        ".bundle-p-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-p-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}"
        ".bundle-p-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72)}"
        ".bundle-p-table{width:100%;border-collapse:collapse;font-size:.9rem}"
        ".bundle-p-table th,.bundle-p-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-p-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header>"
        "<h2>1000-Turn Readiness Dashboard</h2>"
        f'<span class="bundle-p-badge bundle-p-badge-{_bundle_p_safe_html(status_class)}">{_bundle_p_safe_html(status_label)}</span>'
        "</header>"
        "<p>Rollup of long-run readiness gates from Bundle F through Bundle O.</p>"
        f"<p>Progress: {_bundle_p_safe_html(dashboard.get('passing_required_gate_count', 0))}/{_bundle_p_safe_html(dashboard.get('required_gate_count', 0))} required gates passing ({_bundle_p_safe_html(dashboard.get('completion_percent', 0))}%).</p>"
        f"<p>Recommended next step: {_bundle_p_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-p-grid">'
        '<div class="bundle-p-card"><h3>Required Gates</h3><table class="bundle-p-table"><thead><tr><th>Gate</th><th>Category</th><th>Status</th><th>Failures</th></tr></thead><tbody>'
        f"{_bundle_p_gate_rows(aggregator)}"
        "</tbody></table></div>"
        '<div class="bundle-p-card"><h3>Category Rollup</h3><table class="bundle-p-table"><thead><tr><th>Category</th><th>Gates</th><th>Pass</th><th>Fail</th></tr></thead><tbody>'
        f"{_bundle_p_category_rows(dashboard)}"
        "</tbody></table></div>"
        "</div>"
        '<details class="bundle-p-raw-details"><summary>Raw dashboard JSON</summary>'
        f'<pre class="bundle-p-raw-json">{_bundle_p_safe_html(raw_json)}</pre>'
        "</details>"
        "</section>"
    )


def _bundle_p_looks_like_campaign_report(path: _BundlePPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-p-1000-turn-readiness-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_p_inject_dashboard_section(path: _BundlePPath, html_text: str) -> str:
    if not _bundle_p_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_p_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_P_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_P_ORIGINAL_PATH_WRITE_TEXT = _BundlePPath.write_text

    def _bundle_p_write_text_with_readiness_dashboard(self, data, *args, **kwargs):
        path = _BundlePPath(self)
        if isinstance(data, str) and _bundle_p_looks_like_campaign_report(path, data):
            try:
                data = _bundle_p_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle P dashboard injection skipped: " + _bundle_p_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_P_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_P_AGGREGATOR_FILE:
                _bundle_p_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundlePPath, _bundle_p_write_text_with_readiness_dashboard)
    globals()["_BUNDLE_P_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle Q — 1000-Turn Preflight Profile + Command Builder
#
# Advisory profile layer for the first full-scale preflight.  This fragment
# exposes a deterministic 1000-turn preflight profile, command-builder helpers,
# and a summary artifact that links Bundle O/P readiness to a concrete next run.
# It does not mutate authoritative simulation state.

import json as _bundle_q_json
import os as _bundle_q_os
_BundleQPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleQAny, Dict as _BundleQDict, List as _BundleQList, Tuple as _BundleQTuple

_BUNDLE_Q_PROFILE_NAME = "preflight_1000"
_BUNDLE_Q_SUMMARY_FILE = "one-thousand-turn-preflight-profile-summary.json"
_BUNDLE_Q_AGGREGATOR_FILE = "one-thousand-turn-readiness-aggregator-summary.json"
_BUNDLE_Q_DASHBOARD_FILE = "one-thousand-turn-readiness-dashboard-summary.json"
_BUNDLE_Q_TARGET_TURNS = 1000

_BUNDLE_Q_PROFILE: _BundleQDict[str, _BundleQAny] = {
    "format_version": "bundle_q_1000_turn_preflight_profile_v1",
    "source": "bundle_q_1000_turn_preflight_profile",
    "name": _BUNDLE_Q_PROFILE_NAME,
    "target_turns": _BUNDLE_Q_TARGET_TURNS,
    "intent": "First full-scale advisory preflight before a live 1000-turn LLM campaign run.",
    "defaults": {
        "turns": _BUNDLE_Q_TARGET_TURNS,
        "narration_mode": "deferred",
        "background_llm_mode": "combined",
        "checkpoint_interval": 25,
        "artifact_detail": "full",
        "transcript_detail": "auto",
        "compact_transcript_mode": True,
        "final_background_drain_required": True,
        "readiness_aggregator_required": True,
        "dashboard_required": True,
    },
    "safety_thresholds": {
        "max_blocking_turn_p95_seconds": 8.0,
        "max_background_drain_seconds": 120.0,
        "max_player_agent_fallback_rate": 0.25,
        "min_meaningful_progress_rate": 0.10,
        "max_required_gate_failures": 0,
    },
    "canonical_cli_args": [
        "--turns", "1000",
        "--narration-mode", "deferred",
        "--background-llm-mode", "combined",
        "--checkpoint-interval", "25",
        "--artifact-detail", "full",
        "--transcript-detail", "auto",
    ],
}


def _bundle_q_load_json_file(path: _BundleQPath) -> _BundleQDict[str, _BundleQAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_q_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_q_bool(value: _BundleQAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed"}:
        return True
    if text in {"0", "false", "no", "fail", "failed"}:
        return False
    return default


def _bundle_q_build_preflight_command(script: str = "src/tests/rpg/autoplay_llm_campaign.py") -> _BundleQList[str]:
    return ["python", script, *list(_BUNDLE_Q_PROFILE["canonical_cli_args"])]


def _bundle_q_missing_command_flags(argv: _BundleQList[str]) -> _BundleQList[str]:
    supplied = {arg.split("=", 1)[0] for arg in argv if str(arg).startswith("--")}
    required = ["--turns", "--narration-mode", "--background-llm-mode", "--checkpoint-interval", "--artifact-detail", "--transcript-detail"]
    return [flag for flag in required if flag not in supplied]


def _bundle_q_strip_profile_args(argv: _BundleQList[str]) -> _BundleQTuple[_BundleQList[str], bool]:
    stripped: _BundleQList[str] = []
    applied = False
    profile_flags = {"--profile", "--autoplay-profile", "--dry-run-profile", "--preflight-profile"}
    index = 0
    while index < len(argv):
        item = argv[index]
        if item in profile_flags and index + 1 < len(argv):
            value = argv[index + 1]
            if value == _BUNDLE_Q_PROFILE_NAME:
                applied = True
                index += 2
                continue
        if item.startswith("--profile=") or item.startswith("--autoplay-profile=") or item.startswith("--dry-run-profile=") or item.startswith("--preflight-profile="):
            value = item.split("=", 1)[1]
            if value == _BUNDLE_Q_PROFILE_NAME:
                applied = True
                index += 1
                continue
        stripped.append(item)
        index += 1
    return stripped, applied


def _bundle_q_append_missing_profile_args(argv: _BundleQList[str]) -> _BundleQList[str]:
    expanded = list(argv)
    supplied = {arg.split("=", 1)[0] for arg in expanded if str(arg).startswith("--")}
    for flag, value in [
        ("--turns", "1000"),
        ("--narration-mode", "deferred"),
        ("--background-llm-mode", "combined"),
        ("--checkpoint-interval", "25"),
        ("--artifact-detail", "full"),
        ("--transcript-detail", "auto"),
    ]:
        if flag not in supplied:
            expanded.extend([flag, value])
    return expanded


def _bundle_q_apply_preflight_env() -> None:
    defaults = _BUNDLE_Q_PROFILE["defaults"]
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_PROFILE", _BUNDLE_Q_PROFILE_NAME)
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_TURNS", str(defaults["turns"]))
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_NARRATION_MODE", str(defaults["narration_mode"]))
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_BACKGROUND_LLM_MODE", str(defaults["background_llm_mode"]))
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_CHECKPOINT_INTERVAL", str(defaults["checkpoint_interval"]))
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_ARTIFACT_DETAIL", str(defaults["artifact_detail"]))
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_TRANSCRIPT_DETAIL", str(defaults["transcript_detail"]))
    _bundle_q_os.environ.setdefault("RPG_AUTOPLAY_COMPACT_TRANSCRIPT_MODE", "1")


def _bundle_q_evaluate_preflight_profile(result_dir: _BundleQPath) -> _BundleQDict[str, _BundleQAny]:
    aggregator = _bundle_q_load_json_file(result_dir / _BUNDLE_Q_AGGREGATOR_FILE)
    dashboard = _bundle_q_load_json_file(result_dir / _BUNDLE_Q_DASHBOARD_FILE)
    command = _bundle_q_build_preflight_command()
    missing_flags = _bundle_q_missing_command_flags(command)
    aggregator_ready = _bundle_q_bool(aggregator.get("ready_for_1000_turn_preflight"), False)
    dashboard_ready = bool(dashboard) and dashboard.get("status_label") in {"Live Ready", "Preflight Ready"}
    checks = {
        "profile_descriptor_present": _BUNDLE_Q_PROFILE["name"] == _BUNDLE_Q_PROFILE_NAME,
        "target_turns_1000": _BUNDLE_Q_PROFILE["target_turns"] == _BUNDLE_Q_TARGET_TURNS,
        "canonical_command_complete": not missing_flags,
        "aggregator_preflight_ready": aggregator_ready,
        "dashboard_present": bool(dashboard),
        "dashboard_preflight_ready": dashboard_ready,
        "compact_transcript_mode_enabled": bool(_BUNDLE_Q_PROFILE["defaults"].get("compact_transcript_mode")),
        "final_background_drain_required": bool(_BUNDLE_Q_PROFILE["defaults"].get("final_background_drain_required")),
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_q_1000_turn_preflight_profile_summary_v1",
        "source": "bundle_q_1000_turn_preflight_profile",
        "ok": not failures,
        "advisory_only": True,
        "profile": _BUNDLE_Q_PROFILE,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "target_turns": _BUNDLE_Q_TARGET_TURNS,
            "canonical_command_arg_count": len(command),
            "missing_command_flag_count": len(missing_flags),
            "aggregator_present": bool(aggregator),
            "dashboard_present": bool(dashboard),
        },
        "canonical_command": command,
        "missing_command_flags": missing_flags,
        "recommended_next_step": "run_preflight_1000_command" if not failures else "fix_readiness_dashboard_before_preflight_1000",
    }


def _bundle_q_write_summary_if_possible(result_dir: _BundleQPath):
    try:
        summary = _bundle_q_evaluate_preflight_profile(result_dir)
        _BUNDLE_Q_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_Q_SUMMARY_FILE, _bundle_q_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_Q_MAIN_PATCHED") and callable(globals().get("main")):
    _BUNDLE_Q_ORIGINAL_MAIN = globals()["main"]

    def _bundle_q_main(argv=None):
        args = list(argv or [])
        args, applied = _bundle_q_strip_profile_args(args)
        if applied:
            _bundle_q_apply_preflight_env()
            args = _bundle_q_append_missing_profile_args(args)
        return _BUNDLE_Q_ORIGINAL_MAIN(args)

    globals()["main"] = _bundle_q_main
    globals()["_BUNDLE_Q_MAIN_PATCHED"] = True


if not globals().get("_BUNDLE_Q_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_Q_ORIGINAL_PATH_WRITE_TEXT = _BundleQPath.write_text

    def _bundle_q_write_text_with_preflight_profile(self, data, *args, **kwargs):
        result = _BUNDLE_Q_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleQPath(self)
        try:
            if path.name in {_BUNDLE_Q_AGGREGATOR_FILE, _BUNDLE_Q_DASHBOARD_FILE}:
                _bundle_q_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleQPath, _bundle_q_write_text_with_preflight_profile)
    globals()["_BUNDLE_Q_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle R — 1000-Turn Preflight Result Evaluator + Promotion Gate
#
# Advisory promotion gate for the first 1000-turn preflight run.  This fragment
# reads the preflight profile, readiness rollup, dashboard, run summary, and
# performance artifacts, then writes one-thousand-turn-preflight-result-summary.json.
# It does not mutate authoritative simulation state and does not make shorter
# runs fail.

import json as _bundle_r_json
_BundleRPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleRAny, Dict as _BundleRDict, Iterable as _BundleRIterable

_BUNDLE_R_SUMMARY_FILE = "one-thousand-turn-preflight-result-summary.json"
_BUNDLE_R_PROFILE_FILE = "one-thousand-turn-preflight-profile-summary.json"
_BUNDLE_R_AGGREGATOR_FILE = "one-thousand-turn-readiness-aggregator-summary.json"
_BUNDLE_R_DASHBOARD_FILE = "one-thousand-turn-readiness-dashboard-summary.json"
_BUNDLE_R_TARGET_TURNS = 1000
_BUNDLE_R_MAX_BLOCKING_P95_SECONDS = 8.0
_BUNDLE_R_MAX_BACKGROUND_DRAIN_SECONDS = 120.0
_BUNDLE_R_MAX_PLAYER_AGENT_FALLBACK_RATE = 0.25
_BUNDLE_R_MIN_MEANINGFUL_PROGRESS_RATE = 0.10
_BUNDLE_R_MAX_RUNTIME_ERRORS = 0
_BUNDLE_R_MAX_UNRESOLVED_BACKGROUND_JOBS = 0

_BUNDLE_R_INPUT_FILES = {
    _BUNDLE_R_PROFILE_FILE,
    _BUNDLE_R_AGGREGATOR_FILE,
    _BUNDLE_R_DASHBOARD_FILE,
    "summary.json",
    "artifact-manifest-digest.json",
    "performance-summary.json",
    "autoplay-performance-summary.json",
    "progress-quality-summary.json",
    "long-run-dry-run-projection-summary.json",
    "transcript-payload-budget-summary.json",
}


def _bundle_r_load_json_file(path: _BundleRPath) -> _BundleRDict[str, _BundleRAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_r_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_r_artifacts_from_result_dir(result_dir: _BundleRPath) -> _BundleRDict[str, _BundleRDict[str, _BundleRAny]]:
    artifacts: _BundleRDict[str, _BundleRDict[str, _BundleRAny]] = {}
    for file_name in sorted(_BUNDLE_R_INPUT_FILES):
        payload = _bundle_r_load_json_file(result_dir / file_name)
        if payload:
            artifacts[file_name] = payload
    return artifacts


def _bundle_r_truth(value: _BundleRAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, (int, float)):
        return bool(value)
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed", "ready"}:
        return True
    if text in {"0", "false", "no", "fail", "failed", "not_ready"}:
        return False
    return default


def _bundle_r_to_int(value: _BundleRAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_r_to_float(value: _BundleRAny, default: float = 0.0) -> float:
    try:
        if value is None:
            return default
        return float(str(value))
    except Exception:
        return default


def _bundle_r_walk(value: _BundleRAny):
    stack = [value]
    while stack:
        current = stack.pop()
        yield current
        if isinstance(current, dict):
            stack.extend(current.values())
        elif isinstance(current, list):
            stack.extend(current)


def _bundle_r_first_scalar(payloads: _BundleRIterable[_BundleRDict[str, _BundleRAny]], *keys: str) -> _BundleRAny:
    key_set = set(keys)
    for payload in payloads:
        for node in _bundle_r_walk(payload):
            if not isinstance(node, dict):
                continue
            for key in key_set:
                if key in node and not isinstance(node.get(key), (dict, list)):
                    return node.get(key)
    return None


def _bundle_r_count_failures(payload: _BundleRDict[str, _BundleRAny]) -> int:
    failures = payload.get("advisory_failures")
    if isinstance(failures, list):
        return len(failures)
    checks = payload.get("checks")
    if isinstance(checks, dict):
        return len([value for value in checks.values() if value is False])
    return 0


def _bundle_r_evaluate_1000_turn_preflight_result(artifacts: _BundleRDict[str, _BundleRDict[str, _BundleRAny]]):
    profile = artifacts.get(_BUNDLE_R_PROFILE_FILE, {})
    aggregator = artifacts.get(_BUNDLE_R_AGGREGATOR_FILE, {})
    dashboard = artifacts.get(_BUNDLE_R_DASHBOARD_FILE, {})
    run_summary = artifacts.get("summary.json", {})
    manifest = artifacts.get("artifact-manifest-digest.json", {})
    performance = artifacts.get("performance-summary.json") or artifacts.get("autoplay-performance-summary.json", {})
    progress = artifacts.get("progress-quality-summary.json", {})
    payloads = [profile, aggregator, dashboard, run_summary, manifest, performance, progress]

    completed_turns = _bundle_r_to_int(_bundle_r_first_scalar(payloads, "completed_turns", "turn_count", "turns_completed", "requested_turns"), 0)
    requested_turns = _bundle_r_to_int(_bundle_r_first_scalar(payloads, "requested_turns", "target_turns", "turns"), _BUNDLE_R_TARGET_TURNS)
    runtime_error_count = _bundle_r_to_int(_bundle_r_first_scalar(payloads, "runtime_error_count", "error_count", "exception_count"), 0)
    unresolved_jobs = _bundle_r_to_int(_bundle_r_first_scalar(payloads, "unresolved_final_background_jobs", "unresolved_background_jobs", "unfinished_background_jobs"), 0)
    blocking_p95 = _bundle_r_to_float(_bundle_r_first_scalar(payloads, "blocking_turn_p95_seconds", "turn_p95_seconds", "p95_turn_seconds", "p95_seconds"), 0.0)
    background_drain = _bundle_r_to_float(_bundle_r_first_scalar(payloads, "background_drain_seconds", "final_background_drain_seconds", "background_drain_elapsed_seconds"), 0.0)
    fallback_rate = _bundle_r_to_float(_bundle_r_first_scalar(payloads, "player_agent_fallback_rate", "fallback_rate"), 0.0)
    progress_rate = _bundle_r_to_float(_bundle_r_first_scalar(payloads, "meaningful_progress_rate", "progress_rate"), 1.0)
    required_gate_failures = len(aggregator.get("failing_required_gates") or []) + len(aggregator.get("missing_required_gates") or [])

    checks = {
        "preflight_profile_ready": _bundle_r_truth(profile.get("ok"), False),
        "readiness_aggregator_ready": _bundle_r_truth(aggregator.get("ready_for_1000_turn_preflight"), False),
        "readiness_dashboard_ready": dashboard.get("status_label") in {"Live Ready", "Preflight Ready"},
        "completed_target_turns": completed_turns >= _BUNDLE_R_TARGET_TURNS or requested_turns >= _BUNDLE_R_TARGET_TURNS,
        "no_required_gate_failures": required_gate_failures == 0,
        "no_runtime_errors": runtime_error_count <= _BUNDLE_R_MAX_RUNTIME_ERRORS,
        "no_unresolved_background_jobs": unresolved_jobs <= _BUNDLE_R_MAX_UNRESOLVED_BACKGROUND_JOBS,
        "blocking_turn_p95_within_budget": blocking_p95 <= _BUNDLE_R_MAX_BLOCKING_P95_SECONDS if blocking_p95 > 0 else True,
        "background_drain_within_budget": background_drain <= _BUNDLE_R_MAX_BACKGROUND_DRAIN_SECONDS if background_drain > 0 else True,
        "player_agent_fallback_rate_within_budget": fallback_rate <= _BUNDLE_R_MAX_PLAYER_AGENT_FALLBACK_RATE,
        "meaningful_progress_rate_within_budget": progress_rate >= _BUNDLE_R_MIN_MEANINGFUL_PROGRESS_RATE,
        "artifact_manifest_ok": manifest == {} or _bundle_r_truth(manifest.get("ok") or manifest.get("manifest_ok") or manifest.get("invariant_ok"), True),
    }
    failures = [name for name, ok in checks.items() if not ok]
    promote_to_live_1000_turn_run = not failures

    return {
        "format_version": "bundle_r_1000_turn_preflight_result_summary_v1",
        "source": "bundle_r_1000_turn_preflight_result_gate",
        "ok": promote_to_live_1000_turn_run,
        "advisory_only": True,
        "promote_to_live_1000_turn_run": promote_to_live_1000_turn_run,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "target_turns": _BUNDLE_R_TARGET_TURNS,
            "completed_turns": completed_turns,
            "requested_turns": requested_turns,
            "runtime_error_count": runtime_error_count,
            "unresolved_background_jobs": unresolved_jobs,
            "blocking_turn_p95_seconds": blocking_p95,
            "max_blocking_turn_p95_seconds": _BUNDLE_R_MAX_BLOCKING_P95_SECONDS,
            "background_drain_seconds": background_drain,
            "max_background_drain_seconds": _BUNDLE_R_MAX_BACKGROUND_DRAIN_SECONDS,
            "player_agent_fallback_rate": fallback_rate,
            "max_player_agent_fallback_rate": _BUNDLE_R_MAX_PLAYER_AGENT_FALLBACK_RATE,
            "meaningful_progress_rate": progress_rate,
            "min_meaningful_progress_rate": _BUNDLE_R_MIN_MEANINGFUL_PROGRESS_RATE,
            "required_gate_failure_count": required_gate_failures,
            "profile_failure_count": _bundle_r_count_failures(profile),
            "aggregator_failure_count": _bundle_r_count_failures(aggregator),
            "dashboard_failure_count": _bundle_r_count_failures(dashboard),
        },
        "recommended_next_step": "promote_to_live_1000_turn_run" if promote_to_live_1000_turn_run else "fix_preflight_result_failures_before_live_1000_turn_run",
    }


def _bundle_r_write_summary_if_possible(result_dir: _BundleRPath):
    try:
        summary = _bundle_r_evaluate_1000_turn_preflight_result(_bundle_r_artifacts_from_result_dir(result_dir))
        _BUNDLE_R_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_R_SUMMARY_FILE, _bundle_r_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_R_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_R_ORIGINAL_PATH_WRITE_TEXT = _BundleRPath.write_text

    def _bundle_r_write_text_with_preflight_result_gate(self, data, *args, **kwargs):
        result = _BUNDLE_R_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleRPath(self)
        try:
            if path.name in _BUNDLE_R_INPUT_FILES:
                _bundle_r_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleRPath, _bundle_r_write_text_with_preflight_result_gate)
    globals()["_BUNDLE_R_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle S — Live 1000-Turn Run Profile + Promotion Guard
#
# Advisory profile layer for the first live 1000-turn campaign run.  This
# fragment requires Bundle R's preflight promotion artifact before recommending
# a live run, exports a deterministic command profile, and writes
# one-thousand-turn-live-run-profile-summary.json.  It does not mutate
# authoritative simulation state.

import json as _bundle_s_json
import os as _bundle_s_os
_BundleSPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleSAny, Dict as _BundleSDict, List as _BundleSList, Tuple as _BundleSTuple

_BUNDLE_S_PROFILE_NAME = "live_1000"
_BUNDLE_S_SUMMARY_FILE = "one-thousand-turn-live-run-profile-summary.json"
_BUNDLE_S_PREFLIGHT_RESULT_FILE = "one-thousand-turn-preflight-result-summary.json"
_BUNDLE_S_TARGET_TURNS = 1000

_BUNDLE_S_PROFILE: _BundleSDict[str, _BundleSAny] = {
    "format_version": "bundle_s_live_1000_turn_profile_v1",
    "source": "bundle_s_live_1000_run_profile",
    "name": _BUNDLE_S_PROFILE_NAME,
    "target_turns": _BUNDLE_S_TARGET_TURNS,
    "intent": "First live 1000-turn LLM campaign run after the preflight result gate promotes it.",
    "requires_preflight_promotion": True,
    "defaults": {
        "turns": _BUNDLE_S_TARGET_TURNS,
        "narration_mode": "deferred",
        "background_llm_mode": "combined",
        "checkpoint_interval": 25,
        "artifact_detail": "full",
        "transcript_detail": "auto",
        "compact_transcript_mode": True,
        "final_background_drain_required": True,
        "promotion_gate_required": True,
        "zip_artifacts_required": True,
    },
    "guardrails": {
        "require_preflight_result_file": True,
        "require_promote_to_live_1000_turn_run": True,
        "do_not_run_if_preflight_failed": True,
        "preserve_full_report_artifacts": True,
        "preserve_console_log_artifacts": True,
    },
    "canonical_cli_args": [
        "--turns", "1000",
        "--narration-mode", "deferred",
        "--background-llm-mode", "combined",
        "--checkpoint-interval", "25",
        "--artifact-detail", "full",
        "--transcript-detail", "auto",
        "--capture-console-log",
    ],
}


def _bundle_s_load_json_file(path: _BundleSPath) -> _BundleSDict[str, _BundleSAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_s_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_s_bool(value: _BundleSAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed", "ready", "promote"}:
        return True
    if text in {"0", "false", "no", "fail", "failed", "not_ready", "blocked"}:
        return False
    return default


def _bundle_s_build_live_command(script: str = "src/tests/rpg/autoplay_llm_campaign.py") -> _BundleSList[str]:
    return ["python", script, *list(_BUNDLE_S_PROFILE["canonical_cli_args"])]


def _bundle_s_missing_command_flags(argv: _BundleSList[str]) -> _BundleSList[str]:
    supplied = {arg.split("=", 1)[0] for arg in argv if str(arg).startswith("--")}
    required = [
        "--turns",
        "--narration-mode",
        "--background-llm-mode",
        "--checkpoint-interval",
        "--artifact-detail",
        "--transcript-detail",
        "--capture-console-log",
    ]
    return [flag for flag in required if flag not in supplied]


def _bundle_s_strip_profile_args(argv: _BundleSList[str]) -> _BundleSTuple[_BundleSList[str], bool]:
    stripped: _BundleSList[str] = []
    applied = False
    profile_flags = {"--profile", "--autoplay-profile", "--live-profile", "--run-profile"}
    index = 0
    while index < len(argv):
        item = argv[index]
        if item in profile_flags and index + 1 < len(argv):
            if argv[index + 1] == _BUNDLE_S_PROFILE_NAME:
                applied = True
                index += 2
                continue
        if any(item.startswith(flag + "=") for flag in profile_flags):
            if item.split("=", 1)[1] == _BUNDLE_S_PROFILE_NAME:
                applied = True
                index += 1
                continue
        stripped.append(item)
        index += 1
    return stripped, applied


def _bundle_s_append_missing_profile_args(argv: _BundleSList[str]) -> _BundleSList[str]:
    expanded = list(argv)
    supplied = {arg.split("=", 1)[0] for arg in expanded if str(arg).startswith("--")}
    for flag, value in [
        ("--turns", "1000"),
        ("--narration-mode", "deferred"),
        ("--background-llm-mode", "combined"),
        ("--checkpoint-interval", "25"),
        ("--artifact-detail", "full"),
        ("--transcript-detail", "auto"),
    ]:
        if flag not in supplied:
            expanded.extend([flag, value])
    if "--capture-console-log" not in supplied and "--no-capture-console-log" not in supplied:
        expanded.append("--capture-console-log")
    return expanded


def _bundle_s_apply_live_env() -> None:
    defaults = _BUNDLE_S_PROFILE["defaults"]
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_PROFILE", _BUNDLE_S_PROFILE_NAME)
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_TURNS", str(defaults["turns"]))
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_NARRATION_MODE", str(defaults["narration_mode"]))
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_BACKGROUND_LLM_MODE", str(defaults["background_llm_mode"]))
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_CHECKPOINT_INTERVAL", str(defaults["checkpoint_interval"]))
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_ARTIFACT_DETAIL", str(defaults["artifact_detail"]))
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_TRANSCRIPT_DETAIL", str(defaults["transcript_detail"]))
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_COMPACT_TRANSCRIPT_MODE", "1")
    _bundle_s_os.environ.setdefault("RPG_AUTOPLAY_ZIP_RESULTS", "1")


def _bundle_s_evaluate_live_run_profile(result_dir: _BundleSPath) -> _BundleSDict[str, _BundleSAny]:
    preflight = _bundle_s_load_json_file(result_dir / _BUNDLE_S_PREFLIGHT_RESULT_FILE)
    command = _bundle_s_build_live_command()
    missing_flags = _bundle_s_missing_command_flags(command)
    preflight_present = bool(preflight)
    promoted = _bundle_s_bool(preflight.get("promote_to_live_1000_turn_run"), False)
    preflight_ok = _bundle_s_bool(preflight.get("ok"), False)
    checks = {
        "live_profile_descriptor_present": _BUNDLE_S_PROFILE["name"] == _BUNDLE_S_PROFILE_NAME,
        "target_turns_1000": _BUNDLE_S_PROFILE["target_turns"] == _BUNDLE_S_TARGET_TURNS,
        "canonical_command_complete": not missing_flags,
        "promotion_guard_required": bool(_BUNDLE_S_PROFILE.get("requires_preflight_promotion")),
        "preflight_result_present": preflight_present,
        "preflight_result_ok": preflight_ok,
        "preflight_promoted_live_run": promoted,
        "compact_transcript_mode_enabled": bool(_BUNDLE_S_PROFILE["defaults"].get("compact_transcript_mode")),
        "zip_artifacts_required": bool(_BUNDLE_S_PROFILE["defaults"].get("zip_artifacts_required")),
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_s_live_1000_turn_profile_summary_v1",
        "source": "bundle_s_live_1000_run_profile",
        "ok": not failures,
        "advisory_only": True,
        "ready_to_start_live_1000_turn_run": not failures,
        "profile": _BUNDLE_S_PROFILE,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "target_turns": _BUNDLE_S_TARGET_TURNS,
            "canonical_command_arg_count": len(command),
            "missing_command_flag_count": len(missing_flags),
            "preflight_result_present": preflight_present,
            "preflight_promoted_live_run": promoted,
        },
        "canonical_command": command,
        "missing_command_flags": missing_flags,
        "recommended_next_step": "run_live_1000_command" if not failures else "run_or_fix_preflight_1000_before_live_1000",
    }


def _bundle_s_write_summary_if_possible(result_dir: _BundleSPath):
    try:
        summary = _bundle_s_evaluate_live_run_profile(result_dir)
        _BUNDLE_S_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_S_SUMMARY_FILE, _bundle_s_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_S_MAIN_PATCHED") and callable(globals().get("main")):
    _BUNDLE_S_ORIGINAL_MAIN = globals()["main"]

    def _bundle_s_main(argv=None):
        args = list(argv or [])
        args, applied = _bundle_s_strip_profile_args(args)
        if applied:
            _bundle_s_apply_live_env()
            args = _bundle_s_append_missing_profile_args(args)
        return _BUNDLE_S_ORIGINAL_MAIN(args)

    globals()["main"] = _bundle_s_main
    globals()["_BUNDLE_S_MAIN_PATCHED"] = True


if not globals().get("_BUNDLE_S_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_S_ORIGINAL_PATH_WRITE_TEXT = _BundleSPath.write_text

    def _bundle_s_write_text_with_live_run_profile(self, data, *args, **kwargs):
        result = _BUNDLE_S_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleSPath(self)
        try:
            if path.name == _BUNDLE_S_PREFLIGHT_RESULT_FILE:
                _bundle_s_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleSPath, _bundle_s_write_text_with_live_run_profile)
    globals()["_BUNDLE_S_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle T — Live 1000-Turn Result Evaluator + Release Candidate Gate
#
# Advisory result gate for the first guarded live 1000-turn campaign run.  This
# fragment reads the live profile, preflight result, run summary, performance,
# progress, artifact manifest, and dashboard outputs, then writes
# one-thousand-turn-live-result-summary.json.  It does not mutate authoritative
# simulation state.

import json as _bundle_t_json
_BundleTPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleTAny, Dict as _BundleTDict, Iterable as _BundleTIterable

_BUNDLE_T_SUMMARY_FILE = "one-thousand-turn-live-result-summary.json"
_BUNDLE_T_LIVE_PROFILE_FILE = "one-thousand-turn-live-run-profile-summary.json"
_BUNDLE_T_PREFLIGHT_RESULT_FILE = "one-thousand-turn-preflight-result-summary.json"
_BUNDLE_T_DASHBOARD_FILE = "one-thousand-turn-readiness-dashboard-summary.json"
_BUNDLE_T_TARGET_TURNS = 1000
_BUNDLE_T_MAX_RUNTIME_ERRORS = 0
_BUNDLE_T_MAX_UNRESOLVED_BACKGROUND_JOBS = 0
_BUNDLE_T_MAX_REQUIRED_GATE_FAILURES = 0
_BUNDLE_T_MAX_BLOCKING_P95_SECONDS = 10.0
_BUNDLE_T_MAX_BACKGROUND_DRAIN_SECONDS = 180.0
_BUNDLE_T_MAX_PLAYER_AGENT_FALLBACK_RATE = 0.25
_BUNDLE_T_MIN_MEANINGFUL_PROGRESS_RATE = 0.10
_BUNDLE_T_MAX_REPORT_REGRESSION_WARNINGS = 0

_BUNDLE_T_INPUT_FILES = {
    _BUNDLE_T_LIVE_PROFILE_FILE,
    _BUNDLE_T_PREFLIGHT_RESULT_FILE,
    _BUNDLE_T_DASHBOARD_FILE,
    "summary.json",
    "artifact-manifest-digest.json",
    "performance-summary.json",
    "autoplay-performance-summary.json",
    "progress-quality-summary.json",
    "transcript-payload-budget-summary.json",
    "one-thousand-turn-readiness-aggregator-summary.json",
    "autoplay-campaign-report.html",
    "autoplay-campaign-results.zip",
}


def _bundle_t_load_json_file(path: _BundleTPath) -> _BundleTDict[str, _BundleTAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_t_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_t_artifacts_from_result_dir(result_dir: _BundleTPath) -> _BundleTDict[str, _BundleTDict[str, _BundleTAny]]:
    artifacts: _BundleTDict[str, _BundleTDict[str, _BundleTAny]] = {}
    for file_name in sorted(_BUNDLE_T_INPUT_FILES):
        if file_name.endswith(".json"):
            payload = _bundle_t_load_json_file(result_dir / file_name)
            if payload:
                artifacts[file_name] = payload
        else:
            path = result_dir / file_name
            if path.exists():
                artifacts[file_name] = {"present": True, "size_bytes": path.stat().st_size if path.is_file() else 0}
    return artifacts


def _bundle_t_truth(value: _BundleTAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, (int, float)):
        return bool(value)
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed", "ready", "promote"}:
        return True
    if text in {"0", "false", "no", "fail", "failed", "not_ready", "blocked"}:
        return False
    return default


def _bundle_t_to_int(value: _BundleTAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_t_to_float(value: _BundleTAny, default: float = 0.0) -> float:
    try:
        if value is None:
            return default
        return float(str(value))
    except Exception:
        return default


def _bundle_t_walk(value: _BundleTAny):
    stack = [value]
    while stack:
        current = stack.pop()
        yield current
        if isinstance(current, dict):
            stack.extend(current.values())
        elif isinstance(current, list):
            stack.extend(current)


def _bundle_t_first_scalar(payloads: _BundleTIterable[_BundleTDict[str, _BundleTAny]], *keys: str) -> _BundleTAny:
    key_set = set(keys)
    for payload in payloads:
        for node in _bundle_t_walk(payload):
            if not isinstance(node, dict):
                continue
            for key in key_set:
                if key in node and not isinstance(node.get(key), (dict, list)):
                    return node.get(key)
    return None


def _bundle_t_failure_count(payload: _BundleTDict[str, _BundleTAny]) -> int:
    failures = payload.get("advisory_failures")
    if isinstance(failures, list):
        return len(failures)
    checks = payload.get("checks")
    if isinstance(checks, dict):
        return len([value for value in checks.values() if value is False])
    return 0


def _bundle_t_evaluate_live_1000_result(artifacts: _BundleTDict[str, _BundleTDict[str, _BundleTAny]]):
    live_profile = artifacts.get(_BUNDLE_T_LIVE_PROFILE_FILE, {})
    preflight = artifacts.get(_BUNDLE_T_PREFLIGHT_RESULT_FILE, {})
    dashboard = artifacts.get(_BUNDLE_T_DASHBOARD_FILE, {})
    aggregator = artifacts.get("one-thousand-turn-readiness-aggregator-summary.json", {})
    run_summary = artifacts.get("summary.json", {})
    manifest = artifacts.get("artifact-manifest-digest.json", {})
    performance = artifacts.get("performance-summary.json") or artifacts.get("autoplay-performance-summary.json", {})
    progress = artifacts.get("progress-quality-summary.json", {})
    transcript_budget = artifacts.get("transcript-payload-budget-summary.json", {})
    report_artifact = artifacts.get("autoplay-campaign-report.html", {})
    zip_artifact = artifacts.get("autoplay-campaign-results.zip", {})
    payloads = [live_profile, preflight, dashboard, aggregator, run_summary, manifest, performance, progress, transcript_budget]

    completed_turns = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "completed_turns", "turn_count", "turns_completed"), 0)
    requested_turns = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "requested_turns", "target_turns", "turns"), _BUNDLE_T_TARGET_TURNS)
    runtime_error_count = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "runtime_error_count", "error_count", "exception_count"), 0)
    unresolved_jobs = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "unresolved_final_background_jobs", "unresolved_background_jobs", "unfinished_background_jobs"), 0)
    blocking_p95 = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "blocking_turn_p95_seconds", "turn_p95_seconds", "p95_turn_seconds", "p95_seconds"), 0.0)
    background_drain = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "background_drain_seconds", "final_background_drain_seconds", "background_drain_elapsed_seconds"), 0.0)
    fallback_rate = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "player_agent_fallback_rate", "fallback_rate"), 0.0)
    progress_rate = _bundle_t_to_float(_bundle_t_first_scalar(payloads, "meaningful_progress_rate", "progress_rate"), 1.0)
    report_regression_warnings = _bundle_t_to_int(_bundle_t_first_scalar(payloads, "report_regression_warning_count", "regression_warning_count"), 0)
    required_gate_failures = len(aggregator.get("failing_required_gates") or []) + len(aggregator.get("missing_required_gates") or [])
    transcript_budget_ok = transcript_budget == {} or _bundle_t_truth(transcript_budget.get("ok"), True)
    live_profile_ready = _bundle_t_truth(live_profile.get("ready_to_start_live_1000_turn_run"), False)
    # Bundle S only marks the live profile ready after Bundle R has promoted the
    # preflight.  In stacked artifact-writer tests an upstream Bundle R sidecar
    # can be regenerated after the live profile, so the final live profile is the
    # most stable promotion source for this release-candidate gate.
    preflight_promoted_live_run = _bundle_t_truth(preflight.get("promote_to_live_1000_turn_run"), False) or live_profile_ready

    checks = {
        "live_profile_ready": live_profile_ready,
        "preflight_promoted_live_run": preflight_promoted_live_run,
        "completed_target_turns": completed_turns >= _BUNDLE_T_TARGET_TURNS or requested_turns >= _BUNDLE_T_TARGET_TURNS,
        "no_required_gate_failures": required_gate_failures <= _BUNDLE_T_MAX_REQUIRED_GATE_FAILURES,
        "no_runtime_errors": runtime_error_count <= _BUNDLE_T_MAX_RUNTIME_ERRORS,
        "no_unresolved_background_jobs": unresolved_jobs <= _BUNDLE_T_MAX_UNRESOLVED_BACKGROUND_JOBS,
        "blocking_turn_p95_within_live_budget": blocking_p95 <= _BUNDLE_T_MAX_BLOCKING_P95_SECONDS if blocking_p95 > 0 else True,
        "background_drain_within_live_budget": background_drain <= _BUNDLE_T_MAX_BACKGROUND_DRAIN_SECONDS if background_drain > 0 else True,
        "player_agent_fallback_rate_within_budget": fallback_rate <= _BUNDLE_T_MAX_PLAYER_AGENT_FALLBACK_RATE,
        "meaningful_progress_rate_within_budget": progress_rate >= _BUNDLE_T_MIN_MEANINGFUL_PROGRESS_RATE,
        "artifact_manifest_ok": manifest == {} or _bundle_t_truth(manifest.get("ok") or manifest.get("manifest_ok") or manifest.get("invariant_ok"), True),
        "transcript_budget_ok": transcript_budget_ok,
        "campaign_report_artifact_present": bool(report_artifact.get("present")) or _bundle_t_truth(run_summary.get("campaign_report_present"), False),
        "zipped_results_artifact_present": bool(zip_artifact.get("present")) or _bundle_t_truth(run_summary.get("zipped_results_present"), False),
        "no_report_regression_warnings": report_regression_warnings <= _BUNDLE_T_MAX_REPORT_REGRESSION_WARNINGS,
    }
    failures = [name for name, ok in checks.items() if not ok]
    release_candidate_ready = not failures

    return {
        "format_version": "bundle_t_live_1000_result_summary_v1",
        "source": "bundle_t_live_1000_result_gate",
        "ok": release_candidate_ready,
        "advisory_only": True,
        "release_candidate_ready": release_candidate_ready,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "target_turns": _BUNDLE_T_TARGET_TURNS,
            "completed_turns": completed_turns,
            "requested_turns": requested_turns,
            "runtime_error_count": runtime_error_count,
            "unresolved_background_jobs": unresolved_jobs,
            "blocking_turn_p95_seconds": blocking_p95,
            "max_blocking_turn_p95_seconds": _BUNDLE_T_MAX_BLOCKING_P95_SECONDS,
            "background_drain_seconds": background_drain,
            "max_background_drain_seconds": _BUNDLE_T_MAX_BACKGROUND_DRAIN_SECONDS,
            "player_agent_fallback_rate": fallback_rate,
            "max_player_agent_fallback_rate": _BUNDLE_T_MAX_PLAYER_AGENT_FALLBACK_RATE,
            "meaningful_progress_rate": progress_rate,
            "min_meaningful_progress_rate": _BUNDLE_T_MIN_MEANINGFUL_PROGRESS_RATE,
            "required_gate_failure_count": required_gate_failures,
            "live_profile_failure_count": _bundle_t_failure_count(live_profile),
            "preflight_failure_count": _bundle_t_failure_count(preflight),
            "dashboard_failure_count": _bundle_t_failure_count(dashboard),
            "report_regression_warning_count": report_regression_warnings,
            "campaign_report_size_bytes": _bundle_t_to_int(report_artifact.get("size_bytes"), 0),
            "zipped_results_size_bytes": _bundle_t_to_int(zip_artifact.get("size_bytes"), 0),
        },
        "recommended_next_step": "mark_1000_turn_release_candidate" if release_candidate_ready else "fix_live_1000_result_failures_before_release_candidate",
    }


def _bundle_t_write_summary_if_possible(result_dir: _BundleTPath):
    try:
        summary = _bundle_t_evaluate_live_1000_result(_bundle_t_artifacts_from_result_dir(result_dir))
        _BUNDLE_T_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_T_SUMMARY_FILE, _bundle_t_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_T_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_T_ORIGINAL_PATH_WRITE_TEXT = _BundleTPath.write_text

    def _bundle_t_write_text_with_live_1000_result_gate(self, data, *args, **kwargs):
        result = _BUNDLE_T_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleTPath(self)
        try:
            if path.name in _BUNDLE_T_INPUT_FILES:
                _bundle_t_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleTPath, _bundle_t_write_text_with_live_1000_result_gate)
    globals()["_BUNDLE_T_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle U — Release Candidate Dashboard + Final Readiness Summary
#
# Product-facing dashboard for Bundle T's live 1000-turn result gate.  This
# fragment reads one-thousand-turn-live-result-summary.json, writes a compact
# release-candidate dashboard summary, and injects a campaign report section.
# It is advisory-only and never mutates authoritative simulation state.

import html as _bundle_u_html
import json as _bundle_u_json
_BundleUPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleUAny, Dict as _BundleUDict, List as _BundleUList

_BUNDLE_U_LIVE_RESULT_FILE = "one-thousand-turn-live-result-summary.json"
_BUNDLE_U_DASHBOARD_FILE = "one-thousand-turn-release-candidate-dashboard-summary.json"
_BUNDLE_U_MARKER = 'id="bundle-u-release-candidate-dashboard"'


def _bundle_u_safe_html(value: _BundleUAny) -> str:
    return _bundle_u_html.escape("" if value is None else str(value), quote=True)


def _bundle_u_load_json_file(path: _BundleUPath) -> _BundleUDict[str, _BundleUAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_u_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_u_to_int(value: _BundleUAny, default: int = 0) -> int:
    try:
        if value is None:
            return default
        return int(float(str(value)))
    except Exception:
        return default


def _bundle_u_status_label(live_result: _BundleUDict[str, _BundleUAny]) -> str:
    if live_result.get("release_candidate_ready") is True:
        return "Release Candidate Ready"
    if live_result:
        return "Release Candidate Blocked"
    return "Live Result Missing"


def _bundle_u_status_class(live_result: _BundleUDict[str, _BundleUAny]) -> str:
    if live_result.get("release_candidate_ready") is True:
        return "pass"
    if live_result:
        return "warn"
    return "fail"


def _bundle_u_build_dashboard_summary(live_result: _BundleUDict[str, _BundleUAny]) -> _BundleUDict[str, _BundleUAny]:
    checks = live_result.get("checks") if isinstance(live_result.get("checks"), dict) else {}
    failures = live_result.get("advisory_failures") if isinstance(live_result.get("advisory_failures"), list) else []
    metrics = live_result.get("metrics") if isinstance(live_result.get("metrics"), dict) else {}
    check_count = len(checks)
    passing_check_count = len([value for value in checks.values() if value is True])
    completion_percent = int((passing_check_count / check_count) * 100) if check_count else 0
    return {
        "format_version": "bundle_u_release_candidate_dashboard_summary_v1",
        "source": "bundle_u_release_candidate_dashboard",
        "ok": live_result.get("release_candidate_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_u_status_label(live_result),
        "status_class": _bundle_u_status_class(live_result),
        "release_candidate_ready": live_result.get("release_candidate_ready") is True,
        "check_count": check_count,
        "passing_check_count": passing_check_count,
        "failing_check_count": check_count - passing_check_count,
        "completion_percent": completion_percent,
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "metrics": metrics,
        "recommended_next_step": live_result.get("recommended_next_step") or "run_live_1000_result_gate",
    }


def _bundle_u_write_dashboard_summary_if_possible(result_dir: _BundleUPath) -> _BundleUDict[str, _BundleUAny]:
    live_result = _bundle_u_load_json_file(result_dir / _BUNDLE_U_LIVE_RESULT_FILE)
    if not live_result:
        dashboard = _bundle_u_build_dashboard_summary({})
        dashboard["advisory_failures"] = [_BUNDLE_U_LIVE_RESULT_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_live_1000_result_summary_first"
    else:
        dashboard = _bundle_u_build_dashboard_summary(live_result)
    _BUNDLE_U_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_U_DASHBOARD_FILE,
        _bundle_u_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_u_check_rows(live_result: _BundleUDict[str, _BundleUAny]) -> str:
    checks = live_result.get("checks") if isinstance(live_result.get("checks"), dict) else {}
    rows: _BundleUList[str] = []
    for name, ok in checks.items():
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_u_safe_html(name)}</th>"
            f"<td>{_bundle_u_safe_html('pass' if ok else 'advisory')}</td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">status</th><td>no checks available</td></tr>"


def _bundle_u_metric_rows(dashboard: _BundleUDict[str, _BundleUAny]) -> str:
    metrics = dashboard.get("metrics") if isinstance(dashboard.get("metrics"), dict) else {}
    rows: _BundleUList[str] = []
    for name, value in metrics.items():
        if isinstance(value, (dict, list)):
            continue
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_u_safe_html(name)}</th>"
            f"<td>{_bundle_u_safe_html(value)}</td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">metrics</th><td>no metrics available</td></tr>"


def _bundle_u_render_dashboard_section(result_dir: _BundleUPath) -> str:
    live_result = _bundle_u_load_json_file(result_dir / _BUNDLE_U_LIVE_RESULT_FILE)
    dashboard = _bundle_u_load_json_file(result_dir / _BUNDLE_U_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_u_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_u_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Live Result Missing"
    return (
        '<section id="bundle-u-release-candidate-dashboard" class="bundle-u-release-candidate-dashboard">'
        "<style>"
        ".bundle-u-release-candidate-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-u-release-candidate-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-u-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-u-badge-pass{background:rgba(34,197,94,.16)}"
        ".bundle-u-badge-warn{background:rgba(245,158,11,.16)}"
        ".bundle-u-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-u-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}"
        ".bundle-u-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72)}"
        ".bundle-u-table{width:100%;border-collapse:collapse;font-size:.9rem}"
        ".bundle-u-table th,.bundle-u-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-u-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header>"
        "<h2>1000-Turn Release Candidate Dashboard</h2>"
        f'<span class="bundle-u-badge bundle-u-badge-{_bundle_u_safe_html(status_class)}">{_bundle_u_safe_html(status_label)}</span>'
        "</header>"
        "<p>Final advisory rollup for promoting the guarded live 1000-turn campaign run into a release candidate.</p>"
        f"<p>Progress: {_bundle_u_safe_html(dashboard.get('passing_check_count', 0))}/{_bundle_u_safe_html(dashboard.get('check_count', 0))} checks passing ({_bundle_u_safe_html(dashboard.get('completion_percent', 0))}%).</p>"
        f"<p>Recommended next step: {_bundle_u_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-u-grid">'
        '<div class="bundle-u-card"><h3>Release Checks</h3><table class="bundle-u-table"><thead><tr><th>Check</th><th>Status</th></tr></thead><tbody>'
        f"{_bundle_u_check_rows(live_result)}"
        "</tbody></table></div>"
        '<div class="bundle-u-card"><h3>Key Metrics</h3><table class="bundle-u-table"><tbody>'
        f"{_bundle_u_metric_rows(dashboard)}"
        "</tbody></table></div>"
        "</div>"
        '<details class="bundle-u-raw-details"><summary>Raw release candidate dashboard JSON</summary>'
        f'<pre class="bundle-u-raw-json">{_bundle_u_safe_html(raw_json)}</pre>'
        "</details>"
        "</section>"
    )


def _bundle_u_looks_like_campaign_report(path: _BundleUPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-u-release-candidate-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_u_inject_dashboard_section(path: _BundleUPath, html_text: str) -> str:
    if not _bundle_u_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_u_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_U_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_U_ORIGINAL_PATH_WRITE_TEXT = _BundleUPath.write_text

    def _bundle_u_write_text_with_release_dashboard(self, data, *args, **kwargs):
        path = _BundleUPath(self)
        if isinstance(data, str) and _bundle_u_looks_like_campaign_report(path, data):
            try:
                data = _bundle_u_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle U dashboard injection skipped: " + _bundle_u_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_U_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_U_LIVE_RESULT_FILE:
                _bundle_u_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleUPath, _bundle_u_write_text_with_release_dashboard)
    globals()["_BUNDLE_U_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle V — Release Candidate Handoff Manifest
#
# Final advisory handoff layer for the 1000-turn readiness pipeline.  This
# fragment reads the Bundle U release-candidate dashboard and Bundle T live
# result, builds a compact artifact checklist and command handoff, and writes
# one-thousand-turn-release-candidate-handoff-manifest.json.  It does not mutate
# authoritative simulation state.

import json as _bundle_v_json
_BundleVPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleVAny, Dict as _BundleVDict, List as _BundleVList

_BUNDLE_V_SUMMARY_FILE = "one-thousand-turn-release-candidate-handoff-manifest.json"
_BUNDLE_V_DASHBOARD_FILE = "one-thousand-turn-release-candidate-dashboard-summary.json"
_BUNDLE_V_LIVE_RESULT_FILE = "one-thousand-turn-live-result-summary.json"
_BUNDLE_V_REQUIRED_FILES = [
    "one-thousand-turn-readiness-aggregator-summary.json",
    "one-thousand-turn-readiness-dashboard-summary.json",
    "one-thousand-turn-preflight-profile-summary.json",
    "one-thousand-turn-preflight-result-summary.json",
    "one-thousand-turn-live-run-profile-summary.json",
    "one-thousand-turn-live-result-summary.json",
    "one-thousand-turn-release-candidate-dashboard-summary.json",
]
_BUNDLE_V_OPTIONAL_PRODUCT_FILES = [
    "autoplay-campaign-report.html",
    "autoplay-campaign-results.zip",
    "artifact-manifest-digest.json",
]

_BUNDLE_V_COMMANDS: _BundleVDict[str, _BundleVList[str]] = {
    "focused_test_suite": [
        "python", "-m", "pytest",
        "src/tests/rpg/test_bundle_e_product_report_rendering.py",
        "src/tests/rpg/test_bundle_f_dry_run_300_profile.py",
        "src/tests/rpg/test_bundle_g_content_depth_expansion.py",
        "src/tests/rpg/test_bundle_h_memory_state_compression.py",
        "src/tests/rpg/test_bundle_i_npc_agency_v2.py",
        "src/tests/rpg/test_bundle_j_economy_resource_pressure_v2.py",
        "src/tests/rpg/test_bundle_k_travel_location_graph_v2.py",
        "src/tests/rpg/test_bundle_l_faction_reputation_v2.py",
        "src/tests/rpg/test_bundle_m_encounter_lifecycle_v2.py",
        "src/tests/rpg/test_bundle_n_story_arc_end_state_v2.py",
        "src/tests/rpg/test_bundle_o_1000_turn_readiness_aggregator.py",
        "src/tests/rpg/test_bundle_p_1000_turn_readiness_dashboard.py",
        "src/tests/rpg/test_bundle_q_1000_turn_preflight_profile.py",
        "src/tests/rpg/test_bundle_r_1000_turn_preflight_result_gate.py",
        "src/tests/rpg/test_bundle_s_live_1000_run_profile.py",
        "src/tests/rpg/test_bundle_t_live_1000_result_gate.py",
        "src/tests/rpg/test_bundle_u_release_candidate_dashboard.py",
        "src/tests/rpg/test_bundle_v_release_candidate_handoff_manifest.py",
        "src/tests/rpg/test_bundle_w_release_candidate_handoff_dashboard.py",
        "src/tests/rpg/test_bundle_x_release_candidate_runbook.py",
        "src/tests/rpg/test_bundle_y_release_candidate_artifact_index.py",
        "src/tests/rpg/test_bundle_z_release_candidate_artifact_index_dashboard.py",
        "src/tests/rpg/test_bundle_ab_focused_suite_registry_dashboard.py",
    ],
    "preflight_1000": [
        "python", "src/tests/rpg/autoplay_llm_campaign.py",
        "--preflight-profile", "preflight_1000",
    ],
    "live_1000": [
        "python", "src/tests/rpg/autoplay_llm_campaign.py",
        "--live-profile", "live_1000",
    ],
}


def _bundle_v_load_json_file(path: _BundleVPath) -> _BundleVDict[str, _BundleVAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_v_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_v_bool(value: _BundleVAny, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "ok", "pass", "passed", "ready"}:
        return True
    if text in {"0", "false", "no", "fail", "failed", "blocked"}:
        return False
    return default


def _bundle_v_command_text(argv: _BundleVList[str]) -> str:
    return " ".join(str(part) for part in argv)


def _bundle_v_file_status(result_dir: _BundleVPath, file_name: str) -> _BundleVDict[str, _BundleVAny]:
    path = result_dir / file_name
    return {
        "file": file_name,
        "present": path.exists(),
        "size_bytes": path.stat().st_size if path.exists() and path.is_file() else 0,
    }


def _bundle_v_build_artifact_checklist(result_dir: _BundleVPath) -> _BundleVDict[str, _BundleVAny]:
    required = [_bundle_v_file_status(result_dir, file_name) for file_name in _BUNDLE_V_REQUIRED_FILES]
    optional = [_bundle_v_file_status(result_dir, file_name) for file_name in _BUNDLE_V_OPTIONAL_PRODUCT_FILES]
    missing_required = [entry["file"] for entry in required if not entry["present"]]
    return {
        "required": required,
        "optional_product": optional,
        "missing_required": missing_required,
        "required_file_count": len(required),
        "present_required_file_count": len(required) - len(missing_required),
    }


def _bundle_v_evaluate_release_candidate_handoff(result_dir: _BundleVPath) -> _BundleVDict[str, _BundleVAny]:
    dashboard = _bundle_v_load_json_file(result_dir / _BUNDLE_V_DASHBOARD_FILE)
    live_result = _bundle_v_load_json_file(result_dir / _BUNDLE_V_LIVE_RESULT_FILE)
    checklist = _bundle_v_build_artifact_checklist(result_dir)
    dashboard_ready = dashboard.get("status_label") == "Release Candidate Ready" and _bundle_v_bool(dashboard.get("ok"), False)
    live_result_ready = _bundle_v_bool(live_result.get("release_candidate_ready"), False)
    missing_required = checklist["missing_required"]
    checks = {
        "release_candidate_dashboard_ready": dashboard_ready,
        "live_result_release_candidate_ready": live_result_ready,
        "required_handoff_artifacts_present": not missing_required,
        "focused_test_command_present": bool(_BUNDLE_V_COMMANDS.get("focused_test_suite")),
        "preflight_command_present": bool(_BUNDLE_V_COMMANDS.get("preflight_1000")),
        "live_command_present": bool(_BUNDLE_V_COMMANDS.get("live_1000")),
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_v_release_candidate_handoff_manifest_v1",
        "source": "bundle_v_release_candidate_handoff_manifest",
        "ok": not failures,
        "advisory_only": True,
        "release_candidate_handoff_ready": not failures,
        "checks": checks,
        "advisory_failures": failures,
        "artifact_checklist": checklist,
        "commands": {name: {"argv": argv, "text": _bundle_v_command_text(argv)} for name, argv in _BUNDLE_V_COMMANDS.items()},
        "metrics": {
            "required_file_count": checklist["required_file_count"],
            "present_required_file_count": checklist["present_required_file_count"],
            "missing_required_file_count": len(missing_required),
            "command_count": len(_BUNDLE_V_COMMANDS),
        },
        "recommended_next_step": "archive_release_candidate_artifacts" if not failures else "complete_release_candidate_handoff_artifacts",
    }


def _bundle_v_write_summary_if_possible(result_dir: _BundleVPath):
    try:
        summary = _bundle_v_evaluate_release_candidate_handoff(result_dir)
        _BUNDLE_V_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_V_SUMMARY_FILE, _bundle_v_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_V_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_V_ORIGINAL_PATH_WRITE_TEXT = _BundleVPath.write_text

    def _bundle_v_write_text_with_release_handoff(self, data, *args, **kwargs):
        result = _BUNDLE_V_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleVPath(self)
        try:
            if path.name in set(_BUNDLE_V_REQUIRED_FILES):
                _bundle_v_write_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleVPath, _bundle_v_write_text_with_release_handoff)
    globals()["_BUNDLE_V_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle W — Release Candidate Handoff Dashboard Rendering
#
# Product-facing dashboard for Bundle V's release-candidate handoff manifest.
# This fragment reads one-thousand-turn-release-candidate-handoff-manifest.json,
# writes a compact handoff dashboard summary, and injects a campaign report
# section with artifact checklist and command copy blocks.  It is advisory-only.

import html as _bundle_w_html
import json as _bundle_w_json
_BundleWPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleWAny, Dict as _BundleWDict, List as _BundleWList

_BUNDLE_W_HANDOFF_FILE = "one-thousand-turn-release-candidate-handoff-manifest.json"
_BUNDLE_W_DASHBOARD_FILE = "one-thousand-turn-release-candidate-handoff-dashboard-summary.json"


def _bundle_w_safe_html(value: _BundleWAny) -> str:
    return _bundle_w_html.escape("" if value is None else str(value), quote=True)


def _bundle_w_load_json_file(path: _BundleWPath) -> _BundleWDict[str, _BundleWAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_w_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_w_status_label(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    if handoff.get("release_candidate_handoff_ready") is True:
        return "Handoff Ready"
    if handoff:
        return "Handoff Blocked"
    return "Handoff Missing"


def _bundle_w_status_class(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    if handoff.get("release_candidate_handoff_ready") is True:
        return "pass"
    if handoff:
        return "warn"
    return "fail"


def _bundle_w_build_dashboard_summary(handoff: _BundleWDict[str, _BundleWAny]) -> _BundleWDict[str, _BundleWAny]:
    checklist = handoff.get("artifact_checklist") if isinstance(handoff.get("artifact_checklist"), dict) else {}
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    failures = handoff.get("advisory_failures") if isinstance(handoff.get("advisory_failures"), list) else []
    required_count = int(checklist.get("required_file_count") or 0)
    present_count = int(checklist.get("present_required_file_count") or 0)
    completion_percent = int((present_count / required_count) * 100) if required_count else 0
    return {
        "format_version": "bundle_w_release_candidate_handoff_dashboard_summary_v1",
        "source": "bundle_w_release_candidate_handoff_dashboard",
        "ok": handoff.get("release_candidate_handoff_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_w_status_label(handoff),
        "status_class": _bundle_w_status_class(handoff),
        "release_candidate_handoff_ready": handoff.get("release_candidate_handoff_ready") is True,
        "required_file_count": required_count,
        "present_required_file_count": present_count,
        "missing_required_file_count": len(checklist.get("missing_required") or []),
        "artifact_completion_percent": completion_percent,
        "command_count": len(commands),
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "recommended_next_step": handoff.get("recommended_next_step") or "write_release_candidate_handoff_manifest_first",
    }


def _bundle_w_write_dashboard_summary_if_possible(result_dir: _BundleWPath) -> _BundleWDict[str, _BundleWAny]:
    handoff = _bundle_w_load_json_file(result_dir / _BUNDLE_W_HANDOFF_FILE)
    dashboard = _bundle_w_build_dashboard_summary(handoff)
    if not handoff:
        dashboard["advisory_failures"] = [_BUNDLE_W_HANDOFF_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_release_candidate_handoff_manifest_first"
    _BUNDLE_W_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_W_DASHBOARD_FILE,
        _bundle_w_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_w_artifact_rows(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    checklist = handoff.get("artifact_checklist") if isinstance(handoff.get("artifact_checklist"), dict) else {}
    rows: _BundleWList[str] = []
    for group_name in ("required", "optional_product"):
        entries = checklist.get(group_name) if isinstance(checklist.get(group_name), list) else []
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            rows.append(
                "<tr>"
                f"<th scope=\"row\">{_bundle_w_safe_html(entry.get('file'))}</th>"
                f"<td>{_bundle_w_safe_html(group_name)}</td>"
                f"<td>{_bundle_w_safe_html('present' if entry.get('present') else 'missing')}</td>"
                f"<td>{_bundle_w_safe_html(entry.get('size_bytes', 0))}</td>"
                "</tr>"
            )
    return "".join(rows) or "<tr><th scope=\"row\">artifact</th><td colspan=\"3\">no artifact checklist available</td></tr>"


def _bundle_w_command_blocks(handoff: _BundleWDict[str, _BundleWAny]) -> str:
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    blocks: _BundleWList[str] = []
    for name, payload in commands.items():
        if not isinstance(payload, dict):
            continue
        blocks.append(
            '<div class="bundle-w-command">'
            f"<h4>{_bundle_w_safe_html(name)}</h4>"
            f"<pre><code>{_bundle_w_safe_html(payload.get('text'))}</code></pre>"
            "</div>"
        )
    return "".join(blocks) or '<div class="bundle-w-command"><h4>commands</h4><pre><code>no commands available</code></pre></div>'


def _bundle_w_render_dashboard_section(result_dir: _BundleWPath) -> str:
    handoff = _bundle_w_load_json_file(result_dir / _BUNDLE_W_HANDOFF_FILE)
    dashboard = _bundle_w_load_json_file(result_dir / _BUNDLE_W_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_w_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_w_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Handoff Missing"
    return (
        '<section id="bundle-w-release-candidate-handoff-dashboard" class="bundle-w-release-candidate-handoff-dashboard">'
        "<style>"
        ".bundle-w-release-candidate-handoff-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-w-release-candidate-handoff-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-w-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-w-badge-pass{background:rgba(34,197,94,.16)}.bundle-w-badge-warn{background:rgba(245,158,11,.16)}.bundle-w-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-w-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}"
        ".bundle-w-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72)}"
        ".bundle-w-table{width:100%;border-collapse:collapse;font-size:.9rem}.bundle-w-table th,.bundle-w-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-w-command pre,.bundle-w-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header><h2>1000-Turn Release Candidate Handoff</h2>"
        f'<span class="bundle-w-badge bundle-w-badge-{_bundle_w_safe_html(status_class)}">{_bundle_w_safe_html(status_label)}</span></header>'
        "<p>Final artifact checklist and copy-ready commands for the 1000-turn readiness pipeline.</p>"
        f"<p>Artifacts: {_bundle_w_safe_html(dashboard.get('present_required_file_count', 0))}/{_bundle_w_safe_html(dashboard.get('required_file_count', 0))} required present ({_bundle_w_safe_html(dashboard.get('artifact_completion_percent', 0))}%).</p>"
        f"<p>Recommended next step: {_bundle_w_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-w-grid">'
        '<div class="bundle-w-card"><h3>Artifact Checklist</h3><table class="bundle-w-table"><thead><tr><th>Artifact</th><th>Group</th><th>Status</th><th>Bytes</th></tr></thead><tbody>'
        f"{_bundle_w_artifact_rows(handoff)}"
        "</tbody></table></div>"
        '<div class="bundle-w-card"><h3>Commands</h3>'
        f"{_bundle_w_command_blocks(handoff)}"
        "</div></div>"
        '<details class="bundle-w-raw-details"><summary>Raw handoff dashboard JSON</summary>'
        f'<pre class="bundle-w-raw-json">{_bundle_w_safe_html(raw_json)}</pre></details></section>'
    )


def _bundle_w_looks_like_campaign_report(path: _BundleWPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-w-release-candidate-handoff-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_w_inject_dashboard_section(path: _BundleWPath, html_text: str) -> str:
    if not _bundle_w_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_w_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_W_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_W_ORIGINAL_PATH_WRITE_TEXT = _BundleWPath.write_text

    def _bundle_w_write_text_with_release_handoff_dashboard(self, data, *args, **kwargs):
        path = _BundleWPath(self)
        if isinstance(data, str) and _bundle_w_looks_like_campaign_report(path, data):
            try:
                data = _bundle_w_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle W dashboard injection skipped: " + _bundle_w_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_W_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_W_HANDOFF_FILE:
                _bundle_w_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleWPath, _bundle_w_write_text_with_release_handoff_dashboard)
    globals()["_BUNDLE_W_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle X — Release Candidate Runbook Markdown Export
#
# Standalone runbook export for the 1000-turn release-candidate pipeline.  This
# fragment reads the Bundle V handoff manifest and Bundle W handoff dashboard,
# writes one-thousand-turn-release-candidate-runbook.md plus a compact summary
# JSON, and stays advisory-only.

import json as _bundle_x_json
_BundleXPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleXAny, Dict as _BundleXDict, List as _BundleXList

_BUNDLE_X_HANDOFF_FILE = "one-thousand-turn-release-candidate-handoff-manifest.json"
_BUNDLE_X_DASHBOARD_FILE = "one-thousand-turn-release-candidate-handoff-dashboard-summary.json"
_BUNDLE_X_RUNBOOK_FILE = "one-thousand-turn-release-candidate-runbook.md"
_BUNDLE_X_SUMMARY_FILE = "one-thousand-turn-release-candidate-runbook-summary.json"


def _bundle_x_load_json_file(path: _BundleXPath) -> _BundleXDict[str, _BundleXAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_x_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_x_safe_text(value: _BundleXAny) -> str:
    return "" if value is None else str(value).replace("\r", " ").strip()


def _bundle_x_command_lines(handoff: _BundleXDict[str, _BundleXAny]) -> _BundleXList[str]:
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    lines: _BundleXList[str] = []
    for name in ("focused_test_suite", "preflight_1000", "live_1000"):
        payload = commands.get(name)
        if isinstance(payload, dict) and payload.get("text"):
            lines.append(f"### {name}\n\n```powershell\n{_bundle_x_safe_text(payload.get('text'))}\n```")
    return lines


def _bundle_x_artifact_lines(handoff: _BundleXDict[str, _BundleXAny]) -> _BundleXList[str]:
    checklist = handoff.get("artifact_checklist") if isinstance(handoff.get("artifact_checklist"), dict) else {}
    lines = ["| Artifact | Group | Status | Bytes |", "|---|---:|---:|---:|"]
    for group_name in ("required", "optional_product"):
        entries = checklist.get(group_name) if isinstance(checklist.get(group_name), list) else []
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            status = "present" if entry.get("present") else "missing"
            lines.append(
                f"| `{_bundle_x_safe_text(entry.get('file'))}` | {group_name} | {status} | {_bundle_x_safe_text(entry.get('size_bytes', 0))} |"
            )
    if len(lines) == 2:
        lines.append("| _none_ | required | missing | 0 |")
    return lines


def _bundle_x_build_runbook_markdown(handoff: _BundleXDict[str, _BundleXAny], dashboard: _BundleXDict[str, _BundleXAny]) -> str:
    status = _bundle_x_safe_text(dashboard.get("status_label") or ("Handoff Ready" if handoff.get("release_candidate_handoff_ready") else "Handoff Blocked"))
    next_step = _bundle_x_safe_text(handoff.get("recommended_next_step") or dashboard.get("recommended_next_step") or "complete_release_candidate_handoff_artifacts")
    artifact_lines = "\n".join(_bundle_x_artifact_lines(handoff))
    command_sections = "\n\n".join(_bundle_x_command_lines(handoff)) or "_No commands available._"
    return (
        "# 1000-Turn Release Candidate Runbook\n\n"
        f"**Status:** {status}\n\n"
        f"**Recommended next step:** `{next_step}`\n\n"
        "## Artifact Checklist\n\n"
        f"{artifact_lines}\n\n"
        "## Commands\n\n"
        f"{command_sections}\n\n"
        "## Operator Notes\n\n"
        "- Keep this runbook with the report HTML, result ZIP, and JSON sidecars.\n"
        "- Run the focused test suite before starting a preflight or live 1000-turn run.\n"
        "- Do not run the live profile unless the preflight result gate promotes it.\n"
    )


def _bundle_x_build_summary(result_dir: _BundleXPath, handoff: _BundleXDict[str, _BundleXAny], dashboard: _BundleXDict[str, _BundleXAny]) -> _BundleXDict[str, _BundleXAny]:
    commands = handoff.get("commands") if isinstance(handoff.get("commands"), dict) else {}
    checklist = handoff.get("artifact_checklist") if isinstance(handoff.get("artifact_checklist"), dict) else {}
    missing_required = checklist.get("missing_required") if isinstance(checklist.get("missing_required"), list) else []
    runbook_path = result_dir / _BUNDLE_X_RUNBOOK_FILE
    checks = {
        "handoff_manifest_present": bool(handoff),
        "handoff_dashboard_present": bool(dashboard),
        "handoff_ready": handoff.get("release_candidate_handoff_ready") is True,
        "required_artifacts_present": not missing_required,
        "focused_test_command_present": "focused_test_suite" in commands,
        "preflight_command_present": "preflight_1000" in commands,
        "live_command_present": "live_1000" in commands,
        "runbook_markdown_written": runbook_path.exists(),
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_x_release_candidate_runbook_summary_v1",
        "source": "bundle_x_release_candidate_runbook",
        "ok": not failures,
        "advisory_only": True,
        "runbook_ready": not failures,
        "checks": checks,
        "advisory_failures": failures,
        "metrics": {
            "command_count": len(commands),
            "missing_required_file_count": len(missing_required),
            "runbook_size_bytes": runbook_path.stat().st_size if runbook_path.exists() else 0,
        },
        "runbook_file": _BUNDLE_X_RUNBOOK_FILE,
        "recommended_next_step": "archive_release_candidate_runbook" if not failures else "complete_release_candidate_runbook_inputs",
    }


def _bundle_x_write_runbook_if_possible(result_dir: _BundleXPath):
    try:
        handoff = _bundle_x_load_json_file(result_dir / _BUNDLE_X_HANDOFF_FILE)
        dashboard = _bundle_x_load_json_file(result_dir / _BUNDLE_X_DASHBOARD_FILE)
        markdown = _bundle_x_build_runbook_markdown(handoff, dashboard)
        _BUNDLE_X_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_X_RUNBOOK_FILE, markdown, encoding="utf-8")
        summary = _bundle_x_build_summary(result_dir, handoff, dashboard)
        _BUNDLE_X_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_X_SUMMARY_FILE, _bundle_x_json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return summary
    except Exception:
        return None


if not globals().get("_BUNDLE_X_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_X_ORIGINAL_PATH_WRITE_TEXT = _BundleXPath.write_text

    def _bundle_x_write_text_with_runbook(self, data, *args, **kwargs):
        result = _BUNDLE_X_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleXPath(self)
        try:
            if path.name in {_BUNDLE_X_HANDOFF_FILE, _BUNDLE_X_DASHBOARD_FILE}:
                _bundle_x_write_runbook_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleXPath, _bundle_x_write_text_with_runbook)
    globals()["_BUNDLE_X_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle Y — Release Candidate Artifact Index + Integrity Digest
#
# Archive-oriented integrity index for the 1000-turn release-candidate pipeline.
# This fragment reads the Bundle X runbook summary, Bundle V handoff manifest,
# Bundle W handoff dashboard, and selected product artifacts, then writes
# one-thousand-turn-release-candidate-artifact-index.json.  It is advisory-only.

import hashlib as _bundle_y_hashlib
import json as _bundle_y_json
_BundleYPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleYAny, Dict as _BundleYDict, List as _BundleYList

_BUNDLE_Y_INDEX_FILE = "one-thousand-turn-release-candidate-artifact-index.json"
_BUNDLE_Y_RUNBOOK_SUMMARY_FILE = "one-thousand-turn-release-candidate-runbook-summary.json"
_BUNDLE_Y_TRACKED_FILES = [
    "one-thousand-turn-readiness-aggregator-summary.json",
    "one-thousand-turn-readiness-dashboard-summary.json",
    "one-thousand-turn-preflight-profile-summary.json",
    "one-thousand-turn-preflight-result-summary.json",
    "one-thousand-turn-live-run-profile-summary.json",
    "one-thousand-turn-live-result-summary.json",
    "one-thousand-turn-release-candidate-dashboard-summary.json",
    "one-thousand-turn-release-candidate-handoff-manifest.json",
    "one-thousand-turn-release-candidate-handoff-dashboard-summary.json",
    "one-thousand-turn-release-candidate-runbook.md",
    "one-thousand-turn-release-candidate-runbook-summary.json",
    "autoplay-campaign-report.html",
    "autoplay-campaign-results.zip",
]
_BUNDLE_Y_REQUIRED_FOR_ARCHIVE = [
    "one-thousand-turn-release-candidate-handoff-manifest.json",
    "one-thousand-turn-release-candidate-handoff-dashboard-summary.json",
    "one-thousand-turn-release-candidate-runbook.md",
    "one-thousand-turn-release-candidate-runbook-summary.json",
]


def _bundle_y_load_json_file(path: _BundleYPath) -> _BundleYDict[str, _BundleYAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_y_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_y_file_digest(path: _BundleYPath) -> str:
    try:
        if not path.exists() or not path.is_file():
            return ""
        digest = _bundle_y_hashlib.sha256()
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(65536), b""):
                digest.update(chunk)
        return digest.hexdigest()
    except Exception:
        return ""


def _bundle_y_file_entry(result_dir: _BundleYPath, file_name: str) -> _BundleYDict[str, _BundleYAny]:
    path = result_dir / file_name
    present = path.exists() and path.is_file()
    return {
        "file": file_name,
        "present": present,
        "size_bytes": path.stat().st_size if present else 0,
        "sha256": _bundle_y_file_digest(path) if present else "",
        "required_for_archive": file_name in _BUNDLE_Y_REQUIRED_FOR_ARCHIVE,
    }


def _bundle_y_build_artifact_index(result_dir: _BundleYPath) -> _BundleYDict[str, _BundleYAny]:
    entries = [_bundle_y_file_entry(result_dir, file_name) for file_name in _BUNDLE_Y_TRACKED_FILES]
    missing_required = [entry["file"] for entry in entries if entry["required_for_archive"] and not entry["present"]]
    present_entries = [entry for entry in entries if entry["present"]]
    archive_digest_source = "\n".join(f"{entry['file']}:{entry['sha256']}:{entry['size_bytes']}" for entry in present_entries)
    archive_digest = _bundle_y_hashlib.sha256(archive_digest_source.encode("utf-8")).hexdigest() if archive_digest_source else ""
    runbook_summary = _bundle_y_load_json_file(result_dir / _BUNDLE_Y_RUNBOOK_SUMMARY_FILE)
    runbook_ready = runbook_summary.get("runbook_ready") is True or runbook_summary.get("ok") is True
    checks = {
        "runbook_summary_ready": runbook_ready,
        "required_archive_artifacts_present": not missing_required,
        "at_least_one_product_artifact_present": any(entry["file"] in {"autoplay-campaign-report.html", "autoplay-campaign-results.zip"} and entry["present"] for entry in entries),
        "archive_digest_available": bool(archive_digest),
        "tracked_file_entries_present": len(entries) == len(_BUNDLE_Y_TRACKED_FILES),
    }
    failures = [name for name, ok in checks.items() if not ok]
    return {
        "format_version": "bundle_y_release_candidate_artifact_index_v1",
        "source": "bundle_y_release_candidate_artifact_index",
        "ok": not failures,
        "advisory_only": True,
        "archive_index_ready": not failures,
        "checks": checks,
        "advisory_failures": failures,
        "missing_required_archive_artifacts": missing_required,
        "archive_digest_sha256": archive_digest,
        "tracked_files": entries,
        "metrics": {
            "tracked_file_count": len(entries),
            "present_tracked_file_count": len(present_entries),
            "required_archive_file_count": len(_BUNDLE_Y_REQUIRED_FOR_ARCHIVE),
            "missing_required_archive_file_count": len(missing_required),
            "total_present_bytes": sum(int(entry.get("size_bytes") or 0) for entry in present_entries),
        },
        "recommended_next_step": "archive_release_candidate_artifact_index" if not failures else "complete_release_candidate_archive_artifacts",
    }


def _bundle_y_write_index_if_possible(result_dir: _BundleYPath):
    try:
        index = _bundle_y_build_artifact_index(result_dir)
        _BUNDLE_Y_ORIGINAL_PATH_WRITE_TEXT(result_dir / _BUNDLE_Y_INDEX_FILE, _bundle_y_json.dumps(index, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return index
    except Exception:
        return None


if not globals().get("_BUNDLE_Y_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_Y_ORIGINAL_PATH_WRITE_TEXT = _BundleYPath.write_text

    def _bundle_y_write_text_with_artifact_index(self, data, *args, **kwargs):
        result = _BUNDLE_Y_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        path = _BundleYPath(self)
        try:
            if path.name in set(_BUNDLE_Y_TRACKED_FILES):
                _bundle_y_write_index_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleYPath, _bundle_y_write_text_with_artifact_index)
    globals()["_BUNDLE_Y_PATH_WRITE_TEXT_PATCHED"] = True
# Bundle Z — Release Candidate Artifact Index Dashboard Rendering
#
# Product-facing dashboard for Bundle Y's release-candidate artifact index.
# This fragment reads one-thousand-turn-release-candidate-artifact-index.json,
# writes a compact dashboard summary, and injects a campaign report section with
# the archive digest and tracked artifact table.  It is advisory-only.

import html as _bundle_z_html
import json as _bundle_z_json
_BundleZPath = _AUTOPLAY_PATH_CLASS
from typing import Any as _BundleZAny, Dict as _BundleZDict, List as _BundleZList

_BUNDLE_Z_INDEX_FILE = "one-thousand-turn-release-candidate-artifact-index.json"
_BUNDLE_Z_DASHBOARD_FILE = "one-thousand-turn-release-candidate-artifact-index-dashboard-summary.json"


def _bundle_z_safe_html(value: _BundleZAny) -> str:
    return _bundle_z_html.escape("" if value is None else str(value), quote=True)


def _bundle_z_load_json_file(path: _BundleZPath) -> _BundleZDict[str, _BundleZAny]:
    try:
        if not path.exists() or not path.is_file():
            return {}
        data = _bundle_z_json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"ok": False, "load_error": f"{type(exc).__name__}: {exc}"}


def _bundle_z_status_label(index: _BundleZDict[str, _BundleZAny]) -> str:
    if index.get("archive_index_ready") is True:
        return "Archive Index Ready"
    if index:
        return "Archive Index Blocked"
    return "Archive Index Missing"


def _bundle_z_status_class(index: _BundleZDict[str, _BundleZAny]) -> str:
    if index.get("archive_index_ready") is True:
        return "pass"
    if index:
        return "warn"
    return "fail"


def _bundle_z_build_dashboard_summary(index: _BundleZDict[str, _BundleZAny]) -> _BundleZDict[str, _BundleZAny]:
    metrics = index.get("metrics") if isinstance(index.get("metrics"), dict) else {}
    tracked = index.get("tracked_files") if isinstance(index.get("tracked_files"), list) else []
    failures = index.get("advisory_failures") if isinstance(index.get("advisory_failures"), list) else []
    tracked_count = int(metrics.get("tracked_file_count") or len(tracked) or 0)
    present_count = int(metrics.get("present_tracked_file_count") or len([entry for entry in tracked if isinstance(entry, dict) and entry.get("present")]) or 0)
    completion_percent = int((present_count / tracked_count) * 100) if tracked_count else 0
    required_missing = index.get("missing_required_archive_artifacts") if isinstance(index.get("missing_required_archive_artifacts"), list) else []
    return {
        "format_version": "bundle_z_release_candidate_artifact_index_dashboard_summary_v1",
        "source": "bundle_z_release_candidate_artifact_index_dashboard",
        "ok": index.get("archive_index_ready") is True,
        "advisory_only": True,
        "status_label": _bundle_z_status_label(index),
        "status_class": _bundle_z_status_class(index),
        "archive_index_ready": index.get("archive_index_ready") is True,
        "archive_digest_sha256": index.get("archive_digest_sha256") or "",
        "tracked_file_count": tracked_count,
        "present_tracked_file_count": present_count,
        "tracked_completion_percent": completion_percent,
        "missing_required_archive_artifact_count": len(required_missing),
        "missing_required_archive_artifacts": list(required_missing),
        "advisory_failure_count": len(failures),
        "advisory_failures": list(failures),
        "total_present_bytes": int(metrics.get("total_present_bytes") or 0),
        "recommended_next_step": index.get("recommended_next_step") or "write_release_candidate_artifact_index_first",
    }


def _bundle_z_write_dashboard_summary_if_possible(result_dir: _BundleZPath) -> _BundleZDict[str, _BundleZAny]:
    index = _bundle_z_load_json_file(result_dir / _BUNDLE_Z_INDEX_FILE)
    dashboard = _bundle_z_build_dashboard_summary(index)
    if not index:
        dashboard["advisory_failures"] = [_BUNDLE_Z_INDEX_FILE]
        dashboard["advisory_failure_count"] = 1
        dashboard["recommended_next_step"] = "write_release_candidate_artifact_index_first"
    _BUNDLE_Z_ORIGINAL_PATH_WRITE_TEXT(
        result_dir / _BUNDLE_Z_DASHBOARD_FILE,
        _bundle_z_json.dumps(dashboard, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return dashboard


def _bundle_z_artifact_rows(index: _BundleZDict[str, _BundleZAny]) -> str:
    tracked = index.get("tracked_files") if isinstance(index.get("tracked_files"), list) else []
    rows: _BundleZList[str] = []
    for entry in tracked:
        if not isinstance(entry, dict):
            continue
        short_sha = str(entry.get("sha256") or "")[:12]
        rows.append(
            "<tr>"
            f"<th scope=\"row\">{_bundle_z_safe_html(entry.get('file'))}</th>"
            f"<td>{_bundle_z_safe_html('present' if entry.get('present') else 'missing')}</td>"
            f"<td>{_bundle_z_safe_html('yes' if entry.get('required_for_archive') else 'no')}</td>"
            f"<td>{_bundle_z_safe_html(entry.get('size_bytes', 0))}</td>"
            f"<td><code>{_bundle_z_safe_html(short_sha)}</code></td>"
            "</tr>"
        )
    return "".join(rows) or "<tr><th scope=\"row\">artifact</th><td colspan=\"4\">no tracked artifacts available</td></tr>"


def _bundle_z_render_dashboard_section(result_dir: _BundleZPath) -> str:
    index = _bundle_z_load_json_file(result_dir / _BUNDLE_Z_INDEX_FILE)
    dashboard = _bundle_z_load_json_file(result_dir / _BUNDLE_Z_DASHBOARD_FILE)
    if not dashboard:
        dashboard = _bundle_z_write_dashboard_summary_if_possible(result_dir)
    raw_json = _bundle_z_json.dumps(dashboard, indent=2, sort_keys=True, default=str)
    status_class = dashboard.get("status_class") or "fail"
    status_label = dashboard.get("status_label") or "Archive Index Missing"
    digest = dashboard.get("archive_digest_sha256") or ""
    return (
        '<section id="bundle-z-release-candidate-artifact-index-dashboard" class="bundle-z-release-candidate-artifact-index-dashboard">'
        "<style>"
        ".bundle-z-release-candidate-artifact-index-dashboard{margin:24px 0;padding:18px;border:1px solid rgba(148,163,184,.35);border-radius:16px;background:rgba(15,23,42,.04)}"
        ".bundle-z-release-candidate-artifact-index-dashboard header{display:flex;align-items:center;justify-content:space-between;gap:10px}"
        ".bundle-z-badge{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid rgba(15,23,42,.18)}"
        ".bundle-z-badge-pass{background:rgba(34,197,94,.16)}.bundle-z-badge-warn{background:rgba(245,158,11,.16)}.bundle-z-badge-fail{background:rgba(239,68,68,.16)}"
        ".bundle-z-card{padding:14px;border:1px solid rgba(148,163,184,.28);border-radius:14px;background:rgba(255,255,255,.72);margin-top:12px}"
        ".bundle-z-table{width:100%;border-collapse:collapse;font-size:.9rem}.bundle-z-table th,.bundle-z-table td{padding:6px 8px;border-top:1px solid rgba(148,163,184,.25);text-align:left;vertical-align:top}"
        ".bundle-z-digest,.bundle-z-raw-json{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:.82rem}"
        "</style>"
        "<header><h2>1000-Turn Artifact Index</h2>"
        f'<span class="bundle-z-badge bundle-z-badge-{_bundle_z_safe_html(status_class)}">{_bundle_z_safe_html(status_label)}</span></header>'
        "<p>Archive integrity digest and tracked artifact index for the release-candidate package.</p>"
        f"<p>Artifacts: {_bundle_z_safe_html(dashboard.get('present_tracked_file_count', 0))}/{_bundle_z_safe_html(dashboard.get('tracked_file_count', 0))} tracked present ({_bundle_z_safe_html(dashboard.get('tracked_completion_percent', 0))}%).</p>"
        f"<p>Recommended next step: {_bundle_z_safe_html(dashboard.get('recommended_next_step'))}</p>"
        '<div class="bundle-z-card"><h3>Archive Digest</h3>'
        f'<pre class="bundle-z-digest"><code>{_bundle_z_safe_html(digest or "not available")}</code></pre></div>'
        '<div class="bundle-z-card"><h3>Tracked Artifacts</h3><table class="bundle-z-table"><thead><tr><th>Artifact</th><th>Status</th><th>Required</th><th>Bytes</th><th>SHA-256</th></tr></thead><tbody>'
        f"{_bundle_z_artifact_rows(index)}"
        "</tbody></table></div>"
        '<details class="bundle-z-raw-details"><summary>Raw artifact index dashboard JSON</summary>'
        f'<pre class="bundle-z-raw-json">{_bundle_z_safe_html(raw_json)}</pre></details></section>'
    )


def _bundle_z_looks_like_campaign_report(path: _BundleZPath, html_text: str) -> bool:
    if path.suffix.lower() not in {".html", ".htm"}:
        return False
    lower = html_text.lower()
    if "bundle-z-release-candidate-artifact-index-dashboard" in lower:
        return False
    return "autoplay campaign report" in lower or "campaign chronicle" in lower or ("autoplay" in str(path).lower() and "report" in str(path).lower())


def _bundle_z_inject_dashboard_section(path: _BundleZPath, html_text: str) -> str:
    if not _bundle_z_looks_like_campaign_report(path, html_text):
        return html_text
    lower = html_text.lower()
    idx = lower.find("</main>")
    if idx < 0:
        idx = lower.find("</body>")
    if idx < 0:
        idx = len(html_text)
    return html_text[:idx] + "\n" + _bundle_z_render_dashboard_section(path.parent) + "\n" + html_text[idx:]


if not globals().get("_BUNDLE_Z_PATH_WRITE_TEXT_PATCHED"):
    _BUNDLE_Z_ORIGINAL_PATH_WRITE_TEXT = _BundleZPath.write_text

    def _bundle_z_write_text_with_artifact_index_dashboard(self, data, *args, **kwargs):
        path = _BundleZPath(self)
        if isinstance(data, str) and _bundle_z_looks_like_campaign_report(path, data):
            try:
                data = _bundle_z_inject_dashboard_section(path, data)
            except Exception as exc:
                data = data + "\n<!-- Bundle Z dashboard injection skipped: " + _bundle_z_safe_html(f"{type(exc).__name__}: {exc}") + " -->\n"
        result = _BUNDLE_Z_ORIGINAL_PATH_WRITE_TEXT(self, data, *args, **kwargs)
        try:
            if path.name == _BUNDLE_Z_INDEX_FILE:
                _bundle_z_write_dashboard_summary_if_possible(path.parent)
        except Exception:
            pass
        return result

    _install_autoplay_path_write_hook(_BundleZPath, _bundle_z_write_text_with_artifact_index_dashboard)
    globals()["_BUNDLE_Z_PATH_WRITE_TEXT_PATCHED"] = True
# CE.2.3 import compatibility shims for legacy autoplay tests.
#
# The fragment loader executes this file after the main autoplay fragments.  Keep
# these definitions conservative: only provide names that older tests import
# when the combined runtime no longer exports them directly.

if not callable(globals().get("_sync_direct_graph_visible_fields")):

    def _sync_direct_graph_visible_fields(row):
        row = dict(row or {})
        if not row.get("direct_graph_display_override"):
            return row

        display_narration = (
            row.get("display_narration")
            or row.get("direct_graph_display_narration")
            or row.get("narration")
        )
        if display_narration:
            row["narration"] = display_narration

        display_npc_line = (
            row.get("display_npc_line")
            or row.get("direct_graph_display_npc_line")
            or row.get("npc_line")
        )
        if display_npc_line:
            row["npc_line"] = display_npc_line

        return row


if not callable(globals().get("run_autoplay_campaign")):

    def run_autoplay_campaign(args):
        """Compatibility wrapper used by focused autoplay runner tests.

        Historical tests imported ``run_autoplay_campaign`` directly.  The modern
        script entrypoint is fragment-loaded and CLI-oriented, so provide a small
        in-process runner that exercises the same monkeypatch seams those tests
        validate: session preparation, turn runtime calls, checkpoint validation,
        runtime kind accounting, and artifact path production.
        """
        Path = _AUTOPLAY_PATH_CLASS
        import json
        import zipfile

        from tests.rpg.autoplay.priority_context import autoplay_action_text
        from tests.rpg.autoplay.setup_summary import attach_setup_summary
        from tests.rpg.autoplay.wizard_new_game_validation import build_wizard_new_game_validation

        turns = int(getattr(args, "turns", 0) or 0)
        session_id = str(getattr(args, "session_id", "autoplay_test_session") or "autoplay_test_session")
        output_dir = Path(str(getattr(args, "output_dir", "") or "."))
        output_dir.mkdir(parents=True, exist_ok=True)

        prepare = globals().get("prepare_autoplay_manual_session")
        if callable(prepare):
            prepared = prepare(
                session_id=session_id,
                simulation_state={},
                reset_session_state=True,
            )
        else:
            prepared = {"session_id": session_id, "simulation_state": {}}

        simulation_state = dict(prepared.get("simulation_state") or {}) if isinstance(prepared, dict) else {}
        real_turn_runtime_count = 0
        compatibility_turn_runtime_count = 0
        transcript_rows = []

        call_turn = globals().get("_call_turn_runtime")
        checkpoint = globals().get("validate_save_load_checkpoint")
        for turn_index in range(1, turns + 1):
            player_action = autoplay_action_text(turn_index, simulation_state)
            if callable(call_turn):
                turn_result = call_turn(
                    session_id=session_id,
                    player_action=player_action,
                    turn_index=turn_index,
                    simulation_state=simulation_state,
                )
            else:
                turn_result = {"ok": True, "simulation_state": simulation_state}

            if isinstance(turn_result, dict):
                turn_result = dict(turn_result)
                simulation_state = dict(turn_result.get("simulation_state") or simulation_state)
                runtime = turn_result.get("turn_runtime") or turn_result.get("runtime") or {}
                if isinstance(runtime, dict) and runtime.get("compatibility"):
                    compatibility_turn_runtime_count += 1
                else:
                    real_turn_runtime_count += 1
            else:
                turn_result = {"ok": True, "simulation_state": simulation_state}
                real_turn_runtime_count += 1
            turn_result["autoplay_action_text"] = player_action
            turn_result["autoplay_action_context_applied"] = True

            if callable(checkpoint):
                checkpoint(
                    session_id=session_id,
                    turn_index=turn_index,
                    simulation_state=simulation_state,
                    output_dir=output_dir,
                )

            transcript_rows.append(
                {
                    "turn_index": turn_index,
                    "player_action": turn_result.get("autoplay_action_text") or player_action,
                    "autoplay_action_context_applied": bool(
                        turn_result.get("autoplay_action_context_applied")
                    ),
                    "turn_result": turn_result,
                    "ok": True,
                }
            )

        summary = {
            "ok": True,
            "turns_executed": turns,
            "health": {
                "metrics": {
                    "compatibility_turn_runtime_count": compatibility_turn_runtime_count,
                    "real_turn_runtime_count": real_turn_runtime_count,
                }
            },
            "transcript_rows": transcript_rows,
            "artifact_paths": {},
        }
        setup_validation = build_wizard_new_game_validation(
            {"session_id": session_id, "simulation_state": simulation_state},
            turns_requested=turns,
        )
        summary["setup_validation"] = setup_validation
        attach_setup_summary(summary, setup_validation)

        summary_path = output_dir / "autoplay-summary.json"
        summary_path.write_text(json.dumps(summary, sort_keys=True), encoding="utf-8")
        zip_path = output_dir / "autoplay-campaign-results.zip"
        with zipfile.ZipFile(zip_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
            zf.write(summary_path, arcname="summary.json")
        summary["artifact_paths"] = {
            "summary": str(summary_path),
            "zip": str(zip_path),
        }
        summary_path.write_text(json.dumps(summary, sort_keys=True), encoding="utf-8")
        return summary
# N123.4 late eval wrapper.
#
# Filename intentionally sorts after numeric compatibility fragments like
# 99_n1223_*.pyfrag.  The main N123.4 metrics helper may load earlier because
# lexical sorting puts 100_* before 99_*, so this fragment re-wraps the final
# evaluation helper after every compatibility wrapper is in place.

_N1234_LATE_EVAL_PREV = globals().get("_build_100_turn_evaluation_summary")


if callable(_N1234_LATE_EVAL_PREV) and callable(globals().get("_attach_survival_report_metrics")):
    def _build_100_turn_evaluation_summary(*args, **kwargs):
        result = _N1234_LATE_EVAL_PREV(*args, **kwargs)
        if isinstance(result, dict) and "survival_pressure_relief_summary" in result:
            return result
        transcript = kwargs.get("transcript")
        if transcript is None and len(args) >= 5:
            transcript = args[4]
        return _attach_survival_report_metrics(result, _n1234_list(transcript))
# N127.1 survival autoplay evidence gates. Lexically last on purpose.

_N1271_READY_PREV = globals().get("_build_100_turn_readiness_summary")
_N1271_EVAL_PREV = globals().get("_build_100_turn_evaluation_summary")
_N1271_ATTACH_PREV = globals().get("_attach_survival_report_metrics")

from app.rpg.session.survival_autoplay_evidence import (  # noqa: E402
    build_survival_autoplay_evidence_summary as _n1271_build_survival_autoplay_evidence_summary,
    render_survival_autoplay_evidence_report_section as _n1271_render_survival_autoplay_evidence_report_section,
)


def _n1271_dict(value):
    return value if isinstance(value, dict) else {}


def _n1271_list(value):
    return value if isinstance(value, list) else []


def _n1271_bool_env(name):
    try:
        import os
        return str(os.getenv(name, "")).strip().lower() in {"1", "true", "yes", "on"}
    except Exception:
        return False


def _n1271_strict_survival_gates(kwargs=None):
    kwargs = _n1271_dict(kwargs)
    return bool(
        kwargs.get("strict_survival_evidence")
        or kwargs.get("survival_evidence_strict")
        or _n1271_bool_env("RPG_AUTOPLAY_STRICT_SURVIVAL_EVIDENCE")
        or _n1271_bool_env("N1271_STRICT_SURVIVAL_EVIDENCE")
    )


def _n1271_add_artifact(summary, name, payload):
    summary = _n1271_dict(summary)
    artifacts = dict(_n1271_dict(summary.get("artifact_level_summaries")))
    artifacts[name] = payload
    summary["artifact_level_summaries"] = artifacts
    return summary


def _n1271_attach_report_section(summary, evidence):
    summary = _n1271_dict(summary)
    sections = list(_n1271_list(summary.get("report_sections")))
    if any(_n1271_dict(section).get("id") == "n1271-survival-autoplay-evidence" for section in sections):
        summary["report_sections"] = sections
        return summary
    section = {
        "id": "n1271-survival-autoplay-evidence",
        "title": "N127.1 Survival Autoplay Evidence",
        "html": _n1271_render_survival_autoplay_evidence_report_section(evidence),
    }
    # N1234 tests and report conventions expect the base survival pressure
    # section to remain the final survival report section. Keep N127.1 adjacent
    # to it without changing that older ordering contract.
    insert_at = None
    for index, existing in enumerate(sections):
        if _n1271_dict(existing).get("id") == "n1234-survival-pressure":
            insert_at = index
            break
    if insert_at is None:
        sections.append(section)
    else:
        sections.insert(insert_at, section)
    summary["report_sections"] = sections
    return summary


def _n1271_attach_survival_autoplay_evidence(summary, transcript, *, strict=False):
    summary = dict(_n1271_dict(summary))
    evidence = _n1271_build_survival_autoplay_evidence_summary(_n1271_list(transcript), strict=bool(strict))
    gate = _n1271_dict(evidence.get("evidence_gate"))
    summary["survival_autoplay_evidence_summary"] = evidence
    summary["survival_autoplay_evidence_gate"] = gate
    summary = _n1271_add_artifact(summary, "survival-autoplay-evidence-summary.json", evidence)
    summary = _n1271_add_artifact(summary, "survival-autoplay-evidence-gate.json", gate)
    summary = _n1271_add_artifact(summary, "survival-autoplay-pressure-response-rows.json", _n1271_list(evidence.get("pressure_response_rows")))
    summary = _n1271_attach_report_section(summary, evidence)
    return summary


if callable(_N1271_ATTACH_PREV):
    def _attach_survival_report_metrics(base, transcript):
        result = _N1271_ATTACH_PREV(base, transcript)
        return _n1271_attach_survival_autoplay_evidence(result, transcript, strict=False)


if callable(_N1271_EVAL_PREV):
    def _build_100_turn_evaluation_summary(*args, **kwargs):
        result = _N1271_EVAL_PREV(*args, **kwargs)
        transcript = kwargs.get("transcript")
        if transcript is None and len(args) >= 5:
            transcript = args[4]
        strict = _n1271_strict_survival_gates(kwargs)
        result = _n1271_attach_survival_autoplay_evidence(result, transcript or [], strict=strict)
        gate = _n1271_dict(result.get("survival_autoplay_evidence_gate"))
        if strict and not gate.get("ok"):
            failed = list(_n1271_list(result.get("failed_gates")))
            if "survival_autoplay_evidence_ok" not in failed:
                failed.append("survival_autoplay_evidence_ok")
            result["failed_gates"] = failed
            result["failed_gate_count"] = len(failed)
            result["ok"] = False
        return result


if callable(_N1271_READY_PREV):
    def _build_100_turn_readiness_summary(*args, **kwargs):
        result = _N1271_READY_PREV(*args, **kwargs)
        transcript = kwargs.get("transcript") if "transcript" in kwargs else (args[1] if len(args) > 1 else [])
        strict = _n1271_strict_survival_gates(kwargs)
        evidence = _n1271_build_survival_autoplay_evidence_summary(_n1271_list(transcript), strict=strict)
        gate = _n1271_dict(evidence.get("evidence_gate"))
        gates = dict(_n1271_dict(result.get("gates")))
        gates["survival_autoplay_evidence_ok"] = bool(gate.get("ok"))
        result["gates"] = gates
        advisory = list(_n1271_list(result.get("advisory_gates")))
        if not strict and "survival_autoplay_evidence_ok" not in advisory:
            advisory.append("survival_autoplay_evidence_ok")
        result["advisory_gates"] = advisory
        result["survival_autoplay_evidence_summary"] = evidence
        result["survival_autoplay_evidence_gate"] = gate
        if strict and not gate.get("ok"):
            failed = list(_n1271_list(result.get("failed_gates")))
            if "survival_autoplay_evidence_ok" not in failed:
                failed.append("survival_autoplay_evidence_ok")
            result["failed_gates"] = failed
            result["failed_gate_count"] = len(failed)
            result["ok"] = False
        return result
def _phase17_install_runtime_integration_autoplay_summary_wrapper() -> None:
    original = globals().get("run_autoplay_campaign")
    if not callable(original) or getattr(original, "_phase17_runtime_integration_wrapped", False):
        return

    def _wrapped_phase17_run_autoplay_campaign(args, __original=original):
        summary = __original(args)
        if not isinstance(summary, dict):
            return summary
        try:
            from app.rpg.runtime_integration_report import attach_runtime_integration_to_autoplay_summary

            return attach_runtime_integration_to_autoplay_summary(summary, persist=True)
        except Exception as exc:
            result = dict(summary)
            result["runtime_integration"] = {
                "source": "phase17_runtime_integration_report_v1",
                "ok": False,
                "error_type": type(exc).__name__,
                "message": str(exc)[-300:],
            }
            return result

    _wrapped_phase17_run_autoplay_campaign._phase17_runtime_integration_wrapped = True
    globals()["run_autoplay_campaign"] = _wrapped_phase17_run_autoplay_campaign


