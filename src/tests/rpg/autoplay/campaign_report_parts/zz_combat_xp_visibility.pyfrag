
# PR.1.15: Combat XP report visibility extension.
# Loaded last by campaign_report.py so it wraps the assembled renderer without
# depending on the current internal fragment layout.
from html import escape as _combat_xp_report_escape

_base_render_campaign_report_html_for_combat_xp_visibility = render_campaign_report_html


def _combat_xp_report_safe_dict(value):
    return value if isinstance(value, dict) else {}


def _combat_xp_report_safe_list(value):
    return value if isinstance(value, list) else []


def _combat_xp_report_safe_int(value, default=0):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def _combat_xp_report_first_xp_result(*values):
    for value in values:
        xp_result = _combat_xp_report_safe_dict(value)
        if not xp_result:
            continue
        if (
            bool(xp_result.get("awarded"))
            or _combat_xp_report_safe_int(xp_result.get("xp_awarded")) > 0
            or _combat_xp_report_safe_int(xp_result.get("xp_gained")) > 0
            or bool(xp_result.get("level_ups"))
        ):
            return xp_result
    return {}


def _iter_combat_xp_report_turns(report_data):
    report_data = _combat_xp_report_safe_dict(report_data)
    candidate_lists = [
        report_data.get("turns"),
        report_data.get("transcript"),
        report_data.get("final_transcript"),
        report_data.get("turn_records"),
        _combat_xp_report_safe_dict(report_data.get("summary")).get("turns"),
    ]
    for candidate in candidate_lists:
        for turn in _combat_xp_report_safe_list(candidate):
            if isinstance(turn, dict):
                yield turn


def _collect_combat_xp_report_rows(report_data):
    rows = []
    total_awarded = 0
    for index, turn in enumerate(_iter_combat_xp_report_turns(report_data), start=1):
        result = _combat_xp_report_safe_dict(turn.get("result"))
        resolved_result = _combat_xp_report_safe_dict(turn.get("resolved_result"))
        narration_context = _combat_xp_report_safe_dict(turn.get("narration_context"))
        combat_result = (
            _combat_xp_report_safe_dict(turn.get("combat_result"))
            or _combat_xp_report_safe_dict(result.get("combat_result"))
            or _combat_xp_report_safe_dict(resolved_result.get("combat_result"))
            or _combat_xp_report_safe_dict(narration_context.get("combat_result"))
        )
        xp_result = _combat_xp_report_first_xp_result(
            turn.get("xp_result"),
            result.get("xp_result"),
            resolved_result.get("xp_result"),
            narration_context.get("xp_result"),
            combat_result.get("xp_result"),
            _combat_xp_report_safe_dict(combat_result.get("loot_result")).get("xp_result"),
        )
        if not xp_result:
            continue
        xp_awarded = _combat_xp_report_safe_int(
            xp_result.get("xp_awarded"),
            _combat_xp_report_safe_int(xp_result.get("xp_gained")),
        )
        total_awarded += xp_awarded
        rows.append(
            {
                "turn": turn.get("turn") or turn.get("turn_index") or turn.get("tick") or index,
                "action": result.get("action_type") or resolved_result.get("action_type") or turn.get("action_type") or "combat",
                "target": combat_result.get("target_id") or resolved_result.get("target_id") or result.get("target_id") or "",
                "xp_awarded": xp_awarded,
                "awarded": bool(xp_result.get("awarded")),
                "reason": xp_result.get("reason") or combat_result.get("reason") or "",
            }
        )
    return rows, total_awarded


def _render_combat_xp_report_visibility_section(report_data):
    rows, total_awarded = _collect_combat_xp_report_rows(report_data)
    if not rows:
        return (
            '<section id="combat-xp-rewards" class="card">'
            '<h2>Combat XP Rewards</h2>'
            '<p>No deterministic combat XP rewards were recorded in this run.</p>'
            '</section>'
        )

    row_html = []
    for row in rows:
        row_html.append(
            "<tr>"
            f"<td>{_combat_xp_report_escape(str(row['turn']))}</td>"
            f"<td>{_combat_xp_report_escape(str(row['action']))}</td>"
            f"<td>{_combat_xp_report_escape(str(row['target']))}</td>"
            f"<td>{row['xp_awarded']}</td>"
            f"<td>{'yes' if row['awarded'] else 'no'}</td>"
            f"<td>{_combat_xp_report_escape(str(row['reason']))}</td>"
            "</tr>"
        )
    return (
        '<section id="combat-xp-rewards" class="card">'
        '<h2>Combat XP Rewards</h2>'
        f'<p>Total deterministic combat XP shown in turn payloads: <strong>{total_awarded}</strong></p>'
        '<table><thead><tr>'
        '<th>Turn</th><th>Action</th><th>Target</th><th>XP</th><th>Awarded</th><th>Reason</th>'
        '</tr></thead><tbody>'
        + "".join(row_html)
        + '</tbody></table>'
        '</section>'
    )


def _insert_combat_xp_report_visibility_section(html, section):
    body_close = html.lower().rfind("</body>")
    if body_close >= 0:
        return html[:body_close] + section + html[body_close:]
    return html + section


def render_campaign_report_html(report_data):
    html = _base_render_campaign_report_html_for_combat_xp_visibility(report_data)
    section = _render_combat_xp_report_visibility_section(report_data)
    return _insert_combat_xp_report_visibility_section(html, section)
