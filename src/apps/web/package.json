{
  "name": "@omnix/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:devtools": "vite --host 0.0.0.0 --port 5173 --mode devtools",
    "devtools": "react-devtools",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:trading": "vitest run src/features/trading",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:trading": "playwright test tests/e2e/trading-terminal.spec.ts --project=chromium",
    "typecheck": "tsc -b",
    "typecheck:trading": "tsc -p tsconfig.trading.json",
    "api:schema": "python ../../../scripts/export_gateway_openapi.py src/apps/web/src/api/generated/openapi.json",
    "api:types": "openapi-typescript src/api/generated/openapi.json -o src/api/generated/types.ts",
    "api:generate": "npm run api:schema && npm run api:types",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated/openapi.json src/api/generated/types.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.15",
    "lightweight-charts": "^5.1.0",
    "pixi.js": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "untitled-pixi-live2d-engine": "^1.3.5",
    "zod": "^4.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.0"
  }
}
