  "patterns": {
    "broad_excepts": "an ``except`` clause whose type is ``Exception`` or a tuple containing ``Exception``, and bare ``except:``.",
    "contract_bypass_imports": "an import (at any scope) from one RPG context into a module of another context that is not that context's ``contracts`` module or package. Contexts come from ``[rpg_contexts]`` with AL017's longest-entry match. Counted as distinct (importing module, imported module) pairs.",
    "deepcopy_calls": "a call whose callee name is ``deepcopy`` (``deepcopy(...)`` or ``copy.deepcopy(...)``).",
    "dict_str_any": "regex ``\\b(?:dict|Dict)\\[\\s*str\\s*,\\s*Any\\s*\\]`` over the source text (annotations in strings count too). Both spellings count, so ``Dict`` -> ``dict`` is not a change; each is also reported.",
    "nondeterminism": "a call to a ``random`` module function (the global, unseeded generator), ``random.Random()`` without a seed, ``uuid4``, ``time.time``, or ``datetime.now``/``datetime.utcnow`` (on ``datetime`` or ``datetime.datetime``). Calls are resolved through the module's imports, so ``from uuid import uuid4`` counts. ``time.perf_counter``/``monotonic`` are durations, not clock reads, and are not counted.",
    "python_files_over_1200_lines": "RPG Python files with more than 1,200 lines (``str.splitlines``).",
    "save_call_sites": "a call whose callee name (bare or attribute) is ``save_session`` or ``save_runtime_session``. Definitions are not calls. Reported as call sites and modules.",
    "state_string_key_reads": "a read of a literal string key from a state section, where the receiver is a name or attribute called ``simulation_state`` or ``runtime_state``: ``<receiver>[\"key\"]`` in load context, or ``<receiver>.get(\"key\", ...)``. Reported as occurrences and distinct keys, per section.",
    "web_files_over_600_lines": "RPG web files with more than 600 lines.",
    "word_list_constants": "a module-level assignment to a name ending in ``WORDS``, ``KEYWORDS``, ``VERBS``, ``TERMS``, ``MARKERS`` or ``PHRASES`` (any case of a leading underscore), by context.",
    "world_specific_names": "regex, case-insensitive, with letters and digits (not ``_``) as the word boundary, so ``npc:Bran``, ``npc_bran`` and ``demo_glimmerdeep_pass`` match and ``Brandon`` does not: ``Rusty Flagon``/``rusty_flagon``, ``Bran``, ``Elara``, ``Aldric``, ``Mira``, ``old_mill``/``old mill``, ``Glimmerdeep``. Scope: the ``rules``, ``world``, ``session`` and ``narration`` contexts, excluding fixture modules (a file name containing ``fixture``). The whole package is reported alongside, for reference."
  },
