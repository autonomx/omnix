# Data files
resources/data/

# Allow the small review-safe manifest digest to be committed from ignored
# test-result trees.  Other large/generated test-result files remain ignored
# unless they are already tracked or explicitly force-added.
!/resources/data/
/resources/data/*
!/resources/data/test-results/
/resources/data/test-results/**/*
!/resources/data/test-results/**/
!/resources/data/test-results/**/artifact-manifest-digest.json

# Logs
*.log
/resources/logs/

# Generated runtime and rehearsal artifacts
/resources/artifacts/
# Runtime output under resources (WP-11.6): caches, market-data evidence
# captures, benchmark runs and voice clones users create. The approved sample
# voices are tracked; add a new one deliberately with `git add -f`.
/resources/cache/
/resources/trading/ibkr_evidence/
/resources/trading/yahoo_evidence/
/resources/trading/activity_log/
/resources/benchmarks/gateway/hardening-*.json
/resources/voice_clones/*
# Local launcher settings; resources/config/launcher.example.toml is the template.
/resources/config/launcher.toml

# Environment variables
.env
.env.local

